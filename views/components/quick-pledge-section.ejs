<!-- ==========================================================================
     HOME QUICK ACTION / ONLINE PLEDGE SECTION (Fully Responsive)
     Replaces Why-Choose Section as requested
     ========================================================================== -->
<section class="home-pledge-section" id="pledge-form-section">
  <div class="ny-container">

    <div class="home-pledge-layout">

      <!-- Left Column: Mission, Trust Points & Helpline Support -->
      <div class="home-pledge-info">
        <div class="section-tag">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span>त्वरित संकल्प एवं सदस्यता</span>
        </div>

        <h2 class="pledge-info-title">
          निषाद संकल्प अभियान से जुड़ें — <span class="text-highlight">अपना संकल्प दर्ज करें</span>
        </h2>

        <p class="pledge-info-desc">
          निषाद समाज के संवैधानिक अधिकार, आरक्षण, शिक्षा, स्वाभिमान और सामाजिक न्याय के इस ऐतिहासिक महा-अभियान में अपनी सहभागिता सुनिश्चित करें। आपका एक कदम समाज को नई ऊर्जा और शक्ति प्रदान करेगा।
        </p>

        <div class="pledge-trust-list">
          <div class="pledge-trust-item">
            <div class="pledge-trust-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
              <h4>निःशुल्क व सीधा संकल्प</h4>
              <p>फॉर्म भरकर बिना किसी शुल्क के अभियान के सक्रिय सदस्य बनें।</p>
            </div>
          </div>

          <div class="pledge-trust-item">
            <div class="pledge-trust-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <h4>एकजुटता और सामाजिक शक्ति</h4>
              <p>लाखों लोगों के साथ मिलकर समाज की आवाज़ को राष्ट्रीय स्तर पर बुलंद करें।</p>
            </div>
          </div>

          <div class="pledge-trust-item">
            <div class="pledge-trust-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h4>सीधा संपर्क व हेल्पलाइन</h4>
              <p>किसी भी सहयोग व जानकारी हेतु सीधे कॉल करें: <strong>+91 99553 09029</strong></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Quick Action Pledge Form Card -->
      <div class="home-pledge-card-wrapper">
        <div class="home-pledge-form-card">
          <div class="pledge-form-header">
            <div class="pledge-badge-row">
              <img src="/images/mainlogo.png" alt="लोगो" class="pledge-badge-logo" onerror="this.src='/images/logo.png'" />
              <div>
                <h3 class="pledge-form-title">ऑनलाइन संकल्प फॉर्म</h3>
                <span class="pledge-form-subtitle">Quick Movement Action</span>
              </div>
            </div>
            <p class="pledge-form-note">कृपया अपना सही विवरण दर्ज करें ताकि टीम आपसे संपर्क कर सके।</p>
          </div>

          <form id="homeSectionPledgeForm" class="home-pledge-form" novalidate>
            <!-- 1. Full Name -->
            <div class="pledge-input-group">
              <label for="homePledgeName" class="pledge-label">
                पूरा नाम (Full Name) <span class="req">*</span>
              </label>
              <input
                type="text"
                id="homePledgeName"
                name="name"
                class="pledge-control"
                placeholder="उदा. राहुल निषाद"
                required
                autocomplete="name"
              />
            </div>

            <!-- 2. Phone Number -->
            <div class="pledge-input-group">
              <label for="homePledgePhone" class="pledge-label">
                मोबाइल नंबर (Phone Number) <span class="req">*</span>
              </label>
              <input
                type="tel"
                id="homePledgePhone"
                name="phone"
                class="pledge-control"
                placeholder="10 अंकों का मोबाइल नंबर"
                pattern="[0-9]{10}"
                maxlength="10"
                required
                autocomplete="tel"
              />
            </div>

            <!-- 3. District / Region -->
            <div class="pledge-input-group">
              <label for="homePledgeDistrict" class="pledge-label">
                ज़िला / क्षेत्र (District / Region)
              </label>
              <select id="homePledgeDistrict" name="district" class="pledge-control pledge-select-control">
                <option value="Prayagraj">प्रयागराज (Prayagraj)</option>
                <option value="Varanasi">वाराणसी (Varanasi)</option>
                <option value="Gorakhpur">गोरखपुर (Gorakhpur)</option>
                <option value="Ayodhya">अयोध्या (Ayodhya)</option>
                <option value="Mirzapur">मिर्जापुर (Mirzapur)</option>
                <option value="Patna">पटना (Patna)</option>
                <option value="Ranchi">राँची (Ranchi)</option>
                <option value="Bhopal">भोपाल (Bhopal)</option>
                <option value="Lucknow">लखनऊ (Lucknow)</option>
                <option value="Kanpur">कानपुर (Kanpur)</option>
                <option value="Other District">अन्य ज़िला (Other District)</option>
              </select>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="ny-btn ny-btn-primary pledge-submit-button" id="homePledgeSubmitBtn">
              <span>संकल्प दर्ज करें (Submit Pledge)</span>
              <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
            </button>
          </form>

          <!-- Feedback Alerts -->
          <div id="homePledgeSuccessMsg" class="pledge-status-alert pledge-status-success" style="display: none;" role="alert">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>आपका संकल्प सफलतापूर्वक दर्ज कर लिया गया है। हमारे प्रतिनिधि जल्द आपसे संपर्क करेंगे। धन्यवाद!</span>
          </div>

          <div id="homePledgeErrorMsg" class="pledge-status-alert pledge-status-error" style="display: none;" role="alert">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="homePledgeErrorText">कृपया सभी आवश्यक फ़ील्ड सही से भरें।</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  (function () {
    const form = document.getElementById("homeSectionPledgeForm");
    const nameInput = document.getElementById("homePledgeName");
    const phoneInput = document.getElementById("homePledgePhone");
    const districtInput = document.getElementById("homePledgeDistrict");
    const submitBtn = document.getElementById("homePledgeSubmitBtn");
    const successMsg = document.getElementById("homePledgeSuccessMsg");
    const errorMsg = document.getElementById("homePledgeErrorMsg");
    const errorText = document.getElementById("homePledgeErrorText");

    if (!form) return;

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      if (successMsg) successMsg.style.display = "none";
      if (errorMsg) errorMsg.style.display = "none";

      const nameVal = nameInput ? nameInput.value.trim() : "";
      const phoneVal = phoneInput ? phoneInput.value.trim() : "";
      const districtVal = districtInput ? districtInput.value.trim() : "";

      if (!nameVal) {
        showError("कृपया अपना पूरा नाम दर्ज करें।");
        if (nameInput) nameInput.focus();
        return;
      }

      const phoneRegex = /^[0-9]{10}$/;
      if (!phoneVal || !phoneRegex.test(phoneVal)) {
        showError("कृपया 10 अंकों का वैध मोबाइल नंबर दर्ज करें।");
        if (phoneInput) phoneInput.focus();
        return;
      }

      // Disable button
      const origHtml = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = "<span>दर्ज किया जा रहा है...</span>";

      try {
        const response = await fetch("/api/submit-pledge", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: nameVal,
            phone: phoneVal,
            district: districtVal
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          form.reset();
          if (successMsg) {
            successMsg.style.display = "flex";
            successMsg.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
        } else {
          showError(data.message || "कुछ गड़बड़ हुई, कृपया पुनः प्रयास करें।");
        }
      } catch (err) {
        console.error("Home pledge submit error:", err);
        showError("सर्वर से संपर्क नहीं हो सका। कृपया इंटरनेट जांचें और पुनः प्रयास करें।");
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = origHtml;
      }
    });

    function showError(msg) {
      if (errorText) errorText.textContent = msg;
      if (errorMsg) {
        errorMsg.style.display = "flex";
        errorMsg.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }
  })();
</script>
