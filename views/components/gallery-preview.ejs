<!-- =========================================
     SANKALP PHOTO GALLERY — SCROLLING PREVIEW SECTION
========================================= -->
<section class="gallery-preview-section" id="gallery-preview" aria-label="Image Gallery Preview">
  <div class="gallery-preview-wrapper">
    
    <!-- Section Header -->
    <div class="gallery-header-row">
      <div class="gallery-title-wrap">
        <h2>
          <span style="color: #d72a2a;">Image Gallery</span>
        </h2>
        <p class="gallery-subtitle">संकल्प पत्र, चौपाल एवं सामाजिक अभियानों की ऐतिहासिक झलकियां</p>
      </div>
    </div>

    <!-- Scrolling Cards Container (आगे-पीछे स्क्रोल करने वाला ट्रैक) -->
    <div class="gallery-scroll-container" id="galleryScrollContainer">
      <div class="gallery-scroll-track" id="galleryScrollTrack">
        <% if (typeof galleryPhotos !== 'undefined' && galleryPhotos && galleryPhotos.length > 0) { %>
          <% galleryPhotos.forEach(function(photo, idx) { %>
            <a href="/gallery" class="gallery-card-item" data-index="<%= idx %>">
              <div class="gallery-card-thumb">
                <img
                  src="<%= photo.imageUrl %>"
                  alt="<%= photo.name %>"
                  class="gallery-card-img"
                  loading="lazy"
                  onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=800&q=80'"
                />
                <% if (photo.district) { %>
                  <span class="gallery-card-location">
                    📍 <%= photo.district %>
                  </span>
                <% } %>
                <span class="gallery-card-date">
                  📅 <%= photo.dateString || photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('hi-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '2026') %>
                </span>
              </div>
              <div class="gallery-card-body">
                <strong class="gallery-card-title"><%= photo.name %></strong>
                <p class="gallery-card-caption">
                  <%= photo.caption || 'अखंड निषाद संकल्प अभियान के अंतर्गत लिया गया पावन संकल्प।' %>
                </p>
              </div>
            </a>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Scroll Progress Dots Indicators -->
    <% if (typeof galleryPhotos !== 'undefined' && galleryPhotos && galleryPhotos.length > 4) { %>
      <% const dotCount = Math.min(6, Math.ceil(galleryPhotos.length / 2)); %>
      <div class="gallery-scroll-dots" id="galleryScrollDots" aria-hidden="true">
        <% for (let i = 0; i < dotCount; i++) { %>
          <button type="button" class="gallery-scroll-dot <%= i === 0 ? 'active' : '' %>" data-dot="<%= i %>" aria-label="Go to gallery slide <%= i + 1 %>"></button>
        <% } %>
      </div>
    <% } %>

    <!-- Bottom Action: View Full Gallery Button Below Images -->
    <div class="gallery-bottom-action">
      <a href="/gallery" class="gallery-view-all-btn">
        <span>View Full Gallery</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>
