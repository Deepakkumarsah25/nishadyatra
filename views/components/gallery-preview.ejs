<section class="gallery-preview-section home-media-section" id="gallery-preview">
  <div class="home-media-container">
    <header class="home-media-header">
      <div>
        <span class="home-media-eyebrow">Campaign moments</span>
        <h2 class="section-title">Image <span class="text-highlight">Gallery</span></h2>
      </div>
    </header>

    <% if (typeof galleryPhotos !== 'undefined' && galleryPhotos && galleryPhotos.length) { %>
      <div class="home-media-rail home-photo-rail" aria-label="Latest campaign photos">
        <% galleryPhotos.slice(0, 10).forEach(function(photo) { %>
          <a href="<%= photo.imageUrl %>" target="_blank" rel="noopener" class="home-photo-card" aria-label="View full size photo: <%= photo.name %>">
            <div class="home-photo-thumb">
              <img src="<%= photo.imageUrl %>" alt="<%= photo.name %>" loading="lazy"
                onerror="this.onerror=null; this.src='/images/about/nishad-sankalp-rally.jpg';" />
              <% if (photo.district) { %><span class="home-photo-location"><%= photo.district %></span><% } %>
            </div>
            <div class="home-media-card-copy">
              <h3><%= photo.name %></h3>
              <% if (photo.caption) { %><p><%= photo.caption %></p><% } %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p class="home-media-empty">Campaign photos will appear here soon.</p>
    <% } %>

    <div class="home-media-cta">
      <a href="/gallery" class="ny-btn ny-btn-primary">View More Images <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<dialog class="home-photo-lightbox" id="homePhotoLightbox" aria-label="Full size campaign photo">
  <button class="home-photo-lightbox-close" id="homePhotoLightboxClose" type="button" aria-label="Close photo">&times;</button>
  <img id="homePhotoLightboxImage" alt="" />
  <p id="homePhotoLightboxCaption"></p>
</dialog>

<script>
  (() => {
    const rail = document.querySelector(".home-photo-rail");
    const dialog = document.getElementById("homePhotoLightbox");
    const image = document.getElementById("homePhotoLightboxImage");
    const caption = document.getElementById("homePhotoLightboxCaption");
    const closeButton = document.getElementById("homePhotoLightboxClose");
    if (!rail || !dialog || !image || !caption || !closeButton) return;

    rail.addEventListener("click", (event) => {
      const card = event.target.closest(".home-photo-card");
      if (!card) return;
      event.preventDefault();

      const thumbnail = card.querySelector(".home-photo-thumb img");
      image.src = thumbnail?.currentSrc || card.href;
      image.alt = thumbnail?.alt || "Campaign photo";
      caption.textContent = card.querySelector(".home-media-card-copy h3")?.textContent || "";
      dialog.showModal();
    });

    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
