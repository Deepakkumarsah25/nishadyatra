<!-- =========================================
     SANKALP PHOTO GALLERY — PREVIEW SECTION
========================================= -->
<section class="gallery-preview-section" id="gallery-preview" style="padding: 90px 24px; background: #ffffff; position: relative;">
  <div style="max-width: 1240px; margin: 0 auto;">
    <!-- Section Header -->
    <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 40px;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; background: #fff0ec; color: #d72a2a; padding: 5px 14px; border-radius: 20px; font-size: 13px; font-weight: 800; border: 1px solid #f7c9be; margin-bottom: 12px;">
          <span>॥ जन-भागीदारी ॥</span>
          <span>•</span>
          <span>संकल्प लेते साथी</span>
        </div>
        <h2 style="font-family: 'Rozha One', 'Mukta', serif; font-size: clamp(28px, 4vw, 42px); color: #2c1e1e; line-height: 1.2; font-weight: 800;">
          संकल्प फोटो — <span style="color: #d72a2a;">Image Gallery</span>
        </h2>
        <p style="font-size: 15px; color: #78665f; margin-top: 8px; max-width: 600px; line-height: 1.5;">
          विभिन्न जनपदों से निषाद संकल्प अभियान के प्रति समर्पित समाज बंधुओं एवं जनसामान्य द्वारा भेजी गई तस्वीरें।
        </p>
      </div>

      <div>
        <a href="/gallery" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 10px; background: linear-gradient(135deg, #d72a2a, #a91c1c); color: #fff; font-weight: 800; font-size: 14px; text-decoration: none; box-shadow: 0 4px 15px rgba(215, 42, 42, 0.25);">
          <span>संपूर्ण गैलरी देखें (All Photos)</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Preview Grid (4-6 photos) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
      <% if (typeof galleryPhotos !== 'undefined' && galleryPhotos && galleryPhotos.length > 0) { %>
        <% galleryPhotos.slice(0, 4).forEach(function(photo) { %>
          <a href="/gallery" style="text-decoration: none; color: inherit; display: block; background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid #ebdcd3; box-shadow: 0 8px 24px rgba(40, 20, 15, 0.05); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 16px 35px rgba(215,42,42,0.14)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 24px rgba(40, 20, 15, 0.05)';">
            <div style="position: relative; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; background: #eee;">
              <img
                src="<%= photo.imageUrl %>"
                alt="<%= photo.name %>"
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
                onmouseover="this.style.transform='scale(1.07)'"
                onmouseout="this.style.transform='scale(1)'"
                onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=800&q=80'"
              />
              <span style="position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.92); color: #a91c1c; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                📍 <%= photo.district %>
              </span>
              <span style="position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,0.65); color: #fff; font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 20px;">
                📅 <%= photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('hi-IN') : '') %>
              </span>
            </div>
            <div style="padding: 16px 18px;">
              <strong style="display: block; font-size: 16px; color: #2c1e1e; font-weight: 800; margin-bottom: 4px;"><%= photo.name %></strong>
              <p style="font-size: 12px; color: #806e67; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= photo.caption || 'अखंड निषाद संकल्प अभियान के प्रति समर्पित भाव से लिया गया पावन संकल्प।' %>
              </p>
            </div>
          </a>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>
