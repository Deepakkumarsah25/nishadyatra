<!-- ==========================================================================
     HERO SECTION - Full Display / Edge-to-Edge Carousel (Dynamic)
     ========================================================================== -->
<section class="hero-wrapper" id="home">
  
  <!-- Full Screen Slider Area -->
  <div class="hero-full-slider" aria-label="Main Slider">
    
    <!-- Previous / Next Controls -->
    <button type="button" class="hero-nav-arrow prev" id="heroPrevBtn" aria-label="Previous Slide">
      <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </button>
    <button type="button" class="hero-nav-arrow next" id="heroNextBtn" aria-label="Next Slide">
      <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </button>

    <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length > 0) { %>
      <% heroSlides.forEach(function(slide, idx) { %>
        <div class="hero-slide <%= idx === 0 ? 'active' : '' %>">
          <img
            src="<%= slide.imageUrl %>"
            alt="<%= slide.tag %>"
            class="hero-slide-bg"
            loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
          />
          <div class="hero-slide-overlay"></div>
          
          <div class="ny-container" style="height: 100%;">
            <div class="hero-slide-content">
              <% if (slide.tag || slide.badgeText) { %>
                <div class="hero-pill">
                  <% if (slide.tag) { %>
                    <span class="hero-pill-badge"><%= slide.tag %></span>
                  <% } %>
                  <% if (slide.badgeText) { %>
                    <span class="hero-pill-text"><%= slide.badgeText %></span>
                  <% } %>
                </div>
              <% } %>

              <h1 class="hero-heading">
                <%= slide.headingPrefix %>
                <% if (slide.highlightText) { %>
                  <span class="text-highlight"><%= slide.highlightText %></span>
                <% } %>
                <%= slide.headingSuffix %>
              </h1>

              <p class="hero-description">
                <%= slide.description %>
              </p>

              <div class="hero-actions">
                <% if (slide.primaryBtnText) { %>
                  <a
                    href="<%= slide.primaryBtnLink || '#quickActionSidebar' %>"
                    class="ny-btn ny-btn-primary"
                    <%= slide.primaryBtnInitiative ? 'data-initiative="' + slide.primaryBtnInitiative + '"' : (slide.primaryBtnLink === '#quickActionSidebar' ? 'id="openSidebarCta"' : '') %>
                  >
                    <span><%= slide.primaryBtnText %></span>
                    <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                  </a>
                <% } %>

                <% if (slide.secondaryBtnText) { %>
                  <a
                    href="<%= slide.secondaryBtnLink || '#what-we-do' %>"
                    class="ny-btn ny-btn-outline"
                    <%= slide.secondaryBtnInitiative ? 'data-initiative="' + slide.secondaryBtnInitiative + '"' : '' %>
                  >
                    <span><%= slide.secondaryBtnText %></span>
                    <svg viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>

    <!-- Indicators -->
    <div class="hero-slider-dots">
      <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length > 0) { %>
        <% heroSlides.forEach(function(slide, idx) { %>
          <button class="hero-dot <%= idx === 0 ? 'active' : '' %>" data-slide-index="<%= idx %>" aria-label="Slide <%= idx + 1 %>"></button>
        <% }); %>
      <% } else { %>
        <button class="hero-dot active" data-slide-index="0" aria-label="Slide 1"></button>
      <% } %>
    </div>

  </div>

</section>
