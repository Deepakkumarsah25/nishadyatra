<!-- ==========================================================================
     HERO SECTION - Full Display / Edge-to-Edge Carousel (Dynamic)
     ========================================================================== -->
<section class="hero-wrapper" id="home">
  
  <!-- Full Screen Slider Area -->
  <div class="hero-full-slider" aria-label="Main Slider">
    
    <!-- Previous / Next Controls -->
    <button type="button" class="hero-nav-arrow prev" id="heroPrevBtn" aria-label="Previous Slide">
      <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </button>
    <button type="button" class="hero-nav-arrow next" id="heroNextBtn" aria-label="Next Slide">
      <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </button>

    <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length > 0) { %>
      <% heroSlides.forEach(function(slide, idx) { %>
        <div class="hero-slide <%= idx === 0 ? 'active' : '' %>">
          <img
            src="<%= slide.imageUrl %>"
            alt="<%= slide.tag || slide.headingPrefix || 'Nishad Sankalp Campaign' %>"
            class="hero-slide-bg"
            loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
          />
        </div>
      <% }); %>
    <% } %>

    <!-- Indicators -->
    <div class="hero-slider-dots">
      <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length > 0) { %>
        <% heroSlides.forEach(function(slide, idx) { %>
          <button class="hero-dot <%= idx === 0 ? 'active' : '' %>" data-slide-index="<%= idx %>" aria-label="Slide <%= idx + 1 %>"></button>
        <% }); %>
      <% } else { %>
        <button class="hero-dot active" data-slide-index="0" aria-label="Slide 1"></button>
      <% } %>
    </div>

  </div>

</section>
