<!-- ==========================================================================
     WHAT WE DO SECTION - Our Key Initiatives & Pledges (Dynamic)
     ========================================================================== -->
<section class="initiatives-section" id="what-we-do">
  <div class="ny-container">
    
    <!-- Section Header -->
    <div class="section-header">
      <div class="section-tag">
        <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        <span>Focus Areas & Priorities</span>
      </div>
      <h2 class="section-title">
        Key Initiatives for <span class="text-highlight">Holistic Development</span>
      </h2>
      <p class="section-subtitle">
        We don't just discuss policies; we work on the ground to lay a strong foundation of education, self-reliance, and dignity.
      </p>
    </div>

    <!-- Initiatives Grid -->
    <div class="initiatives-grid">
      <% if (typeof initiatives !== 'undefined' && initiatives && initiatives.length > 0) { %>
        <% initiatives.forEach(function(item) { %>
          <article class="initiative-card">
            <div class="initiative-icon-box">
              <svg viewBox="0 0 24 24">
                <% if (item.iconKey === 'scale') { %>
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15v-4H8l5-7v4h3l-5 7z"/>
                <% } else if (item.iconKey === 'school') { %>
                  <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/>
                <% } else if (item.iconKey === 'trending') { %>
                  <path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/>
                <% } else if (item.iconKey === 'water') { %>
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                <% } else if (item.iconKey === 'hospital') { %>
                  <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
                <% } else { %>
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                <% } %>
              </svg>
            </div>
            
            <span class="initiative-card-tag"><%= item.cardTag %></span>
            <h3 class="initiative-card-title"><%= item.title %></h3>
            <p class="initiative-card-desc">
              <%= item.description %>
            </p>

            <% if (item.points && item.points.length > 0) { %>
              <ul class="initiative-points">
                <% item.points.forEach(function(pt) { %>
                  <li class="initiative-point-item"><span class="initiative-point-bullet">•</span> <%= pt %></li>
                <% }); %>
              </ul>
            <% } %>

            <a href="#initiativeAction" class="initiative-link" data-initiative="<%= item.key %>" role="button" aria-haspopup="dialog">
              <span><%= item.btnText || 'Support or Join' %></span>
              <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
            </a>
          </article>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>
