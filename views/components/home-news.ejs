<%
  const newsItems = (typeof homeNewsList !== 'undefined' && Array.isArray(homeNewsList)) ? homeNewsList.slice(0, 10) : [];

  function formatNewsDate(d) {
    if (!d) return "";
    const dateObj = new Date(d);
    return Number.isNaN(dateObj.getTime()) ? "" : dateObj.toLocaleDateString("hi-IN", { day: "numeric", month: "short", year: "numeric" });
  }

  function getFallbackImg(index) {
    const fallbacks = [
      "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=800&q=80",
      "https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=800&q=80",
      "https://images.unsplash.com/photo-1514222134-b57cbb8ce073?auto=format&fit=crop&w=800&q=80",
      "https://images.unsplash.com/photo-1532375810709-75b1da00537c?auto=format&fit=crop&w=800&q=80"
    ];
    return fallbacks[index % fallbacks.length];
  }
%>

<section class="home-news-section home-media-section" id="news-section">
  <div class="home-news-container">
    <header class="home-media-header">
      <div>
        <span class="home-media-eyebrow">Updates & coverage</span>
        <h2 class="section-title">Latest <span class="text-highlight">News</span></h2>
      </div>
    </header>

    <% if (newsItems.length) { %>
      <div class="home-media-rail home-news-rail" aria-label="Latest campaign news">
        <% newsItems.forEach(function(item, idx) { %>
          <article class="home-news-card">
            <a href="/news/<%= item._id %>" class="home-news-card-link" title="<%= item.title %>">
              <div class="home-news-thumb">
                <img src="<%= item.thumbnailPath || getFallbackImg(idx) %>" alt="<%= item.title %>" loading="lazy"
                  onerror="this.onerror=null; this.src='<%= getFallbackImg(idx) %>'" />
                <% if (item.category) { %><span><%= item.category %></span><% } %>
              </div>
              <div class="home-media-card-copy">
                <div class="home-media-card-meta"><% if (item.source) { %><%= item.source %><% } %><% if (formatNewsDate(item.publicationDate || item.publishedAt || item.createdAt)) { %> · <%= formatNewsDate(item.publicationDate || item.publishedAt || item.createdAt) %><% } %></div>
                <h3><%= item.title %></h3>
                <% if (item.summary) { %><p><%= item.summary %></p><% } %>
                <span class="home-news-read-more">Read story →</span>
              </div>
            </a>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <p class="home-media-empty">Campaign news will appear here soon.</p>
    <% } %>

    <div class="home-media-cta">
      <a href="/news" class="ny-btn ny-btn-primary">View More News <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
