<% const aboutData = (typeof homeAbout !== 'undefined' && homeAbout) ? homeAbout : {}; %>
<% if (aboutData.isActive !== false) { %>
<!-- ==========================================================================
     HOME ABOUT SECTION - Equal 50/50 Columns: Left Image Slider, Right Image 2 Style Card
     ========================================================================== -->
<section class="home-about-section" id="home-about" aria-label="About Movement Highlight">
  <div class="home-about-bg-accent" aria-hidden="true"></div>

  <div class="ny-container">
    <div class="home-about-grid">
      
      <!-- LEFT COLUMN: Image Slider (Height & Width exactly match right card) -->
      <div class="home-about-visual-col">
        <% 
          const sliderImages = (aboutData.images && aboutData.images.length > 0) 
            ? aboutData.images 
            : [aboutData.imageUrl || '/images/about/nishad-sankalp-rally.jpg'];
        %>
        <div class="home-about-image-card">
          <div class="image-inner-wrapper home-about-slider" id="homeAboutSlider">
            <div class="home-about-slider-track" id="homeAboutTrack">
              <% sliderImages.forEach(function(imgUrl, idx) { %>
                <div class="home-about-slide <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>">
                  <img 
                    src="<%= imgUrl %>" 
                    alt="Nishad Sankalp Campaign Highlight Photo <%= idx + 1 %>" 
                    class="home-about-img"
                    loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
                    onerror="this.src='/images/about/nishad-sankalp-rally.jpg'"
                  />
                </div>
              <% }); %>
            </div>
            
            <div class="image-gradient-shade" aria-hidden="true"></div>

            <!-- Slide Indicators / Dots (Bottom Center) -->
            <% if (sliderImages.length > 1) { %>
              <div class="home-about-slider-dots" id="homeAboutDots">
                <% sliderImages.forEach(function(_, idx) { %>
                  <button type="button" class="home-about-dot <%= idx === 0 ? 'active' : '' %>" data-slide="<%= idx %>" aria-label="Slide <%= idx + 1 %>"></button>
                <% }); %>
              </div>
            <% } %>

            <!-- Top Corner Floating Badge -->
            <% if (aboutData.floatingBadgeText) { %>
              <div class="floating-top-badge">
                <span class="badge-flame-icon">🔥</span>
                <span><%= aboutData.floatingBadgeText %></span>
              </div>
            <% } %>

            <!-- Corner Large Stat Box Overlay -->
            <% if (aboutData.imageBadgeNumber) { %>
              <div class="floating-stat-box">
                <span class="stat-box-digit"><%= aboutData.imageBadgeNumber %></span>
                <span class="stat-box-text"><%= aboutData.imageBadgeLabel || 'उप-जातियां एकजुट' %></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Card exactly styled like User's Provided Image 2 -->
      <div class="home-about-content">
        <div class="home-about-card">
          
          <!-- Top Content Area -->
          <div class="home-about-card-top">
            <!-- Red Quote Marks Icon (Matching Image 2) -->
            <div class="home-about-quote-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="34" height="34" fill="#b91c1c">
                <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/>
              </svg>
            </div>

            <!-- Motivational Bold Heading (Matching Image 2) -->
            <h3 class="home-about-card-heading">
              <%= (aboutData.quoteText && aboutData.quoteText.trim()) ? aboutData.quoteText : 'जब समाज का एक-एक हाथ साथ जुड़ता है, तो इतिहास की दिशा बदल जाती है। निषाद संकल्प अभियान आपकी आवाज है।' %>
            </h3>

            <!-- Checklist with Green Checkmarks (Matching Image 2) -->
            <ul class="home-about-checklist">
              <% 
                const pointsList = (aboutData.points && aboutData.points.length > 0) ? aboutData.points : [
                  { title: 'निःशुल्क सदस्यता एवं पारदर्शी भागीदारी' },
                  { title: 'गांव व ब्लॉक स्तर पर प्रत्यक्ष संवाद बैठकें' },
                  { title: 'छात्रों और युवाओं के लिए व्यक्तिगत मार्गदर्शन' },
                  { title: 'आपदा व संकट में तत्काल स्वयंसेवक दल सेवा' }
                ];
              %>
              <% pointsList.forEach(function(pt) { %>
                <li class="checklist-item">
                  <span class="checklist-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="#16a34a" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                  <span class="checklist-text"><%= pt.title %></span>
                </li>
              <% }); %>
            </ul>
          </div>

          <!-- Bottom Action: Red Pill Button (Matching Image 2) leading to /about -->
          <div class="home-about-card-bottom">
            <a href="<%= aboutData.readMoreLink || '/about' %>" class="home-about-pill-btn" id="homeAboutReadMoreBtn" title="विस्तार से जानें">
              <span><%= aboutData.readMoreText || 'और जानें (Read More)' %></span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
<% } %>
