<%
  const vList = (typeof latestVideos !== 'undefined' && Array.isArray(latestVideos)) ? latestVideos.slice(0, 10) : [];

  function toEmbedUrl(url) {
    if (!url) return "";
    try {
      const parsed = new URL(url, "https://local.invalid");
      if (/(^|\.)vimeo\.com$/i.test(parsed.hostname)) {
        const match = parsed.pathname.match(/\/(?:video\/)?(\d+)(?:\/|$)/);
        if (match) {
          const embed = new URL("https://player.vimeo.com/video/" + match[1]);
          const hash = parsed.searchParams.get("h") || parsed.pathname.match(/\/(?:video\/)?\d+\/([\da-f]+)/i)?.[1];
          if (hash) embed.searchParams.set("h", hash);
          return embed.toString();
        }
      }
    } catch (_) {}
    if (url.includes("embed/")) return url;
    const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
    return match && match[1] ? "https://www.youtube-nocookie.com/embed/" + match[1] : url;
  }

  function getThumb(url, explicitThumb) {
    const t = String(explicitThumb || '').trim();
    const u = String(url || '').trim();
    const isVideoWebpage = /^(https?:\/\/)?(www\.)?(youtube\.com|youtu\.be|vimeo\.com|player\.vimeo\.com)\//i.test(t);
    if (t && !isVideoWebpage && (/\.(jpe?g|png|webp|gif|avif)($|\?)/i.test(t) || t.includes('/uploads/') || t.includes('cloudinary.com') || t.includes('unsplash.com') || t.includes('vumbnail.com') || t.includes('ytimg.com'))) {
      return t;
    }
    const ytMatch = (u || t).match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/))([\w-]{11})/i);
    if (ytMatch && ytMatch[1]) return 'https://img.youtube.com/vi/' + ytMatch[1] + '/hqdefault.jpg';
    const vimeoMatch = (u || t).match(/(?:player\.)?vimeo\.com\/(?:video\/)?(\d+)/i);
    if (vimeoMatch && vimeoMatch[1]) return 'https://vumbnail.com/' + vimeoMatch[1] + '.jpg';
    return '/images/kalash-yatra-featured.jpg';
  }

%>

<section class="video-showcase-section home-media-section" id="videos">
  <div class="ny-container">
    <header class="home-media-header">
      <div>
        <span class="home-media-eyebrow">Campaign videos</span>
        <h2 class="section-title">Latest <span class="text-highlight">Videos</span></h2>
      </div>
    </header>

    <% if (vList.length) { %>
      <div class="home-media-rail" aria-label="Latest campaign videos">
        <% vList.forEach(function(vid) { %>
          <article class="home-video-card latest-video-item js-open-video"
            data-video-url="<%= toEmbedUrl(vid.videoUrl) %>"
            data-video-title="<%= vid.title %>"
            tabindex="0" role="button" aria-label="Play <%= vid.title %>">
            <div class="home-media-thumb latest-thumb-wrap">
              <img src="<%= getThumb(vid.videoUrl, vid.thumbnail || vid.image) %>" alt="<%= vid.title %>" loading="lazy"
                onerror="if(!this.dataset.fallback){ this.dataset.fallback='1'; this.src='/images/kalash-yatra-featured.jpg'; }" />
              <span class="latest-thumb-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
            </div>
            <div class="home-media-card-copy">
              <span class="home-media-card-meta"><%= vid.tag || vid.category || 'Campaign' %><% if (vid.district || vid.stateName) { %> · <%= vid.district || vid.stateName %><% } %></span>
              <h3><%= vid.title %></h3>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <p class="home-media-empty">Campaign videos will appear here soon.</p>
    <% } %>

    <div class="home-media-cta">
      <a href="/video" class="ny-btn ny-btn-primary">View More Videos <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<div class="home-video-modal-backdrop" id="homeVideoModal" aria-hidden="true">
  <div class="home-video-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="homeVideoModalTitle">
    <div class="home-video-modal-head">
      <h4 id="homeVideoModalTitle">Campaign video</h4>
      <div class="modal-head-actions">
        <a href="/video" class="modal-redirect-link">Open video page ↗</a>
        <button type="button" class="home-video-modal-close" id="homeVideoModalClose" aria-label="Close video">×</button>
      </div>
    </div>
    <div class="home-video-modal-body">
      <div class="home-video-iframe-wrap"><iframe id="homeVideoIframe" src="" title="Video player" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById("homeVideoModal");
    const iframe = document.getElementById("homeVideoIframe");
    const titleEl = document.getElementById("homeVideoModalTitle");
    const closeBtn = document.getElementById("homeVideoModalClose");

    function openModal(url, title) {
      if (!modal || !iframe || !url) return;
      iframe.src = url + (url.includes("?") ? "&" : "?") + "autoplay=1";
      if (titleEl) titleEl.textContent = title || "Campaign video";
      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal || !iframe) return;
      iframe.src = "";
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    document.querySelectorAll(".js-open-video").forEach(function (card) {
      card.addEventListener("click", function () {
        openModal(card.dataset.videoUrl, card.dataset.videoTitle);
      });
      card.addEventListener("keydown", function (event) {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openModal(card.dataset.videoUrl, card.dataset.videoTitle);
        }
      });
    });
    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (modal) modal.addEventListener("click", function (event) { if (event.target === modal) closeModal(); });
    document.addEventListener("keydown", function (event) { if (event.key === "Escape") closeModal(); });
  })();

  // 1-Second Auto-Scroll for Video Showcase Rail
  (function () {
    const rail = document.querySelector(".video-showcase-section .home-media-rail");
    if (!rail) return;
    const cards = rail.querySelectorAll(".home-video-card");
    if (cards.length <= 1) return;

    let timer = null;
    let paused = false;
    let inView = false;

    function getStep() {
      if (cards.length > 1) {
        const distance = cards[1].offsetLeft - cards[0].offsetLeft;
        if (distance > 0) return distance;
      }
      return cards[0].getBoundingClientRect().width + 16;
    }

    function stop() {
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    function advance() {
      if (paused || !inView || rail.scrollWidth <= rail.clientWidth + 2) return;
      const maxScroll = rail.scrollWidth - rail.clientWidth;
      const step = getStep();
      const nextLeft = rail.scrollLeft + step;
      rail.scrollTo({
        left: nextLeft >= maxScroll - 5 ? 0 : nextLeft,
        behavior: "smooth"
      });
    }

    function start() {
      stop();
      if (!paused && inView && !document.hidden) {
        timer = window.setInterval(advance, 1000); // 1-second auto-scroll
      }
    }

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          inView = entry.isIntersecting;
          if (inView) start();
          else stop();
        });
      }, { threshold: 0.15 });
      observer.observe(rail);
    } else {
      inView = true;
      start();
    }

    rail.addEventListener("mouseenter", () => { paused = true; stop(); });
    rail.addEventListener("mouseleave", () => { paused = false; start(); });
    rail.addEventListener("touchstart", () => { paused = true; stop(); }, { passive: true });
    rail.addEventListener("touchend", () => {
      window.setTimeout(() => { paused = false; start(); }, 1500);
    }, { passive: true });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else if (inView && !paused) start();
    });
  })();
</script>
