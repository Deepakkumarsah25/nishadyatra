<!-- ==========================================================================
     WHY CHOOSE US SECTION - Why Choose Us / Trust & Dedication (Dynamic)
     ========================================================================== -->
<section class="why-choose-section" id="about">
  <span id="why-choose" style="position: absolute; top: -80px;"></span>
  <div class="ny-container">
    
    <!-- Section Header -->
    <div class="section-header">
      <div class="section-tag">
        <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span><%= typeof whyChoose !== 'undefined' && whyChoose.sectionTag ? whyChoose.sectionTag : 'Transparency & Commitment' %></span>
      </div>
      <h2 class="section-title">
        <%= typeof whyChoose !== 'undefined' && whyChoose.sectionTitle ? whyChoose.sectionTitle : 'Nishad Sankalp Campaign' %>
        <% if (typeof whyChoose !== 'undefined' && whyChoose.highlightText) { %>
          <span class="text-highlight"><%= whyChoose.highlightText %></span>
        <% } %>
      </h2>
      <p class="section-subtitle">
        <%= typeof whyChoose !== 'undefined' && whyChoose.sectionSubtitle ? whyChoose.sectionSubtitle : 'Our mission is not political gain, but delivering education, dignity, legal security, and economic progress to the grassroots.' %>
      </p>
    </div>

    <!-- Layout Grid -->
    <div class="why-choose-layout">
      
      <!-- Left: Trust Pillars -->
      <div class="why-choose-intro">
        <h3 class="why-choose-heading">
          <%= typeof whyChoose !== 'undefined' && whyChoose.introHeading ? whyChoose.introHeading : 'Built on Ground Reality and Unwavering Dedication' %>
        </h3>
        <p class="why-choose-desc">
          <%= typeof whyChoose !== 'undefined' && whyChoose.introDesc ? whyChoose.introDesc : 'Through years of dedication and continuous service, we have earned the steadfast trust of our community. Standing by you at every step is our foremost duty.' %>
        </p>

        <div class="trust-pillars">
          <% if (typeof whyChoose !== 'undefined' && whyChoose.pillars && whyChoose.pillars.length > 0) { %>
            <% whyChoose.pillars.forEach(function(pillar) { %>
              <div class="trust-pillar-item">
                <div class="trust-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <% if (pillar.iconKey === 'users') { %>
                      <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    <% } else if (pillar.iconKey === 'check') { %>
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    <% } else if (pillar.iconKey === 'award') { %>
                      <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    <% } else { %>
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <% } %>
                  </svg>
                </div>
                <div>
                  <h4 class="trust-pillar-title"><%= pillar.title %></h4>
                  <p class="trust-pillar-text"><%= pillar.description %></p>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Right: Pledge Showcase Card -->
      <div class="why-choose-showcase">
        <div class="pledge-callout-card">
          <div class="pledge-quote-mark">“</div>
          <p class="pledge-quote-text">
            <%= typeof whyChoose !== 'undefined' && whyChoose.quoteText ? whyChoose.quoteText : 'When every hand in the community unites, the course of history changes. Nishad Sankalp Campaign is your voice.' %>
          </p>

          <% if (typeof whyChoose !== 'undefined' && whyChoose.pledgePoints && whyChoose.pledgePoints.length > 0) { %>
            <ul class="pledge-points-list">
              <% whyChoose.pledgePoints.forEach(function(pt) { %>
                <li class="pledge-point-check">
                  <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  <span><%= pt %></span>
                </li>
              <% }); %>
            </ul>
          <% } %>

          <a href="<%= typeof whyChoose !== 'undefined' && whyChoose.pledgeBtnLink ? whyChoose.pledgeBtnLink : '#quickActionSidebar' %>" class="ny-btn ny-btn-primary pledge-card-action" id="openSidebarPledge">
            <span><%= typeof whyChoose !== 'undefined' && whyChoose.pledgeBtnText ? whyChoose.pledgeBtnText : 'Take the Pledge Today' %></span>
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
