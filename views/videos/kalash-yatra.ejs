<!DOCTYPE html>
<html lang="hi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>कलश यात्रा वीडियो | निषाद संकल्प अभियान</title>
  <meta name="description" content="निषाद संकल्प अभियान की पावन कलश यात्रा के वीडियो, कार्यक्रम, ऐतिहासिक क्षण और राज्यवार विशेष झलकियां।" />

  <!-- Google Fonts: Rozha One, Noto Serif Devanagari, Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Noto+Serif+Devanagari:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Rozha+One&display=swap" rel="stylesheet" />

  <!-- Common Navbar CSS -->
  <link rel="stylesheet" href="/css/common/navbar.css" />

  <style>
    /* =====================================================
       DESIGN TOKENS & SYSTEM
    ===================================================== */
    :root {
      /* Royal Crimson & Devotional Palette */
      --primary-crimson: #b91c1c;
      --crimson-dark: #991b1b;
      --crimson-deep: #7f1d1d;
      --crimson-ultra: #450a0a;
      --crimson-soft: rgba(185, 28, 28, 0.08);
      --crimson-glow: rgba(185, 28, 28, 0.22);

      /* Sacred Gold & Amber */
      --gold-primary: #d97706;
      --gold-dark: #b45309;
      --gold-light: #fbbf24;
      --gold-soft: #fef3c7;
      --gold-border: rgba(217, 119, 6, 0.25);

      /* Ivory & Canvas */
      --canvas: #fdfaf6;
      --canvas-alt: #f7f1e7;
      --surface-white: #ffffff;
      --surface-card: #ffffff;
      --border-warm: #ebdccf;
      --border-light: #f5ebe1;
      --border-focus: #b91c1c;

      /* Text Hierarchy */
      --text-main: #2b1818;
      --text-body: #5a4545;
      --text-muted: #846f6f;
      --text-light: #ab9898;

      /* Accents */
      --emerald: #15803d;
      --emerald-bg: #ecfdf5;

      /* Elevations */
      --shadow-sm: 0 4px 15px rgba(69, 10, 10, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(69, 10, 10, 0.08), 0 8px 10px -6px rgba(69, 10, 10, 0.04);
      --shadow-lg: 0 20px 45px -10px rgba(69, 10, 10, 0.12), 0 12px 20px -8px rgba(69, 10, 10, 0.06);
      --shadow-xl: 0 30px 70px -15px rgba(69, 10, 10, 0.20);
      --shadow-crimson: 0 12px 30px rgba(185, 28, 28, 0.28);
      --shadow-gold: 0 10px 25px rgba(217, 119, 6, 0.25);

      /* Radii */
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 28px;
      --radius-full: 9999px;

      --navbar-height: 64px;
    }

    /* Reset & Base */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: clip;
    }

    body {
      font-family: "Noto Sans Devanagari", "Plus Jakarta Sans", sans-serif;
      background-color: var(--canvas);
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(217, 119, 6, 0.035) 0%, transparent 40%),
        radial-gradient(circle at 90% 60%, rgba(185, 28, 28, 0.035) 0%, transparent 45%);
      background-attachment: fixed;
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: clip;
    }

    body.modal-open {
      overflow: hidden !important;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select {
      font-family: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
    }

    /* Container Standard */
    .container {
      width: min(1220px, 92%);
      margin: 0 auto;
    }

    /* =====================================================
       PAGE HEADER / HERO SECTION
    ===================================================== */
    .kalash-page {
      padding-top: var(--navbar-height);
    }

    .hero-wrapper {
      position: relative;
      overflow: hidden;
      background: linear-gradient(175deg, #fffdfa 0%, #fbf5ee 50%, #f4e7da 100%);
      border-bottom: 1px solid var(--border-warm);
      padding: 60px 0 80px;
    }

    /* Decorative background motifs */
    .hero-wrapper::before {
      content: "";
      position: absolute;
      top: -150px;
      right: -150px;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(217, 119, 6, 0.12) 0%, rgba(217, 119, 6, 0) 70%);
      pointer-events: none;
      z-index: 1;
    }

    .hero-wrapper::after {
      content: "";
      position: absolute;
      bottom: -120px;
      left: 10%;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(185, 28, 28, 0.08) 0%, rgba(185, 28, 28, 0) 70%);
      pointer-events: none;
      z-index: 1;
    }

    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 60px;
    }

    /* Left Content */
    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--gold-border);
      box-shadow: 0 4px 15px rgba(217, 119, 6, 0.12);
      font-size: 13px;
      font-weight: 700;
      color: var(--crimson-deep);
      margin-bottom: 24px;
      backdrop-filter: blur(10px);
    }

    .live-dot-pulse {
      position: relative;
      width: 10px;
      height: 10px;
      background: var(--primary-crimson);
      border-radius: 50%;
    }

    .live-dot-pulse::after {
      content: "";
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid var(--primary-crimson);
      animation: pulsePing 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes pulsePing {
      0% {
        transform: scale(0.9);
        opacity: 1;
      }
      80%, 100% {
        transform: scale(2.2);
        opacity: 0;
      }
    }

    .live-badge-divider {
      color: var(--gold-primary);
      opacity: 0.6;
    }

    .live-badge-sub {
      color: var(--gold-dark);
      font-weight: 600;
      font-size: 12px;
      letter-spacing: 0.3px;
    }

    .hero-heading {
      font-family: "Noto Serif Devanagari", "Rozha One", serif;
      font-size: clamp(38px, 4.8vw, 62px);
      line-height: 1.15;
      font-weight: 900;
      color: var(--crimson-ultra);
      letter-spacing: -0.8px;
      margin-bottom: 22px;
    }

    .hero-heading span.highlight {
      background: linear-gradient(135deg, #b91c1c 0%, #dc2626 50%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
      position: relative;
    }

    .hero-subheading {
      font-size: 17px;
      line-height: 1.8;
      color: var(--text-body);
      max-width: 580px;
      margin-bottom: 34px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-bottom: 40px;
    }

    .btn-primary-glow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 28px;
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      color: #ffffff;
      font-size: 15px;
      font-weight: 700;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-crimson);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .btn-primary-glow::after {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transform: skewX(-20deg);
      transition: left 0.6s ease;
    }

    .btn-primary-glow:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(185, 28, 28, 0.38);
      background: linear-gradient(135deg, #c72424 0%, #881515 100%);
    }

    .btn-primary-glow:hover::after {
      left: 140%;
    }

    .btn-secondary-glass {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 26px;
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid var(--border-warm);
      color: var(--crimson-ultra);
      font-size: 15px;
      font-weight: 700;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(10px);
      transition: all 0.25s ease;
    }

    .btn-secondary-glass:hover {
      background: #ffffff;
      border-color: var(--primary-crimson);
      color: var(--primary-crimson);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    /* Stats Strip */
    .hero-stats-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      width: 100%;
      max-width: 580px;
      padding-top: 24px;
      border-top: 1px solid rgba(217, 119, 6, 0.2);
    }

    .hero-stat-item {
      display: flex;
      flex-direction: column;
    }

    .hero-stat-number {
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 24px;
      font-weight: 800;
      color: var(--crimson-deep);
      line-height: 1.1;
    }

    .hero-stat-label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 600;
      margin-top: 4px;
    }

    /* Left 50% Sacred Highlights Pills */
    .hero-highlights-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 30px;
    }

    .hero-highlight-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 15px;
      border-radius: var(--radius-full);
      background: #ffffff;
      border: 1px solid var(--border-warm);
      box-shadow: 0 2px 8px rgba(69, 10, 10, 0.04);
      font-size: 13px;
      font-weight: 700;
      color: var(--crimson-deep);
      transition: all 0.25s ease;
    }

    .hero-highlight-pill:hover {
      border-color: var(--gold-primary);
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(217, 119, 6, 0.15);
    }

    .highlight-icon {
      font-size: 15px;
      line-height: 1;
    }

    /* =====================================================
       RIGHT 50%: CREATIVE IMAGE MONTAGE & SCENE SWITCHER
    ===================================================== */
    .hero-media-wrapper {
      position: relative;
    }

    .hero-gallery-montage {
      position: relative;
      padding-bottom: 6px;
    }

    /* Aura glow behind the montage */
    .hero-gallery-montage::before {
      content: "";
      position: absolute;
      top: 10%;
      left: 15%;
      width: 70%;
      height: 70%;
      background: radial-gradient(circle, rgba(217, 119, 6, 0.18) 0%, rgba(185, 28, 28, 0.1) 50%, transparent 70%);
      filter: blur(40px);
      z-index: 0;
      pointer-events: none;
    }

    /* Main Big Image Stage */
    .hero-main-stage {
      position: relative;
      z-index: 2;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: #1a0808;
      border: 5px solid #ffffff;
      box-shadow: 0 25px 60px -10px rgba(69, 10, 10, 0.22), 0 12px 25px rgba(0, 0, 0, 0.12);
      aspect-ratio: 16 / 11;
      transition: transform 0.4s ease;
    }

    .hero-main-stage:hover {
      transform: scale(1.015);
    }

    .hero-main-stage img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: opacity 0.35s ease, transform 0.6s ease;
    }

    .hero-main-stage:hover img {
      transform: scale(1.04);
    }

    .hero-stage-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, transparent 40%, rgba(20, 5, 5, 0.88) 100%);
      pointer-events: none;
    }

    .hero-stage-badge {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 3;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.95);
      color: var(--crimson-deep);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      backdrop-filter: blur(8px);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .hero-stage-badge svg {
      width: 13px;
      height: 13px;
      fill: var(--gold-primary);
    }

    .hero-stage-caption {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 18px;
      z-index: 3;
      color: #ffffff;
    }

    .hero-stage-caption h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 20px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 3px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    }

    .hero-stage-caption p {
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    }

    /* Floating Overlapping Mini Photo Cards */
    .hero-float-card {
      position: absolute;
      z-index: 4;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 3.5px solid #ffffff;
      box-shadow: 0 16px 35px rgba(0, 0, 0, 0.25);
      background: #150505;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    .hero-float-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }

    .hero-float-card:hover {
      transform: translateY(-6px) scale(1.06);
      box-shadow: 0 20px 45px rgba(185, 28, 28, 0.35);
      border-color: var(--gold-light);
    }

    .hero-float-card:hover img {
      transform: scale(1.1);
    }

    .hero-float-tag {
      position: absolute;
      bottom: 8px;
      left: 8px;
      right: 8px;
      padding: 4px 8px;
      border-radius: 6px;
      background: rgba(15, 4, 4, 0.88);
      backdrop-filter: blur(6px);
      color: #ffffff;
      font-size: 10.5px;
      font-weight: 700;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* Floating Card 1: Top Right */
    .hero-float-card.card-top-right {
      top: -22px;
      right: -22px;
      width: 148px;
      height: 108px;
    }

    /* Floating Card 2: Bottom Left */
    .hero-float-card.card-bottom-left {
      bottom: 40px;
      left: -24px;
      width: 142px;
      height: 104px;
    }

    /* Bottom Interactive Thumbnail Selector Strip */
    .hero-thumb-nav {
      position: relative;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .hero-thumb-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.9);
      border: 1.5px solid var(--border-warm);
      box-shadow: 0 3px 10px rgba(69, 10, 10, 0.05);
      color: var(--crimson-deep);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
      backdrop-filter: blur(8px);
    }

    .hero-thumb-btn img {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
      border: 1.5px solid var(--gold-primary);
    }

    .hero-thumb-btn:hover {
      background: #ffffff;
      border-color: var(--primary-crimson);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(185, 28, 28, 0.18);
    }

    .hero-thumb-btn.active {
      background: linear-gradient(135deg, var(--primary-crimson), var(--crimson-dark));
      border-color: var(--gold-light);
      color: #ffffff;
      box-shadow: 0 6px 20px rgba(185, 28, 28, 0.35);
    }

    .hero-thumb-btn.active img {
      border-color: #ffffff;
    }

    /* =====================================================
       YATRA VISUAL STORYCASE: IMAGES & TEXT SHOWCASE
    ===================================================== */
    .yatra-storycase-section {
      position: relative;
      background: linear-gradient(180deg, var(--canvas) 0%, #fbf5ee 50%, var(--canvas) 100%);
      padding: 40px 0 10px; /* Zero empty space at bottom */
      margin: 0;
    }

    .yatra-storycase-header {
      text-align: center;
      max-width: 900px;
      margin: 0 auto 32px;
      padding: 0 20px;
    }

    .storycase-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      background: var(--gold-soft);
      border: 1px solid var(--gold-border);
      border-radius: 999px;
      color: var(--gold-dark);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    .storycase-kicker-sep {
      color: var(--primary-crimson);
      font-weight: 900;
    }

    .storycase-kicker-sub {
      color: var(--primary-crimson);
      font-weight: 800;
    }

    .storycase-title {
      font-family: "Noto Serif Devanagari", "Rozha One", serif;
      font-size: clamp(26px, 3.2vw, 38px);
      font-weight: 900;
      color: var(--text-main);
      line-height: 1.25;
      margin-bottom: 12px;
    }

    .storycase-title span.highlight {
      color: var(--primary-crimson);
      position: relative;
      display: inline-block;
    }

    .storycase-sub {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.7;
      max-width: 820px;
      margin: 0 auto;
    }

    /* Container */
    .storycase-container {
      width: min(1280px, 94%);
      margin: 0 auto;
    }

    /* =====================================================
       FEATURED HERO STORY CARD (50/50 SPLIT)
    ===================================================== */
    .storycase-featured-card {
      background: #ffffff;
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-xl);
      box-shadow: 0 16px 40px rgba(69, 10, 10, 0.08);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      margin-bottom: 24px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .storycase-featured-card:hover {
      box-shadow: 0 22px 50px rgba(69, 10, 10, 0.14);
      border-color: var(--gold-light);
    }

    .storycase-featured-media {
      position: relative;
      min-height: 380px;
      background: #000000;
      overflow: hidden;
    }

    .storycase-featured-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .storycase-featured-card:hover .storycase-featured-img {
      transform: scale(1.04);
    }

    .storycase-featured-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.05) 50%, rgba(18,5,5,0.7) 100%);
      pointer-events: none;
    }

    .storycase-featured-badge {
      position: absolute;
      top: 18px;
      left: 18px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: rgba(185, 28, 28, 0.92);
      backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow: 0 4px 15px rgba(185, 28, 28, 0.4);
    }

    .storycase-featured-caption {
      position: absolute;
      bottom: 18px;
      left: 18px;
      right: 18px;
      color: #ffffff;
    }

    .storycase-featured-caption h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.3;
      margin-bottom: 4px;
      text-shadow: 0 2px 6px rgba(0,0,0,0.8);
    }

    .storycase-featured-caption p {
      font-size: 13px;
      color: #fce7cf;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Right Content Area */
    .storycase-featured-content {
      padding: 34px 30px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: linear-gradient(165deg, #ffffff 0%, #fffdfa 100%);
    }

    .storycase-meta-tag-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .storycase-tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
      background: var(--canvas-alt);
      color: var(--text-muted);
      border: 1px solid var(--border-light);
    }

    .storycase-tag-pill.crimson {
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      border-color: var(--crimson-glow);
    }

    .storycase-tag-pill.gold {
      background: var(--gold-soft);
      color: var(--gold-dark);
      border-color: var(--gold-border);
    }

    .storycase-featured-content h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 23px;
      font-weight: 900;
      color: var(--text-main);
      line-height: 1.35;
      margin-bottom: 12px;
    }

    .storycase-featured-content p {
      font-size: 14px;
      line-height: 1.75;
      color: var(--text-body);
      margin-bottom: 16px;
    }

    .storycase-pills-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 12px 14px;
      background: rgba(253, 250, 246, 0.9);
      border: 1px solid var(--border-warm);
      border-radius: var(--radius-md);
      margin-bottom: 18px;
    }

    .storycase-pill-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-main);
    }

    .storycase-pill-item .emoji {
      font-size: 14px;
      flex-shrink: 0;
    }

    .storycase-actions-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      padding-top: 14px;
      border-top: 1px dashed var(--border-warm);
    }

    .btn-storycase-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      color: #ffffff;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 700;
      box-shadow: 0 4px 14px rgba(185, 28, 28, 0.35);
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-storycase-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(185, 28, 28, 0.5);
    }

    .btn-storycase-outline {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--canvas-alt);
      border: 1.5px solid var(--border-warm);
      color: var(--text-main);
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 700;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-storycase-outline:hover {
      border-color: var(--gold-primary);
      color: var(--gold-dark);
      background: #ffffff;
    }

    /* =====================================================
       4-CARD SHOWCASE GRID
    ===================================================== */
    .storycase-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    .storycase-card {
      background: #ffffff;
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-lg);
      box-shadow: 0 8px 24px rgba(69, 10, 10, 0.05);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .storycase-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 36px rgba(69, 10, 10, 0.12);
      border-color: var(--gold-primary);
    }

    .storycase-card-thumb {
      position: relative;
      width: 100%;
      height: 190px;
      overflow: hidden;
      background: #180505;
    }

    .storycase-card-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }

    .storycase-card:hover .storycase-card-thumb img {
      transform: scale(1.08);
    }

    .storycase-card-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      background: rgba(18, 5, 5, 0.85);
      backdrop-filter: blur(6px);
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.18);
    }

    .storycase-card-body {
      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex-grow: 1;
      background: #ffffff;
    }

    .storycase-card-body h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 16.5px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.35;
      margin-bottom: 8px;
      transition: color 0.2s ease;
    }

    .storycase-card:hover .storycase-card-body h4 {
      color: var(--primary-crimson);
    }

    .storycase-card-body p {
      font-size: 13px;
      line-height: 1.65;
      color: var(--text-body);
      margin-bottom: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .storycase-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 10px;
      border-top: 1px solid var(--border-light);
    }

    .storycase-location-text {
      font-size: 11.5px;
      color: var(--text-muted);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .btn-card-filter-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      font-weight: 800;
      color: var(--primary-crimson);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-card-filter-link:hover {
      color: var(--crimson-dark);
      transform: translateX(3px);
    }

    /* =====================================================
       ZERO-GAP TRANSITION BAR
    ===================================================== */
    .storycase-transition-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 22px;
      background: linear-gradient(135deg, rgba(217, 119, 6, 0.08) 0%, rgba(185, 28, 28, 0.08) 100%);
      border: 1px solid var(--gold-border);
      border-radius: var(--radius-lg);
      margin-top: 6px;
      margin-bottom: 0;
    }

    .transition-text-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .transition-icon-circle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--primary-crimson);
      color: #ffffff;
      font-size: 15px;
      box-shadow: 0 4px 10px rgba(185, 28, 28, 0.3);
    }

    .transition-text-group h5 {
      font-size: 14px;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 2px;
    }

    .transition-text-group p {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .btn-jump-filter {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 16px;
      background: #ffffff;
      border: 1.5px solid var(--gold-primary);
      border-radius: var(--radius-sm);
      color: var(--gold-dark);
      font-size: 12.5px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .btn-jump-filter:hover {
      background: var(--gold-primary);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
    }

    /* Filter Console Section adjustments for seamless zero-gap connection */
    .filter-console-section {
      padding-top: 15px !important;
      margin-top: 0 !important;
    }

    /* =====================================================
       RESPONSIVE BREAKPOINTS
    ===================================================== */
    @media (max-width: 1100px) {
      .storycase-grid-4 {
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
      }
    }

    @media (max-width: 900px) {
      .storycase-featured-card {
        grid-template-columns: 1fr;
      }

      .storycase-featured-media {
        min-height: 280px;
      }

      .storycase-featured-content {
        padding: 24px 20px;
      }
    }

    @media (max-width: 600px) {
      .yatra-storycase-section {
        padding: 25px 0 10px;
      }

      .storycase-grid-4 {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .storycase-transition-bar {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
        padding: 14px;
      }

      .transition-text-group {
        flex-direction: column;
      }

      .btn-jump-filter {
        justify-content: center;
      }
    }

    /* =====================================================
       MOBILE FLOATING FILTER TAB & DRAWER
    ===================================================== */
    .mobile-filter-floating-tab {
      display: none;
      position: fixed;
      right: 0;
      top: 48%;
      transform: translateY(-50%);
      z-index: 2500;
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      color: #ffffff;
      border: 2px solid #ffffff;
      border-right: none;
      border-radius: 14px 0 0 14px;
      padding: 12px 9px;
      box-shadow: -4px 6px 20px rgba(185, 28, 28, 0.45);
      cursor: pointer;
      align-items: center;
      gap: 6px;
      writing-mode: vertical-rl;
      text-orientation: mixed;
      transition: all 0.25s ease;
    }

    .mobile-filter-floating-tab:hover, .mobile-filter-floating-tab:active {
      padding-right: 13px;
      background: var(--primary-crimson);
      box-shadow: -6px 8px 25px rgba(185, 28, 28, 0.6);
    }

    .tab-lines-icon {
      display: flex;
      flex-direction: column;
      gap: 3px;
      writing-mode: horizontal-tb;
    }

    .tab-lines-icon span {
      display: block;
      width: 14px;
      height: 2.2px;
      background: #ffffff;
      border-radius: 2px;
    }

    .tab-label-text {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .mobile-filter-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--gold-light);
      color: var(--crimson-ultra);
      font-size: 10px;
      font-weight: 900;
      writing-mode: horizontal-tb;
    }

    .mobile-filter-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 5, 5, 0.65);
      backdrop-filter: blur(8px);
      z-index: 2990;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-filter-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .drawer-mobile-close {
      display: none;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 700;
      cursor: pointer;
      border: none;
    }

    .drawer-apply-footer {
      display: none;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--border-light);
    }

    .btn-apply-drawer {
      width: 100%;
      height: 48px;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--primary-crimson), var(--crimson-dark));
      color: #ffffff;
      font-size: 15px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: var(--shadow-crimson);
      border: none;
      cursor: pointer;
    }

    .mobile-filter-inline-btn {
      display: none;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: var(--radius-full);
      background: var(--crimson-soft);
      border: 1px solid rgba(185, 28, 28, 0.2);
      color: var(--primary-crimson);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    /* =====================================================
       FILTER CONSOLE (SEARCH & CATEGORIES)
    ===================================================== */
    .filter-console-section {
      padding: 40px 0 20px;
    }

    .filter-card {
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid var(--border-warm);
      border-radius: var(--radius-xl);
      padding: 30px;
      box-shadow: var(--shadow-md);
      backdrop-filter: blur(15px);
    }

    .filter-header-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--border-light);
    }

    .filter-title-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .filter-icon-box {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .filter-icon-box svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    .filter-heading-text h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 20px;
      font-weight: 800;
      color: var(--crimson-ultra);
      line-height: 1.2;
    }

    .filter-heading-text p {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .filter-top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .count-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      border-radius: var(--radius-full);
      background: var(--canvas-alt);
      border: 1px solid var(--border-warm);
      font-size: 13px;
      font-weight: 700;
      color: var(--crimson-deep);
    }

    .count-indicator strong {
      color: var(--primary-crimson);
      font-size: 15px;
    }

    .btn-reset-filters {
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 700;
      color: var(--primary-crimson);
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-reset-filters:hover {
      background: var(--crimson-soft);
      text-decoration: underline;
    }

    /* Filter Form Grid */
    .filter-input-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1.35fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .form-group-custom {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group-custom label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .form-group-custom label svg {
      width: 14px;
      height: 14px;
      fill: var(--primary-crimson);
    }

    /* Select Box Wrapper */
    .custom-select-wrapper, .custom-input-wrapper {
      position: relative;
    }

    .styled-select, .styled-input {
      width: 100%;
      height: 48px;
      border-radius: var(--radius-md);
      border: 1.5px solid var(--border-warm);
      background: #ffffff;
      color: var(--text-main);
      font-size: 14px;
      font-weight: 500;
      padding: 0 16px;
      outline: none;
      transition: all 0.2s ease;
    }

    .styled-select {
      appearance: none;
      padding-right: 40px;
      cursor: pointer;
    }

    .styled-select:focus, .styled-input:focus {
      border-color: var(--primary-crimson);
      box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.12);
    }

    .styled-select:disabled {
      background: #f5ede6;
      color: #a49187;
      cursor: not-allowed;
      border-color: #eeddd2;
    }

    /* Dropdown Chevron SVG */
    .select-arrow {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      color: var(--text-muted);
      display: flex;
      align-items: center;
    }

    .select-arrow svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    /* Search input icon */
    .search-icon-inside {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
      display: flex;
      align-items: center;
    }

    .search-icon-inside svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .styled-input.with-icon {
      padding-left: 42px;
      padding-right: 36px;
    }

    .search-clear-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--canvas-alt);
      color: var(--text-muted);
      display: none;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      cursor: pointer;
    }

    .search-clear-btn.visible {
      display: flex;
    }

    /* Category Buttons Strip */
    .category-nav-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding-top: 18px;
      border-top: 1px dashed var(--border-warm);
    }

    .category-nav-label {
      font-size: 12px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-right: 6px;
    }

    .pill-category-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      border-radius: var(--radius-full);
      background: #ffffff;
      border: 1.5px solid var(--border-warm);
      color: var(--text-body);
      font-size: 13px;
      font-weight: 700;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pill-category-btn svg {
      width: 15px;
      height: 15px;
      fill: currentColor;
    }

    .pill-category-btn:hover {
      border-color: var(--primary-crimson);
      color: var(--primary-crimson);
      transform: translateY(-1px);
    }

    .pill-category-btn.active {
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      border-color: var(--primary-crimson);
      color: #ffffff;
      box-shadow: 0 4px 15px rgba(185, 28, 28, 0.25);
    }

    .category-badge-count {
      padding: 2px 7px;
      border-radius: var(--radius-full);
      background: rgba(0, 0, 0, 0.08);
      font-size: 11px;
      font-weight: 800;
    }

    .pill-category-btn.active .category-badge-count {
      background: rgba(255, 255, 255, 0.25);
      color: #ffffff;
    }

    /* Active Filter Chips Container */
    .active-chips-tray {
      display: none;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--border-light);
    }

    .active-chips-tray.show {
      display: flex;
    }

    .active-chip-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px;
      border-radius: var(--radius-full);
      background: var(--crimson-soft);
      border: 1px solid rgba(185, 28, 28, 0.15);
      color: var(--crimson-deep);
      font-size: 12px;
      font-weight: 700;
      animation: chipPop 0.2s ease;
    }

    @keyframes chipPop {
      0% {
        transform: scale(0.9);
        opacity: 0;
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    .active-chip-remove {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(185, 28, 28, 0.12);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .active-chip-remove:hover {
      background: var(--primary-crimson);
      color: #ffffff;
    }

    /* =====================================================
       VIDEO GALLERY SECTION & VIEW FORMATS
    ===================================================== */
    .gallery-section {
      padding: 40px 0 80px;
    }

    .gallery-header-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .gallery-section-title {
      font-family: "Noto Serif Devanagari", serif;
      font-size: clamp(26px, 3.2vw, 36px);
      font-weight: 900;
      color: var(--crimson-ultra);
      line-height: 1.2;
    }

    .gallery-section-subtitle {
      font-size: 15px;
      color: var(--text-body);
      margin-top: 6px;
    }

    /* Grid / List Format Switcher */
    .gallery-view-controls {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .view-mode-toggle {
      display: inline-flex;
      align-items: center;
      background: #ffffff;
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-full);
      padding: 4px;
      box-shadow: var(--shadow-sm);
    }

    .btn-view-toggle {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 18px;
      border-radius: var(--radius-full);
      font-size: 13px;
      font-weight: 700;
      color: var(--text-body);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-view-toggle svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    .btn-view-toggle:hover {
      color: var(--primary-crimson);
    }

    .btn-view-toggle.active {
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(185, 28, 28, 0.35);
    }

    /* Quick District Filter Bar */
    .quick-district-filter-section {
      background: rgba(255, 255, 255, 0.92);
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-lg);
      padding: 18px 22px;
      margin-bottom: 30px;
      box-shadow: 0 4px 18px rgba(69, 10, 10, 0.04);
      backdrop-filter: blur(10px);
    }

    .quick-district-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .quick-district-title {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 800;
      color: var(--crimson-ultra);
    }

    .quick-district-title svg {
      fill: var(--primary-crimson);
    }

    .quick-district-hint {
      font-size: 12px;
      color: var(--text-muted);
    }

    .quick-district-pills {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      overflow-x: auto;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }

    .district-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 15px;
      border-radius: var(--radius-full);
      background: var(--canvas-alt);
      border: 1.5px solid var(--border-warm);
      color: var(--text-main);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      white-space: nowrap;
    }

    .district-pill:hover {
      border-color: var(--gold-primary);
      color: var(--crimson-deep);
      background: #ffffff;
      transform: translateY(-2px);
    }

    .district-pill.active {
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      border-color: var(--primary-crimson);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(185, 28, 28, 0.3);
    }

    .district-pill .pill-count {
      padding: 1px 7px;
      border-radius: 10px;
      background: rgba(0, 0, 0, 0.08);
      font-size: 11px;
    }

    .district-pill.active .pill-count {
      background: rgba(255, 255, 255, 0.25);
      color: #ffffff;
    }

    /* =====================================================
       VIDEO CARDS CONTAINER (GRID & LIST FORMATS)
    ===================================================== */
    /* 1. GRID FORMAT (Default) */
    .video-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      transition: opacity 0.25s ease;
    }

    .video-cards-grid.view-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .video-cards-grid.view-grid .video-card-item {
      display: flex;
      flex-direction: column;
    }

    .video-cards-grid.view-grid .card-media-box {
      width: 100%;
      height: 220px;
    }

    /* 2. LIST FORMAT */
    .video-cards-grid.view-list {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .video-cards-grid.view-list .video-card-item {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      min-height: 230px;
      border-radius: var(--radius-xl);
    }

    .video-cards-grid.view-list .card-media-box {
      width: 350px;
      min-width: 320px;
      max-width: 380px;
      height: auto;
      flex-shrink: 0;
    }

    .video-cards-grid.view-list .card-info-box {
      flex: 1;
      padding: 24px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .video-cards-grid.view-list .card-title-text {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .video-cards-grid.view-list .card-description-text {
      -webkit-line-clamp: 3;
      margin-bottom: 14px;
    }

    /* Common Video Card Base */
    .video-card-item {
      background: var(--surface-card);
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .video-card-item:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: rgba(185, 28, 28, 0.35);
    }

    .video-card-item.hidden {
      display: none !important;
    }

    /* Card Thumbnail Box */
    .card-media-box {
      position: relative;
      overflow: hidden;
      background: #231212;
    }

    .card-media-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .video-card-item:hover .card-media-box img {
      transform: scale(1.07);
    }

    .card-gradient-vignette {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, transparent 40%, rgba(0, 0, 0, 0.75) 100%);
      pointer-events: none;
    }

    /* Center Play Ripple on Hover */
    .card-play-symbol {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 3;
    }

    .card-play-symbol svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
      margin-left: 3px;
    }

    .video-card-item:hover .card-play-symbol {
      transform: translate(-50%, -50%) scale(1.15);
      background: var(--primary-crimson);
      color: #ffffff;
      box-shadow: 0 10px 30px rgba(185, 28, 28, 0.5);
    }

    /* Badges on Thumbnail */
    .badge-location-corner {
      position: absolute;
      bottom: 12px;
      left: 12px;
      z-index: 3;
      padding: 4px 10px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.95);
      color: var(--crimson-ultra);
      font-size: 11px;
      font-weight: 800;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(6px);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .badge-location-corner svg {
      width: 12px;
      height: 12px;
      fill: var(--primary-crimson);
    }

    .badge-duration-corner {
      position: absolute;
      bottom: 12px;
      right: 12px;
      z-index: 3;
      padding: 4px 8px;
      border-radius: var(--radius-sm);
      background: rgba(15, 6, 6, 0.88);
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      backdrop-filter: blur(6px);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .badge-duration-corner svg {
      width: 11px;
      height: 11px;
      fill: var(--gold-light);
    }

    /* Card Text Content */
    .card-info-box {
      padding: 22px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .card-tags-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 10px;
    }

    .card-category-tag {
      color: var(--primary-crimson);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      background: var(--crimson-soft);
      padding: 3px 10px;
      border-radius: var(--radius-full);
      border: 1px solid rgba(185, 28, 28, 0.15);
    }

    .card-district-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      background: var(--gold-soft);
      border: 1px solid var(--gold-border);
      color: var(--crimson-ultra);
      font-size: 11.5px;
      font-weight: 700;
    }

    .card-district-pill svg {
      width: 12px;
      height: 12px;
      fill: var(--primary-crimson);
    }

    .card-title-text {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 18px;
      font-weight: 800;
      color: var(--crimson-ultra);
      line-height: 1.38;
      margin-bottom: 10px;
      transition: color 0.2s ease;
    }

    .video-card-item:hover .card-title-text {
      color: var(--primary-crimson);
    }

    /* Person / Place Row (व्यक्ति / स्थान का नाम) */
    .card-meta-line {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      margin-bottom: 10px;
      color: var(--text-body);
    }

    .card-person-line {
      background: var(--canvas-alt);
      border: 1px solid var(--border-light);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      margin-bottom: 12px;
    }

    .card-person-line .meta-icon {
      display: inline-flex;
      align-items: center;
      color: var(--primary-crimson);
      flex-shrink: 0;
    }

    .card-person-line .meta-icon svg {
      width: 15px;
      height: 15px;
      fill: currentColor;
    }

    .card-person-line .meta-label {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      white-space: nowrap;
    }

    .card-person-line .meta-val {
      font-size: 13px;
      font-weight: 800;
      color: var(--crimson-deep);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .card-description-text {
      font-size: 13px;
      line-height: 1.65;
      color: var(--text-body);
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      flex: 1;
    }

    .card-footer-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      border-top: 1px solid var(--border-light);
      font-size: 12px;
      color: var(--text-muted);
    }

    .card-footer-date {
      display: flex;
      align-items: center;
      gap: 5px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .card-footer-date svg {
      width: 13px;
      height: 13px;
      fill: currentColor;
    }

    .btn-card-play {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      background: var(--crimson-soft);
      border: 1px solid rgba(185, 28, 28, 0.2);
      color: var(--primary-crimson);
      font-size: 12.5px;
      font-weight: 800;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-card-play:hover, .video-card-item:hover .btn-card-play {
      background: var(--primary-crimson);
      color: #ffffff;
      border-color: var(--primary-crimson);
      box-shadow: 0 4px 12px rgba(185, 28, 28, 0.3);
    }

    /* =====================================================
       EMPTY STATE
    ===================================================== */
    .empty-state-card {
      display: none;
      grid-column: 1 / -1;
      background: rgba(255, 255, 255, 0.85);
      border: 2px dashed var(--border-warm);
      border-radius: var(--radius-xl);
      padding: 60px 30px;
      text-align: center;
      backdrop-filter: blur(10px);
    }

    .empty-state-card.show {
      display: block;
    }

    .empty-symbol-icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }

    .empty-symbol-icon svg {
      width: 32px;
      height: 32px;
      fill: currentColor;
    }

    .empty-state-card h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 22px;
      font-weight: 800;
      color: var(--crimson-ultra);
      margin-bottom: 8px;
    }

    .empty-state-card p {
      font-size: 14px;
      color: var(--text-body);
      max-width: 480px;
      margin: 0 auto 22px;
    }

    .btn-empty-clear {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: var(--primary-crimson);
      color: #ffffff;
      font-size: 14px;
      font-weight: 700;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-crimson);
      transition: all 0.2s ease;
    }

    .btn-empty-clear:hover {
      background: var(--crimson-dark);
      transform: translateY(-2px);
    }

    /* =====================================================
       CREATIVE SECTION: PILLARS & VISUAL STORY SHOWCASE
    ===================================================== */
    .pillars-showcase-section {
      margin-top: 60px;
      padding: 40px 0 20px;
      position: relative;
    }

    .pillars-header-block {
      text-align: center;
      max-width: 820px;
      margin: 0 auto 46px;
    }

    .pillars-kicker-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 18px;
      border-radius: var(--radius-full);
      background: var(--gold-soft);
      border: 1px solid var(--gold-border);
      color: var(--crimson-deep);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.5px;
      margin-bottom: 16px;
    }

    .pillars-kicker-tag svg {
      width: 14px;
      height: 14px;
      fill: var(--gold-dark);
    }

    .pillars-main-title {
      font-family: "Noto Serif Devanagari", "Rozha One", serif;
      font-size: clamp(28px, 3.8vw, 44px);
      line-height: 1.25;
      font-weight: 900;
      color: var(--crimson-ultra);
      letter-spacing: -0.5px;
      margin-bottom: 14px;
    }

    .pillars-main-title span.accent {
      background: linear-gradient(135deg, #b91c1c 0%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .pillars-subtitle {
      font-size: 15px;
      line-height: 1.8;
      color: var(--text-body);
    }

    /* Master 2-Column Grid */
    .pillars-content-grid {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 34px;
      align-items: stretch;
      margin-bottom: 0;
    }

    /* Left Column: Visual Story Collage */
    .visual-story-column {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .story-card-primary {
      position: relative;
      border-radius: var(--radius-xl);
      overflow: hidden;
      aspect-ratio: 16 / 10.5;
      background: var(--crimson-ultra);
      border: 4px solid #ffffff;
      box-shadow: var(--shadow-lg);
      cursor: pointer;
    }

    .story-card-primary img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .story-card-primary:hover img {
      transform: scale(1.06);
    }

    .story-overlay-grad {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, transparent 40%, rgba(20, 5, 5, 0.88) 100%);
      pointer-events: none;
    }

    .story-floating-badge {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 3;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.95);
      color: var(--crimson-deep);
      font-size: 11px;
      font-weight: 800;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      backdrop-filter: blur(8px);
    }

    .story-floating-badge svg {
      width: 13px;
      height: 13px;
      fill: var(--gold-primary);
    }

    .story-caption-block {
      position: absolute;
      left: 22px;
      right: 22px;
      bottom: 20px;
      z-index: 3;
      color: #ffffff;
    }

    .story-caption-block h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 21px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 4px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    }

    .story-caption-block p {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.5;
    }

    /* Dual Secondary Cards */
    .story-cards-dual {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .story-card-sub {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      aspect-ratio: 4 / 3.1;
      background: #1f0b0b;
      border: 3px solid #ffffff;
      box-shadow: var(--shadow-md);
      cursor: pointer;
    }

    .story-card-sub img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .story-card-sub:hover img {
      transform: scale(1.08);
    }

    .story-card-sub .story-overlay-grad {
      background: linear-gradient(180deg, transparent 35%, rgba(20, 5, 5, 0.9) 100%);
    }

    .story-sub-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 3;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.95);
      color: var(--crimson-deep);
      font-size: 10px;
      font-weight: 800;
    }

    .story-sub-caption {
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 14px;
      z-index: 3;
      color: #ffffff;
    }

    .story-sub-caption h5 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 2px;
    }

    .story-sub-caption p {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.85);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Right Column: 4 Sacred Pillars Cards */
    .pillars-list-column {
      display: flex;
      flex-direction: column;
      gap: 14px;
      justify-content: space-between;
    }

    .pillar-interactive-card {
      background: rgba(255, 255, 255, 0.94);
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-lg);
      padding: 20px 22px;
      box-shadow: var(--shadow-sm);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .pillar-interactive-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--gold-primary), var(--primary-crimson));
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .pillar-interactive-card:hover {
      transform: translateX(6px);
      border-color: var(--gold-primary);
      background: #ffffff;
      box-shadow: var(--shadow-md);
    }

    .pillar-interactive-card:hover::before {
      opacity: 1;
    }

    .pillar-card-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }

    .pillar-num-badge {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
      color: #ffffff;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 13px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
    }

    .pillar-icon-symbol {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .pillar-icon-symbol svg {
      width: 19px;
      height: 19px;
      fill: currentColor;
    }

    .pillar-card-head h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 17px;
      font-weight: 800;
      color: var(--crimson-ultra);
      line-height: 1.25;
    }

    .pillar-card-body p {
      font-size: 13px;
      line-height: 1.7;
      color: var(--text-body);
      padding-left: 48px;
    }



    /* =====================================================
       VIDEO MODAL POPUP
    ===================================================== */
    .video-modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: rgba(15, 5, 5, 0.92);
      backdrop-filter: blur(12px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .video-modal-backdrop.active {
      display: flex;
      opacity: 1;
    }

    .modal-content-shell {
      position: relative;
      width: min(1040px, 98%);
      background: #150909;
      border: 1px solid rgba(217, 119, 6, 0.3);
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: 0 35px 90px rgba(0, 0, 0, 0.7);
      transform: scale(0.92);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .video-modal-backdrop.active .modal-content-shell {
      transform: scale(1);
    }

    .modal-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px;
      background: #200e0e;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      color: #ffffff;
    }

    .modal-title-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      overflow: hidden;
    }

    .modal-title-wrap h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 17px;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 600px;
    }

    .modal-actions-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .modal-share-btn {
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 0.2s ease;
    }

    .modal-share-btn:hover {
      background: var(--primary-crimson);
    }

    .modal-close-cross {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      transition: all 0.2s ease;
    }

    .modal-close-cross:hover {
      background: var(--primary-crimson);
      transform: rotate(90deg);
    }

    .modal-video-frame-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000000;
    }

    .modal-video-frame-wrap iframe,
    .modal-video-frame-wrap video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    /* Modal Info Strip below player */
    .modal-meta-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 24px;
      background: #180909;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      color: #e5d8d8;
      font-size: 13px;
      flex-wrap: wrap;
    }

    .modal-meta-col {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .modal-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .modal-meta-item .m-icon {
      font-size: 15px;
    }

    .modal-meta-item .m-label {
      color: #ab9898;
      font-size: 12px;
      font-weight: 600;
    }

    .modal-meta-item .m-val {
      color: #ffffff;
      font-weight: 700;
    }

    /* Toast Notification for Link Copied */
    .toast-notification {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 100000;
      background: var(--crimson-ultra);
      color: #ffffff;
      border: 1px solid var(--gold-light);
      padding: 12px 20px;
      border-radius: var(--radius-md);
      font-size: 14px;
      font-weight: 700;
      box-shadow: var(--shadow-xl);
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .toast-notification.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* =====================================================
       RESPONSIVE BREAKPOINTS
    ===================================================== */
    @media (max-width: 1060px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 45px;
      }

      .hero-content {
        align-items: center;
        text-align: center;
      }

      .hero-subheading {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-highlights-list {
        justify-content: center;
      }

      .hero-actions {
        justify-content: center;
      }

      .hero-stats-strip {
        margin: 0 auto;
      }

      .hero-media-wrapper {
        max-width: 620px;
        margin: 0 auto;
        width: 100%;
      }

      .hero-float-card.card-top-right {
        top: -16px;
        right: -10px;
        width: 132px;
        height: 98px;
      }

      .hero-float-card.card-bottom-left {
        bottom: 38px;
        left: -10px;
        width: 128px;
        height: 94px;
      }

      .filter-input-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      /* Keep 2-column pinned stage down to 920px */
      .scrolly-yatra-grid {
        gap: 24px;
      }

      .video-cards-grid,
      .video-cards-grid.view-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
      }

      .video-cards-grid.view-list .card-media-box {
        width: 300px;
        min-width: 270px;
      }
    }

    @media (max-width: 860px) {
      .video-cards-grid.view-list .video-card-item {
        flex-direction: column;
      }

      .video-cards-grid.view-list .card-media-box {
        width: 100%;
        max-width: 100%;
        height: 220px;
      }

      .quick-district-header {
        flex-direction: column;
        align-items: flex-start;
      }

      /* Mobile Floating Filter Tab on Right Screen Edge */
      .mobile-filter-floating-tab {
        display: flex;
      }

      .mobile-filter-backdrop {
        display: block;
      }

      .drawer-mobile-close {
        display: flex;
      }

      .drawer-apply-footer {
        display: block;
      }

      /* Slide-out Filter Console Drawer */
      .filter-console-section {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(390px, 92vw);
        height: 100dvh;
        z-index: 3000;
        padding: 0;
        transform: translate3d(105%, 0, 0);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }

      .filter-console-section.drawer-open {
        transform: translate3d(0, 0, 0);
        pointer-events: auto;
      }

      .filter-console-section .container {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        max-width: 100%;
      }

      .filter-card {
        height: 100%;
        border-radius: 24px 0 0 24px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        padding: 24px 20px 40px;
        box-shadow: -15px 0 50px rgba(0, 0, 0, 0.45);
        border: 2px solid var(--gold-border);
        border-right: none;
      }

      .scrolly-pips-nav {
        justify-content: flex-start;
      }

      .thumb-label-mini {
        font-size: 9px;
      }

      /* Mobile UI: Images on TOP, Right side Text boxes BELOW */
      .pillars-content-grid {
        grid-template-columns: 1fr !important;
        gap: 28px;
      }

      .visual-story-column {
        order: 1 !important;
        width: 100%;
      }

      .pillars-list-column {
        order: 2 !important;
        width: 100%;
        gap: 14px;
      }
    }

    @media (max-width: 768px) {
      .hero-wrapper {
        padding: 40px 0 60px;
      }

      .hero-heading {
        font-size: 34px;
      }

      .hero-stats-strip {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }

      .hero-float-card.card-top-right,
      .hero-float-card.card-bottom-left {
        display: none;
      }

      .hero-thumb-nav {
        gap: 8px;
      }

      .hero-thumb-btn {
        padding: 5px 12px;
        font-size: 11px;
      }

      .filter-card {
        padding: 20px;
      }

      .filter-header-bar {
        flex-direction: column;
        align-items: flex-start;
      }

      .filter-top-actions {
        width: 100%;
        justify-content: space-between;
      }

      .filter-input-grid {
        grid-template-columns: 1fr;
      }

      .category-nav-bar {
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 8px;
        -webkit-overflow-scrolling: touch;
      }

      .pill-category-btn {
        flex-shrink: 0;
      }

      .video-cards-grid,
      .video-cards-grid.view-grid {
        grid-template-columns: 1fr;
      }

      .pillars-showcase-section {
        margin-top: 40px;
        padding: 30px 0 10px;
      }

      .pillars-header-block {
        margin-bottom: 28px;
      }

      .pillars-main-title {
        font-size: 26px;
      }

      .story-card-primary {
        aspect-ratio: 16 / 10;
        border-width: 3px;
        border-radius: 18px;
      }

      .story-caption-block {
        left: 16px;
        right: 16px;
        bottom: 16px;
      }

      .story-caption-block h4 {
        font-size: 18px;
      }

      .story-caption-block p {
        font-size: 12.5px;
      }

      .pillar-interactive-card {
        padding: 16px 18px;
      }

      .pillar-card-head h4 {
        font-size: 16px;
      }

      .pillar-card-body p {
        padding-left: 0;
        margin-top: 6px;
        font-size: 13px;
      }


    }

    @media (max-width: 480px) {
      .hero-heading {
        font-size: 29px;
      }

      .hero-actions {
        flex-direction: column;
        width: 100%;
      }

      .btn-primary-glow, .btn-secondary-glass {
        width: 100%;
      }

      .hero-stage-caption h3 {
        font-size: 17px;
      }

      .hero-stage-caption p {
        font-size: 11.5px;
      }

      .hero-thumb-btn {
        padding: 4px 10px;
        font-size: 10px;
      }

      .hero-thumb-btn img {
        width: 20px;
        height: 20px;
      }

      .scrolly-center-play-btn {
        width: 58px;
        height: 58px;
      }

      .scrolly-center-play-btn svg {
        width: 22px;
        height: 22px;
      }

      .scrolly-sticky-footer {
        flex-direction: column;
        align-items: stretch;
      }

      .scrolly-pips-nav {
        gap: 6px;
      }

      .scrolly-pip-btn {
        padding: 5px 11px;
        font-size: 11px;
      }

      .pillars-showcase-section {
        margin-top: 30px;
        padding: 20px 0 10px;
      }

      .pillars-main-title {
        font-size: 22px;
      }

      .pillars-subtitle {
        font-size: 13px;
        line-height: 1.6;
      }

      .story-card-primary {
        aspect-ratio: 16 / 10.5;
        border-radius: 14px;
      }

      .story-floating-badge {
        top: 10px;
        left: 10px;
        padding: 4px 10px;
        font-size: 10.5px;
      }

      .story-caption-block {
        left: 12px;
        right: 12px;
        bottom: 12px;
      }

      .story-caption-block h4 {
        font-size: 16px;
      }

      .story-caption-block p {
        font-size: 11.5px;
        line-height: 1.4;
      }

      .story-cards-dual {
        gap: 10px;
      }

      .story-card-sub {
        border-radius: 12px;
        border-width: 2px;
        aspect-ratio: 4 / 3.2;
      }

      .story-sub-tag {
        top: 6px;
        left: 6px;
        padding: 2px 7px;
        font-size: 8.5px;
      }

      .story-sub-caption {
        left: 8px;
        right: 8px;
        bottom: 8px;
      }

      .story-sub-caption h5 {
        font-size: 12px;
      }

      .story-sub-caption p {
        font-size: 9.5px;
      }

      .pillar-interactive-card {
        padding: 14px;
        border-radius: 14px;
      }

      .pillar-num-badge {
        width: 30px;
        height: 30px;
        font-size: 11px;
      }

      .pillar-icon-symbol {
        width: 30px;
        height: 30px;
      }

      .pillar-card-head h4 {
        font-size: 14.5px;
      }

      .pillar-card-body p {
        font-size: 12px;
        line-height: 1.55;
      }
    }
  </style>
</head>

<body>

  <!-- =====================================================
       NAVBAR
  ===================================================== -->
  <%- include("../common/navbar.ejs") %>

  <!-- =====================================================
       MAIN PAGE
  ===================================================== -->
  <main class="kalash-page">

    <!-- ===================================================
         HERO SECTION: 50/50 CONTENT & CREATIVE IMAGE SHOWCASE
    ==================================================== -->
    <section class="hero-wrapper" id="hero">
      <div class="container hero-grid">

        <!-- Left 50%: Structured Content -->
        <div class="hero-content">
          <div class="live-badge">
            <span class="live-dot-pulse"></span>
            <span><%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.liveBadgeText) ? kalash.hero.liveBadgeText : 'निषाद संकल्प अभियान • कलश यात्रा विशेष दर्शन' %></span>
          </div>

          <h1 class="hero-heading">
            <%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.headingMain) ? kalash.hero.headingMain : 'आस्था, एकता और संकल्प का पावन महासंगम —' %> <span class="highlight"><%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.headingHighlight) ? kalash.hero.headingHighlight : 'कलश यात्रा' %></span>
          </h1>

          <p class="hero-subheading">
            <%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.subheading) ? kalash.hero.subheading : 'समाज को जोड़ने और सामूहिक शक्ति के जागरण हेतु आयोजित ऐतिहासिक कलश यात्राएं। मातृशक्ति का पावन संकल्प, स्वाभिमान की पुकार और सांस्कृतिक धरोहर के संरक्षण का ऐतिहासिक जनप्रवाह। अपने राज्य व जिले के अनुसार संग्रह देखें।' %>
          </p>

          <!-- Sacred Highlights Pills -->
          <div class="hero-highlights-list">
            <% const heroHighlights = (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.highlights && kalash.hero.highlights.length > 0) ? kalash.hero.highlights : ['पावन जल संकल्प', 'मातृशक्ति जनसैलाब', 'सामाजिक स्वाभिमान']; %>
            <% heroHighlights.forEach((hl, hIdx) => { %>
              <div class="hero-highlight-pill">
                <span class="highlight-icon"><%= hIdx === 0 ? '🪔' : (hIdx === 1 ? '🚩' : '🤝') %></span>
                <span><%= hl %></span>
              </div>
            <% }) %>
          </div>

          <div class="hero-actions">
            <a href="#videoGallery" class="btn-primary-glow">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z"/>
              </svg>
              <span>वीडियो संकलन देखें</span>
            </a>

            <a href="#filterConsole" class="btn-secondary-glass" id="heroFilterTrigger">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12 2.5a7.2 7.2 0 0 0-7.2 7.2c0 5.2 7.2 11.8 7.2 11.8s7.2-6.6 7.2-11.8A7.2 7.2 0 0 0 12 2.5zm0 9.9a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4z"/>
              </svg>
              <span>राज्य व जिला चुनें</span>
            </a>
          </div>

          <!-- Quick Stats Strip -->
          <div class="hero-stats-strip">
            <% const heroStats = (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.stats && kalash.hero.stats.length > 0) ? kalash.hero.stats : [
                 { number: '150+', label: 'जिले सम्मिलित' },
                 { number: '50,000+', label: 'मंगल कलश पूजन' },
                 { number: '10,000+', label: 'मातृशक्ति सहभागिता' },
                 { number: '28+', label: 'राज्यों में चेतना' }
               ]; %>
            <% heroStats.forEach((st) => { %>
              <div class="hero-stat-item">
                <span class="hero-stat-number"><%= st.number %></span>
                <span class="hero-stat-label"><%= st.label %></span>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Right 50%: Creative Image Montage & Scene Switcher -->
        <div class="hero-media-wrapper">
          <div class="hero-gallery-montage">

            <!-- Main Big Stage Image -->
            <div class="hero-main-stage" id="heroMainStage">
              <img
                src="/images/kalash-yatra-hero.jpg"
                alt="कलश यात्रा भव्य शोभायात्रा"
                id="heroMainStageImg"
                loading="eager"
              />
              <div class="hero-stage-overlay"></div>

              <div class="hero-stage-badge">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                <span id="heroStageBadgeText">विशेष महाझलक • 2026</span>
              </div>

              <div class="hero-stage-caption">
                <h3 id="heroStageTitle">मातृशक्ति का पावन कलश संकल्प</h3>
                <p id="heroStageDesc">गोपालगंज से लेकर काशी तक — सामाजिक एकता व स्वाभिमान का विराट प्रवाह</p>
              </div>
            </div>

            <!-- Overlapping Floating Card 1: Sacred Kalash Ritual -->
            <div
              class="hero-float-card card-top-right"
              data-img="/images/sacred-kalash-ritual.jpg"
              data-badge="पावन अनुष्ठान • 2026"
              data-title="पावन कलश एवं दीप पूजन"
              data-desc="वैदिक मंत्रोच्चार और समाज के कल्याण हेतु पावन कलश स्थापना"
              title="क्लिक करके मुख्य फोटो बनाएं"
            >
              <img src="/images/sacred-kalash-ritual.jpg" alt="पावन कलश एवं दीप पूजन" loading="lazy" />
              <span class="hero-float-tag">🪔 कलश पूजन</span>
            </div>

            <!-- Overlapping Floating Card 2: Ghat Procession -->
            <div
              class="hero-float-card card-bottom-left"
              data-img="/images/ghat-kalash-procession.jpg"
              data-badge="पवित्र संगम • 2026"
              data-title="पवित्र घाट पर जल संकल्प"
              data-desc="सूर्योदय की पावन वेला में श्रद्धालुओं का ऐतिहासिक जल संकल्प"
              title="क्लिक करके मुख्य फोटो बनाएं"
            >
              <img src="/images/ghat-kalash-procession.jpg" alt="पवित्र घाट पर जल संकल्प" loading="lazy" />
              <span class="hero-float-tag">🌊 घाट संकल्प</span>
            </div>

            <!-- Interactive Scene Switcher Strip -->
            <div class="hero-thumb-nav" id="heroThumbNav">
              <button
                type="button"
                class="hero-thumb-btn active"
                data-img="/images/kalash-yatra-hero.jpg"
                data-badge="विशेष महाझलक • 2026"
                data-title="मातृशक्ति का पावन कलश संकल्प"
                data-desc="गोपालगंज से लेकर काशी तक — सामाजिक एकता व स्वाभिमान का विराट प्रवाह"
              >
                <img src="/images/kalash-yatra-hero.jpg" alt="शोभायात्रा" />
                <span>🚩 शोभायात्रा</span>
              </button>

              <button
                type="button"
                class="hero-thumb-btn"
                data-img="/images/sacred-kalash-ritual.jpg"
                data-badge="पावन अनुष्ठान • 2026"
                data-title="पावन कलश एवं दीप पूजन"
                data-desc="वैदिक मंत्रोच्चार और समाज के कल्याण हेतु पावन कलश स्थापना"
              >
                <img src="/images/sacred-kalash-ritual.jpg" alt="कलश पूजन" />
                <span>🪔 कलश पूजन</span>
              </button>

              <button
                type="button"
                class="hero-thumb-btn"
                data-img="/images/ghat-kalash-procession.jpg"
                data-badge="पवित्र संगम • 2026"
                data-title="पवित्र घाट पर जल संकल्प"
                data-desc="सूर्योदय की पावन वेला में श्रद्धालुओं का ऐतिहासिक जल संकल्प"
              >
                <img src="/images/ghat-kalash-procession.jpg" alt="घाट संकल्प" />
                <span>🌊 घाट संकल्प</span>
              </button>

              <button
                type="button"
                class="hero-thumb-btn"
                data-img="/images/kalash-yatra-featured.jpg"
                data-badge="महाजनसैलाब • 2026"
                data-title="ऐतिहासिक कलश यात्रा जनसैलाब"
                data-desc="हजारों माताओं, बहनों और सामाजिक साथियों का विराट जनसैलाब"
              >
                <img src="/images/kalash-yatra-featured.jpg" alt="महाजनसैलाब" />
                <span>👥 जनसैलाब</span>
              </button>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ===================================================
         YATRA VISUAL STORYCASE: IMAGES & TEXT SHOWCASE
    ==================================================== -->
    <section class="yatra-storycase-section" id="featuredShowcase">

      <!-- Section Header -->
      <div class="yatra-storycase-header">
        <div class="storycase-kicker">
          <span>★</span>
          <span>पावन संस्मरण • निषाद संकल्प अभियान</span>
          <span class="storycase-kicker-sep">•</span>
          <span class="storycase-kicker-sub">ऐतिहासिक महासंगम</span>
        </div>

        <h2 class="storycase-title">
          कलश यात्रा महागाथा — <span class="highlight">आस्था, स्वाभिमान व सामाजिक संकल्प</span> के पावन आयाम
        </h2>

        <p class="storycase-sub">
          पवित्र गंगाजल, वैदिक मंत्रोच्चार और मातृशक्ति के अटूट संकल्प के साथ देश के विभिन्न अंचलों से गुजरी ऐतिहासिक कलश यात्रा की पावन झलकियां एवं समाज के सशक्तिकरण का जीवंत दर्शन।
        </p>
      </div>

      <div class="storycase-container">

        <% const featMilestone = (typeof kalash !== 'undefined' && kalash.milestonesSection && kalash.milestonesSection.items && kalash.milestonesSection.items.length > 0) ? kalash.milestonesSection.items[0] : null; %>
        <% if (featMilestone) { %>
        <!-- 1. Featured Big Story Card -->
        <article class="storycase-featured-card">
          <div class="storycase-featured-media">
            <img
              src="<%= featMilestone.image %>"
              alt="<%= featMilestone.title %>"
              class="storycase-featured-img"
              loading="lazy"
            />
            <div class="storycase-featured-overlay"></div>
            <div class="storycase-featured-badge">
              <span><%= featMilestone.tag || '★ मुख्य केंद्र • ऐतिहासिक शंखनाद' %></span>
            </div>
            <div class="storycase-featured-caption">
              <h4><%= featMilestone.title %></h4>
              <p>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                </svg>
                <span><%= featMilestone.district %>, <%= featMilestone.stateName %> • विराट जनप्रवाह</span>
              </p>
            </div>
          </div>

          <div class="storycase-featured-content">
            <div>
              <div class="storycase-meta-tag-row">
                <span class="storycase-tag-pill crimson"><%= featMilestone.stateName %> • <%= featMilestone.district %></span>
                <span class="storycase-tag-pill gold"><%= featMilestone.tag || 'विशेष संस्मरण' %></span>
              </div>

              <h3><%= featMilestone.title %></h3>

              <p><%= featMilestone.description %></p>
            </div>

            <div class="storycase-actions-row">
              <button type="button" class="btn-storycase-primary btn-jump-filter-state" data-state="<%= featMilestone.stateKey %>">
                <span><%= featMilestone.stateName %> के वीडियो देखें ↓</span>
              </button>
              <button type="button" class="btn-storycase-outline btn-watch-featured" data-video="<%= featMilestone.videoUrl %>" data-title="<%= featMilestone.title %>">
                <span>झलकियां देखें ▶</span>
              </button>
            </div>
          </div>
        </article>
        <% } %>

        <!-- 2. Four Complementary Visual Story Cards -->
        <div class="storycase-grid-4">
          <% const subMilestones = (typeof kalash !== 'undefined' && kalash.milestonesSection && kalash.milestonesSection.items && kalash.milestonesSection.items.length > 1) ? kalash.milestonesSection.items.slice(1) : []; %>
          <% subMilestones.forEach((item) => { %>
            <article class="storycase-card">
              <div class="storycase-card-thumb">
                <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy" />
                <span class="storycase-card-tag"><%= item.stateName %> • <%= item.district %></span>
              </div>
              <div class="storycase-card-body">
                <div>
                  <h4><%= item.title %></h4>
                  <p><%= item.description %></p>
                </div>
                <div class="storycase-card-footer">
                  <span class="storycase-location-text"><%= item.district %>, <%= item.stateName %></span>
                  <span class="btn-card-filter-link btn-jump-filter-state" data-state="<%= item.stateKey %>">वीडियो देखें →</span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- 3. Seamless Transition Ribbon connecting into Filter Console (NO GAP) -->
        <div class="storycase-transition-bar">
          <div class="transition-text-group">
            <div class="transition-icon-circle">🎥</div>
            <div>
              <h5>कलश यात्रा के सभी वीडियो व संबोधन नीचे उपलब्ध हैं</h5>
              <p>राज्य, जिला या श्रेणी का चयन करके अपनी पसंद का वीडियो तुरंत देखें</p>
            </div>
          </div>
          <button type="button" class="btn-jump-filter" id="btnJumpToFilter">
            <span>वीडियो फ़िल्टर एवं खोज केंद्र ↓</span>
          </button>
        </div>

      </div>

    </section>

    <!-- ===================================================
         MOBILE FLOATING FILTER TAB & DRAWER OVERLAY
    ==================================================== -->
    <button type="button" class="mobile-filter-floating-tab" id="mobileFilterTab" aria-label="वीडियो फ़िल्टर खोलें">
      <div class="tab-lines-icon">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span class="tab-label-text">फ़िल्टर</span>
      <span class="mobile-filter-badge" id="mobileFilterBadge">6</span>
    </button>

    <div class="mobile-filter-backdrop" id="mobileFilterBackdrop"></div>

    <!-- ===================================================
         FILTER CONSOLE (SEARCH, STATE, DISTRICT, SORT)
    ==================================================== -->
    <section class="filter-console-section" id="filterConsole">
      <div class="container">
        <div class="filter-card">

          <!-- Filter Top Bar -->
          <div class="filter-header-bar">
            <div class="filter-title-group">
              <div class="filter-icon-box">
                <svg viewBox="0 0 24 24">
                  <path d="M3 4h18v2H3V4zm3 7h12v2H6v-2zm4 7h4v2h-4v-2z"/>
                </svg>
              </div>
              <div class="filter-heading-text">
                <h3>वीडियो खोज एवं चयन केंद्र</h3>
                <p>राज्य, जिला, श्रेणी अथवा शीर्षक लिखकर मनचाहा वीडियो तुरंत प्राप्त करें</p>
              </div>
            </div>

            <div class="filter-top-actions">
              <div class="count-indicator">
                <span>दिख रहे हैं:</span>
                <strong id="resultCount">6</strong>
                <span>वीडियो</span>
              </div>

              <button type="button" class="btn-reset-filters" id="clearFilters">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </svg>
                <span>रीसेट करें</span>
              </button>

              <!-- Drawer Close Button for Mobile Screens -->
              <button type="button" class="drawer-mobile-close" id="mobileFilterClose" aria-label="फ़िल्टर बंद करें">
                ✕
              </button>
            </div>
          </div>

          <!-- Inputs Grid -->
          <div class="filter-input-grid">

            <!-- State -->
            <div class="form-group-custom">
              <label for="stateFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                </svg>
                <span>राज्य चुनें</span>
              </label>
              <div class="custom-select-wrapper">
                <select id="stateFilter" class="styled-select">
                  <option value="all">सभी राज्य (सम्पूर्ण भारत)</option>
                  <option value="bihar">बिहार (Bihar)</option>
                  <option value="madhya-pradesh">मध्य प्रदेश (Madhya Pradesh)</option>
                  <option value="uttar-pradesh">उत्तर प्रदेश (Uttar Pradesh)</option>
                  <option value="jharkhand">झारखंड (Jharkhand)</option>
                  <option value="rajasthan">राजस्थान (Rajasthan)</option>
                </select>
                <span class="select-arrow">
                  <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
                </span>
              </div>
            </div>

            <!-- District -->
            <div class="form-group-custom">
              <label for="districtFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M15 11V5l-3-3-3 3v2H3v14h18V11h-6zm-8 7H5v-2h2v2zm0-4H5v-2h2v2zm0-4H5V8h2v2zm6 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V8h2v2zm0-4h-2V4h2v2zm6 12h-2v-2h2v2zm0-4h-2v-2h2v2z"/>
                </svg>
                <span id="districtLabel">जिला चुनें</span>
              </label>
              <div class="custom-select-wrapper">
                <select id="districtFilter" class="styled-select" disabled>
                  <option value="all">पहले राज्य का चयन करें</option>
                </select>
                <span class="select-arrow">
                  <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
                </span>
              </div>
            </div>

            <!-- Search -->
            <div class="form-group-custom">
              <label for="searchFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                </svg>
                <span>कीवर्ड / नाम से खोजें</span>
              </label>
              <div class="custom-input-wrapper">
                <span class="search-icon-inside">
                  <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                </span>
                <input
                  type="search"
                  id="searchFilter"
                  class="styled-input with-icon"
                  placeholder="उदा. गोपालगंज, संबोधन, शोभायात्रा..."
                  autocomplete="off"
                />
                <button type="button" class="search-clear-btn" id="searchClearBtn" aria-label="खोज साफ करें">×</button>
              </div>
            </div>

            <!-- Sort -->
            <div class="form-group-custom">
              <label for="sortFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/>
                </svg>
                <span>वीडियो क्रम (Sort)</span>
              </label>
              <div class="custom-select-wrapper">
                <select id="sortFilter" class="styled-select">
                  <option value="latest">नवीनतम पहले (Latest)</option>
                  <option value="oldest">पुराने पहले (Oldest)</option>
                  <option value="az">शीर्षक (A से Z)</option>
                </select>
                <span class="select-arrow">
                  <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
                </span>
              </div>
            </div>

          </div>

          <!-- Category Pills -->
          <div class="category-nav-bar">
            <span class="category-nav-label">श्रेणी:</span>

            <button type="button" class="pill-category-btn active" data-category="all">
              <svg viewBox="0 0 24 24"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
              <span>सभी वीडियो</span>
              <span class="category-badge-count" id="countCatAll">6</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="yatra">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>कलश यात्रा</span>
              <span class="category-badge-count" id="countCatYatra">2</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="program">
              <svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
              <span>कार्यक्रम</span>
              <span class="category-badge-count" id="countCatProgram">2</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="speech">
              <svg viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
              <span>संबोधन</span>
              <span class="category-badge-count" id="countCatSpeech">1</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="highlights">
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <span>विशेष झलकियां</span>
              <span class="category-badge-count" id="countCatHighlights">1</span>
            </button>
          </div>

          <!-- Active Filter Chips Tray -->
          <div class="active-chips-tray" id="activeFilters"></div>

          <!-- Mobile Drawer Footer Apply Button -->
          <div class="drawer-apply-footer">
            <button type="button" class="btn-apply-drawer" id="btnApplyDrawer">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
              </svg>
              <span>वीडियो देखें (<span id="drawerResultCount">6</span> परिणाम)</span>
            </button>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================================================
         VIDEO GALLERY CARDS
    ==================================================== -->
    <section class="gallery-section" id="videoGallery">
      <div class="container">

        <div class="gallery-header-row">
          <div>
            <h2 class="gallery-section-title">कलश यात्रा की अमर झलकियां</h2>
            <p class="gallery-section-subtitle">समस्त राज्यों व जिलों से प्राप्त प्रमाणिक वीडियो संकलन</p>
          </div>

          <!-- View Mode Toggle (Grid / List format) -->
          <div class="gallery-view-controls">
            <div class="view-mode-toggle" id="viewModeToggle" role="group" aria-label="प्रदर्शन प्रारूप (View Format)">
              <button type="button" class="btn-view-toggle active" id="btnViewGrid" data-view="grid" title="ग्रिड प्रारूप में देखें">
                <svg viewBox="0 0 24 24"><path d="M3 3v8h8V3H3zm2 2h4v4H5V5zm8-2v8h8V3h-8zm2 2h4v4h-4V5zM3 13v8h8v-8H3zm2 2h4v4H5v-4zm8-2v8h8v-8h-8zm2 2h4v4h-4v-4z"/></svg>
                <span>ग्रिड (Grid)</span>
              </button>
              <button type="button" class="btn-view-toggle" id="btnViewList" data-view="list" title="सूची प्रारूप में देखें">
                <svg viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/></svg>
                <span>सूची (List)</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Dedicated District-wise Quick Filter Bar -->
        <div class="quick-district-filter-section" id="quickDistrictSection">
          <div class="quick-district-header">
            <span class="quick-district-title">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
              <span>ज़िला अनुसार फ़िल्टर (District Filter):</span>
            </span>
            <span class="quick-district-hint">त्वरित चयन हेतु किसी भी ज़िले पर क्लिक करें</span>
          </div>
          <div class="quick-district-pills" id="quickDistrictPills">
            <!-- Dynamically populated from script -->
          </div>
        </div>

        <div class="video-cards-grid view-grid" id="videoGrid">
          <% const videoList = (typeof kalash !== 'undefined' && kalash.videos && kalash.videos.length > 0) ? kalash.videos : []; %>
          <% videoList.forEach((vid) => { %>
            <% 
              let ytId = '';
              if (vid.videoUrl) {
                if (vid.videoUrl.includes('embed/')) {
                  ytId = vid.videoUrl.split('embed/')[1].split(/[?&]/)[0];
                } else if (vid.videoUrl.includes('watch?v=')) {
                  ytId = vid.videoUrl.split('watch?v=')[1].split('&')[0];
                } else if (vid.videoUrl.includes('youtu.be/')) {
                  ytId = vid.videoUrl.split('youtu.be/')[1].split(/[?&]/)[0];
                } else if (vid.videoUrl.includes('shorts/')) {
                  ytId = vid.videoUrl.split('shorts/')[1].split(/[?&]/)[0];
                }
              }
              const thumbImg = vid.thumbnail || (ytId ? ('https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg') : '/images/kalash-yatra-hero.jpg');
            %>
            <article
              class="video-card-item"
              data-category="<%= vid.category || 'yatra' %>"
              data-state="<%= vid.state || 'bihar' %>"
              data-district="<%= (vid.district || '').trim() %>"
              data-person="<%= (vid.personOrPlace || '').trim() %>"
              data-date="<%= vid.date || '' %>"
              data-video="<%= vid.videoUrl %>"
              data-title="<%= vid.title %>"
              data-duration="<%= vid.duration || '' %>"
              data-desc="<%= vid.description || '' %>"
              data-location="<%= vid.district ? (vid.district + ', ') : '' %><%= vid.state %>"
            >
              <div class="card-media-box">
                <img
                  src="<%= thumbImg %>"
                  alt="<%= vid.title %>"
                  loading="lazy"
                />
                <div class="card-gradient-vignette"></div>

                <div class="card-play-symbol" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5.2v13.6c0 .9 1 1.4 1.8.9l10-6.8c.7-.5.7-1.5 0-2l-10-6.6C9 3.8 8 4.3 8 5.2z"/></svg>
                </div>

                <span class="badge-location-corner">
                  <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                  <%= vid.district || 'पावन धाम' %>
                </span>

                <span class="badge-duration-corner">
                  <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                  <%= vid.duration || '10:00' %>
                </span>
              </div>

              <div class="card-info-box">
                <div class="card-tags-row">
                  <span class="card-category-tag"><%= vid.tag || (vid.category === 'speech' ? 'संबोधन' : vid.category === 'program' ? 'कार्यक्रम' : 'कलश यात्रा') %></span>
                  <span class="card-district-pill">
                    <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                    ज़िला: <strong><%= vid.district || '—' %></strong>
                  </span>
                </div>

                <h3 class="card-title-text"><%= vid.title %></h3>

                <!-- व्यक्ति / स्थान का नाम (Person / Place Name) -->
                <div class="card-meta-line card-person-line">
                  <span class="meta-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                  </span>
                  <span class="meta-label">व्यक्ति / स्थान:</span>
                  <span class="meta-val"><%= vid.personOrPlace || (vid.district ? (vid.district + ' (आयोजन स्थल)') : 'पावन धाम') %></span>
                </div>

                <p class="card-description-text">
                  <%= vid.description || '' %>
                </p>

                <div class="card-footer-strip">
                  <span class="card-footer-date">
                    <svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                    <span>अपलोड: <%= vid.date || 'विशेष प्रस्तुति' %></span>
                  </span>
                  <button type="button" class="btn-card-play" aria-label="वीडियो देखें">
                    <span>चलाएं</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                </div>
              </div>
            </article>
          <% }) %>

          <!-- EMPTY STATE WHEN NO VIDEOS MATCH -->
          <div class="empty-state-card" id="emptyState">
            <div class="empty-symbol-icon">
              <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            </div>
            <h3>कोई वीडियो नहीं मिला</h3>
            <p>आपके द्वारा चुने गए राज्य, जिले या खोज शब्द के लिए वर्तमान में कोई वीडियो उपलब्ध नहीं है। कृपया फ़िल्टर बदलें या रीसेट करें।</p>
            <button type="button" class="btn-empty-clear" id="emptyClear">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
              <span>सभी फ़िल्टर रीसेट करें</span>
            </button>
          </div>

        </div>

        <!-- ===================================================
             CREATIVE SHOWCASE: PILLARS & VISUAL STORY
        ==================================================== -->
        <section class="pillars-showcase-section" id="pillarsSection">
          
          <!-- Section Heading -->
          <div class="pillars-header-block">
            <div class="pillars-kicker-tag">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>पावन धरोहर एवं सामाजिक जागरण • महा-संकल्प दर्शन</span>
            </div>
            <h2 class="pillars-main-title">
              कलश यात्रा के चार महा-संकल्प — <span class="accent">आस्था, संस्कार और स्वाभिमान</span>
            </h2>
            <p class="pillars-subtitle">
              पवित्र नदियों के जल से समाज में समरसता, मातृशक्ति का सम्मान और भावी पीढ़ी के उज्ज्वल भविष्य का पावन जन-अभियान। जानें इस आंदोलन के मूल आदर्श।
            </p>
          </div>

          <!-- Master 2-Column Grid -->
          <div class="pillars-content-grid">

            <!-- Left: Visual Living Story (Interactive Image Collage) -->
            <div class="visual-story-column">

              <!-- Primary Big Card -->
              <div class="story-card-primary" id="storyPrimaryCard" data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" data-title="पवित्र नदी तटों पर वैदिक कलश स्थापन व जल पूजन">
                <img
                  src="/images/ghat-kalash-procession.jpg"
                  alt="पवित्र नदी तटों पर कलश यात्रा"
                  loading="lazy"
                />
                <div class="story-overlay-grad"></div>

                <div class="story-floating-badge">
                  <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                  <span>गंगा व पावन नदियों का संगम</span>
                </div>

                <div class="story-caption-block">
                  <h4><%= (typeof kalash !== 'undefined' && kalash.pillarsSection && kalash.pillarsSection.storyCollage && kalash.pillarsSection.storyCollage.primaryCard.title) ? kalash.pillarsSection.storyCollage.primaryCard.title : 'जल शुद्धि एवं सनातन संस्कृति का पुनर्जागरण' %></h4>
                  <p><%= (typeof kalash !== 'undefined' && kalash.pillarsSection && kalash.pillarsSection.storyCollage && kalash.pillarsSection.storyCollage.primaryCard.desc) ? kalash.pillarsSection.storyCollage.primaryCard.desc : 'पवित्र घाटों पर सूर्योदय के समय माताओं-बहनों द्वारा वैदिक मंत्रोच्चार के साथ कलश पूजन का अलौकिक दृश्य।' %></p>
                </div>
              </div>

              <!-- Dual Sub-Cards -->
              <div class="story-cards-dual">

                <div class="story-card-sub" data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" data-title="वैदिक कलश पूजन — आम्रपल्लव व श्रीफल अर्चन">
                  <img
                    src="/images/sacred-kalash-ritual.jpg"
                    alt="वैदिक कलश पूजन"
                    loading="lazy"
                  />
                  <div class="story-overlay-grad"></div>
                  <span class="story-sub-tag">🪔 वैदिक अनुष्ठान</span>
                  <div class="story-sub-caption">
                    <h5>मंगल कलश स्थापन</h5>
                    <p>आम्रपल्लव, श्रीफल व पावन जल</p>
                  </div>
                </div>

                <div class="story-card-sub" data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" data-title="हजारों श्रद्धालुओं का संगठित जनसैलाब">
                  <img
                    src="/images/kalash-yatra-featured.jpg"
                    alt="विशाल जनसैलाब रैली"
                    loading="lazy"
                  />
                  <div class="story-overlay-grad"></div>
                  <span class="story-sub-tag">🚩 ऐतिहासिक रैली</span>
                  <div class="story-sub-caption">
                    <h5>स्वाभिमान का शंखनाद</h5>
                    <p>150+ जिलों में एकता का संगम</p>
                  </div>
                </div>

              </div>

            </div>

            <!-- Right: The 4 Sacred Pillars (Interactive Cards) -->
            <div class="pillars-list-column">
              <% const pillarList = (typeof kalash !== 'undefined' && kalash.pillarsSection && kalash.pillarsSection.pillars && kalash.pillarsSection.pillars.length > 0) ? kalash.pillarsSection.pillars : [
                { number: '01', title: 'पवित्र जल एवं पर्यावरण संरक्षण संकल्प', description: 'गंगा, सरयू, नर्मदा व गंडक जैसी पावन नदियों के जल को साक्षी मानकर जलस्रोतों के संरक्षण, स्वच्छता और पर्यावरण संतुलन का सामूहिक प्रण लेना।' },
                { number: '02', title: 'मातृशक्ति का गौरव एवं सशक्तिकरण', description: 'कलश यात्रा में घर-परिवार की माताओं, बहनों और बेटियों की प्रथम पंक्ति में भागीदारी, जो समाज में नारी नेतृत्व और सम्मान का प्रत्यक्ष उदाहरण है।' },
                { number: '03', title: 'सामाजिक समरसता व अखंड एकजुटता', description: 'गांव, कस्बों और राज्यों के बंधनों से परे समाज के हर वर्ग को एक धागे में पिरोकर आपसी सहयोग, बंधुत्व और संगठित शक्ति की नींव रखना।' },
                { number: '04', title: 'शिक्षा, संस्कार और स्वावलंबन की राह', description: 'नई पीढ़ी को अपनी गौरवशाली ऐतिहासिक पहचान से जोड़ना, उच्च शिक्षा के प्रति जागरूक करना और आत्मनिर्भर समाज निर्माण के लिए प्रेरित करना।' }
              ]; %>

              <% pillarList.forEach((pil, pIdx) => { %>
                <div class="pillar-interactive-card">
                  <div class="pillar-card-head">
                    <div class="pillar-num-badge"><%= pil.number || ('0' + (pIdx + 1)) %></div>
                    <div class="pillar-icon-symbol">
                      <% if (pIdx === 0) { %>
                        <svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                      <% } else if (pIdx === 1) { %>
                        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                      <% } else if (pIdx === 2) { %>
                        <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                      <% } else { %>
                        <svg viewBox="0 0 24 24"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/></svg>
                      <% } %>
                    </div>
                    <h4><%= pil.title %></h4>
                  </div>
                  <div class="pillar-card-body">
                    <p><%= pil.description %></p>
                  </div>
                </div>
              <% }) %>

            </div>

          </div>

        </section>

      </div>
    </section>

  </main>

  <!-- =====================================================
       VIDEO MODAL POPUP
  ===================================================== -->
  <div class="video-modal-backdrop" id="videoModal" aria-modal="true" role="dialog">
    <div class="modal-content-shell">
      <div class="modal-top-bar">
        <div class="modal-title-wrap">
          <span class="meta-tag-pill" id="modalCategoryBadge">कलश यात्रा</span>
          <h4 id="modalVideoTitle">वीडियो प्लेयर</h4>
        </div>
        <div class="modal-actions-right">
          <button type="button" class="modal-share-btn" id="modalShareBtn" title="वीडियो लिंक कॉपी करें">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
            </svg>
            <span>कॉपी लिंक</span>
          </button>
          <button type="button" class="modal-close-cross" id="modalClose" aria-label="बंद करें">×</button>
        </div>
      </div>

      <div class="modal-video-frame-wrap" id="modalVideoFrameWrap">
        <iframe
          id="modalVideoIframe"
          src=""
          title="कलश यात्रा वीडियो प्लेयर"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

      <!-- Modal Info Strip below player -->
      <div class="modal-meta-strip">
        <div class="modal-meta-col">
          <div class="modal-meta-item">
            <span class="m-icon">👤</span>
            <span class="m-label">व्यक्ति / स्थान:</span>
            <strong class="m-val" id="modalVideoPerson">—</strong>
          </div>
          <div class="modal-meta-item">
            <span class="m-icon">📍</span>
            <span class="m-label">ज़िला:</span>
            <strong class="m-val" id="modalVideoDistrict">—</strong>
          </div>
        </div>
        <div class="modal-meta-col">
          <div class="modal-meta-item">
            <span class="m-icon">📅</span>
            <span class="m-label">अपलोड तिथि:</span>
            <span class="m-val" id="modalVideoDate">—</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast-notification" id="toastNotification">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
    <span id="toastMessage">लिंक सफलतापूर्वक कॉपी किया गया!</span>
  </div>

