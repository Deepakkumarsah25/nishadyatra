      /* ===================================================
         FILTERING & SEARCH LOGIC
      ==================================================== */
      function applyFilters() {
        const state = stateFilter ? stateFilter.value : "all";
        const districtDropdown = districtFilter ? districtFilter.value : "all";
        const effectiveDistrict = selectedDistrict !== "all" ? selectedDistrict : districtDropdown;
        const search = (searchFilter ? searchFilter.value : "").trim().toLowerCase();
        const visibleCards = [];

        // Toggle clear search button
        if (searchClearBtn) {
          searchClearBtn.classList.toggle("visible", search.length > 0);
        }

        videoCards.forEach(function (card) {
          const cardState = card.dataset.state || "";
          const cardDistrict = card.dataset.district || "";
          const cardCat = card.dataset.category || "yatra";

          const matchesState = state === "all" || cardState === state;
          const matchesDistrict = effectiveDistrict === "all" || isDistrictMatch(cardDistrict, effectiveDistrict);
          const matchesCategory = selectedCategory === "all" || cardCat === selectedCategory;

          let matchesSearch = true;
          if (search) {
            const searchHaystack = [
              card.dataset.title || "",
              card.dataset.person || "",
              cardDistrict,
              cardState,
              card.dataset.date || "",
              card.dataset.desc || "",
              card.textContent || ""
            ].join(" ").toLowerCase();
            matchesSearch = searchHaystack.includes(search);
          }

          const isVisible = matchesState && matchesDistrict && matchesCategory && matchesSearch;

          if (isVisible) {
            card.classList.remove("hidden");
            visibleCards.push(card);
          } else {
            card.classList.add("hidden");
          }
        });

        sortCards(visibleCards);

        if (resultCount) resultCount.textContent = visibleCards.length;
        if (mobileFilterBadge) mobileFilterBadge.textContent = visibleCards.length;
        if (drawerResultCount) drawerResultCount.textContent = visibleCards.length;
        if (emptyState) emptyState.classList.toggle("show", visibleCards.length === 0);

        updateActiveChips();
      }

      /* ===================================================
         SORT CARDS
      ==================================================== */
      function sortCards(cards) {
        const sortMode = sortFilter ? sortFilter.value : "latest";

        cards.sort(function (a, b) {
          if (sortMode === "latest") {
            return new Date(b.dataset.date) - new Date(a.dataset.date);
          }
          if (sortMode === "oldest") {
            return new Date(a.dataset.date) - new Date(b.dataset.date);
          }
          if (sortMode === "az") {
            const titleA = a.querySelector("h3")?.textContent?.trim() || "";
            const titleB = b.querySelector("h3")?.textContent?.trim() || "";
            return titleA.localeCompare(titleB, "hi");
          }
          return 0;
        });

        cards.forEach(function (card) {
          if (videoGrid) videoGrid.appendChild(card);
        });
      }

      /* ===================================================
         ACTIVE FILTER CHIPS
      ==================================================== */
      function updateActiveChips() {
        if (!activeFilters) return;
        activeFilters.innerHTML = "";
        let hasFilter = false;

        const state = stateFilter ? stateFilter.value : "all";
        const district = selectedDistrict !== "all" ? selectedDistrict : (districtFilter ? districtFilter.value : "all");
        const search = searchFilter ? searchFilter.value.trim() : "";

        if (state !== "all") {
          const stateName = stateFilter.options[stateFilter.selectedIndex]?.textContent || state;
          addChip("राज्य: " + stateName, function () {
            stateFilter.value = "all";
            updateDistricts();
            applyFilters();
          });
          hasFilter = true;
        }

        if (district !== "all") {
          addChip("जिला: " + district, function () {
            selectDistrict("all");
          });
          hasFilter = true;
        }

        if (selectedCategory !== "all") {
          const catBtn = document.querySelector(`.pill-category-btn[data-category="${selectedCategory}"]`);
          const catName = catBtn?.querySelector("span")?.textContent || selectedCategory;
          addChip("श्रेणी: " + catName, function () {
            selectedCategory = "all";
            setCategoryButtons();
            applyFilters();
          });
          hasFilter = true;
        }

        if (search) {
          addChip("खोज: " + search, function () {
            searchFilter.value = "";
            applyFilters();
          });
          hasFilter = true;
        }

        activeFilters.classList.toggle("show", hasFilter);
      }

      function addChip(label, onRemove) {
        const chip = document.createElement("div");
        chip.className = "active-chip-tag";

        const span = document.createElement("span");
        span.textContent = label;

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "active-chip-remove";
        btn.innerHTML = "×";
        btn.title = "हटाएं";
        btn.addEventListener("click", onRemove);

        chip.appendChild(span);
        chip.appendChild(btn);
        activeFilters.appendChild(chip);
      }

      /* ===================================================
         RESET FILTERS
      ==================================================== */
      function resetFilters() {
        if (stateFilter) stateFilter.value = "all";
        selectedDistrict = "all";
        updateDistricts();
        if (searchFilter) searchFilter.value = "";
        if (sortFilter) sortFilter.value = "latest";
        selectedCategory = "all";
        setCategoryButtons();
        if (quickDistrictPills) {
          const pills = quickDistrictPills.querySelectorAll(".district-pill");
          pills.forEach(p => p.classList.toggle("active", p.dataset.district === "all"));
        }
        applyFilters();
      }

      if (clearFilters) clearFilters.addEventListener("click", resetFilters);
      if (emptyClear) emptyClear.addEventListener("click", resetFilters);

      if (searchClearBtn) {
        searchClearBtn.addEventListener("click", function () {
          if (searchFilter) searchFilter.value = "";
          applyFilters();
        });
      }

      if (stateFilter) {
        stateFilter.addEventListener("change", function () {
          selectedDistrict = "all";
          updateDistricts();
          applyFilters();
        });
      }

      if (districtFilter) {
        districtFilter.addEventListener("change", function () {
          selectedDistrict = districtFilter.value;
          if (quickDistrictPills) {
            const pills = quickDistrictPills.querySelectorAll(".district-pill");
            pills.forEach(p => p.classList.toggle("active", p.dataset.district === selectedDistrict));
          }
          applyFilters();
        });
      }

      if (searchFilter) searchFilter.addEventListener("input", applyFilters);
      if (sortFilter) sortFilter.addEventListener("change", applyFilters);

      /* ===================================================
         MODAL VIDEO PLAYBACK (PROPER VIDEO PLAYER)
      ==================================================== */
      function parseYouTubeUrl(url) {
        if (!url) return "";
        let videoId = "";

        if (url.includes("embed/")) {
          videoId = url.split("embed/")[1].split(/[?&]/)[0];
        } else if (url.includes("watch?v=")) {
          videoId = url.split("watch?v=")[1].split("&")[0];
        } else if (url.includes("youtu.be/")) {
          videoId = url.split("youtu.be/")[1].split(/[?&]/)[0];
        } else if (url.includes("shorts/")) {
          videoId = url.split("shorts/")[1].split(/[?&]/)[0];
        }

        if (videoId) {
          return "https://www.youtube-nocookie.com/embed/" + videoId + "?autoplay=1&rel=0&modestbranding=1";
        }
        return url;
      }

      function openModalVideo(url, title, category, personOrPlace, district, date) {
        if (!url) return;

        const embedUrl = parseYouTubeUrl(url);

        // Update Frame Content
        if (modalVideoFrameWrap) {
          if (embedUrl.endsWith(".mp4") || embedUrl.endsWith(".webm")) {
            modalVideoFrameWrap.innerHTML = `
              <video src="${embedUrl}" controls autoplay style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;">
                आपका ब्राउज़र यह वीडियो चलाने में असमर्थ है।
              </video>
            `;
          } else {
            const sep = embedUrl.includes("?") ? "&" : "?";
            const finalSrc = embedUrl.includes("autoplay=1") ? embedUrl : (embedUrl + sep + "autoplay=1");
            modalVideoFrameWrap.innerHTML = `
              <iframe
                id="modalVideoIframe"
                src="${finalSrc}"
                title="${title || 'कलश यात्रा वीडियो'}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                style="position:absolute;inset:0;width:100%;height:100%;border:none;"
              ></iframe>
            `;
          }
        }

        // Update Metadata
        if (modalVideoTitle) modalVideoTitle.textContent = title || "कलश यात्रा विशेष वीडियो";
        if (modalCategoryBadge) modalCategoryBadge.textContent = category || "कलश यात्रा";
        if (modalVideoPerson) modalVideoPerson.textContent = personOrPlace || "आयोजन स्थल";
        if (modalVideoDistrict) modalVideoDistrict.textContent = district || "पावन धाम";
        if (modalVideoDate) modalVideoDate.textContent = date || "विशेष प्रस्तुति";

        activeVideoShareUrl = url;

        if (videoModal) videoModal.classList.add("active");
        document.body.classList.add("modal-open");
      }

      function closeModalVideo() {
        if (videoModal) videoModal.classList.remove("active");
        if (modalVideoFrameWrap) {
          modalVideoFrameWrap.innerHTML = "";
        }
        document.body.classList.remove("modal-open");
      }

      // Card Click Listeners
      videoCards.forEach(function (card) {
        card.addEventListener("click", function (e) {
          const videoUrl = card.dataset.video;
          const videoTitle = card.dataset.title || card.querySelector("h3")?.textContent?.trim();
          const categoryTag = card.querySelector(".card-category-tag")?.textContent?.trim() || "कलश यात्रा";
          const person = card.dataset.person || "";
          const district = card.dataset.district || "";
          const date = card.dataset.date || "";

          openModalVideo(videoUrl, videoTitle, categoryTag, person, district, date);
        });
      });

      // Featured Video Trigger
      const heroFeaturedPlayBtn = document.getElementById("heroFeaturedPlayBtn");
      if (heroFeaturedPlayBtn) {
        heroFeaturedPlayBtn.addEventListener("click", function () {
          openModalVideo(
            heroFeaturedPlayBtn.dataset.video,
            heroFeaturedPlayBtn.dataset.title,
            "विशेष प्रस्तुति",
            "राष्ट्रीय महा-आयोजन",
            "सम्पूर्ण भारत",
            "2026"
          );
        });
      }

      // Visual Story Cards Click Listeners
      const storyCards = document.querySelectorAll(".story-card-primary, .story-card-sub");
      storyCards.forEach(function (card) {
        card.addEventListener("click", function () {
          const videoUrl = card.dataset.video || "https://www.youtube.com/embed/dQw4w9WgXcQ";
          const videoTitle = card.dataset.title || "कलश यात्रा विशेष दर्शन";
          openModalVideo(videoUrl, videoTitle, "पावन दर्शन", "पवित्र संगम", "काशी - प्रयागराज", "2026");
        });
      });

      // Close Modal Triggers
      if (modalClose) modalClose.addEventListener("click", closeModalVideo);

      if (videoModal) {
        videoModal.addEventListener("click", function (event) {
          if (event.target === videoModal) {
            closeModalVideo();
          }
        });
      }

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          if (videoModal && videoModal.classList.contains("active")) {
            closeModalVideo();
          }
          if (filterConsole && filterConsole.classList.contains("drawer-open")) {
            closeFilterDrawer();
          }
        }
      });

      /* ===================================================
         SHARE & TOAST NOTIFICATION
      ==================================================== */
      function showToast(msg) {
        if (!toastNotification || !toastMessage) return;
        toastMessage.textContent = msg || "लिंक कॉपी हो गया!";
        toastNotification.classList.add("show");
        setTimeout(function () {
          toastNotification.classList.remove("show");
        }, 3200);
      }

      function copyTextToClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(function () {
            showToast("लिंक क्लिपबोर्ड पर कॉपी हो गया!");
          }).catch(function () {
            showToast("लिंक: " + text);
          });
        } else {
          showToast("लिंक: " + text);
        }
      }

      if (modalShareBtn) {
        modalShareBtn.addEventListener("click", function () {
          copyTextToClipboard(activeVideoShareUrl || window.location.href);
        });
      }

      const btnShareFeatured = document.getElementById("btnShareFeatured");
      if (btnShareFeatured) {
        btnShareFeatured.addEventListener("click", function () {
          copyTextToClipboard(window.location.origin + window.location.pathname + "#videoGallery");
        });
      }

      /* ===================================================
         INIT ON LOAD
      ==================================================== */
      try {
        const savedView = localStorage.getItem("ky_view_mode") || "grid";
        setViewMode(savedView);
      } catch (e) {
        setViewMode("grid");
      }

      renderQuickDistrictPills();
      updateDistricts();
      updateCategoryCounts();
      setCategoryButtons();
      applyFilters();

    });
  </script>

</body>

</html>