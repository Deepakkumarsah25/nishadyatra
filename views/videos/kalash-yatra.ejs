      function normalizeStr(str) {
        if (!str) return "";
        return str.trim().toLowerCase();
      }

      function isDistrictMatch(cardDist, targetDist) {
        if (!targetDist || targetDist === "all") return true;
        if (!cardDist) return false;

        const cNorm = normalizeStr(cardDist);
        const tNorm = normalizeStr(targetDist);

        if (cNorm === tNorm) return true;
        if (cNorm.includes(tNorm) || tNorm.includes(cNorm)) return true;

        for (const [enKey, hiVal] of Object.entries(districtAliasMap)) {
          const hiNorm = normalizeStr(hiVal);
          const enNorm = normalizeStr(enKey);

          const matchesTarget = tNorm === enNorm || tNorm === hiNorm;
          const matchesCard = cNorm === enNorm || cNorm === hiNorm;

          if (matchesTarget && matchesCard) return true;
        }

        return false;
      }

      function updateDistricts() {
        if (!districtFilter) return;
        const state = stateFilter ? stateFilter.value : "all";
        const currentSelected = districtFilter.value;
        districtFilter.innerHTML = "";

        const stateNameMap = {
          "bihar": "बिहार",
          "uttar-pradesh": "उत्तर प्रदेश",
          "madhya-pradesh": "मध्य प्रदेश",
          "jharkhand": "झारखंड",
          "rajasthan": "राजस्थान"
        };

        const allOpt = document.createElement("option");
        allOpt.value = "all";
        allOpt.textContent = state === "all" ? "सभी ज़िले (All Districts)" : ("सभी ज़िले (" + (stateNameMap[state] || state) + ")");
        districtFilter.appendChild(allOpt);

        if (districtLabel) {
          districtLabel.textContent = state === "all" ? "ज़िला चुनें (Select District)" : ("ज़िला चुनें (" + (stateNameMap[state] || state) + " के ज़िले)");
        }

        const districtsSet = new Set();

        // 1. If specific state selected, add all districts of that state
        if (state !== "all" && stateDistrictList[state]) {
          stateDistrictList[state].forEach(d => districtsSet.add(d));
        } else if (state === "all") {
          // If all states, collect districts from video cards
          videoCards.forEach(card => {
            const cardDist = (card.dataset.district || "").trim();
            if (cardDist) districtsSet.add(cardDist);
          });
        }

        Array.from(districtsSet).sort((a, b) => a.localeCompare(b, "hi")).forEach(dist => {
          const opt = document.createElement("option");
          opt.value = dist;
          opt.textContent = dist;
          districtFilter.appendChild(opt);
        });

        // Retain selection if valid
        if (currentSelected && currentSelected !== "all") {
          let found = false;
          Array.from(districtFilter.options).forEach(opt => {
            if (opt.value === currentSelected || isDistrictMatch(opt.value, currentSelected)) {
              districtFilter.value = opt.value;
              found = true;
            }
          });
          if (!found) districtFilter.value = "all";
        } else {
          districtFilter.value = "all";
        }
      }

      /* ===================================================
         FILTERING & SEARCH LOGIC
      ==================================================== */
      function applyFilters() {
        const state = stateFilter ? stateFilter.value : "all";
        const district = districtFilter ? districtFilter.value : "all";
        const search = (searchFilter ? searchFilter.value : "").trim().toLowerCase();
        const visibleCards = [];

        if (searchClearBtn) {
          searchClearBtn.classList.toggle("visible", search.length > 0);
        }

        videoCards.forEach(card => {
          const cardState = card.dataset.state || "";
          const cardDist = card.dataset.district || "";

          const matchesState = state === "all" || cardState === state;
          const matchesDistrict = district === "all" || isDistrictMatch(cardDist, district);

          let matchesSearch = true;
          if (search) {
            const haystack = [
              card.dataset.title || "",
              card.dataset.person || "",
              cardDist,
              cardState,
              card.dataset.desc || "",
              card.dataset.date || "",
              card.textContent || ""
            ].join(" ").toLowerCase();
            matchesSearch = haystack.includes(search);
          }

          if (matchesState && matchesDistrict && matchesSearch) {
            visibleCards.push(card);
          }
        });

        if (resultCount) resultCount.textContent = visibleCards.length;
        if (mobileFilterBadge) mobileFilterBadge.textContent = visibleCards.length;
        if (drawerResultCount) drawerResultCount.textContent = visibleCards.length;
        if (emptyState) emptyState.classList.toggle("show", visibleCards.length === 0);

        updateActiveChips();

        currentPaginationPage = 1;
        renderPagination(visibleCards);
      }

      function updateActiveChips() {
        if (!activeFilters) return;
        activeFilters.innerHTML = "";
        let hasFilter = false;

        const state = stateFilter ? stateFilter.value : "all";
        const district = districtFilter ? districtFilter.value : "all";
        const search = searchFilter ? searchFilter.value.trim() : "";

        if (state !== "all") {
          const stateText = stateFilter.options[stateFilter.selectedIndex]?.textContent || state;
          addChip("राज्य: " + stateText, function () {
            stateFilter.value = "all";
            updateDistricts();
            applyFilters();
          });
          hasFilter = true;
        }

        if (district !== "all") {
          addChip("ज़िला: " + district, function () {
            districtFilter.value = "all";
            applyFilters();
          });
          hasFilter = true;
        }

        if (search) {
          addChip("खोज: " + search, function () {
            searchFilter.value = "";
            applyFilters();
          });
          hasFilter = true;
        }

        activeFilters.classList.toggle("show", hasFilter);
      }

      function addChip(label, onRemove) {
        const chip = document.createElement("div");
        chip.className = "active-chip-tag";

        const span = document.createElement("span");
        span.textContent = label;

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "active-chip-remove";
        btn.innerHTML = "×";
        btn.title = "हटाएं";
        btn.addEventListener("click", onRemove);

        chip.appendChild(span);
        chip.appendChild(btn);
        activeFilters.appendChild(chip);
      }

      function resetFilters() {
        if (stateFilter) stateFilter.value = "all";
        updateDistricts();
        if (searchFilter) searchFilter.value = "";
        applyFilters();
      }

      if (clearFilters) clearFilters.addEventListener("click", resetFilters);
      if (emptyClear) emptyClear.addEventListener("click", resetFilters);

      if (searchClearBtn) {
        searchClearBtn.addEventListener("click", function () {
          if (searchFilter) searchFilter.value = "";
          applyFilters();
        });
      }

      if (stateFilter) {
        stateFilter.addEventListener("change", function () {
          updateDistricts();
          applyFilters();
        });
      }

      if (districtFilter) {
        districtFilter.addEventListener("change", function () {
          applyFilters();
        });
      }

      if (searchFilter) {
        searchFilter.addEventListener("input", function () {
          applyFilters();
        });
      }

      /* ===================================================
         MOBILE FILTER DRAWER LOGIC (PHONE RIGHT-SIDE TAB)
      ==================================================== */
      function openFilterDrawer() {
        if (!filterConsole) return;
        filterConsole.classList.add("drawer-open");
        if (mobileFilterBackdrop) mobileFilterBackdrop.classList.add("open");
        document.body.classList.add("filter-drawer-open");
      }

      function closeFilterDrawer() {
        if (!filterConsole) return;
        filterConsole.classList.remove("drawer-open");
        if (mobileFilterBackdrop) mobileFilterBackdrop.classList.remove("open");
        document.body.classList.remove("filter-drawer-open");
      }

      if (mobileFilterTab) {
        mobileFilterTab.addEventListener("click", openFilterDrawer);
      }

      if (mobileFilterClose) {
        mobileFilterClose.addEventListener("click", closeFilterDrawer);
      }

      if (mobileFilterBackdrop) {
        mobileFilterBackdrop.addEventListener("click", closeFilterDrawer);
      }

      if (btnApplyDrawer) {
        btnApplyDrawer.addEventListener("click", function () {
          closeFilterDrawer();
          const videoGallery = document.getElementById("videoGallery");
          if (videoGallery) {
            videoGallery.scrollIntoView({ behavior: "smooth" });
          }
        });
      }

      /* ===================================================
         GALLERY PAGINATION (9 VIDEOS PER PAGE, RIGHT-ALIGNED NEXT)
      ==================================================== */
      function renderPagination(cards) {
        currentFilteredCards = (cards !== undefined) ? cards : videoCards;
        const total = currentFilteredCards.length;
        const totalPages = Math.ceil(total / VIDEOS_PER_PAGE) || 1;

        if (currentPaginationPage > totalPages) {
          currentPaginationPage = totalPages;
        }
        if (currentPaginationPage < 1) {
          currentPaginationPage = 1;
        }

        const startIndex = (currentPaginationPage - 1) * VIDEOS_PER_PAGE;
        const endIndex = Math.min(startIndex + VIDEOS_PER_PAGE, total);

        // Show only the 9 cards for current page among filtered cards
        currentFilteredCards.forEach(function (card, idx) {
          if (idx >= startIndex && idx < endIndex) {
            card.classList.remove("paged-out", "hidden");
            card.style.display = "";
          } else {
            card.classList.add("paged-out");
            card.style.display = "none";
          }
        });

        // Hide all cards not in filtered set
        videoCards.forEach(function (card) {
          if (!currentFilteredCards.includes(card)) {
            card.classList.add("hidden");
            card.style.display = "none";
          }
        });

        if (!galleryPagination) return;

        if (total === 0) {
          galleryPagination.style.display = "none";
          return;
        }

        galleryPagination.style.display = "flex";

        if (paginationShowingText) {
          paginationShowingText.textContent = total > 0 ? (startIndex + 1) + " - " + endIndex : "0";
        }
        if (paginationTotalCount) {
          paginationTotalCount.textContent = total;
        }

        if (btnPaginationPrev) {
          btnPaginationPrev.disabled = currentPaginationPage <= 1;
        }
        if (btnPaginationNext) {
          btnPaginationNext.disabled = currentPaginationPage >= totalPages;
        }

        // Render Page Number Buttons
        if (paginationNumbersList) {
          paginationNumbersList.innerHTML = "";
          for (let p = 1; p <= totalPages; p++) {
            const pageBtn = document.createElement("button");
            pageBtn.type = "button";
            pageBtn.className = "pagination-page-btn" + (p === currentPaginationPage ? " active" : "");
            pageBtn.textContent = p;
            pageBtn.setAttribute("aria-label", "पृष्ठ " + p);
            pageBtn.addEventListener("click", function () {
              goToPage(p);
            });
            paginationNumbersList.appendChild(pageBtn);
          }
        }
      }

      function goToPage(page) {
        currentPaginationPage = page;
        renderPagination(currentFilteredCards);
        const galleryElem = document.getElementById("videoGallery");
        if (galleryElem) {
          galleryElem.scrollIntoView({ behavior: "smooth" });
        }
      }

      if (btnPaginationPrev) {
        btnPaginationPrev.addEventListener("click", function () {
          if (currentPaginationPage > 1) {
            goToPage(currentPaginationPage - 1);
          }
        });
      }

      if (btnPaginationNext) {
        btnPaginationNext.addEventListener("click", function () {
          const totalPages = Math.ceil(currentFilteredCards.length / VIDEOS_PER_PAGE) || 1;
          if (currentPaginationPage < totalPages) {
            goToPage(currentPaginationPage + 1);
          }
        });
      }

      /* ===================================================
         INTERACTIVE NAVIGATION & SMOOTH SCROLL
      ==================================================== */
      const btnJumpToFilter = document.getElementById("btnJumpToFilter");
      if (btnJumpToFilter) {
        btnJumpToFilter.addEventListener("click", function () {
          if (window.innerWidth <= 860) {
            openFilterDrawer();
          } else {
            const fc = document.getElementById("filterConsole");
            if (fc) {
              fc.scrollIntoView({ behavior: "smooth" });
            }
          }
        });
      }

      const stateFilterTriggers = document.querySelectorAll(".btn-jump-filter-state");
      stateFilterTriggers.forEach(function (trigger) {
        trigger.addEventListener("click", function () {
          const targetState = trigger.dataset.state;
          if (targetState && stateFilter) {
            stateFilter.value = targetState;
            updateDistricts();
            applyFilters();
          }
          const gallery = document.getElementById("videoGallery");
          if (gallery) {
            gallery.scrollIntoView({ behavior: "smooth" });
          }
        });
      });

      // Watch Featured Video Modal Trigger
      const watchFeaturedTriggers = document.querySelectorAll(".btn-watch-featured");
      watchFeaturedTriggers.forEach(function (btn) {
        btn.addEventListener("click", function () {
          const videoUrl = btn.dataset.video || "https://www.youtube.com/embed/dQw4w9WgXcQ";
          const videoTitle = btn.dataset.title || "लोकतांत्रिक महा-संकल्प यात्रा";
          openModalVideo(videoUrl, videoTitle, "लोकतांत्रिक महा-संकल्प");
        });
      });

      /* ===================================================
         VIEW MODE (GRID VS LIST FORMAT)
      ==================================================== */
      function setViewMode(mode) {
        currentViewMode = mode === "list" ? "list" : "grid";
        if (videoGrid) {
          if (currentViewMode === "list") {
            videoGrid.classList.remove("view-grid");
            videoGrid.classList.add("view-list");
          } else {
            videoGrid.classList.remove("view-list");
            videoGrid.classList.add("view-grid");
          }
        }

        if (btnViewGrid && btnViewList) {
          btnViewGrid.classList.toggle("active", currentViewMode === "grid");
          btnViewList.classList.toggle("active", currentViewMode === "list");
        }

        try {
          localStorage.setItem("ky_view_mode", currentViewMode);
        } catch (e) {}
      }

      if (btnViewGrid) {
        btnViewGrid.addEventListener("click", function () {
          setViewMode("grid");
        });
      }

      if (btnViewList) {
        btnViewList.addEventListener("click", function () {
          setViewMode("list");
        });
      }

      /* ===================================================
         MODAL VIDEO PLAYBACK (PROPER VIDEO PLAYER)
      ==================================================== */
      function parseYouTubeUrl(url) {
        if (!url) return "";
        let videoId = "";

        if (url.includes("embed/")) {
          videoId = url.split("embed/")[1].split(/[?&]/)[0];
        } else if (url.includes("watch?v=")) {
          videoId = url.split("watch?v=")[1].split("&")[0];
        } else if (url.includes("youtu.be/")) {
          videoId = url.split("youtu.be/")[1].split(/[?&]/)[0];
        } else if (url.includes("shorts/")) {
          videoId = url.split("shorts/")[1].split(/[?&]/)[0];
        }

        if (videoId) {
          return "https://www.youtube-nocookie.com/embed/" + videoId + "?autoplay=1&rel=0&modestbranding=1";
        }
        return url;
      }

      function openModalVideo(url, title, category, peopleCount, district, date) {
        if (!url) return;

        const isDirectVideo = url.startsWith("/uploads/") || /\.(mp4|webm|ogg|mov|mkv)(\?.*)?$/i.test(url);
        const embedUrl = isDirectVideo ? url : parseYouTubeUrl(url);

        // Update Frame Content
        if (modalVideoFrameWrap) {
          if (isDirectVideo || embedUrl.endsWith(".mp4") || embedUrl.endsWith(".webm")) {
            modalVideoFrameWrap.innerHTML = `
              <video src="${embedUrl}" controls autoplay playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;">
                आपका ब्राउज़र यह वीडियो चलाने में असमर्थ है।
              </video>
            `;
          } else {
            const sep = embedUrl.includes("?") ? "&" : "?";
            const finalSrc = embedUrl.includes("autoplay=1") ? embedUrl : (embedUrl + sep + "autoplay=1");
            modalVideoFrameWrap.innerHTML = `
              <iframe
                id="modalVideoIframe"
                src="${finalSrc}"
                title="${title || 'संकल्प यात्रा विशेष वीडियो'}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                style="position:absolute;inset:0;width:100%;height:100%;border:none;"
              ></iframe>
            `;
          }
        }

        // Update Metadata
        if (modalVideoTitle) modalVideoTitle.textContent = title || "लोकतांत्रिक संकल्प विशेष वीडियो";
        if (modalCategoryBadge) {
          let catText = category || "संकल्प यात्रा";
          if (/kalash|कलश/i.test(catText)) catText = "संकल्प यात्रा";
          modalCategoryBadge.textContent = catText;
        }
        const modalVideoPeople = document.getElementById("modalVideoPeople");
        if (modalVideoPeople) modalVideoPeople.textContent = peopleCount || "5,000+ लोग";
        if (modalVideoDistrict) modalVideoDistrict.textContent = district || "प्रमुख केंद्र";
        if (modalVideoDate) modalVideoDate.textContent = date || "विशेष जन-सभा";
        activeVideoShareUrl = url;

        if (videoModal) videoModal.classList.add("active");
        document.body.classList.add("modal-open");
      }

      function closeModalVideo() {
        if (videoModal) videoModal.classList.remove("active");
        if (modalVideoFrameWrap) {
          modalVideoFrameWrap.innerHTML = "";
        }
        document.body.classList.remove("modal-open");
      }

      // Card Click Listeners
      videoCards.forEach(function (card) {
        card.addEventListener("click", function () {
          const videoUrl = card.dataset.video;
          const videoTitle = card.dataset.title || card.querySelector("h3")?.textContent?.trim();
          let categoryTag = "संकल्प यात्रा";
          const people = card.dataset.people || card.querySelector(".card-category-tag span")?.textContent?.trim() || "5,000+ लोग";
          const district = card.dataset.district || "";
          const date = card.dataset.date || "";

          openModalVideo(videoUrl, videoTitle, categoryTag, people, district, date);
        });
      });

      // Featured Video Trigger
      const heroFeaturedPlayBtn = document.getElementById("heroFeaturedPlayBtn");
      if (heroFeaturedPlayBtn) {
        heroFeaturedPlayBtn.addEventListener("click", function () {
          openModalVideo(
            heroFeaturedPlayBtn.dataset.video,
            heroFeaturedPlayBtn.dataset.title,
            "लोकतांत्रिक महा-संकल्प",
            "राष्ट्रीय जन-जागरण अभियान",
            "सम्पूर्ण भारत",
            "2026"
          );
        });
      }

      // Visual Story Cards Click Listeners
      const storyCards = document.querySelectorAll(".story-card-primary, .story-card-sub");
      storyCards.forEach(function (card) {
        card.addEventListener("click", function () {
          const videoUrl = card.dataset.video || "https://www.youtube.com/embed/dQw4w9WgXcQ";
          const videoTitle = card.dataset.title || "लोकतांत्रिक महा-संकल्प जन-सभा";
          openModalVideo(videoUrl, videoTitle, "जन-जागरण दर्शन", "स्वाभिमान व अधिकार चेतना", "बिहार - उत्तर प्रदेश - मध्य प्रदेश", "2026");
        });
      });

      // Close Modal Triggers
      if (modalClose) modalClose.addEventListener("click", closeModalVideo);

      if (videoModal) {
        videoModal.addEventListener("click", function (event) {
          if (event.target === videoModal) {
            closeModalVideo();
          }
        });
      }

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          if (videoModal && videoModal.classList.contains("active")) {
            closeModalVideo();
          }
          if (filterConsole && filterConsole.classList.contains("drawer-open")) {
            closeFilterDrawer();
          }
        }
      });

      /* ===================================================
         SHARE & TOAST NOTIFICATION
      ==================================================== */
      function showToast(msg) {
        if (!toastNotification || !toastMessage) return;
        toastMessage.textContent = msg || "लिंक कॉपी हो गया!";
        toastNotification.classList.add("show");
        setTimeout(function () {
          toastNotification.classList.remove("show");
        }, 3200);
      }

      function copyTextToClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(function () {
            showToast("लिंक कॉपी हो गया!");
          }).catch(function () {
            showToast("Link: " + text);
          });
        } else {
          showToast("Link: " + text);
        }
      }

      if (modalShareBtn) {
        modalShareBtn.addEventListener("click", function () {
          copyTextToClipboard(activeVideoShareUrl || window.location.href);
        });
      }

      const btnShareFeatured = document.getElementById("btnShareFeatured");
      if (btnShareFeatured) {
        btnShareFeatured.addEventListener("click", function () {
          copyTextToClipboard(window.location.origin + window.location.pathname + "#videoGallery");
        });
      }

      /* ===================================================
         INIT ON LOAD
      ==================================================== */
      try {
        const savedView = localStorage.getItem("ky_view_mode") || "grid";
        setViewMode(savedView);
      } catch (e) {
        setViewMode("grid");
      }

      updateDistricts();
      applyFilters();

    });
  </script>

</body>

</html>