        gwalior: "ग्वालियर"
      };

      function normalizeDistrict(str) {
        if (!str) return "";
        return str.trim().toLowerCase();
      }

      function isDistrictMatch(cardDist, targetDist) {
        if (!targetDist || targetDist === "all") return true;
        if (!cardDist) return false;

        const cNorm = normalizeDistrict(cardDist);
        const tNorm = normalizeDistrict(targetDist);

        if (cNorm === tNorm) return true;
        if (cNorm.includes(tNorm) || tNorm.includes(cNorm)) return true;

        // Check alias mapping
        for (const [enKey, hiVal] of Object.entries(districtAliasMap)) {
          const hiNorm = normalizeDistrict(hiVal);
          const enNorm = normalizeDistrict(enKey);

          const matchesTarget = tNorm === enNorm || tNorm === hiNorm;
          const matchesCard = cNorm === enNorm || cNorm === hiNorm;

          if (matchesTarget && matchesCard) return true;
        }

        return false;
      }

      /* ===================================================
         DISTRICTS & QUICK PILLS INITIALIZATION
      ==================================================== */
      function getUniqueCardDistricts() {
        const distMap = {};
        videoCards.forEach(function (card) {
          const d = (card.dataset.district || "").trim();
          if (d) {
            distMap[d] = (distMap[d] || 0) + 1;
          }
        });
        return distMap;
      }

      function renderQuickDistrictPills() {
        if (!quickDistrictPills) return;
        quickDistrictPills.innerHTML = "";

        const distCounts = getUniqueCardDistricts();

        // 1. "All Districts" Pill
        const allPill = document.createElement("button");
