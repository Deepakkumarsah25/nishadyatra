      ==================================================== */
      const districtAliasMap = {
        gopalganj: "गोपालगंज",
        patna: "पटना",
        varanasi: "वाराणसी",
        bhopal: "भोपाल",
        ranchi: "रांची",
        lucknow: "लखनऊ",
        ayodhya: "अयोध्या",
        prayagraj: "प्रयागराज",
