<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Kalash Yatra Videos | Nishad Sankalp Campaign</title>
  <meta name="description" content="Videos, events, historic moments, and state-wise highlights of the sacred Kalash Yatra under Nishad Sankalp Campaign." />

  <!-- Google Fonts: Rozha One, Noto Serif Devanagari, Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Noto+Serif+Devanagari:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Rozha+One&display=swap" rel="stylesheet" />

  <!-- Common Navbar CSS -->
  <link rel="stylesheet" href="/css/common/navbar.css" />

  <style>
    /* =====================================================
       DESIGN TOKENS & SYSTEM
    ===================================================== */
    :root {
      /* Royal Crimson & Devotional Palette */
      --primary-crimson: #b91c1c;
      --crimson-dark: #991b1b;
      --crimson-deep: #7f1d1d;
      --crimson-ultra: #450a0a;
      --crimson-soft: rgba(185, 28, 28, 0.08);
      --crimson-glow: rgba(185, 28, 28, 0.22);

      /* Sacred Gold & Amber */
      --gold-primary: #d97706;
      --gold-dark: #b45309;
      --gold-light: #fbbf24;
      --gold-soft: #fef3c7;
      --gold-border: rgba(217, 119, 6, 0.25);

      /* Ivory & Canvas */
      --canvas: #fdfaf6;
      --canvas-alt: #f7f1e7;
      --surface-white: #ffffff;
      --surface-card: #ffffff;
      --border-warm: #ebdccf;
      --border-light: #f5ebe1;
      --border-focus: #b91c1c;

      /* Text Hierarchy */
      --text-main: #2b1818;
      --text-body: #5a4545;
      --text-muted: #846f6f;
      --text-light: #ab9898;

      /* Accents */
      --emerald: #15803d;
      --emerald-bg: #ecfdf5;

      /* Elevations */
      --shadow-sm: 0 4px 15px rgba(69, 10, 10, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(69, 10, 10, 0.08), 0 8px 10px -6px rgba(69, 10, 10, 0.04);
      --shadow-lg: 0 20px 45px -10px rgba(69, 10, 10, 0.12), 0 12px 20px -8px rgba(69, 10, 10, 0.06);
      --shadow-xl: 0 30px 70px -15px rgba(69, 10, 10, 0.20);
      --shadow-crimson: 0 12px 30px rgba(185, 28, 28, 0.28);
      --shadow-gold: 0 10px 25px rgba(217, 119, 6, 0.25);

      /* Radii */
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 28px;
      --radius-full: 9999px;

      --navbar-height: 64px;
    }

    /* Reset & Base */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: clip;
    }

    body {
      font-family: "Noto Sans Devanagari", "Plus Jakarta Sans", sans-serif;
      background-color: var(--canvas);
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(217, 119, 6, 0.035) 0%, transparent 40%),
        radial-gradient(circle at 90% 60%, rgba(185, 28, 28, 0.035) 0%, transparent 45%);
      background-attachment: fixed;
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: clip;
    }

    body.modal-open {
      overflow: hidden !important;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select {
      font-family: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
    }

    /* Container Standard */
    .container {
      width: min(1220px, 92%);
      margin: 0 auto;
    }

    /* =====================================================
       PAGE HEADER / HERO SECTION
    ===================================================== */
    .kalash-page {
      padding-top: var(--navbar-height);
    }

    .hero-wrapper {
      position: relative;
      overflow: hidden;
      background: linear-gradient(175deg, #fffdfa 0%, #fbf5ee 50%, #f4e7da 100%);
      border-bottom: 1px solid var(--border-warm);
      padding: 60px 0 80px;
    }

    /* Decorative background motifs */
    .hero-wrapper::before {
      content: "";
      position: absolute;
      top: -150px;
      right: -150px;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(217, 119, 6, 0.12) 0%, rgba(217, 119, 6, 0) 70%);
      pointer-events: none;
      z-index: 1;
    }

    .hero-wrapper::after {
      content: "";
      position: absolute;
      bottom: -120px;
      left: 10%;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(185, 28, 28, 0.08) 0%, rgba(185, 28, 28, 0) 70%);
      pointer-events: none;
      z-index: 1;
    }

    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 60px;
    }

    /* Left Content */
    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--gold-border);
      box-shadow: 0 4px 15px rgba(217, 119, 6, 0.12);
      font-size: 13px;
      font-weight: 700;
      color: var(--crimson-deep);
      margin-bottom: 24px;
      backdrop-filter: blur(10px);
    }

    .live-dot-pulse {
      position: relative;
      width: 10px;
      height: 10px;
      background: var(--primary-crimson);
      border-radius: 50%;
    }

    .live-dot-pulse::after {
      content: "";
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid var(--primary-crimson);
      animation: pulsePing 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes pulsePing {
      0% {
        transform: scale(0.9);
        opacity: 1;
      }
      80%, 100% {
        transform: scale(2.2);
        opacity: 0;
      }
    }

    .live-badge-divider {
      color: var(--gold-primary);
      opacity: 0.6;
    }

    .live-badge-sub {
      color: var(--gold-dark);
      font-weight: 600;
      font-size: 12px;
      letter-spacing: 0.3px;
    }

    .hero-heading {
      font-family: "Noto Serif Devanagari", "Rozha One", serif;
      font-size: clamp(38px, 4.8vw, 62px);
      line-height: 1.15;
      font-weight: 900;
      color: var(--crimson-ultra);
      letter-spacing: -0.8px;
      margin-bottom: 22px;
    }

    .hero-heading span.highlight {
      background: linear-gradient(135deg, #b91c1c 0%, #dc2626 50%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
      position: relative;
    }

    .hero-subheading {
      font-size: 17px;
      line-height: 1.8;
      color: var(--text-body);
      max-width: 580px;
      margin-bottom: 34px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-bottom: 40px;
    }

    .btn-primary-glow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 28px;
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      color: #ffffff;
      font-size: 15px;
      font-weight: 700;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-crimson);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .btn-primary-glow::after {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transform: skewX(-20deg);
      transition: left 0.6s ease;
    }

    .btn-primary-glow:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(185, 28, 28, 0.38);
      background: linear-gradient(135deg, #c72424 0%, #881515 100%);
    }

    .btn-primary-glow:hover::after {
      left: 140%;
    }

    .btn-secondary-glass {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 26px;
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid var(--border-warm);
      color: var(--crimson-ultra);
      font-size: 15px;
      font-weight: 700;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(10px);
      transition: all 0.25s ease;
    }

    .btn-secondary-glass:hover {
      background: #ffffff;
      border-color: var(--primary-crimson);
      color: var(--primary-crimson);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    /* Stats Strip */
    .hero-stats-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      width: 100%;
      max-width: 580px;
      padding-top: 24px;
      border-top: 1px solid rgba(217, 119, 6, 0.2);
    }

    .hero-stat-item {
      display: flex;
      flex-direction: column;
    }

    .hero-stat-number {
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 24px;
      font-weight: 800;
      color: var(--crimson-deep);
      line-height: 1.1;
    }

    .hero-stat-label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 600;
      margin-top: 4px;
    }

    /* Left 50% Sacred Highlights Pills */
    .hero-highlights-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 30px;
    }

    .hero-highlight-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 15px;
      border-radius: var(--radius-full);
      background: #ffffff;
      border: 1px solid var(--border-warm);
      box-shadow: 0 2px 8px rgba(69, 10, 10, 0.04);
      font-size: 13px;
      font-weight: 700;
      color: var(--crimson-deep);
      transition: all 0.25s ease;
    }

    .hero-highlight-pill:hover {
      border-color: var(--gold-primary);
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(217, 119, 6, 0.15);
    }

    .highlight-icon {
      font-size: 15px;
      line-height: 1;
    }

    /* =====================================================
       RIGHT 50%: CREATIVE IMAGE MONTAGE & SCENE SWITCHER
    ===================================================== */
    .hero-media-wrapper {
      position: relative;
    }

    .hero-gallery-montage {
      position: relative;
      padding-bottom: 6px;
    }

    /* Aura glow behind the montage */
    .hero-gallery-montage::before {
      content: "";
      position: absolute;
      top: 10%;
      left: 15%;
      width: 70%;
      height: 70%;
      background: radial-gradient(circle, rgba(217, 119, 6, 0.18) 0%, rgba(185, 28, 28, 0.1) 50%, transparent 70%);
      filter: blur(40px);
      z-index: 0;
      pointer-events: none;
    }

    /* Main Big Image Stage */
    .hero-main-stage {
      position: relative;
      z-index: 2;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: #1a0808;
      border: 5px solid #ffffff;
      box-shadow: 0 25px 60px -10px rgba(69, 10, 10, 0.22), 0 12px 25px rgba(0, 0, 0, 0.12);
      aspect-ratio: 16 / 11;
      transition: transform 0.4s ease;
    }

    .hero-main-stage:hover {
      transform: scale(1.015);
    }

    .hero-main-stage img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: opacity 0.35s ease, transform 0.6s ease;
    }

    .hero-main-stage:hover img {
      transform: scale(1.04);
    }

    .hero-stage-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, transparent 40%, rgba(20, 5, 5, 0.88) 100%);
      pointer-events: none;
    }

    .hero-stage-badge {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 3;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.95);
      color: var(--crimson-deep);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      backdrop-filter: blur(8px);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .hero-stage-badge svg {
      width: 13px;
      height: 13px;
      fill: var(--gold-primary);
    }

    .hero-stage-caption {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 18px;
      z-index: 3;
      color: #ffffff;
    }

    .hero-stage-caption h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 20px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 3px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    }

    .hero-stage-caption p {
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    }

    /* Floating Overlapping Mini Photo Cards */
    .hero-float-card {
      position: absolute;
      z-index: 4;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 3.5px solid #ffffff;
      box-shadow: 0 16px 35px rgba(0, 0, 0, 0.25);
      background: #150505;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    .hero-float-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }

    .hero-float-card:hover {
      transform: translateY(-6px) scale(1.06);
      box-shadow: 0 20px 45px rgba(185, 28, 28, 0.35);
      border-color: var(--gold-light);
    }

    .hero-float-card:hover img {
      transform: scale(1.1);
    }

    .hero-float-tag {
      position: absolute;
      bottom: 8px;
      left: 8px;
      right: 8px;
      padding: 4px 8px;
      border-radius: 6px;
      background: rgba(15, 4, 4, 0.88);
      backdrop-filter: blur(6px);
      color: #ffffff;
      font-size: 10.5px;
      font-weight: 700;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* Floating Card 1: Top Right */
    .hero-float-card.card-top-right {
      top: -22px;
      right: -22px;
      width: 148px;
      height: 108px;
    }

    /* Floating Card 2: Bottom Left */
    .hero-float-card.card-bottom-left {
      bottom: 40px;
      left: -24px;
      width: 142px;
      height: 104px;
    }

    /* Bottom Interactive Thumbnail Selector Strip */
    .hero-thumb-nav {
      position: relative;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .hero-thumb-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.9);
      border: 1.5px solid var(--border-warm);
      box-shadow: 0 3px 10px rgba(69, 10, 10, 0.05);
      color: var(--crimson-deep);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
      backdrop-filter: blur(8px);
    }

    .hero-thumb-btn img {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
      border: 1.5px solid var(--gold-primary);
    }

    .hero-thumb-btn:hover {
      background: #ffffff;
      border-color: var(--primary-crimson);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(185, 28, 28, 0.18);
    }

    .hero-thumb-btn.active {
      background: linear-gradient(135deg, var(--primary-crimson), var(--crimson-dark));
      border-color: var(--gold-light);
      color: #ffffff;
      box-shadow: 0 6px 20px rgba(185, 28, 28, 0.35);
    }

    .hero-thumb-btn.active img {
      border-color: #ffffff;
    }

    /* =====================================================
       YATRA VISUAL STORYCASE: IMAGES & TEXT SHOWCASE
    ===================================================== */
    .yatra-storycase-section {
      position: relative;
      background: linear-gradient(180deg, var(--canvas) 0%, #fbf5ee 50%, var(--canvas) 100%);
      padding: 40px 0 10px; /* Zero empty space at bottom */
      margin: 0;
    }

    .yatra-storycase-header {
      text-align: center;
      max-width: 900px;
      margin: 0 auto 32px;
      padding: 0 20px;
    }

    .storycase-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      background: var(--gold-soft);
      border: 1px solid var(--gold-border);
      border-radius: 999px;
      color: var(--gold-dark);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    .storycase-kicker-sep {
      color: var(--primary-crimson);
      font-weight: 900;
    }

    .storycase-kicker-sub {
      color: var(--primary-crimson);
      font-weight: 800;
    }

    .storycase-title {
      font-family: "Noto Serif Devanagari", "Rozha One", serif;
      font-size: clamp(26px, 3.2vw, 38px);
      font-weight: 900;
      color: var(--text-main);
      line-height: 1.25;
      margin-bottom: 12px;
    }

    .storycase-title span.highlight {
      color: var(--primary-crimson);
      position: relative;
      display: inline-block;
    }

    .storycase-sub {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.7;
      max-width: 820px;
      margin: 0 auto;
    }

    /* Container */
    .storycase-container {
      width: min(1280px, 94%);
      margin: 0 auto;
    }

    /* =====================================================
       FEATURED HERO STORY CARD (50/50 SPLIT)
    ===================================================== */
    .storycase-featured-card {
      background: #ffffff;
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-xl);
      box-shadow: 0 16px 40px rgba(69, 10, 10, 0.08);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      margin-bottom: 24px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .storycase-featured-card:hover {
      box-shadow: 0 22px 50px rgba(69, 10, 10, 0.14);
      border-color: var(--gold-light);
    }

    .storycase-featured-media {
      position: relative;
      min-height: 380px;
      background: #000000;
      overflow: hidden;
    }

    .storycase-featured-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .storycase-featured-card:hover .storycase-featured-img {
      transform: scale(1.04);
    }

    .storycase-featured-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.05) 50%, rgba(18,5,5,0.7) 100%);
      pointer-events: none;
    }

    .storycase-featured-badge {
      position: absolute;
      top: 18px;
      left: 18px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: rgba(185, 28, 28, 0.92);
      backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow: 0 4px 15px rgba(185, 28, 28, 0.4);
    }

    .storycase-featured-caption {
      position: absolute;
      bottom: 18px;
      left: 18px;
      right: 18px;
      color: #ffffff;
    }

    .storycase-featured-caption h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.3;
      margin-bottom: 4px;
      text-shadow: 0 2px 6px rgba(0,0,0,0.8);
    }

    .storycase-featured-caption p {
      font-size: 13px;
      color: #fce7cf;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Right Content Area */
    .storycase-featured-content {
      padding: 34px 30px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: linear-gradient(165deg, #ffffff 0%, #fffdfa 100%);
    }

    .storycase-meta-tag-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .storycase-tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
      background: var(--canvas-alt);
      color: var(--text-muted);
      border: 1px solid var(--border-light);
    }

    .storycase-tag-pill.crimson {
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      border-color: var(--crimson-glow);
    }

    .storycase-tag-pill.gold {
      background: var(--gold-soft);
      color: var(--gold-dark);
      border-color: var(--gold-border);
    }

    .storycase-featured-content h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 23px;
      font-weight: 900;
      color: var(--text-main);
      line-height: 1.35;
      margin-bottom: 12px;
    }

    .storycase-featured-content p {
      font-size: 14px;
      line-height: 1.75;
      color: var(--text-body);
      margin-bottom: 16px;
    }

    .storycase-pills-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 12px 14px;
      background: rgba(253, 250, 246, 0.9);
      border: 1px solid var(--border-warm);
      border-radius: var(--radius-md);
      margin-bottom: 18px;
    }

    .storycase-pill-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-main);
    }

    .storycase-pill-item .emoji {
      font-size: 14px;
      flex-shrink: 0;
    }

    .storycase-actions-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      padding-top: 14px;
      border-top: 1px dashed var(--border-warm);
    }

    .btn-storycase-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      color: #ffffff;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 700;
      box-shadow: 0 4px 14px rgba(185, 28, 28, 0.35);
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-storycase-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(185, 28, 28, 0.5);
    }

    .btn-storycase-outline {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--canvas-alt);
      border: 1.5px solid var(--border-warm);
      color: var(--text-main);
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 700;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-storycase-outline:hover {
      border-color: var(--gold-primary);
      color: var(--gold-dark);
      background: #ffffff;
    }

    /* =====================================================
       4-CARD SHOWCASE GRID
    ===================================================== */
    .storycase-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    .storycase-card {
      background: #ffffff;
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-lg);
      box-shadow: 0 8px 24px rgba(69, 10, 10, 0.05);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .storycase-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 36px rgba(69, 10, 10, 0.12);
      border-color: var(--gold-primary);
    }

    .storycase-card-thumb {
      position: relative;
      width: 100%;
      height: 190px;
      overflow: hidden;
      background: #180505;
    }

    .storycase-card-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }

    .storycase-card:hover .storycase-card-thumb img {
      transform: scale(1.08);
    }

    .storycase-card-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      background: rgba(18, 5, 5, 0.85);
      backdrop-filter: blur(6px);
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.18);
    }

    .storycase-card-body {
      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex-grow: 1;
      background: #ffffff;
    }

    .storycase-card-body h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 16.5px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.35;
      margin-bottom: 8px;
      transition: color 0.2s ease;
    }

    .storycase-card:hover .storycase-card-body h4 {
      color: var(--primary-crimson);
    }

    .storycase-card-body p {
      font-size: 13px;
      line-height: 1.65;
      color: var(--text-body);
      margin-bottom: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .storycase-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 10px;
      border-top: 1px solid var(--border-light);
    }

    .storycase-location-text {
      font-size: 11.5px;
      color: var(--text-muted);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .btn-card-filter-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      font-weight: 800;
      color: var(--primary-crimson);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-card-filter-link:hover {
      color: var(--crimson-dark);
      transform: translateX(3px);
    }

    /* =====================================================
       ZERO-GAP TRANSITION BAR
    ===================================================== */
    .storycase-transition-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 22px;
      background: linear-gradient(135deg, rgba(217, 119, 6, 0.08) 0%, rgba(185, 28, 28, 0.08) 100%);
      border: 1px solid var(--gold-border);
      border-radius: var(--radius-lg);
      margin-top: 6px;
      margin-bottom: 0;
    }

    .transition-text-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .transition-icon-circle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--primary-crimson);
      color: #ffffff;
      font-size: 15px;
      box-shadow: 0 4px 10px rgba(185, 28, 28, 0.3);
    }

    .transition-text-group h5 {
      font-size: 14px;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 2px;
    }

    .transition-text-group p {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .btn-jump-filter {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 16px;
      background: #ffffff;
      border: 1.5px solid var(--gold-primary);
      border-radius: var(--radius-sm);
      color: var(--gold-dark);
      font-size: 12.5px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .btn-jump-filter:hover {
      background: var(--gold-primary);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
    }

    /* Filter Console Section adjustments for seamless zero-gap connection */
    .filter-console-section {
      padding-top: 15px !important;
      margin-top: 0 !important;
    }

    /* =====================================================
       RESPONSIVE BREAKPOINTS
    ===================================================== */
    @media (max-width: 1100px) {
      .storycase-grid-4 {
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
      }
    }

    @media (max-width: 900px) {
      .storycase-featured-card {
        grid-template-columns: 1fr;
      }

      .storycase-featured-media {
        min-height: 280px;
      }

      .storycase-featured-content {
        padding: 24px 20px;
      }
    }

    @media (max-width: 600px) {
      .yatra-storycase-section {
        padding: 25px 0 10px;
      }

      .storycase-grid-4 {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .storycase-transition-bar {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
        padding: 14px;
      }

      .transition-text-group {
        flex-direction: column;
      }

      .btn-jump-filter {
        justify-content: center;
      }
    }

    /* =====================================================
       MOBILE FLOATING FILTER TAB & DRAWER
    ===================================================== */
    .mobile-filter-floating-tab {
      display: none;
      position: fixed;
      right: 0;
      top: 48%;
      transform: translateY(-50%);
      z-index: 2500;
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      color: #ffffff;
      border: 2px solid #ffffff;
      border-right: none;
      border-radius: 14px 0 0 14px;
      padding: 12px 9px;
      box-shadow: -4px 6px 20px rgba(185, 28, 28, 0.45);
      cursor: pointer;
      align-items: center;
      gap: 6px;
      writing-mode: vertical-rl;
      text-orientation: mixed;
      transition: all 0.25s ease;
    }

    .mobile-filter-floating-tab:hover, .mobile-filter-floating-tab:active {
      padding-right: 13px;
      background: var(--primary-crimson);
      box-shadow: -6px 8px 25px rgba(185, 28, 28, 0.6);
    }

    .tab-lines-icon {
      display: flex;
      flex-direction: column;
      gap: 3px;
      writing-mode: horizontal-tb;
    }

    .tab-lines-icon span {
      display: block;
      width: 14px;
      height: 2.2px;
      background: #ffffff;
      border-radius: 2px;
    }

    .tab-label-text {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .mobile-filter-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--gold-light);
      color: var(--crimson-ultra);
      font-size: 10px;
      font-weight: 900;
      writing-mode: horizontal-tb;
    }

    .mobile-filter-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 5, 5, 0.65);
      backdrop-filter: blur(8px);
      z-index: 2990;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-filter-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .drawer-mobile-close {
      display: none;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 700;
      cursor: pointer;
      border: none;
    }

    .drawer-apply-footer {
      display: none;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--border-light);
    }

    .btn-apply-drawer {
      width: 100%;
      height: 48px;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--primary-crimson), var(--crimson-dark));
      color: #ffffff;
      font-size: 15px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: var(--shadow-crimson);
      border: none;
      cursor: pointer;
    }

    .mobile-filter-inline-btn {
      display: none;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: var(--radius-full);
      background: var(--crimson-soft);
      border: 1px solid rgba(185, 28, 28, 0.2);
      color: var(--primary-crimson);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    /* =====================================================
       FILTER CONSOLE (SEARCH & CATEGORIES)
    ===================================================== */
    .filter-console-section {
      padding: 40px 0 20px;
    }

    .filter-card {
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid var(--border-warm);
      border-radius: var(--radius-xl);
      padding: 30px;
      box-shadow: var(--shadow-md);
      backdrop-filter: blur(15px);
    }

    .filter-header-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--border-light);
    }

    .filter-title-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .filter-icon-box {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .filter-icon-box svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    .filter-heading-text h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 20px;
      font-weight: 800;
      color: var(--crimson-ultra);
      line-height: 1.2;
    }

    .filter-heading-text p {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .filter-top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .count-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      border-radius: var(--radius-full);
      background: var(--canvas-alt);
      border: 1px solid var(--border-warm);
      font-size: 13px;
      font-weight: 700;
      color: var(--crimson-deep);
    }

    .count-indicator strong {
      color: var(--primary-crimson);
      font-size: 15px;
    }

    .btn-reset-filters {
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 700;
      color: var(--primary-crimson);
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-reset-filters:hover {
      background: var(--crimson-soft);
      text-decoration: underline;
    }

    /* Filter Form Grid */
    .filter-input-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1.35fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .form-group-custom {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group-custom label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .form-group-custom label svg {
      width: 14px;
      height: 14px;
      fill: var(--primary-crimson);
    }

    /* Select Box Wrapper */
    .custom-select-wrapper, .custom-input-wrapper {
      position: relative;
    }

    .styled-select, .styled-input {
      width: 100%;
      height: 48px;
      border-radius: var(--radius-md);
      border: 1.5px solid var(--border-warm);
      background: #ffffff;
      color: var(--text-main);
      font-size: 14px;
      font-weight: 500;
      padding: 0 16px;
      outline: none;
      transition: all 0.2s ease;
    }

    .styled-select {
      appearance: none;
      padding-right: 40px;
      cursor: pointer;
    }

    .styled-select:focus, .styled-input:focus {
      border-color: var(--primary-crimson);
      box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.12);
    }

    .styled-select:disabled {
      background: #f5ede6;
      color: #a49187;
      cursor: not-allowed;
      border-color: #eeddd2;
    }

    /* Dropdown Chevron SVG */
    .select-arrow {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      color: var(--text-muted);
      display: flex;
      align-items: center;
    }

    .select-arrow svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    /* Search input icon */
    .search-icon-inside {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
      display: flex;
      align-items: center;
    }

    .search-icon-inside svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .styled-input.with-icon {
      padding-left: 42px;
      padding-right: 36px;
    }

    .search-clear-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--canvas-alt);
      color: var(--text-muted);
      display: none;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      cursor: pointer;
    }

    .search-clear-btn.visible {
      display: flex;
    }

    /* Category Buttons Strip */
    .category-nav-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding-top: 18px;
      border-top: 1px dashed var(--border-warm);
    }

    .category-nav-label {
      font-size: 12px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-right: 6px;
    }

    .pill-category-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      border-radius: var(--radius-full);
      background: #ffffff;
      border: 1.5px solid var(--border-warm);
      color: var(--text-body);
      font-size: 13px;
      font-weight: 700;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pill-category-btn svg {
      width: 15px;
      height: 15px;
      fill: currentColor;
    }

    .pill-category-btn:hover {
      border-color: var(--primary-crimson);
      color: var(--primary-crimson);
      transform: translateY(-1px);
    }

    .pill-category-btn.active {
      background: linear-gradient(135deg, var(--primary-crimson) 0%, var(--crimson-dark) 100%);
      border-color: var(--primary-crimson);
      color: #ffffff;
      box-shadow: 0 4px 15px rgba(185, 28, 28, 0.25);
    }

    .category-badge-count {
      padding: 2px 7px;
      border-radius: var(--radius-full);
      background: rgba(0, 0, 0, 0.08);
      font-size: 11px;
      font-weight: 800;
    }

    .pill-category-btn.active .category-badge-count {
      background: rgba(255, 255, 255, 0.25);
      color: #ffffff;
    }

    /* Active Filter Chips Container */
    .active-chips-tray {
      display: none;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--border-light);
    }

    .active-chips-tray.show {
      display: flex;
    }

    .active-chip-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px;
      border-radius: var(--radius-full);
      background: var(--crimson-soft);
      border: 1px solid rgba(185, 28, 28, 0.15);
      color: var(--crimson-deep);
      font-size: 12px;
      font-weight: 700;
      animation: chipPop 0.2s ease;
    }

    @keyframes chipPop {
      0% {
        transform: scale(0.9);
        opacity: 0;
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    .active-chip-remove {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(185, 28, 28, 0.12);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .active-chip-remove:hover {
      background: var(--primary-crimson);
      color: #ffffff;
    }

    /* =====================================================
       VIDEO GALLERY SECTION
    ===================================================== */
    .gallery-section {
      padding: 40px 0 80px;
    }

    .gallery-header-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 30px;
    }

    .gallery-section-title {
      font-family: "Noto Serif Devanagari", serif;
      font-size: clamp(26px, 3.2vw, 36px);
      font-weight: 900;
      color: var(--crimson-ultra);
      line-height: 1.2;
    }

    .gallery-section-subtitle {
      font-size: 15px;
      color: var(--text-body);
      margin-top: 6px;
    }

    /* 3-Column Video Card Grid */
    .video-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .video-card-item {
      background: var(--surface-card);
      border: 1px solid var(--border-warm);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      cursor: pointer;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .video-card-item:hover {
      transform: translateY(-7px);
      box-shadow: var(--shadow-lg);
      border-color: rgba(185, 28, 28, 0.28);
    }

    .video-card-item.hidden {
      display: none !important;
    }

    /* Card Thumbnail Box */
    .card-media-box {
      position: relative;
      height: 220px;
      overflow: hidden;
      background: #231212;
    }

    .card-media-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .video-card-item:hover .card-media-box img {
      transform: scale(1.07);
    }

    .card-gradient-vignette {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, transparent 40%, rgba(0, 0, 0, 0.7) 100%);
      pointer-events: none;
    }

    /* Center Play Ripple on Hover */
    .card-play-symbol {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 3;
    }

    .card-play-symbol svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
      margin-left: 3px;
    }

    .video-card-item:hover .card-play-symbol {
      transform: translate(-50%, -50%) scale(1.15);
      background: var(--primary-crimson);
      color: #ffffff;
      box-shadow: 0 10px 30px rgba(185, 28, 28, 0.5);
    }

    /* Badges on Thumbnail */
    .badge-location-corner {
      position: absolute;
      bottom: 12px;
      left: 12px;
      z-index: 3;
      padding: 4px 10px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.94);
      color: var(--crimson-ultra);
      font-size: 11px;
      font-weight: 800;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      backdrop-filter: blur(6px);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .badge-location-corner svg {
      width: 12px;
      height: 12px;
      fill: var(--primary-crimson);
    }

    .badge-duration-corner {
      position: absolute;
      bottom: 12px;
      right: 12px;
      z-index: 3;
      padding: 4px 8px;
      border-radius: var(--radius-sm);
      background: rgba(15, 6, 6, 0.85);
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      backdrop-filter: blur(6px);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .badge-duration-corner svg {
      width: 11px;
      height: 11px;
      fill: var(--gold-light);
    }

    /* Card Text Content */
    .card-info-box {
      padding: 22px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .card-tags-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 10px;
    }

    .card-category-tag {
      color: var(--primary-crimson);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .card-state-tag {
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 600;
    }

    .card-title-text {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 18px;
      font-weight: 800;
      color: var(--crimson-ultra);
      line-height: 1.38;
      margin-bottom: 10px;
      transition: color 0.2s ease;
    }

    .video-card-item:hover .card-title-text {
      color: var(--primary-crimson);
    }

    .card-description-text {
      font-size: 13px;
      line-height: 1.65;
      color: var(--text-body);
      margin-bottom: 18px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      flex: 1;
    }

    .card-footer-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      border-top: 1px solid var(--border-light);
      font-size: 12px;
      color: var(--text-muted);
    }

    .card-footer-date {
      display: flex;
      align-items: center;
      gap: 5px;
      font-weight: 600;
    }

    .card-footer-date svg {
      width: 13px;
      height: 13px;
      fill: currentColor;
    }

    .card-cta-link {
      color: var(--primary-crimson);
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: transform 0.2s ease;
    }

    .video-card-item:hover .card-cta-link {
      transform: translateX(3px);
    }

    /* =====================================================
       EMPTY STATE
    ===================================================== */
    .empty-state-card {
      display: none;
      grid-column: 1 / -1;
      background: rgba(255, 255, 255, 0.85);
      border: 2px dashed var(--border-warm);
      border-radius: var(--radius-xl);
      padding: 60px 30px;
      text-align: center;
      backdrop-filter: blur(10px);
    }

    .empty-state-card.show {
      display: block;
    }

    .empty-symbol-icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }

    .empty-symbol-icon svg {
      width: 32px;
      height: 32px;
      fill: currentColor;
    }

    .empty-state-card h3 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 22px;
      font-weight: 800;
      color: var(--crimson-ultra);
      margin-bottom: 8px;
    }

    .empty-state-card p {
      font-size: 14px;
      color: var(--text-body);
      max-width: 480px;
      margin: 0 auto 22px;
    }

    .btn-empty-clear {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: var(--primary-crimson);
      color: #ffffff;
      font-size: 14px;
      font-weight: 700;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-crimson);
      transition: all 0.2s ease;
    }

    .btn-empty-clear:hover {
      background: var(--crimson-dark);
      transform: translateY(-2px);
    }

    /* =====================================================
       CREATIVE SECTION: PILLARS & VISUAL STORY SHOWCASE
    ===================================================== */
    .pillars-showcase-section {
      margin-top: 60px;
      padding: 40px 0 20px;
      position: relative;
    }

    .pillars-header-block {
      text-align: center;
      max-width: 820px;
      margin: 0 auto 46px;
    }

    .pillars-kicker-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 18px;
      border-radius: var(--radius-full);
      background: var(--gold-soft);
      border: 1px solid var(--gold-border);
      color: var(--crimson-deep);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.5px;
      margin-bottom: 16px;
    }

    .pillars-kicker-tag svg {
      width: 14px;
      height: 14px;
      fill: var(--gold-dark);
    }

    .pillars-main-title {
      font-family: "Noto Serif Devanagari", "Rozha One", serif;
      font-size: clamp(28px, 3.8vw, 44px);
      line-height: 1.25;
      font-weight: 900;
      color: var(--crimson-ultra);
      letter-spacing: -0.5px;
      margin-bottom: 14px;
    }

    .pillars-main-title span.accent {
      background: linear-gradient(135deg, #b91c1c 0%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .pillars-subtitle {
      font-size: 15px;
      line-height: 1.8;
      color: var(--text-body);
    }

    /* Master 2-Column Grid */
    .pillars-content-grid {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 34px;
      align-items: stretch;
      margin-bottom: 0;
    }

    /* Left Column: Visual Story Collage */
    .visual-story-column {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .story-card-primary {
      position: relative;
      border-radius: var(--radius-xl);
      overflow: hidden;
      aspect-ratio: 16 / 10.5;
      background: var(--crimson-ultra);
      border: 4px solid #ffffff;
      box-shadow: var(--shadow-lg);
      cursor: pointer;
    }

    .story-card-primary img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .story-card-primary:hover img {
      transform: scale(1.06);
    }

    .story-overlay-grad {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, transparent 40%, rgba(20, 5, 5, 0.88) 100%);
      pointer-events: none;
    }

    .story-floating-badge {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 3;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.95);
      color: var(--crimson-deep);
      font-size: 11px;
      font-weight: 800;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      backdrop-filter: blur(8px);
    }

    .story-floating-badge svg {
      width: 13px;
      height: 13px;
      fill: var(--gold-primary);
    }

    .story-caption-block {
      position: absolute;
      left: 22px;
      right: 22px;
      bottom: 20px;
      z-index: 3;
      color: #ffffff;
    }

    .story-caption-block h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 21px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 4px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    }

    .story-caption-block p {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.5;
    }

    /* Dual Secondary Cards */
    .story-cards-dual {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .story-card-sub {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      aspect-ratio: 4 / 3.1;
      background: #1f0b0b;
      border: 3px solid #ffffff;
      box-shadow: var(--shadow-md);
      cursor: pointer;
    }

    .story-card-sub img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .story-card-sub:hover img {
      transform: scale(1.08);
    }

    .story-card-sub .story-overlay-grad {
      background: linear-gradient(180deg, transparent 35%, rgba(20, 5, 5, 0.9) 100%);
    }

    .story-sub-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 3;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.95);
      color: var(--crimson-deep);
      font-size: 10px;
      font-weight: 800;
    }

    .story-sub-caption {
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 14px;
      z-index: 3;
      color: #ffffff;
    }

    .story-sub-caption h5 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 2px;
    }

    .story-sub-caption p {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.85);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Right Column: 4 Sacred Pillars Cards */
    .pillars-list-column {
      display: flex;
      flex-direction: column;
      gap: 14px;
      justify-content: space-between;
    }

    .pillar-interactive-card {
      background: rgba(255, 255, 255, 0.94);
      border: 1.5px solid var(--border-warm);
      border-radius: var(--radius-lg);
      padding: 20px 22px;
      box-shadow: var(--shadow-sm);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .pillar-interactive-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--gold-primary), var(--primary-crimson));
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .pillar-interactive-card:hover {
      transform: translateX(6px);
      border-color: var(--gold-primary);
      background: #ffffff;
      box-shadow: var(--shadow-md);
    }

    .pillar-interactive-card:hover::before {
      opacity: 1;
    }

    .pillar-card-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }

    .pillar-num-badge {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
      color: #ffffff;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 13px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
    }

    .pillar-icon-symbol {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      background: var(--crimson-soft);
      color: var(--primary-crimson);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .pillar-icon-symbol svg {
      width: 19px;
      height: 19px;
      fill: currentColor;
    }

    .pillar-card-head h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 17px;
      font-weight: 800;
      color: var(--crimson-ultra);
      line-height: 1.25;
    }

    .pillar-card-body p {
      font-size: 13px;
      line-height: 1.7;
      color: var(--text-body);
      padding-left: 48px;
    }



    /* =====================================================
       VIDEO MODAL POPUP
    ===================================================== */
    .video-modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: rgba(15, 5, 5, 0.92);
      backdrop-filter: blur(12px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .video-modal-backdrop.active {
      display: flex;
      opacity: 1;
    }

    .modal-content-shell {
      position: relative;
      width: min(1040px, 98%);
      background: #150909;
      border: 1px solid rgba(217, 119, 6, 0.3);
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: 0 35px 90px rgba(0, 0, 0, 0.7);
      transform: scale(0.92);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .video-modal-backdrop.active .modal-content-shell {
      transform: scale(1);
    }

    .modal-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px;
      background: #200e0e;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      color: #ffffff;
    }

    .modal-title-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      overflow: hidden;
    }

    .modal-title-wrap h4 {
      font-family: "Noto Serif Devanagari", serif;
      font-size: 17px;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 600px;
    }

    .modal-actions-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .modal-share-btn {
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 0.2s ease;
    }

    .modal-share-btn:hover {
      background: var(--primary-crimson);
    }

    .modal-close-cross {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      transition: all 0.2s ease;
    }

    .modal-close-cross:hover {
      background: var(--primary-crimson);
      transform: rotate(90deg);
    }

    .modal-video-frame-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000000;
    }

    .modal-video-frame-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    /* Toast Notification for Link Copied */
    .toast-notification {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 100000;
      background: var(--crimson-ultra);
      color: #ffffff;
      border: 1px solid var(--gold-light);
      padding: 12px 20px;
      border-radius: var(--radius-md);
      font-size: 14px;
      font-weight: 700;
      box-shadow: var(--shadow-xl);
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .toast-notification.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* =====================================================
       RESPONSIVE BREAKPOINTS
    ===================================================== */
    @media (max-width: 1060px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 45px;
      }

      .hero-content {
        align-items: center;
        text-align: center;
      }

      .hero-subheading {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-highlights-list {
        justify-content: center;
      }

      .hero-actions {
        justify-content: center;
      }

      .hero-stats-strip {
        margin: 0 auto;
      }

      .hero-media-wrapper {
        max-width: 620px;
        margin: 0 auto;
        width: 100%;
      }

      .hero-float-card.card-top-right {
        top: -16px;
        right: -10px;
        width: 132px;
        height: 98px;
      }

      .hero-float-card.card-bottom-left {
        bottom: 38px;
        left: -10px;
        width: 128px;
        height: 94px;
      }

      .filter-input-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      /* Keep 2-column pinned stage down to 920px */
      .scrolly-yatra-grid {
        gap: 24px;
      }

      .video-cards-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
      }
    }

    @media (max-width: 860px) {
      /* Mobile Floating Filter Tab on Right Screen Edge */
      .mobile-filter-floating-tab {
        display: flex;
      }

      .mobile-filter-backdrop {
        display: block;
      }

      .drawer-mobile-close {
        display: flex;
      }

      .drawer-apply-footer {
        display: block;
      }

      /* Slide-out Filter Console Drawer */
      .filter-console-section {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(390px, 92vw);
        height: 100dvh;
        z-index: 3000;
        padding: 0;
        transform: translate3d(105%, 0, 0);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }

      .filter-console-section.drawer-open {
        transform: translate3d(0, 0, 0);
        pointer-events: auto;
      }

      .filter-console-section .container {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        max-width: 100%;
      }

      .filter-card {
        height: 100%;
        border-radius: 24px 0 0 24px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        padding: 24px 20px 40px;
        box-shadow: -15px 0 50px rgba(0, 0, 0, 0.45);
        border: 2px solid var(--gold-border);
        border-right: none;
      }

      .scrolly-pips-nav {
        justify-content: flex-start;
      }

      .thumb-label-mini {
        font-size: 9px;
      }

      /* Mobile UI: Images on TOP, Right side Text boxes BELOW */
      .pillars-content-grid {
        grid-template-columns: 1fr !important;
        gap: 28px;
      }

      .visual-story-column {
        order: 1 !important;
        width: 100%;
      }

      .pillars-list-column {
        order: 2 !important;
        width: 100%;
        gap: 14px;
      }
    }

    @media (max-width: 768px) {
      .hero-wrapper {
        padding: 40px 0 60px;
      }

      .hero-heading {
        font-size: 34px;
      }

      .hero-stats-strip {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }

      .hero-float-card.card-top-right,
      .hero-float-card.card-bottom-left {
        display: none;
      }

      .hero-thumb-nav {
        gap: 8px;
      }

      .hero-thumb-btn {
        padding: 5px 12px;
        font-size: 11px;
      }

      .filter-card {
        padding: 20px;
      }

      .filter-header-bar {
        flex-direction: column;
        align-items: flex-start;
      }

      .filter-top-actions {
        width: 100%;
        justify-content: space-between;
      }

      .filter-input-grid {
        grid-template-columns: 1fr;
      }

      .category-nav-bar {
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 8px;
        -webkit-overflow-scrolling: touch;
      }

      .pill-category-btn {
        flex-shrink: 0;
      }

      .video-cards-grid {
        grid-template-columns: 1fr;
      }

      .pillars-showcase-section {
        margin-top: 40px;
        padding: 30px 0 10px;
      }

      .pillars-header-block {
        margin-bottom: 28px;
      }

      .pillars-main-title {
        font-size: 26px;
      }

      .story-card-primary {
        aspect-ratio: 16 / 10;
        border-width: 3px;
        border-radius: 18px;
      }

      .story-caption-block {
        left: 16px;
        right: 16px;
        bottom: 16px;
      }

      .story-caption-block h4 {
        font-size: 18px;
      }

      .story-caption-block p {
        font-size: 12.5px;
      }

      .pillar-interactive-card {
        padding: 16px 18px;
      }

      .pillar-card-head h4 {
        font-size: 16px;
      }

      .pillar-card-body p {
        padding-left: 0;
        margin-top: 6px;
        font-size: 13px;
      }


    }

    @media (max-width: 480px) {
      .hero-heading {
        font-size: 29px;
      }

      .hero-actions {
        flex-direction: column;
        width: 100%;
      }

      .btn-primary-glow, .btn-secondary-glass {
        width: 100%;
      }

      .hero-stage-caption h3 {
        font-size: 17px;
      }

      .hero-stage-caption p {
        font-size: 11.5px;
      }

      .hero-thumb-btn {
        padding: 4px 10px;
        font-size: 10px;
      }

      .hero-thumb-btn img {
        width: 20px;
        height: 20px;
      }

      .scrolly-center-play-btn {
        width: 58px;
        height: 58px;
      }

      .scrolly-center-play-btn svg {
        width: 22px;
        height: 22px;
      }

      .scrolly-sticky-footer {
        flex-direction: column;
        align-items: stretch;
      }

      .scrolly-pips-nav {
        gap: 6px;
      }

      .scrolly-pip-btn {
        padding: 5px 11px;
        font-size: 11px;
      }

      .pillars-showcase-section {
        margin-top: 30px;
        padding: 20px 0 10px;
      }

      .pillars-main-title {
        font-size: 22px;
      }

      .pillars-subtitle {
        font-size: 13px;
        line-height: 1.6;
      }

      .story-card-primary {
        aspect-ratio: 16 / 10.5;
        border-radius: 14px;
      }

      .story-floating-badge {
        top: 10px;
        left: 10px;
        padding: 4px 10px;
        font-size: 10.5px;
      }

      .story-caption-block {
        left: 12px;
        right: 12px;
        bottom: 12px;
      }

      .story-caption-block h4 {
        font-size: 16px;
      }

      .story-caption-block p {
        font-size: 11.5px;
        line-height: 1.4;
      }

      .story-cards-dual {
        gap: 10px;
      }

      .story-card-sub {
        border-radius: 12px;
        border-width: 2px;
        aspect-ratio: 4 / 3.2;
      }

      .story-sub-tag {
        top: 6px;
        left: 6px;
        padding: 2px 7px;
        font-size: 8.5px;
      }

      .story-sub-caption {
        left: 8px;
        right: 8px;
        bottom: 8px;
      }

      .story-sub-caption h5 {
        font-size: 12px;
      }

      .story-sub-caption p {
        font-size: 9.5px;
      }

      .pillar-interactive-card {
        padding: 14px;
        border-radius: 14px;
      }

      .pillar-num-badge {
        width: 30px;
        height: 30px;
        font-size: 11px;
      }

      .pillar-icon-symbol {
        width: 30px;
        height: 30px;
      }

      .pillar-card-head h4 {
        font-size: 14.5px;
      }

      .pillar-card-body p {
        font-size: 12px;
        line-height: 1.55;
      }
    }
  </style>
</head>

<body>

  <!-- =====================================================
       NAVBAR
  ===================================================== -->
  <%- include("../common/navbar.ejs") %>

  <!-- =====================================================
       MAIN PAGE
  ===================================================== -->
  <main class="kalash-page">

    <!-- ===================================================
         HERO SECTION: 50/50 CONTENT & CREATIVE IMAGE SHOWCASE
    ==================================================== -->
    <section class="hero-wrapper" id="hero">
      <div class="container hero-grid">

        <!-- Left 50%: Structured Content -->
        <div class="hero-content">
          <div class="live-badge">
            <span class="live-dot-pulse"></span>
            <span><%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.liveBadgeText) ? kalash.hero.liveBadgeText : 'Nishad Sankalp Campaign • Kalash Yatra Special Video Highlights' %></span>
          </div>

          <h1 class="hero-heading">
            <%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.headingMain) ? kalash.hero.headingMain : 'Sacred Confluence of Faith, Unity & Resolve —' %> <span class="highlight"><%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.headingHighlight) ? kalash.hero.headingHighlight : 'Kalash Yatra' %></span>
          </h1>

          <p class="hero-subheading">
            <%= (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.subheading) ? kalash.hero.subheading : 'Historic Kalash Yatras organized to unite communities and awaken collective resolve. Explore videos and sacred memories by state and district.' %>
          </p>

          <!-- Sacred Highlights Pills -->
          <div class="hero-highlights-list">
            <% const heroHighlights = (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.highlights && kalash.hero.highlights.length > 0) ? kalash.hero.highlights : ['Sacred Water Pledge', 'Women Empowerment Wave', 'Community Dignity']; %>
            <% heroHighlights.forEach((hl, hIdx) => { %>
              <div class="hero-highlight-pill">
                <span class="highlight-icon"><%= hIdx === 0 ? '🪔' : (hIdx === 1 ? '🚩' : '🤝') %></span>
                <span><%= hl %></span>
              </div>
            <% }) %>
          </div>

          <div class="hero-actions">
            <a href="#videoGallery" class="btn-primary-glow">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z"/>
              </svg>
              <span>Watch Video Collection</span>
            </a>

            <a href="#filterConsole" class="btn-secondary-glass" id="heroFilterTrigger">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12 2.5a7.2 7.2 0 0 0-7.2 7.2c0 5.2 7.2 11.8 7.2 11.8s7.2-6.6 7.2-11.8A7.2 7.2 0 0 0 12 2.5zm0 9.9a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4z"/>
              </svg>
              <span>Select State & District</span>
            </a>
          </div>

          <!-- Quick Stats Strip -->
          <div class="hero-stats-strip">
            <% const heroStats = (typeof kalash !== 'undefined' && kalash.hero && kalash.hero.stats && kalash.hero.stats.length > 0) ? kalash.hero.stats : [
                 { number: '150+', label: 'Districts Joined' },
                 { number: '50,000+', label: 'Mangal Kalash Rituals' },
                 { number: '10,000+', label: 'Women Participants' },
                 { number: '28+', label: 'States Reached' }
               ]; %>
            <% heroStats.forEach((st) => { %>
              <div class="hero-stat-item">
                <span class="hero-stat-number"><%= st.number %></span>
                <span class="hero-stat-label"><%= st.label %></span>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Right 50%: Creative Image Montage & Scene Switcher -->
        <div class="hero-media-wrapper">
          <div class="hero-gallery-montage">

            <!-- Main Big Stage Image -->
            <div class="hero-main-stage" id="heroMainStage">
              <img
                src="/images/kalash-yatra-hero.jpg"
                alt="Kalash Yatra Grand Procession"
                id="heroMainStageImg"
                loading="eager"
              />
              <div class="hero-stage-overlay"></div>

              <div class="hero-stage-badge">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                <span id="heroStageBadgeText">Grand Highlights • 2026</span>
              </div>

              <div class="hero-stage-caption">
                <h3 id="heroStageTitle">Women's Sacred Kalash Pledge</h3>
                <p id="heroStageDesc">From Gopalganj to Kashi — A grand movement of social unity and dignity</p>
              </div>
            </div>

            <!-- Overlapping Floating Card 1: Sacred Kalash Ritual -->
            <div
              class="hero-float-card card-top-right"
              data-img="/images/sacred-kalash-ritual.jpg"
              data-badge="Sacred Ritual • 2026"
              data-title="Sacred Kalash & Lamp Worship"
              data-desc="Sacred Kalash consecration with Vedic chants for community welfare"
              title="Click to view main image"
            >
              <img src="/images/sacred-kalash-ritual.jpg" alt="Sacred Kalash and Lamp Worship" loading="lazy" />
              <span class="hero-float-tag">🪔 Kalash Worship</span>
            </div>

            <!-- Overlapping Floating Card 2: Ghat Procession -->
            <div
              class="hero-float-card card-bottom-left"
              data-img="/images/ghat-kalash-procession.jpg"
              data-badge="Sacred Confluence • 2026"
              data-title="Water Pledge at Sacred Ghats"
              data-desc="Historic water pledge by devotees at sunrise"
              title="Click to view main image"
            >
              <img src="/images/ghat-kalash-procession.jpg" alt="Water Pledge at Sacred Ghats" loading="lazy" />
              <span class="hero-float-tag">🌊 Ghat Pledge</span>
            </div>

            <!-- Interactive Scene Switcher Strip -->
            <div class="hero-thumb-nav" id="heroThumbNav">
              <button
                type="button"
                class="hero-thumb-btn active"
                data-img="/images/kalash-yatra-hero.jpg"
                data-badge="Grand Highlights • 2026"
                data-title="Women's Sacred Kalash Pledge"
                data-desc="From Gopalganj to Kashi — A grand movement of social unity and dignity"
              >
                <img src="/images/kalash-yatra-hero.jpg" alt="Procession" />
                <span>🚩 Procession</span>
              </button>

              <button
                type="button"
                class="hero-thumb-btn"
                data-img="/images/sacred-kalash-ritual.jpg"
                data-badge="Sacred Ritual • 2026"
                data-title="Sacred Kalash & Lamp Worship"
                data-desc="Sacred Kalash consecration with Vedic chants for community welfare"
              >
                <img src="/images/sacred-kalash-ritual.jpg" alt="Kalash Worship" />
                <span>🪔 Kalash Worship</span>
              </button>

              <button
                type="button"
                class="hero-thumb-btn"
                data-img="/images/ghat-kalash-procession.jpg"
                data-badge="Sacred Confluence • 2026"
                data-title="Water Pledge at Sacred Ghats"
                data-desc="Historic water pledge by devotees at sunrise"
              >
                <img src="/images/ghat-kalash-procession.jpg" alt="Ghat Pledge" />
                <span>🌊 Ghat Pledge</span>
              </button>

              <button
                type="button"
                class="hero-thumb-btn"
                data-img="/images/kalash-yatra-featured.jpg"
                data-badge="Grand Gathering • 2026"
                data-title="Historic Kalash Yatra Gathering"
                data-desc="Gathering of thousands of women and community members"
              >
                <img src="/images/kalash-yatra-featured.jpg" alt="Grand Gathering" />
                <span>👥 Grand Gathering</span>
              </button>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ===================================================
         YATRA VISUAL STORYCASE: IMAGES & TEXT SHOWCASE
    ==================================================== -->
    <section class="yatra-storycase-section" id="featuredShowcase">

      <!-- Section Header -->
      <div class="yatra-storycase-header">
        <div class="storycase-kicker">
          <span>★</span>
          <span>Sacred Memories • Nishad Sankalp Campaign</span>
          <span class="storycase-kicker-sep">•</span>
          <span class="storycase-kicker-sub">Historic Confluence</span>
        </div>

        <h2 class="storycase-title">
          Kalash Yatra Epic — Dimensions of <span class="highlight">Faith, Dignity & Social Unity</span>
        </h2>

        <p class="storycase-sub">
          Living glimpses of social empowerment and sacred memories from the historic Kalash Yatra across regions, powered by devotion and community solidarity.
        </p>
      </div>

      <div class="storycase-container">

        <% const featMilestone = (typeof kalash !== 'undefined' && kalash.milestonesSection && kalash.milestonesSection.items && kalash.milestonesSection.items.length > 0) ? kalash.milestonesSection.items[0] : null; %>
        <% if (featMilestone) { %>
        <!-- 1. Featured Big Story Card -->
        <article class="storycase-featured-card">
          <div class="storycase-featured-media">
            <img
              src="<%= featMilestone.image %>"
              alt="<%= featMilestone.title %>"
              class="storycase-featured-img"
              loading="lazy"
            />
            <div class="storycase-featured-overlay"></div>
            <div class="storycase-featured-badge">
              <span><%= featMilestone.tag || '★ Main Center • Historic Milestone' %></span>
            </div>
            <div class="storycase-featured-caption">
              <h4><%= featMilestone.title %></h4>
              <p>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                </svg>
                <span><%= featMilestone.district %>, <%= featMilestone.stateName %> • Grand Movement</span>
              </p>
            </div>
          </div>

          <div class="storycase-featured-content">
            <div>
              <div class="storycase-meta-tag-row">
                <span class="storycase-tag-pill crimson"><%= featMilestone.stateName %> • <%= featMilestone.district %></span>
                <span class="storycase-tag-pill gold"><%= featMilestone.tag || 'Special Memoir' %></span>
              </div>

              <h3><%= featMilestone.title %></h3>

              <p><%= featMilestone.description %></p>
            </div>

            <div class="storycase-actions-row">
              <button type="button" class="btn-storycase-primary btn-jump-filter-state" data-state="<%= featMilestone.stateKey %>">
                <span><%= featMilestone.stateName %>  Videos ↓</span>
              </button>
              <button type="button" class="btn-storycase-outline btn-watch-featured" data-video="<%= featMilestone.videoUrl %>" data-title="<%= featMilestone.title %>">
                <span>Watch Highlights ▶</span>
              </button>
            </div>
          </div>
        </article>
        <% } %>

        <!-- 2. Four Complementary Visual Story Cards -->
        <div class="storycase-grid-4">
          <% const subMilestones = (typeof kalash !== 'undefined' && kalash.milestonesSection && kalash.milestonesSection.items && kalash.milestonesSection.items.length > 1) ? kalash.milestonesSection.items.slice(1) : []; %>
          <% subMilestones.forEach((item) => { %>
            <article class="storycase-card">
              <div class="storycase-card-thumb">
                <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy" />
                <span class="storycase-card-tag"><%= item.stateName %> • <%= item.district %></span>
              </div>
              <div class="storycase-card-body">
                <div>
                  <h4><%= item.title %></h4>
                  <p><%= item.description %></p>
                </div>
                <div class="storycase-card-footer">
                  <span class="storycase-location-text"><%= item.district %>, <%= item.stateName %></span>
                  <span class="btn-card-filter-link btn-jump-filter-state" data-state="<%= item.stateKey %>">Watch Videos →</span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- 3. Seamless Transition Ribbon connecting into Filter Console (NO GAP) -->
        <div class="storycase-transition-bar">
          <div class="transition-text-group">
            <div class="transition-icon-circle">🎥</div>
            <div>
              <h5>All Kalash Yatra videos and addresses are available below</h5>
              <p>Select state, district, or category to watch your preferred video instantly</p>
            </div>
          </div>
          <button type="button" class="btn-jump-filter" id="btnJumpToFilter">
            <span>Video Filter & Search Center ↓</span>
          </button>
        </div>

      </div>

    </section>

    <!-- ===================================================
         MOBILE FLOATING FILTER TAB & DRAWER OVERLAY
    ==================================================== -->
    <button type="button" class="mobile-filter-floating-tab" id="mobileFilterTab" aria-label="Open video filters">
      <div class="tab-lines-icon">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span class="tab-label-text">Filter</span>
      <span class="mobile-filter-badge" id="mobileFilterBadge">6</span>
    </button>

    <div class="mobile-filter-backdrop" id="mobileFilterBackdrop"></div>

    <!-- ===================================================
         FILTER CONSOLE (SEARCH, STATE, DISTRICT, SORT)
    ==================================================== -->
    <section class="filter-console-section" id="filterConsole">
      <div class="container">
        <div class="filter-card">

          <!-- Filter Top Bar -->
          <div class="filter-header-bar">
            <div class="filter-title-group">
              <div class="filter-icon-box">
                <svg viewBox="0 0 24 24">
                  <path d="M3 4h18v2H3V4zm3 7h12v2H6v-2zm4 7h4v2h-4v-2z"/>
                </svg>
              </div>
              <div class="filter-heading-text">
                <h3>Video Search & Filter Center</h3>
                <p>Find desired videos quickly by selecting state, district, category, or title keyword</p>
              </div>
            </div>

            <div class="filter-top-actions">
              <div class="count-indicator">
                <span>Showing:</span>
                <strong id="resultCount">6</strong>
                <span>Videos</span>
              </div>

              <button type="button" class="btn-reset-filters" id="clearFilters">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </svg>
                <span>Reset</span>
              </button>

              <!-- Drawer Close Button for Mobile Screens -->
              <button type="button" class="drawer-mobile-close" id="mobileFilterClose" aria-label="Close filters">
                ✕
              </button>
            </div>
          </div>

          <!-- Inputs Grid -->
          <div class="filter-input-grid">

            <!-- State -->
            <div class="form-group-custom">
              <label for="stateFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                </svg>
                <span>Select State</span>
              </label>
              <div class="custom-select-wrapper">
                <select id="stateFilter" class="styled-select">
                  <option value="all">All States (Pan India)</option>
                  <option value="bihar">Bihar</option>
                  <option value="madhya-pradesh">Madhya Pradesh</option>
                  <option value="uttar-pradesh">Uttar Pradesh</option>
                  <option value="jharkhand">Jharkhand</option>
                  <option value="rajasthan">Rajasthan</option>
                </select>
                <span class="select-arrow">
                  <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
                </span>
              </div>
            </div>

            <!-- District -->
            <div class="form-group-custom">
              <label for="districtFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M15 11V5l-3-3-3 3v2H3v14h18V11h-6zm-8 7H5v-2h2v2zm0-4H5v-2h2v2zm0-4H5V8h2v2zm6 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V8h2v2zm0-4h-2V4h2v2zm6 12h-2v-2h2v2zm0-4h-2v-2h2v2z"/>
                </svg>
                <span id="districtLabel">Select District</span>
              </label>
              <div class="custom-select-wrapper">
                <select id="districtFilter" class="styled-select" disabled>
                  <option value="all">Select state first</option>
                </select>
                <span class="select-arrow">
                  <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
                </span>
              </div>
            </div>

            <!-- Search -->
            <div class="form-group-custom">
              <label for="searchFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                </svg>
                <span>Search by Keyword / Name</span>
              </label>
              <div class="custom-input-wrapper">
                <span class="search-icon-inside">
                  <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                </span>
                <input
                  type="search"
                  id="searchFilter"
                  class="styled-input with-icon"
                  placeholder="e.g. Gopalganj, address, procession..."
                  autocomplete="off"
                />
                <button type="button" class="search-clear-btn" id="searchClearBtn" aria-label="Clear search">×</button>
              </div>
            </div>

            <!-- Sort -->
            <div class="form-group-custom">
              <label for="sortFilter">
                <svg viewBox="0 0 24 24">
                  <path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/>
                </svg>
                <span>Sort Videos</span>
              </label>
              <div class="custom-select-wrapper">
                <select id="sortFilter" class="styled-select">
                  <option value="latest">Newest First (Latest)</option>
                  <option value="oldest">Oldest First</option>
                  <option value="az">Title (A to Z)</option>
                </select>
                <span class="select-arrow">
                  <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
                </span>
              </div>
            </div>

          </div>

          <!-- Category Pills -->
          <div class="category-nav-bar">
            <span class="category-nav-label">Category:</span>

            <button type="button" class="pill-category-btn active" data-category="all">
              <svg viewBox="0 0 24 24"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
              <span>All Videos</span>
              <span class="category-badge-count" id="countCatAll">6</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="yatra">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>Kalash Yatra</span>
              <span class="category-badge-count" id="countCatYatra">2</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="program">
              <svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
              <span>Programs</span>
              <span class="category-badge-count" id="countCatProgram">2</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="speech">
              <svg viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
              <span>Speeches</span>
              <span class="category-badge-count" id="countCatSpeech">1</span>
            </button>

            <button type="button" class="pill-category-btn" data-category="highlights">
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <span>Highlights</span>
              <span class="category-badge-count" id="countCatHighlights">1</span>
            </button>
          </div>

          <!-- Active Filter Chips Tray -->
          <div class="active-chips-tray" id="activeFilters"></div>

          <!-- Mobile Drawer Footer Apply Button -->
          <div class="drawer-apply-footer">
            <button type="button" class="btn-apply-drawer" id="btnApplyDrawer">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
              </svg>
              <span>View Videos (<span id="drawerResultCount">6</span> results)</span>
            </button>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================================================
         VIDEO GALLERY CARDS
    ==================================================== -->
    <section class="gallery-section" id="videoGallery">
      <div class="container">

        <div class="gallery-header-row">
          <div>
            <h2 class="gallery-section-title">Historic Highlights of Kalash Yatra</h2>
            <p class="gallery-section-subtitle">Authentic video collection from participating states and districts</p>
          </div>
        </div>

        <div class="video-cards-grid" id="videoGrid">
          <% const videoList = (typeof kalash !== 'undefined' && kalash.videos && kalash.videos.length > 0) ? kalash.videos : []; %>
          <% videoList.forEach((vid) => { %>
            <% 
              let ytId = '';
              if (vid.videoUrl && vid.videoUrl.includes('embed/')) {
                ytId = vid.videoUrl.split('embed/')[1].split('?')[0];
              } else if (vid.videoUrl && vid.videoUrl.includes('watch?v=')) {
                ytId = vid.videoUrl.split('watch?v=')[1].split('&')[0];
              }
              const thumbImg = ytId ? 'https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg' : '/images/kalash-yatra-hero.jpg';
            %>
            <article
              class="video-card-item"
              data-category="<%= vid.category || 'yatra' %>"
              data-state="<%= vid.state || 'bihar' %>"
              data-district="<%= (vid.district || '').toLowerCase() %>"
              data-date="<%= vid.date || '' %>"
              data-video="<%= vid.videoUrl %>"
              data-title="<%= vid.title %>"
              data-location="<%= vid.district ? (vid.district + ', ') : '' %><%= vid.state %>"
            >
              <div class="card-media-box">
                <img
                  src="<%= thumbImg %>"
                  alt="<%= vid.title %>"
                  loading="lazy"
                />
                <div class="card-gradient-vignette"></div>

                <div class="card-play-symbol" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5.2v13.6c0 .9 1 1.4 1.8.9l10-6.8c.7-.5.7-1.5 0-2l-10-6.6C9 3.8 8 4.3 8 5.2z"/></svg>
                </div>

                <span class="badge-location-corner">
                  <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                  <%= vid.district || vid.state %>
                </span>

                <span class="badge-duration-corner">
                  <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                  <%= vid.duration || '10:00' %>
                </span>
              </div>

              <div class="card-info-box">
                <div class="card-tags-row">
                  <span class="card-category-tag"><%= vid.tag || (vid.category === 'speech' ? 'Speech' : vid.category === 'program' ? 'Program' : 'Kalash Yatra') %></span>
                  <span class="card-state-tag"><%= vid.state %></span>
                </div>

                <h3 class="card-title-text"><%= vid.title %></h3>

                <p class="card-description-text">
                  <%= vid.description || '' %>
                </p>

                <div class="card-footer-strip">
                  <span class="card-footer-date">
                    <svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                    <%= vid.date || 'Special Presentation' %>
                  </span>
                  <span class="card-cta-link">
                    <span>Play</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </article>
          <% }) %>

          <!-- EMPTY STATE WHEN NO VIDEOS MATCH -->
          <div class="empty-state-card" id="emptyState">
            <div class="empty-symbol-icon">
              <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            </div>
            <h3>No Videos Found</h3>
            <p>No videos match your selected state, district, or search criteria. Please adjust or reset filters.</p>
            <button type="button" class="btn-empty-clear" id="emptyClear">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
              <span>Reset All Filters</span>
            </button>
          </div>

        </div>

        <!-- ===================================================
             CREATIVE SHOWCASE: PILLARS & VISUAL STORY
        ==================================================== -->
        <section class="pillars-showcase-section" id="pillarsSection">
          
          <!-- Section Heading -->
          <div class="pillars-header-block">
            <div class="pillars-kicker-tag">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>Sacred Heritage & Social Awakening • Grand Pledge Vision</span>
            </div>
            <h2 class="pillars-main-title">
              Four Great Pillars of Kalash Yatra — <span class="accent">Faith, Values & Dignity</span>
            </h2>
            <p class="pillars-subtitle">
              A sacred movement celebrating unity through the waters of sacred rivers, honoring women, and building a brighter future. Learn the core pillars of this movement.
            </p>
          </div>

          <!-- Master 2-Column Grid -->
          <div class="pillars-content-grid">

            <!-- Left: Visual Living Story (Interactive Image Collage) -->
            <div class="visual-story-column">

              <!-- Primary Big Card -->
              <div class="story-card-primary" id="storyPrimaryCard" data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" data-title="Vedic Kalash Consecration & Water Worship on Sacred Ghats">
                <img
                  src="/images/ghat-kalash-procession.jpg"
                  alt="Kalash Yatra on Sacred Riverbanks"
                  loading="lazy"
                />
                <div class="story-overlay-grad"></div>

                <div class="story-floating-badge">
                  <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                  <span>Confluence of Sacred Rivers</span>
                </div>

                <div class="story-caption-block">
                  <h4><%= (typeof kalash !== 'undefined' && kalash.pillarsSection && kalash.pillarsSection.storyCollage && kalash.pillarsSection.storyCollage.primaryCard.title) ? kalash.pillarsSection.storyCollage.primaryCard.title : 'Water Purity & Cultural Renaissance' %></h4>
                  <p><%= (typeof kalash !== 'undefined' && kalash.pillarsSection && kalash.pillarsSection.storyCollage && kalash.pillarsSection.storyCollage.primaryCard.desc) ? kalash.pillarsSection.storyCollage.primaryCard.desc : 'A magnificent sight of mothers and sisters performing Kalash worship with Vedic chants at sunrise.' %></p>
                </div>
              </div>

              <!-- Dual Sub-Cards -->
              <div class="story-cards-dual">

                <div class="story-card-sub" data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" data-title="Vedic Kalash Worship — Sacred Offerings">
                  <img
                    src="/images/sacred-kalash-ritual.jpg"
                    alt="Vedic Kalash Worship"
                    loading="lazy"
                  />
                  <div class="story-overlay-grad"></div>
                  <span class="story-sub-tag">🪔 Vedic Ritual</span>
                  <div class="story-sub-caption">
                    <h5>Sacred Kalash Installation</h5>
                    <p>Mango foliage, sacred coconut & holy water</p>
                  </div>
                </div>

                <div class="story-card-sub" data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" data-title="Organized Gathering of Thousands of Devotees">
                  <img
                    src="/images/kalash-yatra-featured.jpg"
                    alt="Grand Rally"
                    loading="lazy"
                  />
                  <div class="story-overlay-grad"></div>
                  <span class="story-sub-tag">🚩 Historic Rally</span>
                  <div class="story-sub-caption">
                    <h5>Clarion Call of Dignity</h5>
                    <p>Confluence of unity across 150+ districts</p>
                  </div>
                </div>

              </div>

            </div>

            <!-- Right: The 4 Sacred Pillars (Interactive Cards) -->
            <div class="pillars-list-column">
              <% const pillarList = (typeof kalash !== 'undefined' && kalash.pillarsSection && kalash.pillarsSection.pillars && kalash.pillarsSection.pillars.length > 0) ? kalash.pillarsSection.pillars : [
                { number: '01', title: 'Sacred Water & Environmental Protection', description: 'Taking a collective vow for water conservation, cleanliness, and ecological balance across sacred rivers like Ganga, Saryu, Narmada, and Gandak.' },
                { number: '02', title: 'Women Empowerment & Dignity', description: 'Active frontline participation of mothers, sisters, and daughters in Kalash Yatra, embodying leadership and reverence.' },
                { number: '03', title: 'Social Harmony & Unwavering Unity', description: 'Uniting all sections of the community beyond boundaries to lay the foundation of brotherhood, mutual aid, and strength.' },
                { number: '04', title: 'Education, Values & Self-Reliance', description: 'Connecting younger generations with their proud heritage, promoting higher education, and inspiring an empowered, self-reliant community.' }
              ]; %>

              <% pillarList.forEach((pil, pIdx) => { %>
                <div class="pillar-interactive-card">
                  <div class="pillar-card-head">
                    <div class="pillar-num-badge"><%= pil.number || ('0' + (pIdx + 1)) %></div>
                    <div class="pillar-icon-symbol">
                      <% if (pIdx === 0) { %>
                        <svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                      <% } else if (pIdx === 1) { %>
                        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                      <% } else if (pIdx === 2) { %>
                        <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                      <% } else { %>
                        <svg viewBox="0 0 24 24"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/></svg>
                      <% } %>
                    </div>
                    <h4><%= pil.title %></h4>
                  </div>
                  <div class="pillar-card-body">
                    <p><%= pil.description %></p>
                  </div>
                </div>
              <% }) %>

            </div>

          </div>

        </section>

      </div>
    </section>

  </main>

  <!-- =====================================================
