          if (heroStageBadgeText && badgeText) heroStageBadgeText.textContent = badgeText;
          if (heroStageTitle && title) heroStageTitle.textContent = title;
          if (heroStageDesc && desc) heroStageDesc.textContent = desc;
          heroMainStageImg.style.opacity = "1";
          heroMainStageImg.style.transform = "scale(1)";
        }, 150);

        if (heroThumbBtns && heroThumbBtns.length > 0) {
          heroThumbBtns.forEach(function (btn) {
            btn.classList.toggle("active", btn.dataset.img === imgSrc);
