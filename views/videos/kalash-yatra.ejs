        ]
      };

      /* ===================================================
         DOM ELEMENTS
      ==================================================== */
      const stateFilter = document.getElementById("stateFilter");
      const districtFilter = document.getElementById("districtFilter");
      const districtLabel = document.getElementById("districtLabel");
      const searchFilter = document.getElementById("searchFilter");
      const searchClearBtn = document.getElementById("searchClearBtn");
      const sortFilter = document.getElementById("sortFilter");
      const clearFilters = document.getElementById("clearFilters");
      const emptyClear = document.getElementById("emptyClear");
      const resultCount = document.getElementById("resultCount");
      const videoGrid = document.getElementById("videoGrid");
      const emptyState = document.getElementById("emptyState");
      const activeFilters = document.getElementById("activeFilters");
      const categoryButtons = document.querySelectorAll(".pill-category-btn");
      const videoCards = Array.from(document.querySelectorAll(".video-card-item"));

      // Hero 50/50 Image Montage Elements
      const heroMainStageImg = document.getElementById("heroMainStageImg");
      const heroStageBadgeText = document.getElementById("heroStageBadgeText");
      const heroStageTitle = document.getElementById("heroStageTitle");
      const heroStageDesc = document.getElementById("heroStageDesc");
      const heroThumbBtns = document.querySelectorAll(".hero-thumb-btn");
      const heroFloatCards = document.querySelectorAll(".hero-float-card");
      const heroFilterTrigger = document.getElementById("heroFilterTrigger");

      // Scrollytelling Sacred Yatra Elements
      const scrollyStoryCards = document.querySelectorAll(".scrolly-story-card");
      const scrollyPips = document.querySelectorAll(".scrolly-pip-btn");
      const stickyVideoPoster = document.getElementById("stickyVideoPoster");
      const stickyChapterBadge = document.getElementById("stickyChapterBadge");
      const stickyDurationBadge = document.getElementById("stickyDurationBadge");
      const stickyVideoTitle = document.getElementById("stickyVideoTitle");
      const stickyVideoMeta = document.getElementById("stickyVideoMeta");
      const stickyPlayBtn = document.getElementById("stickyPlayBtn");
      const stickyProgressFill = document.getElementById("stickyProgressFill");
      const btnStickyWatchTrigger = document.getElementById("btnStickyWatchTrigger");
      const btnStickyShare = document.getElementById("btnStickyShare");

      // Mobile Filter Drawer Elements
      const mobileFilterTab = document.getElementById("mobileFilterTab");
      const mobileFilterBackdrop = document.getElementById("mobileFilterBackdrop");
      const mobileFilterClose = document.getElementById("mobileFilterClose");
      const btnApplyDrawer = document.getElementById("btnApplyDrawer");
      const mobileFilterBadge = document.getElementById("mobileFilterBadge");
      const drawerResultCount = document.getElementById("drawerResultCount");
      const filterConsole = document.getElementById("filterConsole");

      // Modal Elements
      const videoModal = document.getElementById("videoModal");
      const modalVideoIframe = document.getElementById("modalVideoIframe");
      const modalClose = document.getElementById("modalClose");
      const modalVideoTitle = document.getElementById("modalVideoTitle");
      const modalCategoryBadge = document.getElementById("modalCategoryBadge");
      const modalShareBtn = document.getElementById("modalShareBtn");

      // Toast Notification
      const toastNotification = document.getElementById("toastNotification");
      const toastMessage = document.getElementById("toastMessage");

      let selectedCategory = "all";
      let activeVideoShareUrl = window.location.href;

      /* ===================================================
         HERO SECTION: 50/50 CREATIVE IMAGE MONTAGE SWITCHER
      ==================================================== */
      function updateHeroStage(imgSrc, badgeText, title, desc) {
        if (!heroMainStageImg || !imgSrc) return;
        heroMainStageImg.style.opacity = "0.25";
        heroMainStageImg.style.transform = "scale(0.98)";
        setTimeout(function () {
          heroMainStageImg.src = imgSrc;
          if (heroStageBadgeText && badgeText) heroStageBadgeText.textContent = badgeText;
          if (heroStageTitle && title) heroStageTitle.textContent = title;
          if (heroStageDesc && desc) heroStageDesc.textContent = desc;
          heroMainStageImg.style.opacity = "1";
          heroMainStageImg.style.transform = "scale(1)";
        }, 150);

        if (heroThumbBtns && heroThumbBtns.length > 0) {
          heroThumbBtns.forEach(function (btn) {
            btn.classList.toggle("active", btn.dataset.img === imgSrc);
          });
        }
      }

      if (heroThumbBtns && heroThumbBtns.length > 0) {
        heroThumbBtns.forEach(function (btn) {
          btn.addEventListener("click", function () {
            updateHeroStage(btn.dataset.img, btn.dataset.badge, btn.dataset.title, btn.dataset.desc);
          });
        });
      }

      if (heroFloatCards && heroFloatCards.length > 0) {
        heroFloatCards.forEach(function (card) {
          card.addEventListener("click", function () {
            updateHeroStage(card.dataset.img, card.dataset.badge, card.dataset.title, card.dataset.desc);
          });
        });
      }

      if (heroFilterTrigger) {
        heroFilterTrigger.addEventListener("click", function (e) {
          if (window.innerWidth <= 860) {
            e.preventDefault();
            openFilterDrawer();
          }
        });
      }

      /* ===================================================
         YATRA VISUAL STORYCASE INTERACTIVE TRIGGERS
      ==================================================== */
      const btnJumpToFilter = document.getElementById("btnJumpToFilter");
      if (btnJumpToFilter) {
        btnJumpToFilter.addEventListener("click", function () {
          const filterConsole = document.getElementById("filterConsole");
          if (filterConsole) {
            filterConsole.scrollIntoView({ behavior: "smooth" });
          }
        });
      }

      // Quick State Filter Jumping Links
      const stateFilterTriggers = document.querySelectorAll(".btn-jump-filter-state");
      stateFilterTriggers.forEach(function (trigger) {
        trigger.addEventListener("click", function () {
          const targetState = trigger.dataset.state;
          if (targetState && stateFilter) {
            stateFilter.value = targetState;
            updateDistricts();
            applyFilters();
          }
          const filterConsole = document.getElementById("filterConsole");
          if (filterConsole) {
            filterConsole.scrollIntoView({ behavior: "smooth" });
          }
        });
      });

      // Watch Featured Video Modal Trigger
      const watchFeaturedTriggers = document.querySelectorAll(".btn-watch-featured");
      watchFeaturedTriggers.forEach(function (btn) {
        btn.addEventListener("click", function () {
          const videoUrl = btn.dataset.video || "https://www.youtube.com/embed/dQw4w9WgXcQ";
          const videoTitle = btn.dataset.title || "Gopalganj Kalash Yatra";
          openModalVideo(videoUrl, videoTitle, "Special Collection");
        });
      });

      /* ===================================================
         MOBILE FILTER DRAWER LOGIC
      ==================================================== */
      function openFilterDrawer() {
        if (!filterConsole) return;
        filterConsole.classList.add("drawer-open");
        if (mobileFilterBackdrop) mobileFilterBackdrop.classList.add("open");
        document.body.classList.add("filter-drawer-open");
      }

      function closeFilterDrawer() {
        if (!filterConsole) return;
        filterConsole.classList.remove("drawer-open");
        if (mobileFilterBackdrop) mobileFilterBackdrop.classList.remove("open");
        document.body.classList.remove("filter-drawer-open");
      }

      if (mobileFilterTab) {
        mobileFilterTab.addEventListener("click", openFilterDrawer);
      }

      if (mobileFilterClose) {
        mobileFilterClose.addEventListener("click", closeFilterDrawer);
      }

      if (mobileFilterBackdrop) {
        mobileFilterBackdrop.addEventListener("click", closeFilterDrawer);
      }

      if (btnApplyDrawer) {
        btnApplyDrawer.addEventListener("click", function () {
          closeFilterDrawer();
          const videoGallery = document.getElementById("videoGallery");
          if (videoGallery) {
            videoGallery.scrollIntoView({ behavior: "smooth" });
          }
        });
      }

      /* ===================================================
         UPDATE DISTRICTS DROPDOWN
      ==================================================== */
      function updateDistricts() {
        const state = stateFilter.value;
        districtFilter.innerHTML = "";

        if (state === "all") {
          const option = document.createElement("option");
          option.value = "all";
          option.textContent = "Select state first (All)";
          districtFilter.appendChild(option);
          districtFilter.disabled = true;
          districtLabel.textContent = "Select District";
          return;
        }

        districtFilter.disabled = false;
        const districts = districtData[state] || [];
        districtLabel.textContent = `Select District (${districts.length} available)`;

        const allOption = document.createElement("option");
        allOption.value = "all";
        allOption.textContent = `All Districts (${districts.length})`;
        districtFilter.appendChild(allOption);

        districts.forEach(function (item) {
          const opt = document.createElement("option");
          opt.value = item[0];
          opt.textContent = item[1];
          districtFilter.appendChild(opt);
        });
      }

      /* ===================================================
         CATEGORY BUTTONS HANDLING
      ==================================================== */
      function updateCategoryCounts() {
        // Calculate counts
        let allCount = 0;
        let yatraCount = 0;
        let programCount = 0;
        let speechCount = 0;
        let highlightsCount = 0;

        videoCards.forEach(card => {
          allCount++;
          const cat = card.dataset.category;
          if (cat === "yatra") yatraCount++;
          if (cat === "program") programCount++;
          if (cat === "speech") speechCount++;
          if (cat === "highlights") highlightsCount++;
        });

        const cAll = document.getElementById("countCatAll");
        const cYatra = document.getElementById("countCatYatra");
        const cProg = document.getElementById("countCatProgram");
        const cSpeech = document.getElementById("countCatSpeech");
        const cHigh = document.getElementById("countCatHighlights");

        if (cAll) cAll.textContent = allCount;
        if (cYatra) cYatra.textContent = yatraCount;
        if (cProg) cProg.textContent = programCount;
        if (cSpeech) cSpeech.textContent = speechCount;
        if (cHigh) cHigh.textContent = highlightsCount;
      }

      function setCategoryButtons() {
        categoryButtons.forEach(function (button) {
          button.classList.toggle(
            "active",
            button.dataset.category === selectedCategory
          );
        });
      }

      categoryButtons.forEach(function (button) {
        button.addEventListener("click", function () {
          selectedCategory = button.dataset.category;
          setCategoryButtons();
          applyFilters();
        });
      });

      /* ===================================================
         FILTERING & SEARCH LOGIC
      ==================================================== */
      function applyFilters() {
        const state = stateFilter.value;
        const district = districtFilter.value;
        const search = searchFilter.value.trim().toLowerCase();
        const visibleCards = [];

        // Toggle clear search button
        if (searchClearBtn) {
          searchClearBtn.classList.toggle("visible", search.length > 0);
        }

        videoCards.forEach(function (card) {
          const matchesState = state === "all" || card.dataset.state === state;
          const matchesDistrict = district === "all" || card.dataset.district === district;
          const matchesCategory = selectedCategory === "all" || card.dataset.category === selectedCategory;
          const cardText = (card.textContent + " " + (card.dataset.title || "")).toLowerCase();
          const matchesSearch = !search || cardText.includes(search);

          const isVisible = matchesState && matchesDistrict && matchesCategory && matchesSearch;

          if (isVisible) {
            card.classList.remove("hidden");
            visibleCards.push(card);
          } else {
            card.classList.add("hidden");
          }
        });

        sortCards(visibleCards);

        resultCount.textContent = visibleCards.length;
        if (mobileFilterBadge) mobileFilterBadge.textContent = visibleCards.length;
        if (drawerResultCount) drawerResultCount.textContent = visibleCards.length;
        emptyState.classList.toggle("show", visibleCards.length === 0);

        updateActiveChips();
      }

      /* ===================================================
         SORT CARDS
      ==================================================== */
      function sortCards(cards) {
        const sortMode = sortFilter.value;

        cards.sort(function (a, b) {
          if (sortMode === "latest") {
            return new Date(b.dataset.date) - new Date(a.dataset.date);
          }
          if (sortMode === "oldest") {
            return new Date(a.dataset.date) - new Date(b.dataset.date);
          }
          if (sortMode === "az") {
            const titleA = a.querySelector("h3")?.textContent?.trim() || "";
            const titleB = b.querySelector("h3")?.textContent?.trim() || "";
            return titleA.localeCompare(titleB, "hi");
          }
          return 0;
        });

        cards.forEach(function (card) {
          videoGrid.appendChild(card);
        });
      }

      /* ===================================================
         ACTIVE FILTER CHIPS
      ==================================================== */
      function updateActiveChips() {
        activeFilters.innerHTML = "";
        let hasFilter = false;

        const state = stateFilter.value;
        const district = districtFilter.value;
        const search = searchFilter.value.trim();

        if (state !== "all") {
          const stateName = stateFilter.options[stateFilter.selectedIndex]?.textContent || state;
          addChip("State: " + stateName, function () {
            stateFilter.value = "all";
            updateDistricts();
            applyFilters();
          });
          hasFilter = true;
        }

        if (state !== "all" && district !== "all") {
          const districtName = districtFilter.options[districtFilter.selectedIndex]?.textContent || district;
          addChip("District: " + districtName, function () {
            districtFilter.value = "all";
            applyFilters();
          });
          hasFilter = true;
        }

        if (selectedCategory !== "all") {
          const catBtn = document.querySelector(`.pill-category-btn[data-category="${selectedCategory}"]`);
          const catName = catBtn?.querySelector("span")?.textContent || selectedCategory;
          addChip("Category: " + catName, function () {
            selectedCategory = "all";
            setCategoryButtons();
            applyFilters();
          });
          hasFilter = true;
        }

        if (search) {
          addChip("Search: " + search, function () {
            searchFilter.value = "";
            applyFilters();
          });
          hasFilter = true;
        }

        activeFilters.classList.toggle("show", hasFilter);
      }

      function addChip(label, onRemove) {
        const chip = document.createElement("div");
        chip.className = "active-chip-tag";

        const span = document.createElement("span");
        span.textContent = label;

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "active-chip-remove";
        btn.innerHTML = "×";
        btn.title = "Remove";
        btn.addEventListener("click", onRemove);

        chip.appendChild(span);
        chip.appendChild(btn);
        activeFilters.appendChild(chip);
      }

      /* ===================================================
         RESET FILTERS
      ==================================================== */
      function resetFilters() {
        stateFilter.value = "all";
        updateDistricts();
        searchFilter.value = "";
        sortFilter.value = "latest";
        selectedCategory = "all";
        setCategoryButtons();
        applyFilters();
      }

      clearFilters.addEventListener("click", resetFilters);
      emptyClear.addEventListener("click", resetFilters);

      if (searchClearBtn) {
        searchClearBtn.addEventListener("click", function () {
          searchFilter.value = "";
          applyFilters();
        });
      }

      stateFilter.addEventListener("change", function () {
        updateDistricts();
        applyFilters();
      });

      districtFilter.addEventListener("change", applyFilters);
      searchFilter.addEventListener("input", applyFilters);
      sortFilter.addEventListener("change", applyFilters);

      /* ===================================================
         MODAL VIDEO PLAYBACK
      ==================================================== */
      function openModalVideo(url, title, category) {
        if (!url) return;

        const separator = url.includes("?") ? "&" : "?";
        modalVideoIframe.src = url + separator + "autoplay=1";
        modalVideoTitle.textContent = title || "Kalash Yatra Special Video";
        modalCategoryBadge.textContent = category || "Special";
        activeVideoShareUrl = url;

        videoModal.classList.add("active");
        document.body.classList.add("modal-open");
      }

      function closeModalVideo() {
        videoModal.classList.remove("active");
        modalVideoIframe.src = "";
        document.body.classList.remove("modal-open");
      }

      // Card Click Listeners
      videoCards.forEach(function (card) {
        card.addEventListener("click", function () {
          const videoUrl = card.dataset.video;
          const videoTitle = card.dataset.title || card.querySelector("h3")?.textContent?.trim();
          const categoryTag = card.querySelector(".card-category-tag")?.textContent?.trim();
          openModalVideo(videoUrl, videoTitle, categoryTag);
        });
      });

      // Featured Video Button Trigger
      if (featuredPlayBtn) {
        featuredPlayBtn.addEventListener("click", function () {
          openModalVideo(
            featuredPlayBtn.dataset.video,
            featuredPlayBtn.dataset.title,
            "Special Presentation"
          );
        });
      }

      if (btnFeaturedWatchTrigger) {
        btnFeaturedWatchTrigger.addEventListener("click", function () {
          openModalVideo(
            btnFeaturedWatchTrigger.dataset.video,
            btnFeaturedWatchTrigger.dataset.title,
            "Special Presentation"
          );
        });
      }



      // Visual Story Cards Click Listeners
      const storyCards = document.querySelectorAll(".story-card-primary, .story-card-sub");
      storyCards.forEach(function (card) {
        card.addEventListener("click", function () {
          const videoUrl = card.dataset.video || "https://www.youtube.com/embed/dQw4w9WgXcQ";
          const videoTitle = card.dataset.title || "Kalash Yatra Special Video";
          openModalVideo(videoUrl, videoTitle, "Special Presentation");
        });
      });

      // Close Modal Triggers
      modalClose.addEventListener("click", closeModalVideo);

      videoModal.addEventListener("click", function (event) {
        if (event.target === videoModal) {
          closeModalVideo();
        }
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          if (videoModal && videoModal.classList.contains("active")) {
            closeModalVideo();
          }
          if (filterConsole && filterConsole.classList.contains("drawer-open")) {
            closeFilterDrawer();
          }
        }
      });

      /* ===================================================
         SHARE & TOAST NOTIFICATION
      ==================================================== */
      function showToast(msg) {
        toastMessage.textContent = msg || "Link copied!";
        toastNotification.classList.add("show");
        setTimeout(function () {
          toastNotification.classList.remove("show");
        }, 3200);
      }

      function copyTextToClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(function () {
            showToast("Link copied to clipboard!");
          }).catch(function () {
            showToast("Link: " + text);
          });
        } else {
          showToast("Link: " + text);
        }
      }

      if (modalShareBtn) {
        modalShareBtn.addEventListener("click", function () {
          copyTextToClipboard(activeVideoShareUrl || window.location.href);
        });
      }

      const btnShareFeatured = document.getElementById("btnShareFeatured");
      if (btnShareFeatured) {
        btnShareFeatured.addEventListener("click", function () {
          copyTextToClipboard(window.location.origin + window.location.pathname + "#videoGallery");
        });
      }


      /* ===================================================
         INIT ON LOAD
      ==================================================== */
      updateDistricts();
      updateCategoryCounts();
      setCategoryButtons();
      applyFilters();

    });
  </script>

