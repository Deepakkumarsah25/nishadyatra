        // 2. Individual District Pills
        Object.keys(distCounts).sort().forEach(function (distName) {
          const pill = document.createElement("button");
          pill.type = "button";
          pill.className = "district-pill" + (selectedDistrict === distName ? " active" : "");
          pill.dataset.district = distName;
          pill.innerHTML = `<span>📍 ${distName}</span><span class="pill-count">${distCounts[distName]}</span>`;
          pill.addEventListener("click", function () {
            selectDistrict(distName);
          });
          quickDistrictPills.appendChild(pill);
        });
      }

      function selectDistrict(distName) {
        selectedDistrict = distName;

        // Sync Quick Pills
        if (quickDistrictPills) {
          const pills = quickDistrictPills.querySelectorAll(".district-pill");
          pills.forEach(function (p) {
            p.classList.toggle("active", p.dataset.district === selectedDistrict);
          });
        }

        // Sync Dropdown
        if (districtFilter) {
          let found = false;
          Array.from(districtFilter.options).forEach(function (opt) {
            if (opt.value === selectedDistrict || isDistrictMatch(opt.value, selectedDistrict)) {
              districtFilter.value = opt.value;
              found = true;
            }
          });
          if (!found && selectedDistrict === "all") {
            districtFilter.value = "all";
          }
        }

        applyFilters();
      }

