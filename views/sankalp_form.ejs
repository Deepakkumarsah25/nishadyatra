        "मुरादाबाद",
        "मुजफ्फरनगर",
        "पीलीभीत",
        "प्रतापगढ़",
        "प्रयागराज",
        "रायबरेली",
        "रामपुर",
        "सहारनपुर",
        "संभल",
        "संत कबीर नगर",
        "संत रविदास नगर",
        "शाहजहांपुर",
        "शामली",
        "श्रावस्ती",
        "सिद्धार्थनगर",
        "सीतापुर",
        "सोनभद्र",
        "सुल्तानपुर",
        "उन्नाव",
        "वाराणसी"

      ]

    };



    /*
    =====================================
    CHANGE STATE
    =====================================
    */

    function updateDistrictField() {

      const selectedState =
        stateSelect.value;


      /*
      -------------------------------------
      UP / BIHAR / JHARKHAND
      => SELECT DROPDOWN
      -------------------------------------
      */

      if (
        dropdownStates[selectedState]
      ) {

        const districts =
          dropdownStates[selectedState];


        districtGroup.innerHTML = `

          <label for="district">
            जिला <span>*</span>
          </label>

          <select
            id="district"
            name="district"
            required
          >

            <option value="">
              जिला चुनें
            </option>

          </select>

        `;


        const districtSelect =
          document.getElementById(
            "district"
          );


        districts.forEach(
          function (district) {

            const option =
              document.createElement(
                "option"
              );


            option.value =
              district;


            option.textContent =
              district;


            districtSelect.appendChild(
              option
            );

          }
        );


        return;
      }



      /*
      -------------------------------------
      OTHER STATES
      => MANUAL INPUT
      -------------------------------------
      */

      districtGroup.innerHTML = `

        <label for="district">
          जिला <span>*</span>
        </label>

        <input
          type="text"
          id="district"
          name="district"
          placeholder="जिले का नाम"
          maxlength="100"
          required
        >

      `;
    }



    /*
    =====================================
    STATE CHANGE EVENT
    =====================================
    */

    stateSelect.addEventListener(
      "change",
      updateDistrictField
    );



    /*
    =====================================
    BIHAR PRESELECTED
    =====================================
    */

    updateDistrictField();



    /*
    =====================================
    MOBILE NUMBER
    =====================================
    */

    const mobileInput =
      document.getElementById(
        "mobile"
      );


    mobileInput.addEventListener(
      "input",
      function () {

        this.value =
          this.value
            .replace(/\D/g, "")
            .slice(0, 10);

      }
    );



    /*
    =====================================
    AGE
    =====================================
    */

    const ageInput =
      document.getElementById(
        "age"
      );


    ageInput.addEventListener(
      "input",
      function () {

        if (this.value > 120) {
          this.value = 120;
        }


        if (
          this.value < 1 &&
          this.value !== ""
        ) {

          this.value = 1;

        }

      }
    );

  </script>

</body>

</html>
