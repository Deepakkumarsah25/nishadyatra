<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= title %> | निषाद आरक्षण संकल्प अभियान</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <meta name="description" content="<%= item.summary || item.title %>">
    <link rel="stylesheet" href="/css/news/video_news.css">
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    >
  </head>
  <body>
    <%- include('../common/navbar') %>

    <main class="press-page">
      <article class="press-article press-container">
        <a class="press-back" href="/news">← सभी खबरें</a>

        <div class="press-meta">
          <span class="press-category"><%= item.category %></span>
          <time>
            <%= new Date(item.publicationDate || item.publishedAt).toLocaleDateString('hi-IN', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            }) %>
          </time>
        </div>

        <h1><%= item.title %></h1>
        <p class="press-source">स्रोत: <strong><%= item.source %></strong></p>

        <% if (item.thumbnailPath) { %>
          <img
            class="press-article-image"
            src="<%= item.thumbnailPath %>"
            alt="<%= item.title %>"
          >
        <% } %>

        <% if (item.summary) { %>
          <p class="press-article-summary"><%= item.summary %></p>
        <% } %>

        <div class="press-article-content"><%= item.content %></div>

        <% if (item.externalUrl) { %>
          <a
            class="press-read"
            href="<%= item.externalUrl %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            मूल प्रकाशन पर पढ़ें ↗
          </a>
          <a class="press-read" href="<%= item.externalUrl %>" target="_blank" rel="noopener noreferrer" style="display:block; margin-top:8px; overflow-wrap:anywhere;">
            <%= item.source ? item.source + ' — ' : '' %><%= item.externalUrl %>
          </a>
        <% } %>
      </article>
    </main>

    <%- include('../common/footer') %>
  </body>
</html>
