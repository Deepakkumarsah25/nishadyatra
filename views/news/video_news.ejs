<%
const articles = Array.isArray(remaining) ? remaining : [];
const featuredArticle = featured || null;
const fmtDate = (value) => value ? new Date(value).toLocaleDateString('hi-IN', { day:'numeric', month:'long', year:'numeric' }) : '';
const allItems = articles;
%><!doctype html>
<html lang="hi">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | निषाद आरक्षण संकल्प अभियान</title>
  <meta name="description" content="निषाद आरक्षण संकल्प अभियान से जुड़ी डिजिटल मीडिया और प्रिंट मीडिया की खबरें।">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Noto+Serif+Devanagari:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/news/video_news.css">
</head>
<body><%- include('../common/navbar') %>
<main class="press-page">
  <section class="press-hero"><div class="press-container"><span class="press-eyebrow">मीडिया कवरेज</span><h1>न्यूज़ <span>&amp;</span> प्रेस</h1><p>निषाद आरक्षण संकल्प अभियान से जुड़ी ताज़ा खबरें और मीडिया रिपोर्ट।</p><span class="press-count"><%= news.length %> प्रकाशित खबरें</span></div></section>
  <section class="press-container press-content">
    <% if (news.length) { %>
      <% if (featuredArticle) { %>
      <article class="press-featured">
        <a class="press-feature-image" href="<%= featuredArticle.externalUrl || '/news/' + featuredArticle._id %>" <%= featuredArticle.externalUrl ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
          <% if (featuredArticle.thumbnailPath) { %><img src="<%= featuredArticle.thumbnailPath %>" alt="<%= featuredArticle.title %>" fetchpriority="high"><% } else { %><span class="press-image-fallback">प्रेस कवरेज</span><% } %>
          <span class="press-feature-label">मुख्य खबर</span>
        </a>
        <div class="press-feature-body"><div class="press-meta"><span class="press-category"><%= featuredArticle.category %></span><time><%= fmtDate(featuredArticle.publicationDate || featuredArticle.publishedAt) %></time></div>
          <h2><%= featuredArticle.title %></h2><p class="press-source">स्रोत: <strong><%= featuredArticle.source || 'मीडिया' %></strong></p>
          <% if (featuredArticle.summary) { %><p class="press-summary"><%= featuredArticle.summary %></p><% } %>
          <a class="press-read" href="<%= featuredArticle.externalUrl || '/news/' + featuredArticle._id %>" <%= featuredArticle.externalUrl ? 'target="_blank" rel="noopener noreferrer"' : '' %>>पूरी खबर पढ़ें <span aria-hidden="true">↗</span></a>
        </div>
      </article>
      <% } %>
      <div class="press-list-heading"><div><span class="press-eyebrow">अभियान की खबरें</span><h2>सभी समाचार</h2></div><label class="press-search"><span aria-hidden="true">⌕</span><input id="pressSearch" type="search" placeholder="खबर या स्रोत खोजें" aria-label="खबर या स्रोत खोजें"></label></div>
      <div class="press-filters" role="group" aria-label="मीडिया प्रकार फ़िल्टर"><button class="is-active" type="button" data-filter="all">सभी</button><button type="button" data-filter="Digital Media">डिजिटल मीडिया</button><button type="button" data-filter="Print Media">प्रिंट मीडिया</button></div>
      <div class="press-grid" id="pressGrid">
        <% allItems.forEach((item, index) => { %>
        <article class="press-card" data-category="<%= item.category || 'Digital Media' %>" data-search="<%= [item.title,item.source,item.summary].join(' ').toLowerCase() %>">
          <a class="press-card-image" href="<%= item.externalUrl || '/news/' + item._id %>" <%= item.externalUrl ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
            <% if(item.thumbnailPath){ %><img src="<%= item.thumbnailPath %>" alt="<%= item.title %>" loading="lazy"><% } else { %><span class="press-image-fallback">मीडिया खबर</span><% } %>
          </a>
          <div class="press-card-body"><div class="press-meta"><span class="press-category"><%= item.category || 'Digital Media' %></span><time><%= fmtDate(item.publicationDate || item.publishedAt) %></time></div>
            <h3><%= item.title %></h3><p class="press-source">स्रोत: <strong><%= item.source || 'मीडिया' %></strong></p>
            <% if(item.summary){ %><p class="press-summary"><%= item.summary %></p><% } %>
            <a class="press-read" href="<%= item.externalUrl || '/news/' + item._id %>" <%= item.externalUrl ? 'target="_blank" rel="noopener noreferrer"' : '' %>>पूरी खबर पढ़ें <span aria-hidden="true">↗</span></a>
          </div>
        </article><% }) %>
      </div>
      <div class="press-empty" id="pressNoResults" hidden><h3>कोई खबर नहीं मिली</h3><p>दूसरे शब्द से खोजकर देखें।</p></div>
    <% } else { %><div class="press-empty press-empty-start"><span>✦</span><h2>जल्द आ रही हैं नई खबरें</h2><p>अभियान से जुड़ी मीडिया कवरेज यहाँ प्रकाशित होगी।</p></div><% } %>
  </section>
</main><%- include('../common/footer') %>
<script>
(() => {
  const search = document.getElementById('pressSearch');
  const cards = [...document.querySelectorAll('.press-card')];
  const empty = document.getElementById('pressNoResults');
  let category = 'all';
  function update(){
    const q = (search?.value || '').trim().toLocaleLowerCase(); let visible = 0;
    cards.forEach(card => { const show = (category === 'all' || card.dataset.category === category) && card.dataset.search.includes(q); card.hidden = !show; if(show) visible++; });
    if(empty) empty.hidden = visible !== 0;
  }
  document.querySelectorAll('.press-filters button').forEach(button => button.addEventListener('click', () => { category = button.dataset.filter; document.querySelectorAll('.press-filters button').forEach(b => b.classList.toggle('is-active', b === button)); update(); }));
  search?.addEventListener('input', update);
})();
</script></body></html>
