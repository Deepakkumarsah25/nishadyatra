<%
const articles = Array.isArray(remaining) ? remaining : [];
const fmtDate = (value) => value ? new Date(value).toLocaleDateString('hi-IN', { day:'numeric', month:'long', year:'numeric' }) : '';
const catClass = (cat) => (cat || 'Digital Media') === 'Print Media' ? 'press-category--print' : 'press-category--digital';
const mediaLabel = (item) => item.mediaType === 'youtube' ? 'यूट्यूब वीडियो' : item.mediaType === 'upload' ? 'अपलोड किया गया वीडियो' : item.category === 'Print Media' ? 'प्रिंट मीडिया' : item.category === 'Digital Media' ? 'डिजिटल मीडिया' : item.category || 'समाचार';
const pageUrl = (number) => {
  const params = new URLSearchParams();
  if (query?.state) params.set('state', query.state);
  if (query?.district) params.set('district', query.district);
  if (query?.category) params.set('category', query.category);
  if (query?.q) params.set('q', query.q);
  params.set('page', String(number));
  return '/news?' + params.toString();
};
%><!doctype html>
<html lang="hi">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | निषाद आरक्षण संकल्प अभियान</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <meta name="description" content="निषाद आरक्षण संकल्प अभियान से जुड़ी ताज़ा खबरें और मीडिया रिपोर्ट।">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/news/video_news.css">
</head>
<body><%- include('../common/navbar') %>
<main class="press-page">
  <section class="press-hero"><% if (heroPoster) { %><div class="press-hero-poster" aria-hidden="true"><img src="<%= heroPoster %>" alt=""></div><% } %><div class="press-container"><div class="press-hero-copy"><h1>न्यूज़ <span>&amp;</span> प्रेस</h1><p>निषाद आरक्षण संकल्प अभियान से जुड़ी ताज़ा खबरें और मीडिया रिपोर्ट।</p>
    <div class="press-stats" aria-label="समाचार आंकड़े">
      <div class="press-stat"><strong><%= stats.news %></strong><span>कुल खबरें</span></div>
      <div class="press-stat"><strong><%= stats.districts %></strong><span>ज़िले</span></div>
      <div class="press-stat"><strong><%= stats.states %></strong><span>राज्य</span></div>
    </div>
  </div></div></section>
  <section class="press-container press-content">
    <div class="press-list-heading"><div><h2>सभी समाचार</h2><span class="press-result-count"></span></div><label class="press-search" for="newsSearch"><span aria-hidden="true">⌕</span><input id="newsSearch" name="q" type="search" form="newsFilters" value="<%= query.q || '' %>" placeholder="Search.." aria-label="खबर या स्रोत खोजें"></label></div>
    <form class="press-filters" method="get" action="/news" id="newsFilters">
      <label class="press-select-label"><select name="state" id="stateFilter" data-auto-submit><option value="">सभी राज्य</option><% [...new Set(locations.map((location) => location._id.state))].forEach((stateName) => { %><option value="<%= stateName %>" <%= query.state === stateName ? 'selected' : '' %>><%= stateName %></option><% }) %></select></label>
      <label class="press-select-label"><select name="district" id="districtFilter" data-auto-submit><option value="">सभी ज़िले</option><% locations.forEach((location) => { %><option value="<%= location._id.district %>" data-state="<%= location._id.state %>" <%= query.district === location._id.district && (!query.state || query.state === location._id.state) ? 'selected' : '' %>><%= location._id.district %><%= !query.state ? ' · ' + location._id.state : '' %></option><% }) %></select></label>
      <label class="press-select-label"><select name="category" data-auto-submit><option value="">सभी प्रकार</option><option value="Digital Media" <%= query.category === 'Digital Media' ? 'selected' : '' %>>डिजिटल मीडिया</option><option value="Print Media" <%= query.category === 'Print Media' ? 'selected' : '' %>>प्रिंट मीडिया</option></select></label>
    </form>
    <div class="press-results" id="pressResults" aria-live="polite" aria-busy="false">
    <% if (articles.length) { %>
      <div class="press-grid" id="pressGrid">
        <% articles.forEach((item) => { %>
        <article class="press-card">
          <a class="press-card-image-link" href="<%= '/news/' + item._id %>" aria-label="पूरा समाचार पढ़ें: <%= item.title %>">
          <div class="press-card-image">
            <% if(item.thumbnailPath){ %><img src="<%= item.thumbnailPath %>" alt="<%= item.title %>" loading="lazy"><% } else { %><span class="press-image-fallback">समाचार चित्र</span><% } %>
            <div class="press-image-meta">
              <span class="press-category <%= catClass(item.category) %>"><%= mediaLabel(item) %></span>
              <% const cardDate = fmtDate(item.publicationDate || item.publishedAt || item.createdAt); if (cardDate) { %><time class="press-image-date"><%= cardDate %></time><% } %>
            </div>
          </div>
          </a>
          <div class="press-card-body">
            <div class="press-card-info-row">
              <% if (item.source) { %><p class="press-source"><span>स्रोत:</span><strong><%= item.source %></strong></p><% } %>
              <% if (item.district) { %>
                <p class="press-location">
                  <span class="press-location-item"><span>ज़िला:</span><strong><%= item.district %></strong></span>
                </p>
              <% } %>
            </div>
            <h3><a class="press-title-link" href="<%= item.externalUrl || '/news/' + item._id %>" <%= item.externalUrl ? 'target="_blank" rel="noopener noreferrer"' : '' %>><%= item.title %></a></h3>
            <% if(item.summary){ %><p class="press-summary"><%= item.summary %></p><% } %>
            <a class="press-read" href="<%= item.externalUrl || '/news/' + item._id %>" <%= item.externalUrl ? 'target="_blank" rel="noopener noreferrer"' : '' %>>पूरी खबर पढ़ें <span aria-hidden="true">↗</span></a>
          </div>
        </article><% }) %>
      </div>
      <nav class="press-pagination" aria-label="News pages">
        <div class="press-pagination-controls">
          <% if (page > 1) { %><a class="pagination-direction" href="<%= pageUrl(page - 1) %>"><span aria-hidden="true">‹</span> Previous</a><% } else { %><span class="pagination-direction is-disabled"><span aria-hidden="true">‹</span> Previous</span><% } %>
          <div class="pagination-pages">
            <% const lastVisiblePage = Math.min(totalPages, page <= 4 ? 4 : page + 1); %>
            <% for (let number = 1; number <= lastVisiblePage; number++) { %>
              <a class="pagination-number <%= number === page ? 'is-current' : '' %>" href="<%= pageUrl(number) %>" <%= number === page ? 'aria-current="page"' : '' %>><%= number %></a>
            <% } %>
            <% if (lastVisiblePage < totalPages) { %>
              <% if (lastVisiblePage < totalPages - 1) { %><span class="pagination-ellipsis" aria-hidden="true">…</span><% } %>
              <a class="pagination-number" href="<%= pageUrl(totalPages) %>"><%= totalPages %></a>
            <% } %>
          </div>
          <% if (page < totalPages) { %><a class="pagination-direction" href="<%= pageUrl(page + 1) %>">Next <span aria-hidden="true">›</span></a><% } else { %><span class="pagination-direction is-disabled">Next <span aria-hidden="true">›</span></span><% } %>
        </div>
      </nav>
    <% } else { %><div class="press-empty"><h3>कोई खबर नहीं मिली</h3><p>आपकी खोज या चुने गए फ़िल्टर से मेल खाने वाली कोई खबर नहीं मिली। खोज शब्द या फ़िल्टर बदलकर फिर कोशिश करें।</p></div><% } %>
    </div>
  </section>
</main><%- include('../common/footer') %>
<script>
(() => {
  const state = document.getElementById('stateFilter'); const district = document.getElementById('districtFilter');
  const filterDistricts = () => { [...district.options].forEach((option) => { if (!option.value) return; option.hidden = !!state.value && option.dataset.state !== state.value; }); if (district.selectedOptions[0]?.hidden) district.value = ''; };
  const form = document.getElementById('newsFilters');
  const results = document.getElementById('pressResults');
  let debounceTimer;
  let activeRequest;
  const buildUrl = (page = 1) => {
    const url = new URL(form.action, window.location.origin);
    const params = new URLSearchParams(new FormData(form));
    params.delete('page');
    if (page > 1) params.set('page', String(page));
    url.search = params.toString();
    return url;
  };
  const loadResults = async (url, historyMode = 'replace') => {
    activeRequest?.abort();
    activeRequest = new AbortController();
    results.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch(url.pathname + url.search, {
        signal: activeRequest.signal,
        headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'text/html' },
      });
      if (!response.ok) throw new Error(`News request failed (${response.status})`);
      const html = await response.text();
      const nextDocument = new DOMParser().parseFromString(html, 'text/html');
      const nextResults = nextDocument.getElementById('pressResults');
      if (!nextResults) throw new Error('News results were not found in the response.');
      results.innerHTML = nextResults.innerHTML;
      results.setAttribute('aria-busy', 'false');
      if (historyMode === 'push') history.pushState({}, '', url.pathname + url.search);
      else if (historyMode === 'replace') history.replaceState({}, '', url.pathname + url.search);
    } catch (error) {
      if (error.name !== 'AbortError') {
        results.setAttribute('aria-busy', 'false');
        console.error(error);
      }
    }
  };
  const scheduleResults = (delay = 350) => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => loadResults(buildUrl()), delay);
  };
  const clearFilters = () => {
    form.querySelectorAll('select').forEach((select) => { select.value = ''; });
    document.getElementById('newsSearch').value = '';
    filterDistricts();
  };
  form.addEventListener('submit', (event) => { event.preventDefault(); scheduleResults(250); });
  state?.addEventListener('change', () => { filterDistricts(); scheduleResults(300); });
  district?.addEventListener('change', () => scheduleResults(300));
  form.querySelector('[name="category"]')?.addEventListener('change', () => scheduleResults(300));
  document.getElementById('newsSearch')?.addEventListener('input', () => scheduleResults(450));
  results.addEventListener('click', (event) => {
    const link = event.target.closest('.press-pagination a');
    if (!link) return;
    const target = new URL(link.href, window.location.origin);
    if (target.origin !== window.location.origin) return;
    event.preventDefault();
    loadResults(target, 'push');
  });
  window.addEventListener('popstate', () => loadResults(new URL(window.location.href), 'none'));
  filterDistricts();
  const navigation = performance.getEntriesByType('navigation')[0];
  if (navigation?.type === 'reload') {
    clearFilters();
    const cleanUrl = new URL(window.location.pathname, window.location.origin);
    history.replaceState({}, '', cleanUrl.pathname);
    loadResults(cleanUrl, 'none');
  }
})();
</script></body></html>
