<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'फ़ोटो गैलरी' %> | निषाद संकल्प अभियान</title>
    <meta name="description" content="निषाद संकल्प अभियान की फोटो गैलरी में संकल्प यात्रा, सामुदायिक कार्यक्रमों और अभियान गतिविधियों की तस्वीरें देखें।" />
    <link rel="canonical" href="https://nishadaarakshansankalp.com/gallery" />
    <meta property="og:title" content="फोटो गैलरी | निषाद संकल्प अभियान" />
    <meta property="og:description" content="संकल्प यात्रा, सामुदायिक कार्यक्रमों और अभियान गतिविधियों की तस्वीरें देखें।" />
    <meta property="og:url" content="https://nishadaarakshansankalp.com/gallery" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://nishadaarakshansankalp.com/images/logo.png" />
    <link rel="icon" type="image/png" href="/images/logo.png" />

    <!-- Google Fonts for authentic typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Global Site CSS -->
    <link rel="stylesheet" href="/css/index.css" />
    <link rel="stylesheet" href="/css/sidebar.css" />

    <!-- Gallery Specific CSS -->
    <link rel="stylesheet" href="/css/gallery.css" />
  </head>
  <body class="gallery-page">
    <!-- Top Navigation Bar -->
    <%- include("common/navbar") %>

    <!-- Quick Action / Helpline Sidebar Drawer -->
    <%- include("components/sidebar") %>

    <!-- HERO BANNER -->
    <section class="gallery-hero">


      <h1>
        <span>फ़ोटो गैलरी</span>
      </h1>

      <p>
        निषाद समाज के लोग आरक्षण का अधिकार पाने के संकल्प के साथ एकजुट होकर अपनी आवाज़ बुलंद कर रहे हैं।
      </p>

      <div class="gallery-stats-pills">
        <div class="gallery-stat-pill">
          <span>कुल संकल्प फ़ोटो:</span>
          <strong><%= totalPhotos %></strong>
        </div>
        <div class="gallery-stat-pill">
          <span>शामिल ज़िले:</span>
          <strong><%= districtsWithCount && districtsWithCount.length ? districtsWithCount.length : 12 %>+</strong>
        </div>
      </div>
    </section>

    <!-- MAIN GALLERY CONTENT -->
    <main class="gallery-container">
      <!-- GALLERY HEADING AND FILTERS -->
      <section class="gallery-controls" aria-label="Photo filters">
        <form id="galleryFilters" action="/gallery" method="get">
        <div class="gallery-list-heading">
          <div><h2>सभी फ़ोटो</h2></div>
          <label class="gallery-search" for="gallerySearchInput"><span aria-hidden="true">⌕</span>
            <input
              type="text"
              name="search"
              id="gallerySearchInput"
              placeholder="Search.."
              value="<%= search || '' %>"
              aria-label="फोटो खोजें"
            />
          </label>
        </div>
        <%- include("components/location-filter", {
          selectedState: typeof selectedState !== 'undefined' ? selectedState : 'all',
          selectedDistrict: typeof selectedDistrict !== 'undefined' ? selectedDistrict : 'all',
          stateId: "galleryStateFilter",
          districtId: "galleryDistrictFilter",
          useLabels: true,
          labelClass: "gallery-select-label",
          stateClass: "",
          districtClass: "",
          wrapperClass: "gallery-filters",
          allValue: "all",
          stateLabel: "सभी राज्य",
          districtLabel: "सभी ज़िले"
        }) %>
        </form>
      </section>

      <!-- PHOTOS GRID -->
      <section class="gallery-grid" id="galleryGrid" aria-label="Pledge photos grid">
        <% if (photos && photos.length > 0) { %>
          <% photos.forEach(function(photo, index) { %>
            <%
              const cardImagesList = (photo.images && photo.images.length > 0)
                ? photo.images.map(img => (typeof img === 'string' ? { url: img, caption: photo.caption } : { url: img.url, caption: img.caption || photo.caption }))
                : [{ url: photo.imageUrl, caption: photo.caption }];
            %>
            <article
              class="gallery-card"
              data-district="<%= photo.district %>"
              data-name="<%= photo.name %>"
              data-date="<%= photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('en-US') : '') %>"
              data-caption="<%= photo.caption || '' %>"
              data-image="<%= photo.imageUrl %>"
              data-images='<%- JSON.stringify(cardImagesList).replace(/'/g, "&#39;") %>'
              data-count="<%= cardImagesList.length %>"
              tabindex="0"
              role="button"
              aria-label="<%= photo.name %>, <%= photo.district %>"
            >
              <div class="gallery-card-image-wrap">
                <img
                  src="<%= photo.imageUrl %>"
                  alt="<%= photo.name %> — <%= photo.district %>"
                  class="gallery-card-img"
                  loading="lazy"
                  onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=800&q=80'"
                />
                <div class="gallery-card-overlay">
                  <div class="card-top-badges">
                    <span class="card-district-badge">
                      📍 <%= photo.district %>
                    </span>
                    <% if (cardImagesList.length > 1) { %>
                      <span class="card-album-badge">
                        📸 <%= cardImagesList.length %> फ़ोटो
                      </span>
                    <% } else { %>
                      <span class="card-date-badge">
                        📅 <%= photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('en-US') : '') %>
                      </span>
                    <% } %>
                  </div>

                  <div class="card-zoom-trigger" title="फ़ोटो देखें">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  </div>
                </div>
              </div>

              <div class="gallery-card-body">
                <div class="gallery-card-name">
                  <span><%= photo.name %></span>
                </div>

                <p class="gallery-card-caption">
                  <%= photo.caption ? photo.caption : 'निषाद संकल्प अभियान के प्रति समर्पण में लिया गया संकल्प।' %>
                </p>

                <div class="gallery-card-footer">
                  <span style="font-size: 13px; font-weight: 700; color: var(--gallery-text-muted);">
                    <% if (cardImagesList.length > 1) { %>
                      📸 <%= cardImagesList.length %> फ़ोटो एल्बम
                    <% } else { %>
                      अभियान के सदस्य
                    <% } %>
                  </span>
                  <span class="card-action-link">
                    <%= cardImagesList.length > 1 ? 'सभी फ़ोटो देखें' : 'फ़ोटो देखें' %>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </article>
          <% }); %>
        <% } %>

        <!-- EMPTY STATE (Hidden by default, shown by JS if 0 matches) -->
        <div class="gallery-empty" id="galleryEmptyState" style="display: none;">
          <div class="gallery-empty-icon">🔍</div>
          <h3>कोई फ़ोटो नहीं मिली</h3>
          <p>आपकी खोज या चुने गए ज़िले से मेल खाने वाली कोई फ़ोटो नहीं मिली। खोज शब्द या ज़िला बदलकर फिर कोशिश करें।</p>
        </div>
      </section>

      <div id="galleryPaginationHost">
      <% if (pagination && pagination.total > 0) { %>
        <% const galleryPageUrl = (pageNumber) => { const params = new URLSearchParams(); if (selectedDistrict !== 'all') params.set('district', selectedDistrict); if (search) params.set('search', search); params.set('page', String(pageNumber)); return '/gallery?' + params.toString(); }; %>
        <nav class="gallery-pagination" id="galleryPagination" aria-label="Gallery pages">
          <div class="gallery-pagination-controls">
            <% if (pagination.page > 1) { %><a class="pagination-direction" href="<%= galleryPageUrl(pagination.page - 1) %>"><span aria-hidden="true">‹</span> Previous</a><% } else { %><span class="pagination-direction is-disabled"><span aria-hidden="true">‹</span> Previous</span><% } %>
            <div class="pagination-pages">
              <% const galleryPageNumbers = [...new Set([1, 2, 3, 4, pagination.page - 1, pagination.page, pagination.page + 1, pagination.totalPages].filter((number) => number >= 1 && number <= pagination.totalPages))].sort((a, b) => a - b); let previousGalleryPage = 0; %>
              <% galleryPageNumbers.forEach((number) => { %>
                <% if (previousGalleryPage && number > previousGalleryPage + 1) { %><span class="pagination-ellipsis" aria-hidden="true">…</span><% } %>
                <a class="pagination-number <%= number === pagination.page ? 'is-current' : '' %>" href="<%= galleryPageUrl(number) %>" <%= number === pagination.page ? 'aria-current="page"' : '' %>><%= number %></a>
                <% previousGalleryPage = number; %>
              <% }); %>
            </div>
            <% if (pagination.page < pagination.totalPages) { %><a class="pagination-direction" href="<%= galleryPageUrl(pagination.page + 1) %>">Next <span aria-hidden="true">›</span></a><% } else { %><span class="pagination-direction is-disabled">Next <span aria-hidden="true">›</span></span><% } %>
          </div>
        </nav>
      <% } %>
      </div>


    </main>

    <!-- FULLSCREEN LIGHTBOX / MODAL (PURE PHOTO SHOWCASE) -->
    <div class="gallery-lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="Photo Lightbox">
      <!-- Close button -->
      <button type="button" class="lightbox-close-btn" id="lightboxCloseBtn" aria-label="Close" title="बंद करें (Close)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <!-- Previous button (< arrow) -->
      <button type="button" class="lightbox-nav-btn lightbox-nav-prev" id="lightboxPrevBtn" aria-label="पिछली फ़ोटो" title="पिछली फ़ोटो (Previous)">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.8"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <!-- Next button (> arrow) -->
      <button type="button" class="lightbox-nav-btn lightbox-nav-next" id="lightboxNextBtn" aria-label="अगली फ़ोटो" title="अगली फ़ोटो (Next)">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.8"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <!-- Content Box (Pure Photo Showcase - No Text) -->
      <div class="lightbox-content-box" onclick="event.stopPropagation();">
        <div class="lightbox-photo-counter" id="lightboxCounter" style="display: none;">1 / 1</div>
        <div class="lightbox-main-img-holder">
          <img id="lightboxImg" src="" alt="फ़ोटो" />
        </div>
        <div class="lightbox-thumb-strip" id="lightboxThumbStrip" style="display: none;"></div>
      </div>
    </div>

    <!-- Footer -->
    <%- include("common/footer") %>

    <!-- Scripts -->
    <script src="/js/sidebar.js"></script>
    <script src="/js/components/location-filter.js"></script>
    <script src="/js/gallery.js"></script>
  </body>
</html>
