<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>निषाद संकल्प अभियान</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@500;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --red:#D72A2A; --red-deep:#8C1A1A; --gold:#E7A93C; --cream:#FBF4EC;
    --ink:#2A1414; --ink-soft:#6B4F4F; --line:#E9D9C8; --card:#FFFFFF;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;scroll-padding-top:80px}
  body{
    font-family:'Noto Sans Devanagari',sans-serif;
    background:var(--cream);
    color:var(--ink);
    line-height:1.65;
    overflow-x:hidden;
    padding-top:env(safe-area-inset-top,0px);
  }
  h1,h2,h3,.brand{font-family:'Noto Serif Devanagari',serif}
  img{max-width:100%;display:block}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}

  /* ============================================================
     NAVBAR — single line on desktop, side drawer on mobile
     ============================================================ */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(251,244,236,.95);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
    padding-top:env(safe-area-inset-top,0px);
  }
  nav{
    max-width:1120px;margin:0 auto;
    padding:12px 24px;
    display:flex;align-items:center;justify-content:space-between;
    gap:16px;
  }
  .brand{
    display:flex;align-items:center;gap:10px;
    font-weight:700;font-size:1.12rem;
    color:var(--red-deep);
    white-space:nowrap;
    flex-shrink:0;
  }
  .brand .mark{
    width:36px;height:36px;border-radius:50%;
    background:conic-gradient(from 210deg,var(--red),var(--gold),var(--red));
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-weight:800;font-family:'Noto Serif Devanagari',serif;
    flex-shrink:0;font-size:.95rem;
  }

  /* Desktop nav links — single horizontal line */
  .nav-links{
    display:flex;align-items:center;gap:4px;
    list-style:none;flex-wrap:nowrap;
  }
  .nav-links a{
    display:block;
    padding:9px 18px;
    border-radius:999px;
    font-weight:600;font-size:.96rem;
    color:var(--ink-soft);
    white-space:nowrap;
    transition:background .2s,color .2s;
  }
  .nav-links a:hover,.nav-links a:focus-visible{
    background:var(--red);color:#fff;
  }

  /* Hamburger — hidden on desktop */
  .burger{
    display:none;background:none;border:none;cursor:pointer;
    padding:8px;z-index:70;flex-shrink:0;
  }
  .burger span{
    display:block;width:26px;height:2.5px;
    background:var(--red-deep);margin:5px 0;
    transition:.28s;border-radius:3px;
  }
  .burger.open span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
  .burger.open span:nth-child(2){opacity:0}
  .burger.open span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}

  /* Drawer overlay */
  .drawer-overlay{
    position:fixed;inset:0;
    background:rgba(42,20,20,.5);
    opacity:0;visibility:hidden;
    transition:.3s;z-index:55;
  }
  .drawer-overlay.open{opacity:1;visibility:visible}

  /* Mobile styles */
  @media(max-width:860px){
    .burger{display:block}
    .nav-links{
      position:fixed;
      top:0;right:0;
      height:100vh;height:100dvh;
      width:min(310px,86vw);
      background:var(--cream);
      flex-direction:column;
      align-items:stretch;
      gap:0;
      padding:84px 22px 28px;
      border-left:1px solid var(--line);
      box-shadow:-12px 0 40px rgba(0,0,0,.18);
      transform:translateX(110%);
      transition:transform .35s cubic-bezier(.4,0,.2,1);
      z-index:56;
      overflow-y:auto;
    }
    .nav-links.open{transform:translateX(0)}
    .nav-links li{width:100%}
    .nav-links a{
      padding:16px 14px;
      border-bottom:1px solid var(--line);
      border-radius:8px;
      font-size:1.05rem;
      white-space:normal;
    }
    .nav-links a:hover{background:var(--red);color:#fff;padding-left:20px}
  }
  @media(min-width:861px){
    .drawer-overlay{display:none}
  }
  @media(max-width:400px){
    .brand{font-size:1rem}
    .brand .mark{width:32px;height:32px;font-size:.85rem}
  }

  /* ============================================================
     HERO
     ============================================================ */
  .hero{
    position:relative;
    padding:100px 24px 80px;
    text-align:center;
    overflow:hidden;
    background:
      radial-gradient(ellipse at 20% -10%, rgba(215,42,42,.14), transparent 55%),
      radial-gradient(ellipse at 100% 0%, rgba(231,169,60,.18), transparent 50%);
  }
  @media(max-width:600px){.hero{padding:70px 20px 60px}}
  .kicker{
    display:inline-block;
    color:var(--red-deep);font-weight:600;
    background:#fff;border:1px solid var(--line);
    padding:6px 16px;border-radius:999px;
    font-size:.9rem;margin-bottom:22px;
  }
  .hero h1{
    font-size:clamp(2rem,6vw,3.8rem);
    font-weight:800;color:var(--red-deep);
    line-height:1.2;max-width:16ch;
    margin:0 auto 20px;
  }
  .hero h1 .accent{color:var(--gold)}
  .hero p{
    max-width:52ch;margin:0 auto 34px;
    color:var(--ink-soft);font-size:clamp(1rem,2.5vw,1.1rem);
  }
  .hero-actions{
    display:flex;gap:14px;justify-content:center;flex-wrap:wrap;
  }
  .btn{
    padding:14px 30px;border-radius:10px;
    font-weight:700;font-size:1rem;
    border:2px solid transparent;
    transition:transform .18s,box-shadow .18s;
    display:inline-block;cursor:pointer;font-family:inherit;
    text-align:center;
  }
  .btn-primary{
    background:var(--red);color:#fff;
    box-shadow:0 10px 24px -10px rgba(215,42,42,.6);
  }
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 30px -10px rgba(215,42,42,.7)}
  .btn-ghost{border-color:var(--red-deep);color:var(--red-deep);background:transparent}
  .btn-ghost:hover{background:var(--red-deep);color:#fff}

  .stats{
    display:flex;justify-content:center;flex-wrap:wrap;
    margin-top:60px;border-top:1px solid var(--line);
  }
  .stats div{
    padding:24px 32px;text-align:center;
    border-right:1px solid var(--line);
    flex:0 0 auto;
  }
  .stats div:last-child{border-right:none}
  .stats strong{
    display:block;font-family:'Noto Serif Devanagari',serif;
    font-size:2rem;color:var(--red);line-height:1.2;
  }
  .stats span{color:var(--ink-soft);font-size:.9rem}
  @media(max-width:600px){
    .stats div{padding:16px 18px;flex:1 1 45%;border-right:none;border-bottom:1px solid var(--line)}
    .stats div:nth-child(odd){border-right:1px solid var(--line)}
    .stats div:nth-last-child(-n+2){border-bottom:none}
    .stats strong{font-size:1.5rem}
  }

  /* ============================================================
     SECTIONS
     ============================================================ */
  section{padding:80px 0}
  @media(max-width:600px){section{padding:56px 0}}
  .sec-head{max-width:640px;margin:0 auto 44px;text-align:center;padding:0 20px}
  .sec-head h2{font-size:clamp(1.6rem,4.5vw,2.5rem);color:var(--red-deep);margin-bottom:14px}
  .sec-head p{color:var(--ink-soft);font-size:clamp(.95rem,2.2vw,1.05rem)}
  .divider{width:60px;height:4px;background:var(--gold);border-radius:4px;margin:0 auto 20px}

  /* ============================================================
     ABOUT
     ============================================================ */
  #about{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .about-grid{
    display:grid;grid-template-columns:1.05fr .95fr;
    gap:56px;align-items:center;
  }
  @media(max-width:860px){.about-grid{grid-template-columns:1fr;gap:36px}}
  .about-copy h3{color:var(--red-deep);font-size:clamp(1.25rem,3.5vw,1.5rem);margin-bottom:14px}
  .about-copy p{color:var(--ink-soft);margin-bottom:16px;font-size:clamp(.95rem,2.2vw,1.02rem)}
  .pillars{list-style:none;display:grid;gap:14px;margin-top:22px}
  .pillars li{
    display:flex;gap:14px;align-items:flex-start;
    background:var(--cream);border:1px solid var(--line);
    border-radius:12px;padding:16px 18px;
  }
  .pillars .num{
    flex-shrink:0;width:34px;height:34px;border-radius:50%;
    background:var(--red);color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-weight:700;font-family:'Noto Serif Devanagari',serif;
  }
  .pillars b{color:var(--red-deep)}

  .about-visual{
    position:relative;aspect-ratio:4/5;
    border-radius:20px;overflow:hidden;
    box-shadow:0 25px 50px -12px rgba(215,42,42,.35);
    max-width:100%;
  }
  .about-visual img{
    width:100%;height:100%;object-fit:cover;
    display:block;transition:transform .6s ease;
  }
  .about-visual:hover img{transform:scale(1.05)}
  .about-visual .overlay{
    position:absolute;inset:0;
    background:linear-gradient(to top, rgba(140,26,26,.92) 0%, rgba(140,26,26,.3) 40%, transparent 70%);
    display:flex;flex-direction:column;justify-content:flex-end;
    padding:32px 26px;
  }
  .about-visual .overlay span{
    color:#fff;font-family:'Noto Serif Devanagari',serif;
    font-size:clamp(1.1rem,3.5vw,1.4rem);font-weight:700;
    line-height:1.3;display:block;margin-bottom:8px;
  }
  .about-visual .overlay small{
    color:var(--gold);font-weight:600;font-size:.85rem;
    letter-spacing:.5px;text-transform:uppercase;
  }
  .about-visual .badge{
    position:absolute;top:18px;right:18px;
    background:var(--gold);color:#3a1c00;
    padding:7px 14px;border-radius:999px;
    font-weight:700;font-size:.78rem;z-index:3;
    box-shadow:0 6px 16px rgba(0,0,0,.15);
  }

  /* ============================================================
     NEWS
     ============================================================ */
  #news{background:var(--cream)}
  .news-grid{
    display:grid;grid-template-columns:1.1fr .9fr;gap:26px;
  }
  @media(max-width:860px){.news-grid{grid-template-columns:1fr}}
  .card{
    background:var(--card);border:1px solid var(--line);
    border-radius:16px;overflow:hidden;
    display:flex;flex-direction:column;
    transition:transform .2s,box-shadow .2s;
  }
  .card:hover{box-shadow:0 12px 28px -8px rgba(215,42,42,.18)}
  .video-box{position:relative;aspect-ratio:16/9;background:#000;overflow:hidden}
  .video-tag{
    position:absolute;top:14px;left:14px;
    background:var(--gold);color:#3a1c00;
    font-weight:700;font-size:.78rem;
    padding:5px 12px;border-radius:999px;z-index:2;
  }
  .card-body{padding:20px 22px}
  .card-body h3{color:var(--red-deep);font-size:clamp(1rem,2.5vw,1.15rem);margin-bottom:8px}
  .card-body p{color:var(--ink-soft);font-size:.95rem}
  .card-body .meta{
    color:var(--red);font-weight:600;font-size:.85rem;
    margin-bottom:8px;display:block;
  }

  /* News list with paper-style images */
  .news-list{display:flex;flex-direction:column;gap:18px}
  .news-list .card{flex-direction:row;align-items:stretch;cursor:pointer}
  .news-list .thumb{
    width:130px;flex-shrink:0;
    position:relative;overflow:hidden;
  }
  .news-list .thumb img{
    width:100%;height:100%;object-fit:cover;display:block;
    transition:transform .5s ease;
  }
  .news-list .card:hover .thumb img{transform:scale(1.1)}
  .news-list .thumb::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(135deg, rgba(215,42,42,.35), rgba(231,169,60,.15));
    mix-blend-mode:multiply;
  }
  .news-list .thumb .paper-num{
    position:absolute;bottom:8px;left:8px;
    background:#fff;color:var(--red-deep);
    font-weight:800;font-family:'Noto Serif Devanagari',serif;
    font-size:.9rem;width:30px;height:30px;
    border-radius:50%;display:flex;
    align-items:center;justify-content:center;
    box-shadow:0 4px 10px rgba(0,0,0,.2);z-index:2;
  }
  .news-list .card-body{padding:16px 18px;flex:1;min-width:0}
  .news-list .card-body h3{font-size:clamp(.9rem,2.3vw,1rem);margin-bottom:6px}
  @media(max-width:520px){
    .news-list .thumb{width:96px}
    .news-list .card-body{padding:12px 14px}
  }

  /* ============================================================
     VIDEOS
     ============================================================ */
  #videos{background:#fff;border-top:1px solid var(--line)}
  .filters{
    display:flex;gap:14px;flex-wrap:wrap;
    justify-content:center;margin-bottom:30px;
  }
  .filter-field{display:flex;flex-direction:column;gap:6px;min-width:200px;flex:0 1 220px}
  @media(max-width:560px){.filter-field{flex:1 1 100%}}
  .filter-field label{font-size:.85rem;font-weight:600;color:var(--red-deep)}
  .filter-field select{
    padding:11px 14px;border-radius:10px;
    border:1.5px solid var(--line);background:var(--cream);
    color:var(--ink);font-family:inherit;font-size:.95rem;cursor:pointer;
    width:100%;
  }
  .filter-field select:focus-visible{outline:3px solid var(--gold)}
  .reset-btn{
    align-self:flex-end;padding:11px 20px;border-radius:10px;
    border:1.5px solid var(--red-deep);background:transparent;
    color:var(--red-deep);font-weight:600;font-family:inherit;
    cursor:pointer;font-size:.92rem;transition:.2s;
  }
  .reset-btn:hover{background:var(--red-deep);color:#fff}
  @media(max-width:560px){.reset-btn{align-self:stretch;width:100%}}
  .result-count{
    text-align:center;color:var(--ink-soft);
    font-size:.9rem;margin-bottom:24px;padding:0 16px;
  }
  .video-grid{
    display:grid;grid-template-columns:repeat(3,1fr);
    gap:22px;
  }
  @media(max-width:900px){.video-grid{grid-template-columns:repeat(2,1fr);gap:18px}}
  @media(max-width:560px){.video-grid{grid-template-columns:1fr;gap:18px}}

  .vcard{
    border-radius:14px;overflow:hidden;
    border:1px solid var(--line);background:var(--cream);
    transition:transform .25s,box-shadow .25s;
    cursor:pointer;position:relative;
    display:flex;flex-direction:column;
  }
  .vcard:hover{transform:translateY(-6px);box-shadow:0 20px 40px -14px rgba(215,42,42,.3)}
  .vcard .thumb{
    position:relative;aspect-ratio:16/9;overflow:hidden;background:#000;
  }
  .vcard .thumb img{
    width:100%;height:100%;object-fit:cover;display:block;
    transition:transform .5s ease;
  }
  .vcard:hover .thumb img{transform:scale(1.08)}
  .vcard .thumb::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(to top, rgba(0,0,0,.55), transparent 60%);
  }
  .play-btn{
    position:absolute;inset:0;display:flex;
    align-items:center;justify-content:center;z-index:3;
  }
  .play-btn .circle{
    width:60px;height:60px;border-radius:50%;
    background:rgba(215,42,42,.95);
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-size:1.5rem;
    box-shadow:0 8px 24px rgba(0,0,0,.35);
    transition:transform .25s;border:3px solid rgba(255,255,255,.9);
  }
  .vcard:hover .play-btn .circle{transform:scale(1.12);background:var(--red)}
  .vcard .card-body{padding:16px 18px;flex:1;display:flex;flex-direction:column;justify-content:space-between}
  .vcard h3{font-size:clamp(.95rem,2.3vw,1.02rem);margin-bottom:6px;color:var(--red-deep);line-height:1.4}
  .vcard .loc{
    font-size:.82rem;color:var(--ink-soft);
    display:flex;align-items:center;gap:6px;
  }
  .vcard .loc i{color:var(--gold)}
  .no-result{
    text-align:center;color:var(--ink-soft);
    padding:40px 16px;grid-column:1/-1;font-size:1rem;
  }

  /* ============================================================
     VIDEO MODAL PLAYER
     ============================================================ */
  .video-modal{
    position:fixed;inset:0;
    background:rgba(20,5,5,.94);
    backdrop-filter:blur(8px);
    z-index:200;display:flex;
    align-items:center;justify-content:center;
    padding:20px;opacity:0;visibility:hidden;
    transition:.3s;
  }
  .video-modal.open{opacity:1;visibility:visible}
  .modal-content{
    position:relative;width:100%;max-width:960px;
    background:#000;border-radius:16px;
    overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,.6);
    transform:scale(.92);
    transition:transform .35s cubic-bezier(.4,0,.2,1);
  }
  .video-modal.open .modal-content{transform:scale(1)}
  .modal-content iframe{
    width:100%;aspect-ratio:16/9;display:block;
    border:0;background:#000;
  }
  .modal-close{
    position:absolute;top:-54px;right:0;
    background:rgba(255,255,255,.15);
    border:1.5px solid rgba(255,255,255,.4);
    color:#fff;width:44px;height:44px;
    border-radius:50%;font-size:1.3rem;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    transition:.2s;backdrop-filter:blur(6px);
    z-index:10;
  }
  .modal-close:hover{background:var(--red);border-color:var(--red);transform:rotate(90deg)}
  .modal-info{
    background:var(--cream);padding:18px 24px;
    display:flex;justify-content:space-between;
    align-items:center;gap:16px;flex-wrap:wrap;
  }
  .modal-info h3{color:var(--red-deep);font-size:clamp(1rem,2.5vw,1.15rem);margin:0}
  .modal-info .loc{color:var(--ink-soft);font-size:.9rem;display:flex;align-items:center;gap:6px}
  .modal-info .loc i{color:var(--gold)}
  @media(max-width:600px){
    .video-modal{padding:14px}
    .modal-close{top:-48px;width:40px;height:40px;font-size:1.1rem}
    .modal-info{padding:14px 18px}
  }

  /* ============================================================
     CTA BAND + FOOTER
     ============================================================ */
  .cta-band{
    background:linear-gradient(120deg,var(--red-deep),var(--red));
    color:#fff;text-align:center;padding:70px 24px;
  }
  .cta-band h2{
    font-size:clamp(1.5rem,4vw,2.3rem);
    margin-bottom:14px;font-family:'Noto Serif Devanagari',serif;
  }
  .cta-band p{opacity:.9;max-width:50ch;margin:0 auto 28px}
  .cta-band .btn-primary{background:#fff;color:var(--red-deep);box-shadow:none}

  footer{background:#210606;color:#e9cfcf;padding:50px 24px 30px}
  .foot-grid{
    display:grid;grid-template-columns:1.3fr 1fr 1fr;
    gap:34px;max-width:1120px;margin:0 auto;
  }
  @media(max-width:700px){.foot-grid{grid-template-columns:1fr;gap:26px}}
  .foot-grid h4{
    color:#fff;font-family:'Noto Serif Devanagari',serif;
    margin-bottom:14px;font-size:1.05rem;
  }
  .foot-grid ul{list-style:none;display:flex;flex-direction:column;gap:9px}
  .foot-grid a:hover{color:#fff}
  .foot-bottom{
    max-width:1120px;margin:36px auto 0;
    padding-top:22px;border-top:1px solid #4a1a1a;
    font-size:.85rem;opacity:.75;text-align:center;
  }
  ::selection{background:var(--red);color:#fff}
  :focus-visible{outline:3px solid var(--gold);outline-offset:2px}
</style>
</head>
<body>

<header>
  <nav>
    <a href="#home" class="brand"><span class="mark">नि</span>निषाद संकल्प अभियान</a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#home">होम</a></li>
      <li><a href="#about">परिचय</a></li>
      <li><a href="#news">समाचार</a></li>
      <li><a href="#videos">संकल्प वीडियो</a></li>
    </ul>
    <button class="burger" id="burgerBtn" aria-label="मेनू खोलें" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>
<div class="drawer-overlay" id="drawerOverlay"></div>

<section id="home" class="hero">
  <span class="kicker">समाज सेवा • एकता • संकल्प</span>
  <h1>निषाद समाज के <span class="accent">उत्थान</span> का संकल्प, हर गाँव तक</h1>
  <p>शिक्षा, स्वाभिमान और समान अधिकार के लिए निषाद समाज को संगठित करने वाला एक जनआंदोलन — आइए मिलकर अभियान को आगे बढ़ाएँ।</p>
  <div class="hero-actions">
    <a href="#videos" class="btn btn-primary">संकल्प वीडियो देखें</a>
    <a href="#about" class="btn btn-ghost">अभियान को जानें</a>
  </div>
