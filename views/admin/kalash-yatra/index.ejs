                          ]).join('\n') %></textarea>
                          <span class="help-hint">प्रत्येक नई पंक्ति एक चेकपॉइंट बैज बनाएगी।</span>
                        </div>

                        <div style="margin-top: 24px;">
                          <button type="submit" class="admin-btn admin-btn-primary">
