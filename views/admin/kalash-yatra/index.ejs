                                <tr>
                                  <td><strong><%= index + 1 %></strong></td>
                                  <td>
                                    <span style="font-weight: 800; color: #991b1b; background: #fee2e2; border: 1px solid #fecaca; padding: 4px 10px; border-radius: 6px; font-size: 12.5px; display: inline-flex; align-items: center; gap: 6px;">
                                      📧 <%= log.adminEmail %>
                                    </span>
                                  </td>
                                  <td>
                                    <strong style="color: var(--admin-text-dark);"><%= log.adminName || 'Admin' %></strong>
                                  </td>
                                  <td>
                                    <span class="activity-section-pill"><%= log.section %></span>
                                  </td>
                                  <td>
                                    <div style="font-weight: 700; color: #1c1917; margin-bottom: 2px;"><%= log.action %></div>
                                    <small style="color: #57534e; font-size: 11.5px;"><%= log.details %></small>
                                  </td>
                                  <td>
                                    <div style="font-weight: 600; color: #44403c; font-size: 12px; white-space: nowrap;">
                                      📅 <%= new Date(log.createdAt).toLocaleString('hi-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) %>
                                    </div>
                                  </td>
                                  <td style="text-align: center;">
                                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 6px; background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; font-size: 11px; font-weight: 700;" title="यह रिकॉर्ड स्थायी है और हटाया या बदला नहीं जा सकता">
                                      🛡️ सुरक्षित रिकॉर्ड
                                    </span>
                                  </td>
                                </tr>
                              <% }) %>
                            <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                <% } %>

            <!-- ====================================================
