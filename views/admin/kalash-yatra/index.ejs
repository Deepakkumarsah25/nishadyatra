<%- include("../common/header") %>
  <%- include("../common/sidebar") %>

<style>
  .ky-nav-tabs {
    display: flex;
    gap: 8px;
    background: #ffffff;
    padding: 8px 12px;
    border-radius: 14px;
    border: 1px solid var(--admin-border);
    margin-bottom: 24px;
    overflow-x: auto;
    box-shadow: var(--admin-shadow-sm);
  }

      .ky-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        color: #63534d;
        background: transparent;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
        text-decoration: none;
      }

      .ky-tab-btn:hover {
        background: var(--admin-primary-light);
        color: var(--admin-primary);
      }

      .ky-tab-btn.active {
        background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-dark));
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(215, 42, 42, 0.25);
      }

      .ky-tab-btn svg {
        width: 16px;
        height: 16px;
      }

      .form-section-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--admin-primary-dark);
        margin: 22px 0 12px;
        padding-bottom: 6px;
        border-bottom: 1.5px dashed var(--admin-border);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .form-section-title:first-child {
        margin-top: 0;
      }

      .milestone-editor-card {
        background: #faf7f5;
        border: 1px solid var(--admin-border);
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 16px;
        position: relative;
        transition: border-color 0.2s;
      }

      .milestone-editor-card:hover {
        border-color: var(--admin-primary);
      }

      .milestone-badge-pill {
        display: inline-block;
        padding: 3px 10px;
        background: #ffe8e2;
        color: var(--admin-primary-dark);
        font-size: 11px;
        font-weight: 800;
        border-radius: 20px;
        margin-bottom: 12px;
      }

      .video-table-wrap {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--admin-border);
        overflow: hidden;
        box-shadow: var(--admin-shadow-sm);
      }

      .video-list-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
      }

      .video-list-table th {
        background: #faf7f5;
        padding: 14px 16px;
        text-align: left;
        font-weight: 800;
        color: #63534d;
        border-bottom: 1px solid var(--admin-border);
      }

      .video-list-table td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--admin-border);
        vertical-align: middle;
      }

      .video-list-table tr:last-child td {
        border-bottom: none;
      }

      .video-list-table tr:hover td {
        background: #fffafa;
      }

      .table-actions {
        display: flex;
        gap: 8px;
      }

      .btn-sm-action {
        padding: 5px 10px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
      }

      .btn-edit {
        background: #f0f4ff;
        color: #2563eb;
      }

      .btn-edit:hover {
        background: #dbeafe;
      }

      .btn-del {
        background: #fff1f2;
        color: #e11d48;
      }

      .btn-del:hover {
        background: #ffe4e6;
      }

      .category-badge {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
      }

      .badge-yatra {
        background: #fee2e2;
        color: #b91c1c;
      }

      .badge-program {
        background: #fef3c7;
        color: #b45309;
      }

      .badge-speech {
        background: #e0e7ff;
        color: #4338ca;
      }

      .help-hint {
        font-size: 11.5px;
        color: #8c7870;
        margin-top: 4px;
        line-height: 1.4;
      }
    
      /* Video Edit Modal */
      .modal-backdrop-admin {
        position: fixed;
        inset: 0;
        background: rgba(15, 7, 7, 0.65);
        backdrop-filter: blur(5px);
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }

      .modal-backdrop-admin.active {
        display: flex;
      }

      .modal-dialog-admin {
        background: #ffffff;
        border-radius: 16px;
        max-width: 760px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
        border: 1px solid var(--admin-border);
        animation: modalSlideIn 0.25s ease-out;
      }

      @keyframes modalSlideIn {
        from {
          opacity: 0;
          transform: translateY(20px) scale(0.97);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .modal-header-admin {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 22px;
        border-bottom: 1px solid var(--admin-border);
        background: #faf7f5;
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .modal-header-admin h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 800;
        color: #7f1d1d;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .modal-close-btn {
        background: none;
        border: none;
        font-size: 24px;
        line-height: 1;
        color: #8c7870;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
      }

      .modal-close-btn:hover {
        color: #b91c1c;
        background: #fee2e2;
      }

      .modal-body-admin {
        padding: 22px;
      }
    
      /* Activity History & Audit Log Styles */
      .activity-audit-banner {
        background: #ffffff;
        border: 1.5px solid #fed7aa;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 22px;
        box-shadow: 0 4px 15px rgba(217, 119, 6, 0.08);
      }

      .activity-audit-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid #ffedd5;
      }

      .activity-audit-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 800;
        color: #9a3412;
      }

      .activity-audit-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        font-size: 11.5px;
        font-weight: 700;
      }

      .activity-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 14px;
      }

      .activity-card-item {
        background: #fffaf5;
        border: 1px solid #fed7aa;
        border-radius: 10px;
        padding: 12px 16px;
        position: relative;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .activity-card-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(217, 119, 6, 0.12);
        border-color: #f97316;
      }

      .activity-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
      }

      .activity-rank-badge {
        font-size: 11px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 6px;
        background: #fee2e2;
        color: #991b1b;
        letter-spacing: 0.3px;
      }

      .activity-timestamp {
        font-size: 11.5px;
        color: #78716c;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .activity-card-row {
        font-size: 12.5px;
        color: #44403c;
        margin-bottom: 5px;
        line-height: 1.5;
      }

      .activity-card-row:last-child {
        margin-bottom: 0;
      }

      .activity-label {
        font-weight: 700;
        color: #78716c;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-right: 4px;
      }

      .activity-email-val {
        font-weight: 800;
        color: #b91c1c;
        background: #fff1f2;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #fecdd3;
      }

      .activity-section-pill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        background: #fef3c7;
        color: #92400e;
        font-weight: 700;
        font-size: 11.5px;
        border: 1px solid #fde68a;
      }
    </style>

    <div class="admin-main">
      <!-- Topbar -->
      <header class="admin-topbar">
        <div class="topbar-left">
          <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
          <div class="page-heading">
            <h1>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)"
                stroke-width="2.2">
                <path
                  d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              संकल्प यात्रा प्रबंधन (Sankalp Yatra Management)
            </h1>
            <p>संकल्प यात्रा के मुख्य हेडर, 5 मुख्य पड़ाव, वीडियो संकलन व संकल्प पत्र का प्रबंधन करें</p>
          </div>
        </div>
        <div class="topbar-right">
          <a href="/video" target="_blank" class="view-site-btn">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            <span>View Live Page</span>
          </a>
        </div>
      </header>

      <!-- Body -->
      <div class="admin-body">
        <% if (message) { %>
          <div class="admin-alert admin-alert-success">✓ <%= message %>
          </div>
          <% } %>
            <% if (error) { %>
              <div class="admin-alert admin-alert-error">⚠ <%= error %>
              </div>
              <% } %>

                
            <!-- ====================================================
                 LAST 2 CHANGES AUDIT BANNER (अंतिम 2 बदलाव)
            ===================================================== -->
            <div class="activity-audit-banner">
              <div class="activity-audit-header">
                <div class="activity-audit-title">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  <span>🕒 अंतिम 2 बदलाव का विवरण (Last 2 Admin Changes Audit)</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="activity-audit-badge">
                    🔒 स्थायी व सुरक्षित ऑडिट ट्रेल
                  </span>
                  <a href="/admin/kalash-yatra?tab=history" class="btn-sm-action" style="background: #ffedd5; color: #9a3412; border: 1px solid #fed7aa; padding: 4px 10px; font-size: 11.5px; text-decoration: none;">
                    📋 पूरा इतिहास देखें →
                  </a>
                </div>
              </div>

              <div class="activity-cards-grid">
                <% if (typeof lastTwoChanges !== 'undefined' && lastTwoChanges && lastTwoChanges.length > 0) { %>
                  <% lastTwoChanges.forEach((log, idx) => { %>
                    <div class="activity-card-item">
                      <div class="activity-card-top">
                        <span class="activity-rank-badge">#<%= idx + 1 %> अंतिम बदलाव</span>
                        <span class="activity-timestamp">
                          📅 <%= new Date(log.createdAt).toLocaleString('hi-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) %>
                        </span>
                      </div>
                      <div class="activity-card-row">
                        <span class="activity-label">📧 एडमिन Gmail:</span>
                        <strong class="activity-email-val"><%= log.adminEmail %></strong>
                        <% if (log.adminName) { %><small style="color: #78716c;">(<%= log.adminName %>)</small><% } %>
                      </div>
                      <div class="activity-card-row">
                        <span class="activity-label">📂 बदला गया सेक्शन:</span>
                        <span class="activity-section-pill"><%= log.section %></span>
                      </div>
                      <div class="activity-card-row">
                        <span class="activity-label">⚡ क्या बदलाव हुआ:</span>
                        <strong style="color: #1c1917;"><%= log.action %></strong>
                        <% if (log.details) { %><div style="font-size: 11.5px; color: #57534e; margin-top: 2px;"><%= log.details %></div><% } %>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div style="grid-column: 1 / -1; padding: 12px; text-align: center; color: #78716c; font-size: 12.5px;">
                    वर्तमान में कोई बदलाव रिकॉर्ड नहीं है। नए बदलाव होने पर यहाँ एडमिन का Gmail और विवरण प्रदर्शित होगा।
                  </div>
                <% } %>
              </div>
            </div>

                <!-- Navigation Tabs -->
                <div class="ky-nav-tabs">
                  <a href="/admin/kalash-yatra?tab=hero" class="ky-tab-btn <%= activeTab === 'hero' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2" />
                      <line x1="3" y1="9" x2="21" y2="9" />
                      <line x1="9" y1="21" x2="9" y2="9" />
                    </svg>
                    <span>1. Hero & Statistics</span>
                  </a>
                  <a href="/admin/kalash-yatra?tab=milestones"
                    class="ky-tab-btn <%= activeTab === 'milestones' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polygon points="12 2 2 7 12 12 22 7 12 2" />
                      <polyline points="2 17 12 22 22 17" />
                      <polyline points="2 12 12 17 22 12" />
                    </svg>
                    <span>2. Yatra Milestones (5 Stops)</span>
                  </a>
                  <a href="/admin/kalash-yatra?tab=videos"
                    class="ky-tab-btn <%= activeTab === 'videos' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="2" width="20" height="20" rx="2.18" />
                      <line x1="7" y1="2" x2="7" y2="22" />
                      <line x1="17" y1="2" x2="17" y2="22" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                    </svg>
                    <span>3. Video Gallery (<%= kalash.videos ? kalash.videos.length : 0 %>)</span>
                  </a>
                  <a href="/admin/kalash-yatra?tab=pledge"
                    class="ky-tab-btn <%= activeTab === 'pledge' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <span>4. लोकतांत्रिक महा-संकल्प (Pledge)</span>
                  </a>
                  <a href="/admin/kalash-yatra?tab=history"
                    class="ky-tab-btn <%= activeTab === 'history' ? 'active' : '' %>"
                    style="<%= activeTab === 'history' ? 'background: #991b1b; color: #fff; border-color: #7f1d1d;' : 'background: #fff7ed; color: #c2410c; border-color: #fed7aa;' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span>5. 📋 गतिविधि इतिहास (Activity Log)</span>
                  </a>
                </div>

                <!-- ====================================================
         TAB 1: HERO & STATS
    ===================================================== -->
                <% if (activeTab==='hero' ) { %>
                  <div class="admin-card">
                    <div class="admin-card-header">
                      <h3>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                          stroke-width="2">
                          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                        </svg>
                        Hero Section Titles, Statistics & Featured Video
                      </h3>
                    </div>

                    <div class="admin-card-body">
                      <form action="/admin/kalash-yatra/hero" method="POST">

                        <div class="form-section-title">🚩 Main Title & Badge</div>
                        <div class="form-grid-2">
                          <div class="form-group">
                            <label for="liveBadgeText">Live Badge Text</label>
                            <input type="text" id="liveBadgeText" name="liveBadgeText" class="form-control"
                              value="<%= kalash.hero.liveBadgeText %>" required />
                            <span class="help-hint">e.g. Sacred Pledge Campaign • National Mega Event</span>
                          </div>
                          <div class="form-group">
                            <label for="headingMain">Main Heading (Primary)</label>
                            <input type="text" id="headingMain" name="headingMain" class="form-control"
                              value="<%= kalash.hero.headingMain %>" required />
                          </div>
                        </div>

                        <div class="form-group">
                          <label for="headingHighlight">Highlight Heading (Accent)</label>
                          <input type="text" id="headingHighlight" name="headingHighlight" class="form-control"
                            value="<%= kalash.hero.headingHighlight %>" required />
                        </div>

                        <div class="form-group">
                          <label for="subheading">Subheading</label>
                          <textarea id="subheading" name="subheading" rows="3" class="form-control"
                            required><%= kalash.hero.subheading %></textarea>
                        </div>

                        <div class="form-group">
                          <label for="highlights">Key Highlights (One point per line)</label>
                          <textarea id="highlights" name="highlights" rows="3"
                            class="form-control"><%= (kalash.hero.highlights || []).join('\n') %></textarea>
                          <span class="help-hint">Each line will create a checkmark bullet point.</span>
                        </div>

                        <div class="form-section-title">📊 4 Key Numerical Statistics (Stats Strip)</div>
                        <div
                          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
                          <% (kalash.hero.stats || []).forEach((st, idx)=> { %>
                            <div
                              style="background: #faf7f5; padding: 14px; border-radius: 10px; border: 1px solid var(--admin-border);">
                              <strong style="color: var(--admin-primary-dark); font-size: 12px;">Stat <%= idx + 1 %>
                                  </strong>
                              <div class="form-group" style="margin-top: 8px;">
                                <label>Number / Value</label>
                                <input type="text" name="stat<%= idx %>_num" class="form-control"
                                  value="<%= st.number %>" required />
                              </div>
                              <div class="form-group">
                                <label>Title / Label</label>
                                <input type="text" name="stat<%= idx %>_label" class="form-control"
                                  value="<%= st.label %>" required />
                              </div>
                              <div class="form-group">
                                <label>Sub-label</label>
                                <input type="text" name="stat<%= idx %>_sub" class="form-control"
                                  value="<%= st.sub %>" />
                              </div>
                            </div>
                            <% }) %>
                        </div>

                        <div class="form-section-title">🎥 Featured Video Player</div>
                        <div class="form-grid-2">
                          <div class="form-group">
                            <label for="featVideo_title">Video Title</label>
                            <input type="text" id="featVideo_title" name="featVideo_title" class="form-control"
                              value="<%= kalash.hero.featuredVideo.title %>" required />
                          </div>
                          <div class="form-group">
                            <label for="featVideo_duration">Duration</label>
                            <input type="text" id="featVideo_duration" name="featVideo_duration" class="form-control"
                              value="<%= kalash.hero.featuredVideo.duration %>" />
                          </div>
                        </div>

                        <div class="form-grid-2">
                          <div class="form-group">
                            <label for="featVideo_videoUrl">YouTube Embed URL</label>
                            <input type="url" id="featVideo_videoUrl" name="featVideo_videoUrl" class="form-control"
                              value="<%= kalash.hero.featuredVideo.videoUrl %>" required />
                            <span class="help-hint">e.g. https://www.youtube.com/embed/dQw4w9WgXcQ</span>
                          </div>
                          <div class="form-group">
                            <label for="featVideo_posterImage">Poster Image Path</label>
                            <input type="text" id="featVideo_posterImage" name="featVideo_posterImage"
                              class="form-control" value="<%= kalash.hero.featuredVideo.posterImage %>" />
                          </div>
                        </div>

                        <div style="margin-top: 24px;">
                          <button type="submit" class="admin-btn admin-btn-primary">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                              stroke-width="2">
                              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                              <polyline points="17 21 17 13 7 13 7 21" />
                              <polyline points="7 3 7 8 15 8" />
                            </svg>
                            <span>Save Hero Section</span>
                          </button>
                        </div>
                      </form>
                    </div>
                  </div>
                  <% } %>

                    <!-- ====================================================
