                                  <div class="form-group">
                                    <label for="vid_title">Video Title (वीडियो शीर्षक) *</label>
                                    <input type="text" id="vid_title" name="title" class="form-control"
                                      placeholder="उदा. गोपालगंज में भव्य लोकतांत्रिक संकल्प महासम्मेलन" required />
                                  </div>
                                  <div class="form-group">
                                    <label for="vid_people">उपस्थित लोग / जनसमूह संख्या (How many people / People Count) *</label>
                                    <input type="text" id="vid_people" name="peopleCount" class="form-control"
                                      placeholder="उदा. 15,000+ लोग या 5,000" value="5,000+ लोग" required />
                                    <span class="help-hint">👥 यह संख्या पब्लिक वीडियो कार्ड पर दिखाई देगी</span>
                                  </div>
                                </div>

                                <div class="form-grid-2" style="background: #fffbf9; border: 1.5px dashed #fbd5c6; border-radius: 10px; padding: 14px 16px; margin-bottom: 16px;">
                                  <div class="form-group" style="margin-bottom: 0;">
                                    <label for="vid_url">1. YouTube / Embed Video URL (वैकल्पिक)</label>
                                    <input type="text" id="vid_url" name="videoUrl" class="form-control"
                                      placeholder="https://www.youtube.com/embed/..." />
                                    <span class="help-hint">यूट्यूब या किसी वीडियो का एम्बेड लिंक दर्ज करें</span>
                                  </div>
                                  <div class="form-group" style="margin-bottom: 0;">
                                    <label for="vid_file">2. या वीडियो फ़ाइल अपलोड करें (Manual Video Upload)</label>
                                    <input type="file" id="vid_file" name="videoFile" class="form-control"
                                      accept="video/mp4,video/webm,video/ogg,video/quicktime,video/*" />
                                    <span class="help-hint">अगर लिंक नहीं है तो डिवाइस से MP4/WEBM वीडियो अपलोड करें (Optional)</span>
                                  </div>
                                </div>

                                <div class="form-grid-3">
                                  <div class="form-group">
                                    <label for="vid_cat">Category (श्रेणी)</label>
                                    <select id="vid_cat" name="category" class="form-control">
                                      <option value="yatra">संकल्प यात्रा (Sankalp Yatra)</option>
                                      <option value="program">Program (program)</option>
                                      <option value="speech">Speech / Address (speech)</option>
                                      <option value="sankalp">महा-संकल्प (Democratic Pledge)</option>
                                    </select>
                                  </div>
                                  <div class="form-group">
                                    <label for="vid_state">State (राज्य)</label>
                                    <select id="vid_state" name="state" class="form-control">
                                      <option value="bihar">Bihar (बिहार)</option>
                                      <option value="uttar-pradesh">Uttar Pradesh (उत्तर प्रदेश)</option>
                                      <option value="madhya-pradesh">Madhya Pradesh (मध्य प्रदेश)</option>
                                      <option value="jharkhand">Jharkhand (झारखंड)</option>
                                      <option value="rajasthan">Rajasthan (राजस्थान)</option>
                                    </select>
                                  </div>
                                  <div class="form-group">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                      <label for="vid_dist" style="margin-bottom: 0;">District (ज़िला चुनें) *</label>
                                      <button type="button" id="btnToggleCustomDist" style="background: none; border: none; color: var(--admin-primary); font-size: 11px; cursor: pointer; text-decoration: underline; font-weight: 700;">
                                        ✍️ अन्य ज़िला लिखें
                                      </button>
                                    </div>
                                    <select id="vid_dist" name="district" class="form-control" required>
                                      <!-- Dynamically populated based on state -->
                                    </select>
                                    <input type="text" id="vid_dist_custom" class="form-control" style="display: none; margin-top: 6px;" placeholder="उदा. किसी अन्य ज़िले या कस्बे का नाम दर्ज करें..." />
                                  </div>
                                </div>

                                <div class="form-grid-3">
                                  <div class="form-group">
                                    <label for="vid_dur">Duration (अवधि)</label>
                                    <input type="text" id="vid_dur" name="duration" class="form-control"
                                      value="12:30 Min" />
                                  </div>
                                  <div class="form-group">
                                    <label for="vid_views">Views Count (दृश्य)</label>
                                    <input type="text" id="vid_views" name="viewsCount" class="form-control"
                                      value="15.2K" />
                                  </div>
                                  <div class="form-group">
                                    <label for="vid_date">Date (दिनांक)</label>
                                    <input type="text" id="vid_date" name="date" class="form-control"
                                      value="<%= new Date().toLocaleDateString('en-US') %>" />
                                  </div>
                                </div>

                                <div class="form-grid-2">
                                  <div class="form-group">
                                    <label for="vid_thumb_url">कस्टम थंबनेल URL (Thumbnail URL - Optional)</label>
                                    <input type="text" id="vid_thumb_url" name="thumbnail" class="form-control"
                                      placeholder="/images/kalash-yatra-hero.jpg या URL" />
                                  </div>
                                  <div class="form-group">
                                    <label for="vid_thumb_file">या थंबनेल इमेज फ़ाइल चुनें (Upload Thumbnail Image)</label>
                                    <input type="file" id="vid_thumb_file" name="thumbnailFile" class="form-control" accept="image/*" />
                                  </div>
                                </div>

                                <div class="form-group">
                                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label for="vid_desc" style="margin-bottom: 0;">Description (विवरण)</label>
                                    <button type="button" id="btnQuickPledgeFill" class="btn-sm-action" style="background: #fff0eb; color: #b91c1c; border: 1px solid #ffd0c2; padding: 3px 10px; font-size: 11.5px; border-radius: 6px; cursor: pointer; font-weight: 700;">
                                      📜 + लोकतांत्रिक संकल्प वाक्य यहाँ भरें
                                    </button>
                                  </div>
                                  <textarea id="vid_desc" name="description" rows="2" class="form-control"
                                    placeholder="Brief video description..."></textarea>
                                </div>

                                <div class="form-group" style="background: #fff8f0; border: 1.5px dashed #fbd5c6; border-radius: 9px; padding: 12px 14px; margin-bottom: 20px;">
                                  <label style="display: flex; align-items: center; gap: 10px; margin-bottom: 0; cursor: pointer; font-size: 13px; font-weight: 700; color: #9a2c0c;">
                                    <input type="checkbox" name="isHighlighted" value="true" style="width: 18px; height: 18px; accent-color: var(--admin-primary); cursor: pointer;" />
                                    <span>⭐ इस वीडियो को होम पेज पर मुख्य वीडियो बनाएं (Set as Highlight on Home Page)</span>
                                  </label>
                                  <span class="help-hint" style="margin-left: 28px; display: block; margin-top: 3px;">चेक करने पर यह वीडियो होम पेज के बड़े वीडियो प्लेयर में सबसे ऊपर प्रदर्शित होगा।</span>
                                </div>

                                <button type="submit" class="admin-btn admin-btn-primary">
                                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="12" y1="5" x2="12" y2="19" />
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                  </svg>
                                  <span>Publish Video (वीडियो प्रकाशित करें)</span>
                                </button>
                              </form>
                            </div>
                          </div>

                          <!-- Current Video List Table -->
                          <div class="admin-card">
                            <div class="admin-card-header">
                              <h3>
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                  stroke-width="2">
                                  <rect x="2" y="2" width="20" height="20" rx="2.18" />
                                  <line x1="7" y1="2" x2="7" y2="22" />
                                  <line x1="17" y1="2" x2="17" y2="22" />
                                  <line x1="2" y1="12" x2="22" y2="12" />
                                </svg>
                                Existing Videos List (<%= (kalash.videos || []).length %> videos)
                              </h3>
                            </div>

                            <div class="video-table-wrap">
                              <table class="video-list-table">
                                <thead>
                                  <tr>
                                    <th style="width: 50px;">#</th>
                                    <th style="width: 100px;">थंबनेल</th>
                                    <th>शीर्षक व विवरण</th>
                                    <th>उपस्थित जनसमूह (People Count)</th>
                                    <th>ज़िला व राज्य</th>
                                    <th>दिनांक</th>
                                    <th style="width: 130px; text-align: center;">होम पेज हाइलाइट</th>
                                    <th style="width: 100px; text-align: right;">कार्रवाई</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if (!kalash.videos || kalash.videos.length===0) { %>
                                    <tr>
                                      <td colspan="7" style="text-align: center; color: var(--admin-text-muted); padding: 30px;">
                                        वर्तमान में कोई वीडियो उपलब्ध नहीं है। ऊपर दिए गए फॉर्म से वीडियो जोड़ें।
                                      </td>
                                        </td>
                                    </tr>
                                    <% } else { %>
                                      <% kalash.videos.forEach((vid, index)=> { %>
                                        <%
                    let ytId = '';
                    if (vid.videoUrl && vid.videoUrl.includes('embed/')) {
                      ytId = vid.videoUrl.split('embed/')[1].split('?')[0];
                    } else if (vid.videoUrl && vid.videoUrl.includes('watch?v=')) {
                      ytId = vid.videoUrl.split('watch?v=')[1].split('&')[0];
                    } else if (vid.videoUrl && vid.videoUrl.includes('youtu.be/')) {
                      ytId = vid.videoUrl.split('youtu.be/')[1].split('?')[0];
                    }
                    const thumb = vid.thumbnail || (ytId ? ('https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg') : '/images/kalash-yatra-hero.jpg');
                  %>
                  <tr>
                    <td><strong><%= index + 1 %></strong></td>
                    <td>
                      <img src="<%= thumb %>" alt="" style="width: 80px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #ebdccf;" />
                    </td>
                    <td>
                      <div style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">
                        <%= vid.title %>
                        <% if (vid.isHighlighted) { %>
                          <span style="font-size: 10px; background: #fef3c7; color: #b45309; border: 1px solid #fde68a; border-radius: 4px; padding: 1px 6px; margin-left: 6px; font-weight: 800;">★ Home Page Highlight</span>
                        <% } %>
                      </div>
                      <small style="color: var(--admin-text-muted); font-size: 11px;"><%= vid.duration %> • <%= vid.category === 'yatra' ? 'संकल्प यात्रा' : vid.category %></small>
                    </td>
                    <td>
                      <span style="font-weight: 700; color: #7f1d1d; background: #fff5f2; border: 1px solid #fed7aa; padding: 4px 8px; border-radius: 6px; font-size: 12px; display: inline-flex; align-items: center; gap: 4px;">
                        👥 <%= vid.peopleCount || (vid.personOrPlace || '5,000+ लोग') %>
                      </span>
                    </td>
                    <td>
                      <strong style="color: #b45309;"><%= vid.district %></strong>
                      <div style="color: var(--admin-text-muted); font-size: 11px; text-transform: capitalize;"><%= vid.state %></div>
                    </td>
                    <td>
                      <small style="color: var(--admin-text-muted);"><%= vid.date || '—' %></small>
                    </td>
                    <td style="text-align: center;">
                      <form action="/admin/kalash-yatra/videos/highlight/<%= vid._id %>" method="POST" style="display: inline;">
                        <% if (vid.isHighlighted) { %>
                          <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: #ecfdf5; color: #047857; border: 1.5px solid #10b981; border-radius: 20px; font-size: 11px; font-weight: 800; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.15);" title="वर्तमान में होम पेज का मुख्य वीडियो">
                            <span>★ मुख्य वीडियो</span>
                          </span>
                        <% } else { %>
                          <button type="submit" class="btn-sm-action" style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-weight: 700; font-size: 11px; padding: 4px 10px; border-radius: 20px; cursor: pointer; transition: all 0.2s ease;" onmouseover="this.style.background='#fef3c7'" onmouseout="this.style.background='#fffbeb'" title="होम पेज के मुख्य वीडियो प्लेयर में दिखाएं">
                            <span style="color: #d97706;">☆</span>
                            <span>हाइलाइट करें</span>
                          </button>
                        <% } %>
                      </form>
                    </td>
                    <td>
                      <div class="table-actions" style="justify-content: flex-end;">
                        <!-- Edit Button -->
                        <button type="button" class="btn-sm-action btn-edit" title="Edit Video" onclick="openEditVideoModal(this)"
                          data-id="<%= vid._id %>"
                          data-title="<%= vid.title %>"
                          data-videourl="<%= vid.videoUrl %>"
                          data-people="<%= vid.peopleCount || '' %>"
                          data-thumbnail="<%= vid.thumbnail || '' %>"
                          data-category="<%= vid.category || 'yatra' %>"
                          data-state="<%= vid.state || 'bihar' %>"
                          data-district="<%= vid.district || '' %>"
                          data-duration="<%= vid.duration || '' %>"
                          data-views="<%= vid.viewsCount || '' %>"
                          data-date="<%= vid.date || '' %>"
                          data-desc="<%= vid.description || '' %>"
                          data-highlight="<%= vid.isHighlighted ? 'true' : 'false' %>"
                        >
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                          </svg>
                          <span>Edit</span>
                        </button>
                        <!-- Delete Form -->
                        <form action="/admin/kalash-yatra/videos/delete/<%= vid._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this video?');">
                          <button type="submit" class="btn-sm-action btn-del" title="Delete">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            <span>Delete</span>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
                            </div>
                          </div>
                          <% } %>

