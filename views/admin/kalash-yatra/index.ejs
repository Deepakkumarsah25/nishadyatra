                // Edit Modal Logic
                const editModal = document.getElementById("editVideoModal");
                const editForm = document.getElementById("editVideoForm");
                const editState = document.getElementById("edit_vid_state");
                const editDist = document.getElementById("edit_vid_dist");

                window.openEditVideoModal = function (btn) {
                  if (!editModal || !editForm) return;
                  const data = btn.dataset;
                  editForm.action = "/admin/kalash-yatra/videos/update/" + data.id;

                  document.getElementById("edit_vid_title").value = data.title || "";
                  document.getElementById("edit_vid_people").value = data.people || "5,000+ लोग";
                  document.getElementById("edit_vid_url").value = data.videourl || "";
                  document.getElementById("edit_vid_file").value = "";
                  document.getElementById("edit_vid_cat").value = data.category || "yatra";
                  document.getElementById("edit_vid_dur").value = data.duration || "12:00 Min";
                  document.getElementById("edit_vid_views").value = data.views || "10K";
                  document.getElementById("edit_vid_date").value = data.date || "";
                  const thumbInput = document.getElementById("edit_vid_thumb");
                  const thumbFileInput = document.getElementById("edit_vid_thumb_file");
                  const previewImg = document.getElementById("edit_vid_thumb_preview");
                  const previewStatus = document.getElementById("edit_vid_thumb_preview_status");

                  thumbInput.value = data.thumbnail || "";
                  thumbFileInput.value = "";
                  document.getElementById("edit_vid_desc").value = data.desc || "";

                  function updateModalThumbPreview() {
                    const customVal = thumbInput.value.trim();
                    const urlVal = (document.getElementById("edit_vid_url").value || "").trim();
                    let previewSrc = "";
                    let isYt = false;

                    if (customVal) {
                      previewSrc = customVal;
                    } else if (urlVal) {
                      const m = urlVal.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/))([\w-]{11})/);
                      if (m && m[1]) {
                        previewSrc = "https://img.youtube.com/vi/" + m[1] + "/hqdefault.jpg";
                        isYt = true;
                      }
                    }
                    if (!previewSrc) {
                      previewSrc = "/images/kalash-yatra-hero.jpg";
                    }
                    if (previewImg) previewImg.src = previewSrc;
                    if (previewStatus) {
                      if (customVal) {
                        previewStatus.textContent = "🖼️ कस्टम थंबनेल सेट है";
                      } else if (isYt) {
                        previewStatus.textContent = "▶ YouTube से स्वतः थंबनेल लिया गया";
                      } else {
                        previewStatus.textContent = "🖼️ डिफ़ॉल्ट पोस्टर";
                      }
                    }
                  }

                  updateModalThumbPreview();
                  thumbInput.oninput = updateModalThumbPreview;
                  document.getElementById("edit_vid_url").oninput = updateModalThumbPreview;
                  thumbFileInput.onchange = function(e) {
                    if (e.target.files && e.target.files[0] && previewImg) {
                      previewImg.src = URL.createObjectURL(e.target.files[0]);
                      if (previewStatus) previewStatus.textContent = "📁 चुनी गई नई फ़ाइल";
                    }
                  };

                  const hlBox = document.getElementById("edit_vid_highlight");
                  if (hlBox) hlBox.checked = data.highlight === "true";

                  const curState = data.state || "bihar";
                  editState.value = curState;
                  populateEditDistricts(curState, data.district || "");

                  editModal.classList.add("active");
                  editModal.setAttribute("aria-hidden", "false");
                  document.body.style.overflow = "hidden";
                };

                window.closeEditVideoModal = function () {
                  if (!editModal) return;
                  editModal.classList.remove("active");
                  editModal.setAttribute("aria-hidden", "true");
                  document.body.style.overflow = "";
                };

                function populateEditDistricts(selectedState, defaultVal) {
                  if (!editDist) return;
                  editDist.innerHTML = "";
                  const list = stateDistricts[selectedState] || stateDistricts["bihar"];
                  let matched = false;
                  list.forEach(function (d) {
                    const opt = document.createElement("option");
                    opt.value = d;
                    opt.textContent = d;
                    if (defaultVal && (defaultVal === d || defaultVal.toLowerCase() === d.toLowerCase())) {
                      opt.selected = true;
                      matched = true;
                    }
                    editDist.appendChild(opt);
                  });
                  if (!matched && defaultVal) {
                    const customOpt = document.createElement("option");
                    customOpt.value = defaultVal;
                    customOpt.textContent = defaultVal;
                    customOpt.selected = true;
                    editDist.prepend(customOpt);
                  }
                }

                if (editState) {
                  editState.addEventListener("change", function () {
                    populateEditDistricts(this.value);
                  });
                }

                if (editModal) {
                  editModal.addEventListener("click", function (e) {
                    if (e.target === editModal) {
                      closeEditVideoModal();
                    }
                  });
                }

                document.addEventListener("keydown", function (e) {
                  if (e.key === "Escape" && editModal && editModal.classList.contains("active")) {
                    closeEditVideoModal();
                  }
                });

                // 1. Video Add Form: State to District Dynamic Population
                const vidState = document.getElementById("vid_state");
                const vidDist = document.getElementById("vid_dist");
                const vidDistCustom = document.getElementById("vid_dist_custom");
                const btnToggleCustomDist = document.getElementById("btnToggleCustomDist");

                function populateAdminDistricts(selectedState, defaultVal) {
                  if (!vidDist) return;
                  vidDist.innerHTML = "";
                  const list = stateDistricts[selectedState] || stateDistricts["bihar"];
                  list.forEach(function (d) {
                    const opt = document.createElement("option");
                    opt.value = d;
                    opt.textContent = d;
                    if (defaultVal && (defaultVal === d || defaultVal.toLowerCase() === d.toLowerCase())) {
                      opt.selected = true;
                    }
                    vidDist.appendChild(opt);
                  });

                  // Add custom option
                  const customOpt = document.createElement("option");
                  customOpt.value = "__custom__";
                  customOpt.textContent = "✍️ अन्य ज़िला लिखें (Custom District)...";
                  vidDist.appendChild(customOpt);
                }

                if (vidState && vidDist) {
                  populateAdminDistricts(vidState.value, "गोपालगंज");

                  vidState.addEventListener("change", function () {
                    populateAdminDistricts(this.value);
                    if (vidDistCustom) {
                      vidDistCustom.style.display = "none";
                      vidDistCustom.value = "";
                      vidDist.name = "district";
                    }
                  });

                  vidDist.addEventListener("change", function () {
                    if (this.value === "__custom__") {
                      if (vidDistCustom) {
                        vidDistCustom.style.display = "block";
                        vidDistCustom.focus();
                        vidDistCustom.name = "district";
                        vidDist.name = "";
                      }
                    } else {
                      if (vidDistCustom) {
                        vidDistCustom.style.display = "none";
                        vidDistCustom.name = "";
                        vidDist.name = "district";
                      }
                    }
                  });
                }

                if (btnToggleCustomDist && vidDistCustom && vidDist) {
                  btnToggleCustomDist.addEventListener("click", function () {
                    if (vidDistCustom.style.display === "none") {
                      vidDistCustom.style.display = "block";
                      vidDistCustom.focus();
                      vidDistCustom.name = "district";
                      vidDist.name = "";
                    } else {
                      vidDistCustom.style.display = "none";
                      vidDistCustom.name = "";
                      vidDist.name = "district";
                    }
                  });
                }

                // 2. Quick Fill Democratic Pledge into Video Description
                const btnQuickPledgeFill = document.getElementById("btnQuickPledgeFill");
                const vidDesc = document.getElementById("vid_desc");
                const DEFAULT_PLEDGE_TEXT = "आज हम लोकतांत्रिक संकल्प लेते हैं कि आगामी चुनाव में भाजपा के पक्ष में मतदान नहीं करेंगे तथा अपने विवेक और विचार के आधार पर अपने मताधिकार का प्रयोग करेंगे।";

                if (btnQuickPledgeFill && vidDesc) {
                  btnQuickPledgeFill.addEventListener("click", function () {
                    vidDesc.value = DEFAULT_PLEDGE_TEXT;
                    vidDesc.focus();
                  });
                }

                // 3. Reset Default Pledge button in Tab 4
                const btnResetDefaultPledge = document.getElementById("btnResetDefaultPledge");
                const pledgeText = document.getElementById("pledgeText");
                if (btnResetDefaultPledge && pledgeText) {
                  btnResetDefaultPledge.addEventListener("click", function () {
                    pledgeText.value = DEFAULT_PLEDGE_TEXT;
                    pledgeText.focus();
                  });
                }
              });
            </script>

