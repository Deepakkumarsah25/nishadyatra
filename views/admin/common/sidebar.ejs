<!-- =====================================
     REUSABLE ADMIN SIDEBAR
====================================== -->
<style>
  .admin-sidebar {
    width: var(--admin-sidebar-w);
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-right: 1px solid var(--admin-border);
    z-index: 100;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .admin-sidebar-logo {
    height: 72px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    border-bottom: 1px solid var(--admin-border);
  }

  .admin-logo-mark {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-dark));
    color: #ffffff;
    font-size: 19px;
    font-weight: 800;
    box-shadow: 0 5px 14px rgba(215, 42, 42, 0.25);
  }

  .admin-logo-text strong {
    display: block;
    font-size: 15px;
    color: var(--admin-text-dark);
    font-weight: 800;
    line-height: 1.2;
  }

  .admin-logo-text small {
    display: block;
    font-size: 11px;
    color: var(--admin-text-muted);
  }

  .admin-sidebar-nav {
    flex: 1;
    padding: 20px 14px;
    overflow-y: auto;
  }

  .nav-group-title {
    padding: 0 12px;
    margin: 16px 0 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #b09e96;
    text-transform: uppercase;
  }

  .nav-group-title:first-child {
    margin-top: 0;
  }

  .admin-nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    padding: 0 12px;
    margin-bottom: 4px;
    border-radius: 9px;
    color: #63534d;
    font-size: 13px;
    font-weight: 600;
    transition: 0.2s ease;
  }

  .admin-nav-item:hover {
    background: var(--admin-primary-light);
    color: var(--admin-primary);
  }

  .admin-nav-item.active {
    background: linear-gradient(135deg, #fff0ec, #ffe8e2);
    color: var(--admin-primary-dark);
    font-weight: 700;
  }

  .admin-nav-item.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3.5px;
    background: var(--admin-primary);
    border-radius: 0 4px 4px 0;
  }

  .nav-item-sub {
    padding-left: 36px;
    font-size: 12px;
    min-height: 36px;
    color: #7a6760;
  }

  .nav-item-icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-item-icon svg {
    width: 17px;
    height: 17px;
  }

  .nav-badge {
    margin-left: auto;
    padding: 2px 7px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 800;
    background: var(--admin-primary);
    color: #fff;
  }

  .admin-sidebar-bottom {
    padding: 14px;
    border-top: 1px solid var(--admin-border);
  }

  .admin-logout-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border-radius: 9px;
    color: #8c2626;
    background: #fff4f4;
    font-size: 13px;
    font-weight: 700;
    transition: 0.2s;
  }

  .admin-logout-btn:hover {
    background: #fee2e2;
  }

  .admin-sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(30, 15, 15, 0.45);
    z-index: 95;
    backdrop-filter: blur(2px);
  }

  .admin-sidebar-close {
    display: none;
    margin-left: auto;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--admin-border);
    background: #fdf8f6;
    color: var(--admin-text-dark);
    font-size: 16px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .admin-sidebar-close:hover {
    background: var(--admin-primary-light);
    color: var(--admin-primary);
  }

  @media (max-width: 1024px) {
    .admin-sidebar {
      transform: translateX(-100%);
      box-shadow: none;
    }
    .admin-sidebar.open {
      transform: translateX(0);
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.32);
    }
    .admin-sidebar-backdrop.open {
      display: block;
    }
    .admin-sidebar-close {
      display: flex;
    }
  }
</style>

