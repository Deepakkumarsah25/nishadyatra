    <a href="/admin/kalash-yatra?tab=hero" class="admin-nav-item nav-item-sub <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/kalash-yatra') && typeof activeTab !== 'undefined' && activeTab === 'hero' ? 'active' : '' %>">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      </span>
      <span>1. हीरो व आंकड़े</span>
