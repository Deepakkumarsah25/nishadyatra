    <a href="/admin/kalash-yatra?tab=videos" class="admin-nav-item nav-item-sub <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/kalash-yatra') && typeof activeTab !== 'undefined' && activeTab === 'videos' ? 'active' : '' %>">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
      </span>
      <span>3. वीडियो गैलरी</span>
    </a>

    <a href="/admin/kalash-yatra?tab=pillars" class="admin-nav-item nav-item-sub <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/kalash-yatra') && typeof activeTab !== 'undefined' && activeTab === 'pillars' ? 'active' : '' %>">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </span>
      <span>4. चार महा-संकल्प</span>
    </a>

    <!-- SYSTEM -->
    <div class="nav-group-title" style="margin-top: 20px;">वेबसाइट लिंक</div>
    <a href="/" target="_blank" class="admin-nav-item">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
