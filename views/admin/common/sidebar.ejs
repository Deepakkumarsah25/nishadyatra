    <a href="/admin/kalash-yatra?tab=milestones" class="admin-nav-item nav-item-sub <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/kalash-yatra') && typeof activeTab !== 'undefined' && activeTab === 'milestones' ? 'active' : '' %>">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
