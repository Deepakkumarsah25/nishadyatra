      </span>
      <span>3. प्रतिबद्धता व आधार</span>
    </a>

    <a href="/admin/home/notices" class="admin-nav-item nav-item-sub <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/home/notices') ? 'active' : '' %>">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      </span>
      <span>4. ताजा सूचनाएं व साइडबार</span>
    </a>

    <a href="/admin/home/inquiries" class="admin-nav-item nav-item-sub <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/home/inquiries') ? 'active' : '' %>">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </span>
      <span>5. प्राप्त संकल्प व संदेश</span>
    </a>

    <!-- KALASH YATRA MANAGER -->
    <div class="nav-group-title" style="margin-top: 20px;">कलश यात्रा प्रबंधन</div>

    <a href="/admin/kalash-yatra" class="admin-nav-item <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/kalash-yatra') ? 'active' : '' %>">
      <span class="nav-item-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </span>
      <span>कलश यात्रा हब</span>
