<!DOCTYPE html>
<html lang="hi">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= title %> | निषाद संकल्प अभियान
  </title>


  <style>

    /* =========================================
       RESET
    ========================================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        Inter,
        "Segoe UI",
        Arial,
        sans-serif;

      background: #f7f4f1;

      color: #342828;

      min-height: 100vh;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button {
      font: inherit;
    }


    /* =========================================
       DASHBOARD
    ========================================= */

    .dashboard {
      min-height: 100vh;

      display: flex;
    }


    /* =========================================
       SIDEBAR
    ========================================= */

    .sidebar {
      width: 260px;

      height: 100vh;

      position: fixed;

      left: 0;
      top: 0;

      display: flex;

      flex-direction: column;

      background: #ffffff;

      border-right: 1px solid #eadfd7;

      z-index: 100;

      transition: 0.3s ease;
    }


    /* =========================================
       SIDEBAR LOGO
    ========================================= */

    .sidebar-logo {
      height: 78px;

      display: flex;

      align-items: center;

      gap: 12px;

      padding: 0 22px;

      border-bottom: 1px solid #eee5df;
    }


    .logo-mark {
      width: 43px;
      height: 43px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background:
        linear-gradient(
          135deg,
          #d72a2a,
          #a91c1c
        );

      color: #ffffff;

      font-size: 21px;

      font-weight: 800;

      box-shadow:
        0 7px 18px rgba(215, 42, 42, 0.2);
    }


    .sidebar-logo strong {
      display: block;

      font-size: 15px;

      color: #3e2d2d;

      font-weight: 800;
    }


    .sidebar-logo small {
      display: block;

      margin-top: 3px;

      font-size: 11px;

      color: #9a8780;
    }


    /* =========================================
       NAVIGATION
    ========================================= */

    .sidebar nav {
      flex: 1;

      padding: 24px 14px;

      overflow-y: auto;
    }


    .nav-title {
      padding: 0 12px;

      margin-bottom: 10px;

      font-size: 10px;

      font-weight: 800;

      letter-spacing: 1.5px;

      color: #aa9991;
    }


    .sidebar nav a {
      position: relative;

      display: flex;

      align-items: center;

      gap: 12px;

      min-height: 47px;

      padding: 0 13px;

      margin-bottom: 5px;

      border-radius: 10px;

      color: #705f59;

      font-size: 13px;

      font-weight: 600;

      transition: 0.2s ease;
    }


    .sidebar nav a:hover {
      background: #fff1ed;

      color: #c72222;
    }


    .sidebar nav a.active {
      background:
        linear-gradient(
          135deg,
          #fff0ec,
          #ffe8e2
        );

      color: #c52222;

      font-weight: 700;
    }


    .sidebar nav a.active::before {
      content: "";

      position: absolute;

      left: 0;

      top: 10px;

      bottom: 10px;

      width: 3px;

      border-radius: 0 4px 4px 0;

      background: #d72a2a;
    }


    .nav-icon {
      width: 19px;
      height: 19px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      color: currentColor;
    }


    .nav-icon svg {
      width: 18px;
      height: 18px;
    }


    /* =========================================
       SIDEBAR BOTTOM
    ========================================= */

    .sidebar-bottom {
      padding: 15px;

      border-top: 1px solid #eee5df;
    }


    .logout-btn {
      width: 100%;

      min-height: 45px;

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 9px;

      border: 1px solid #f0d8d4;

      border-radius: 10px;

      background: #fff8f6;

      color: #b52828;

      font-size: 13px;

      font-weight: 700;

      cursor: pointer;

      transition: 0.2s ease;
    }


    .logout-btn:hover {
      background: #d72a2a;

      border-color: #d72a2a;

      color: #ffffff;
    }


    .logout-btn svg {
      width: 17px;
      height: 17px;
    }


    /* =========================================
       MAIN CONTENT
    ========================================= */

    .main-content {
      width: calc(100% - 260px);

      min-height: 100vh;

      margin-left: 260px;

      background: #f7f4f1;
    }


    /* =========================================
       TOPBAR
    ========================================= */

    .topbar {
      height: 78px;

      position: sticky;

      top: 0;

      z-index: 50;

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding: 0 35px;

      background: rgba(255, 255, 255, 0.94);

      border-bottom: 1px solid #eadfd7;

      backdrop-filter: blur(14px);
    }


    .topbar-left {
      display: flex;

      align-items: center;

      gap: 15px;
    }


    .mobile-menu-btn {
      display: none;

      width: 40px;
      height: 40px;

      align-items: center;
      justify-content: center;

      border: 1px solid #eadfd7;

      border-radius: 9px;

      background: #ffffff;

      color: #5d4848;

      cursor: pointer;
    }


    .mobile-menu-btn svg {
      width: 20px;
      height: 20px;
    }


    .page-title h1 {
      font-size: 22px;

      line-height: 1.2;

      color: #3d2c2c;

      font-weight: 800;
    }


    .page-title p {
      margin-top: 4px;

      color: #97867f;

      font-size: 12px;
    }


    /* =========================================
       ADMIN PROFILE
    ========================================= */

    .admin-info {
      display: flex;

      align-items: center;

      gap: 11px;
    }


    .admin-avatar {
      width: 40px;
      height: 40px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: #d72a2a;

      color: #ffffff;

      font-size: 15px;

      font-weight: 800;
    }


    .admin-details strong {
      display: block;

      font-size: 13px;

      color: #463434;
    }


    .admin-details span {
      display: block;

      margin-top: 2px;

      font-size: 10px;

      text-transform: uppercase;

      letter-spacing: 0.8px;

      color: #a08e87;
    }


    /* =========================================
       CONTENT
    ========================================= */

    .dashboard-content {
      padding: 32px 35px 45px;
    }


    /* =========================================
       WELCOME CARD
    ========================================= */

    .welcome-card {
      position: relative;

      overflow: hidden;

      padding: 30px 32px;

      border-radius: 18px;

      background:
        linear-gradient(
          120deg,
          #8c1a1a,
          #d72a2a
        );

      color: #ffffff;

      box-shadow:
        0 12px 30px rgba(140, 26, 26, 0.14);
    }


    .welcome-card::after {
      content: "";

      position: absolute;

      width: 220px;
      height: 220px;

      border-radius: 50%;

      right: -70px;
      top: -110px;

      background: rgba(255, 255, 255, 0.08);
    }


    .welcome-card::before {
      content: "";

      position: absolute;

      width: 150px;
      height: 150px;

      border-radius: 50%;

      right: 100px;
      bottom: -100px;

      background: rgba(255, 255, 255, 0.05);
    }


    .welcome-content {
      position: relative;

      z-index: 2;
    }


    .welcome-card h2 {
      font-size: 24px;

      font-weight: 800;
    }


    .welcome-card p {
      margin-top: 8px;

      max-width: 650px;

      color: rgba(255, 255, 255, 0.78);

      font-size: 13px;

      line-height: 1.6;
    }


    /* =========================================
       STATS
    ========================================= */

    .section-heading {
      display: flex;

      align-items: center;

      justify-content: space-between;

      margin-top: 30px;

      margin-bottom: 15px;
    }


    .section-heading h2 {
      font-size: 16px;

      color: #493636;

      font-weight: 800;
    }


    .section-heading span {
      font-size: 11px;

      color: #a08e87;
    }


    .stats-grid {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 17px;
    }


    .stat-card {
      position: relative;

      padding: 21px;

      min-height: 125px;

      background: #ffffff;

      border: 1px solid #eadfd7;

      border-radius: 15px;

      transition: 0.2s ease;
    }


    .stat-card:hover {
      transform: translateY(-3px);

      box-shadow:
        0 10px 25px rgba(80, 45, 30, 0.07);
    }


    .stat-top {
      display: flex;

      align-items: center;

      justify-content: space-between;
    }


    .stat-card span {
      font-size: 12px;

      color: #8e7c75;

      font-weight: 600;
    }


    .stat-icon {
      width: 37px;
      height: 37px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 10px;

      background: #fff0ec;

      color: #d72a2a;
    }


    .stat-icon svg {
      width: 19px;
      height: 19px;
    }


    .stat-card strong {
      display: block;

      margin-top: 14px;

      font-size: 28px;

      color: #3f2e2e;

      font-weight: 800;
    }


    /* =========================================
       LOWER GRID
    ========================================= */

    .lower-grid {
      display: grid;

      grid-template-columns:
        minmax(0, 1.4fr)
        minmax(300px, 0.8fr);

      gap: 20px;

      margin-top: 25px;
    }


    .panel {
      background: #ffffff;

      border: 1px solid #eadfd7;

      border-radius: 15px;

      overflow: hidden;
    }


    .panel-header {
      min-height: 62px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding: 0 20px;

      border-bottom: 1px solid #eee5df;
    }


    .panel-header h3 {
      font-size: 14px;

      color: #493636;

      font-weight: 800;
    }


    .panel-header a {
      font-size: 11px;

      color: #d72a2a;

      font-weight: 700;
    }


    /* =========================================
       QUICK ACTIONS
    ========================================= */

    .quick-actions {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 12px;

      padding: 20px;
    }


    .quick-action {
      min-height: 92px;

      display: flex;

      flex-direction: column;

      justify-content: center;

      gap: 7px;

      padding: 15px;

      border: 1px solid #eee2db;

      border-radius: 11px;

      background: #fffdfb;

      transition: 0.2s ease;
    }


    .quick-action:hover {
      border-color: #f0c6be;

      background: #fff6f3;

      transform: translateY(-2px);
    }


    .quick-action-icon {
      width: 32px;
      height: 32px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 8px;

      background: #fff0ec;

      color: #d72a2a;
    }


    .quick-action-icon svg {
      width: 17px;
      height: 17px;
    }


    .quick-action strong {
      font-size: 12px;

      color: #4b3838;
    }


    .quick-action span {
      font-size: 10px;

      color: #9b8982;
    }


    /* =========================================
       ACTIVITY
    ========================================= */

    .activity-list {
      padding: 5px 20px 15px;
    }


    .activity-item {
      display: flex;

      align-items: flex-start;

      gap: 12px;

      padding: 15px 0;

      border-bottom: 1px solid #f0e8e3;
    }


    .activity-item:last-child {
      border-bottom: none;
    }


    .activity-icon {
      width: 33px;
      height: 33px;

      flex-shrink: 0;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 9px;

      background: #fff0ec;

      color: #d72a2a;
    }


    .activity-icon svg {
      width: 16px;
      height: 16px;
    }


    .activity-text strong {
      display: block;

      font-size: 11px;

      color: #554242;

      line-height: 1.5;
    }


    .activity-text span {
      display: block;

      margin-top: 3px;

      font-size: 10px;

      color: #a18f88;
    }


    /* =========================================
       MOBILE OVERLAY
    ========================================= */

    .sidebar-overlay {
      display: none;

      position: fixed;

      inset: 0;

      background: rgba(30, 15, 15, 0.45);

      z-index: 90;
    }


    /* =========================================
       TABLET
    ========================================= */

    @media (max-width: 1100px) {

      .stats-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .lower-grid {
        grid-template-columns: 1fr;
      }

    }


    /* =========================================
       MOBILE
    ========================================= */

    @media (max-width: 800px) {

      .sidebar {
        transform: translateX(-100%);
      }


      .sidebar.open {
        transform: translateX(0);
      }


      .sidebar-overlay.open {
        display: block;
      }


      .main-content {
        width: 100%;

        margin-left: 0;
      }


      .topbar {
        height: 68px;

        padding: 0 18px;
      }


      .mobile-menu-btn {
        display: flex;
      }


      .page-title h1 {
        font-size: 18px;
      }


      .page-title p {
        display: none;
      }


      .admin-details {
        display: none;
      }


      .admin-avatar {
        width: 38px;
        height: 38px;
      }


      .dashboard-content {
        padding: 22px 18px 35px;
      }


      .welcome-card {
        padding: 24px 22px;
      }


      .welcome-card h2 {
        font-size: 20px;
      }


      .stats-grid {
        gap: 12px;
      }


      .stat-card {
        padding: 17px;

        min-height: 110px;
      }


      .stat-card strong {
        font-size: 24px;
      }

    }


    /* =========================================
       SMALL MOBILE
    ========================================= */

    @media (max-width: 500px) {

      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }


      .stat-card {
        min-height: 105px;
      }


      .stat-card span {
        font-size: 10px;
      }


      .stat-card strong {
        font-size: 22px;

        margin-top: 11px;
      }


      .stat-icon {
        width: 32px;
        height: 32px;
      }


      .lower-grid {
        margin-top: 18px;
      }


      .quick-actions {
        grid-template-columns: 1fr 1fr;

        padding: 15px;
      }


      .quick-action {
        min-height: 85px;

        padding: 12px;
      }


      .panel-header {
        padding: 0 15px;
      }


      .activity-list {
        padding-left: 15px;
        padding-right: 15px;
      }

    }


    @media (max-width: 360px) {

      .stats-grid {
        grid-template-columns: 1fr;
      }


      .quick-actions {
        grid-template-columns: 1fr;
      }


      .welcome-card h2 {
        font-size: 18px;
      }

    }

  </style>

</head>


<body>


  <div class="dashboard">


    <!-- =====================================
         SIDEBAR
    ====================================== -->

    <aside
      class="sidebar"
      id="sidebar"
    >


      <!-- LOGO -->

      <div class="sidebar-logo">

        <div class="logo-mark">
          नि
        </div>

        <div>

          <strong>
            निषाद संकल्प
          </strong>

          <small>
            Admin Panel
          </small>

        </div>

      </div>


      <!-- NAVIGATION -->

      <nav>


        <div class="nav-title">
          MAIN MENU
        </div>


        <!-- Dashboard -->

        <a
          href="/admin/dashboard"
          class="active"
        >

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <rect
                x="3"
                y="3"
                width="7"
                height="7"
                rx="1"
              />

              <rect
                x="14"
                y="3"
                width="7"
                height="7"
                rx="1"
              />

              <rect
                x="3"
                y="14"
                width="7"
                height="7"
                rx="1"
              />

              <rect
                x="14"
                y="14"
                width="7"
                height="7"
                rx="1"
              />

            </svg>

          </span>

          Dashboard

        </a>


        <!-- Home Page Manager -->

        <a
          href="/admin/home"
        >

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <path
                d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
              />

              <polyline points="9 22 9 12 15 12 15 22" />

            </svg>

          </span>

          होम पेज प्रबंधन

        </a>


        <!-- Banners -->

        <a href="#">

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <rect
                x="3"
                y="4"
                width="18"
                height="16"
                rx="2"
              />

              <circle
                cx="8"
                cy="9"
                r="1.5"
              />

              <path d="m4 17 5-5 4 4 2-2 5 5" />

            </svg>

          </span>

          Banners

        </a>


        <!-- News -->

        <a href="#">

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <path
                d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
              />

              <path d="M7 8h10" />

              <path d="M7 12h10" />

              <path d="M7 16h6" />

            </svg>

          </span>

          News

        </a>


        <!-- Videos -->

        <a href="#">

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="2"
              />

              <path d="m10 9 5 3-5 3V9Z" />

            </svg>

          </span>

          Videos

        </a>


        <!-- Workers -->

        <a href="#">

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <path
                d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"
              />

              <circle
                cx="9.5"
                cy="7"
                r="4"
              />

              <path d="M17 11a4 4 0 1 0 0-8" />

              <path
                d="M21 21v-2a4 4 0 0 0-3-3.87"
              />

            </svg>

          </span>

          Workers

        </a>


        <!-- Routes -->

        <a href="#">

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <circle
                cx="6"
                cy="19"
                r="2"
              />

              <circle
                cx="18"
                cy="5"
                r="2"
              />

              <path d="M8 18c5 0 2-10 8-11" />

            </svg>

          </span>

          Routes

        </a>


        <div
          class="nav-title"
          style="margin-top:25px;"
        >
          SYSTEM
        </div>


        <!-- Settings -->

        <a href="#">

          <span class="nav-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <circle
                cx="12"
                cy="12"
                r="3"
              />

              <path
                d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-1.8 1.8-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.02 1.56V22h-2.5v-.1a1.7 1.7 0 0 0-1.02-1.56 1.7 1.7 0 0 0-1.88.34l-.06.06-1.8-1.8.06-.06A1.7 1.7 0 0 0 8.2 17a1.7 1.7 0 0 0-1.56-1.02H6v-2.5h.1A1.7 1.7 0 0 0 7.66 12a1.7 1.7 0 0 0-.34-1.88l-.06-.06 1.8-1.8.06.06A1.7 1.7 0 0 0 11 8.2a1.7 1.7 0 0 0 1.02-1.56V6h2.5v.1A1.7 1.7 0 0 0 15.54 7.66a1.7 1.7 0 0 0 1.88-.34l.06-.06 1.8 1.8-.06.06A1.7 1.7 0 0 0 18.8 11a1.7 1.7 0 0 0 1.56 1.02h.1v2.5h-.1A1.7 1.7 0 0 0 19.4 15Z"
              />

            </svg>

          </span>

          Settings

        </a>

      </nav>


      <!-- LOGOUT -->

      <div class="sidebar-bottom">

        <a
          href="/admin/logout"
          class="logout-btn"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >

            <path
              d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
            />

            <path d="m16 17 5-5-5-5" />

            <path d="M21 12H9" />

          </svg>

          Logout

        </a>

      </div>

    </aside>


    <!-- OVERLAY -->

    <div
      class="sidebar-overlay"
      id="sidebarOverlay"
    ></div>


    <!-- =====================================
         MAIN
    ====================================== -->

    <main class="main-content">


      <!-- TOPBAR -->

      <header class="topbar">


        <div class="topbar-left">


          <button
            type="button"
            class="mobile-menu-btn"
            id="mobileMenuBtn"
            aria-label="Open menu"
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <path d="M4 6h16" />

              <path d="M4 12h16" />

