<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Dashboard — Main Overview
        </h1>
        <p>Core website metrics, received pledges, photo gallery, Sankalp Yatra (संकल्प यात्रा), and recent activity</p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/" target="_blank" class="view-site-btn">
        <span>View Live Website ↗</span>
      </a>
      <div class="admin-user-pill">
        <div class="admin-user-avatar"><%= (admin && admin.name ? admin.name.charAt(0) : 'A').toUpperCase() %></div>
        <div class="admin-user-info">
          <strong><%= admin && admin.name ? admin.name : 'Admin' %></strong>
          <small><%= admin && admin.role ? admin.role : 'Superadmin' %></small>
        </div>
      </div>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <!-- WELCOME HERO BANNER -->
    <div style="position: relative; overflow: hidden; padding: 28px 32px; border-radius: 16px; background: linear-gradient(135deg, #1f1212 0%, #3a1515 50%, #8c1a1a 100%); color: #ffffff; box-shadow: 0 12px 30px rgba(140, 26, 26, 0.15); margin-bottom: 26px;">
      <div style="position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.12); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; color: #ffd6cc; margin-bottom: 10px; border: 1px solid rgba(255, 255, 255, 0.2);">
            <span>Jai Nishadraj</span>
            <span>•</span>
            <span>Command & Control Center</span>
          </div>
          <h2 style="font-size: 24px; font-weight: 800; line-height: 1.2; margin-bottom: 6px;">
            Welcome, <%= admin && admin.name ? admin.name : 'Admin' %> 👋
          </h2>
          <p style="font-size: 13px; color: rgba(255, 255, 255, 0.85); max-width: 620px; line-height: 1.5;">
            Welcome to your dashboard. Your database currently has <strong><%= stats.inquiriesTotal %></strong> pledges & inquiries, <strong><%= stats.photosTotal %></strong> gallery photos, and <strong><%= stats.totalNews || 0 %></strong> news stories/videos recorded.
          </p>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/admin/kalash-yatra" class="btn-admin" style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); color: #fff;">
            <span>संकल्प यात्रा हब 🚩</span>
          </a>
          <a href="/admin/gallery/bulk" class="btn-admin" style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); color: #fff;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span>Bulk Photo Upload</span>
          </a>
          <a href="/admin/home/inquiries" class="btn-admin" style="background: #ffffff; color: var(--admin-primary-dark); font-weight: 800;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>View Pledges (<%= stats.inquiriesNew %> new)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 6 KEY REAL STATS CARDS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-bottom: 26px;">
      <!-- 1. Inquiries -->
      <div class="admin-card" style="margin-bottom: 0; padding: 20px; border-left: 4px solid var(--admin-primary); transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Pledges & Inquiries</span>
          <div style="width: 34px; height: 34px; border-radius: 8px; background: #fff0ec; color: var(--admin-primary); display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 10px;">
          <strong style="font-size: 28px; font-weight: 800; color: var(--admin-text-dark);"><%= stats.inquiriesTotal %></strong>
          <% if (stats.inquiriesNew > 0) { %>
            <span style="font-size: 11px; font-weight: 800; color: var(--admin-primary); background: #fff0ec; padding: 2px 7px; border-radius: 10px;">
              +<%= stats.inquiriesNew %> new
            </span>
          <% } %>
        </div>
        <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 6px;">
          <%= stats.pledgesCount %> online pledge forms
        </div>
      </div>

      <!-- 2. Gallery Photos -->
      <div class="admin-card" style="margin-bottom: 0; padding: 20px; border-left: 4px solid #8b5cf6; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Sankalp Photo Gallery</span>
          <div style="width: 34px; height: 34px; border-radius: 8px; background: #f5f3ff; color: #7c3aed; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 10px;">
          <strong style="font-size: 28px; font-weight: 800; color: var(--admin-text-dark);"><%= stats.photosTotal %></strong>
          <span style="font-size: 11px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 2px 7px; border-radius: 10px;">
            <%= stats.photosPublished %> published
          </span>
        </div>
        <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 6px;">
          Photos received from various districts
        </div>
      </div>

      <!-- 3. Active Districts -->
      <div class="admin-card" style="margin-bottom: 0; padding: 20px; border-left: 4px solid #f59e0b; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Active Districts</span>
          <div style="width: 34px; height: 34px; border-radius: 8px; background: #fffbeb; color: #d97706; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 10px;">
          <strong style="font-size: 28px; font-weight: 800; color: var(--admin-text-dark);"><%= stats.districtsCount %></strong>
          <span style="font-size: 11px; font-weight: 800; color: #d97706; background: #fffbeb; padding: 2px 7px; border-radius: 10px;">
            Districts joined
          </span>
        </div>
        <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 6px;">
          Key districts across UP / Bihar
        </div>
      </div>

      <!-- 4. Hero Slides -->
      <div class="admin-card" style="margin-bottom: 0; padding: 20px; border-left: 4px solid #3b82f6; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Hero Slider Banners</span>
          <div style="width: 34px; height: 34px; border-radius: 8px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 10px;">
          <strong style="font-size: 28px; font-weight: 800; color: var(--admin-text-dark);"><%= stats.heroSlidesActive %></strong>
          <span style="font-size: 11px; font-weight: 800; color: #2563eb; background: #eff6ff; padding: 2px 7px; border-radius: 10px;">
            Total <%= stats.heroSlidesTotal %>
          </span>
        </div>
        <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 6px;">
          Home page main sliders
        </div>
      </div>

      <!-- 5. News & Video Content -->
      <div class="admin-card" style="margin-bottom: 0; padding: 20px; border-left: 4px solid #06b6d4; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">News & Videos</span>
          <div style="width: 34px; height: 34px; border-radius: 8px; background: #ecfeff; color: #0891b2; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M7 8h10"/><path d="M7 12h10"/><path d="M7 16h6"/></svg>
          </div>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 10px;">
          <strong style="font-size: 28px; font-weight: 800; color: var(--admin-text-dark);"><%= typeof stats.totalNews !== 'undefined' ? stats.totalNews : 0 %></strong>
          <span style="font-size: 11px; font-weight: 800; color: #0891b2; background: #ecfeff; padding: 2px 7px; border-radius: 10px;">
            <%= typeof stats.publishedNews !== 'undefined' ? stats.publishedNews : 0 %> live
          </span>
        </div>
        <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 6px;">
          Video & digital news coverage
        </div>
      </div>

      <!-- 6. Notices -->
      <div class="admin-card" style="margin-bottom: 0; padding: 20px; border-left: 4px solid #ec4899; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Notices & Alerts</span>
          <div style="width: 34px; height: 34px; border-radius: 8px; background: #fdf2f8; color: #db2777; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
        </div>
        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 10px;">
          <strong style="font-size: 28px; font-weight: 800; color: var(--admin-text-dark);"><%= stats.noticesActive %></strong>
          <span style="font-size: 11px; font-weight: 800; color: #db2777; background: #fdf2f8; padding: 2px 7px; border-radius: 10px;">
            Active notices
          </span>
        </div>
        <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 6px;">
          Live notices in sidebar
        </div>
      </div>
    </div>

    <!-- MAIN TWO COLUMN DATA SECTION -->
    <div style="display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(320px, 1fr); gap: 24px;">
      <!-- LEFT COLUMN -->
      <div>
        <!-- 1. Recent Real Inquiries & Pledges -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Recent Pledges & Messages
            </h3>
            <a href="/admin/home/inquiries" style="font-size: 12px; font-weight: 700; color: var(--admin-primary);">
              View All (<%= stats.inquiriesTotal %>) ↗
            </a>
          </div>

          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Phone</th>
                  <th>District</th>
                  <th>Type</th>
                  <th>Date</th>
                  <th style="width: 100px;">Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentInquiries && recentInquiries.length > 0) { %>
                  <% recentInquiries.forEach(function(item) { %>
                    <tr>
                      <td>
                        <strong style="font-size: 13px; color: var(--admin-text-dark);"><%= item.name %></strong>
                      </td>
                      <td>
                        <a href="tel:<%= item.phone %>" style="color: var(--admin-primary); font-weight: 600; font-size: 12px;">
                          <%= item.phone %>
                        </a>
                      </td>
                      <td>
                        <span style="font-size: 12px; color: var(--admin-text-muted);">
                          <%= item.district ? '📍 ' + item.district : '—' %>
                        </span>
                      </td>
                      <td>
                        <span style="font-size: 11px; padding: 2px 7px; border-radius: 6px; font-weight: 700; background: <%= item.type === 'pledge' ? '#fff0ec' : '#eff6ff' %>; color: <%= item.type === 'pledge' ? 'var(--admin-primary)' : '#2563eb' %>;">
                          <%= item.type === 'pledge' ? 'Pledge' : (item.category || 'Initiative') %>
                        </span>
                      </td>
                      <td>
                        <span style="font-size: 11px; color: var(--admin-text-muted);">
                          <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('en-US') : '-' %>
                        </span>
                      </td>
                      <td>
                        <% if (item.status === 'new') { %>
                          <span class="badge-status" style="background: #fee2e2; color: #b91c1c;">New</span>
                        <% } else if (item.status === 'contacted') { %>
                          <span class="badge-status" style="background: #fef3c7; color: #b45309;">Contacted</span>
                        <% } else { %>
                          <span class="badge-status badge-active">Resolved</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 30px; color: var(--admin-text-muted);">
                      No pledges or inquiries received yet.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Recent Sankalp Gallery Photos -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              Sankalp Photo Gallery — Recent Photos
            </h3>
            <a href="/admin/gallery" style="font-size: 12px; font-weight: 700; color: var(--admin-primary);">
              Manage Gallery ↗
            </a>
          </div>

          <div style="padding: 20px;">
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px;">
              <% if (recentPhotos && recentPhotos.length > 0) { %>
                <% recentPhotos.forEach(function(photo) { %>
                  <div style="background: #faf7f5; border: 1px solid var(--admin-border); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column;">
                    <div style="position: relative; width: 100%; height: 110px; background: #eee;">
                      <img
                        src="<%= photo.imageUrl %>"
                        alt="<%= photo.name %>"
                        style="width: 100%; height: 100%; object-fit: cover;"
                        onerror="this.src='https://placehold.co/180x110/eadfd7/333?text=Photo'"
                      />
                      <span style="position: absolute; top: 6px; left: 6px; font-size: 10px; font-weight: 800; background: rgba(255,255,255,0.9); color: var(--admin-primary); padding: 2px 6px; border-radius: 4px;">
                        📍 <%= photo.district %>
                      </span>
                    </div>
                    <div style="padding: 10px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                      <div>
                        <strong style="display: block; font-size: 12px; color: var(--admin-text-dark); margin-bottom: 2px;"><%= photo.name %></strong>
                        <span style="display: block; font-size: 10px; color: var(--admin-text-muted);">
                          <%= photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('en-US') : '-') %>
                        </span>
                      </div>
                      <div style="margin-top: 8px; display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-size: 10px; font-weight: 700; color: <%= photo.isPublished ? 'var(--admin-success)' : '#8c7870' %>;">
                          <%= photo.isPublished ? '✓ Live' : '✕ Draft' %>
                        </span>
                        <a href="/admin/gallery/edit/<%= photo._id %>" style="font-size: 11px; font-weight: 700; color: var(--admin-primary);">
                          Edit
                        </a>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 24px; color: var(--admin-text-muted);">
                  No photos available yet.
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- 3. Top Active Districts Breakdown -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Top Participating Districts (Gallery)
            </h3>
            <span style="font-size: 11px; color: var(--admin-text-muted);">Real database statistics</span>
          </div>

          <div style="padding: 20px;">
            <% if (topDistricts && topDistricts.length > 0) { %>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px;">
                <% topDistricts.forEach(function(d) { %>
                  <div style="background: #fbf7f4; padding: 12px 16px; border-radius: 10px; border: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
                    <div>
                      <strong style="display: block; font-size: 14px; color: var(--admin-text-dark);">📍 <%= d._id %></strong>
                      <span style="font-size: 11px; color: var(--admin-text-muted);">Pledges from district</span>
                    </div>
                    <span style="font-size: 16px; font-weight: 800; color: var(--admin-primary); background: #fff0ec; padding: 4px 10px; border-radius: 8px;">
                      <%= d.count %>
                    </span>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p style="text-align: center; color: var(--admin-text-muted); font-size: 13px;">District statistics are loading...</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div>
        <!-- 1. Quick Actions -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              Quick Actions
            </h3>
          </div>

          <div style="padding: 16px; display: flex; flex-direction: column; gap: 10px;">
            <a href="/admin/kalash-yatra" class="btn-admin" style="justify-content: flex-start; background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>संकल्प यात्रा हब 🚩</span>
            </a>

            <a href="/admin/gallery/bulk" class="btn-admin" style="justify-content: flex-start; background: #fdf6ec; color: #b45309; border: 1px solid #fde68a;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <span>+ Bulk Photo Upload</span>
            </a>

            <a href="/admin/gallery/new" class="btn-admin" style="justify-content: flex-start; background: #fff0ec; color: var(--admin-primary); border: 1px solid #f7c9be;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>+ Add Single Sankalp Photo</span>
            </a>

            <a href="/admin/home/hero" class="btn-admin btn-admin-outline" style="justify-content: flex-start;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>Manage Hero Sliders</span>
            </a>

            <a href="/admin/home/initiatives" class="btn-admin btn-admin-outline" style="justify-content: flex-start;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              <span>Manage Work & Initiatives</span>
            </a>

            <a href="/admin/home/notices" class="btn-admin btn-admin-outline" style="justify-content: flex-start;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              <span>Update Notices & Helpline</span>
            </a>

            <a href="/gallery" target="_blank" class="btn-admin btn-admin-outline" style="justify-content: flex-start; border-color: #8b5cf6; color: #6d28d9;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <span>View Public Gallery ↗</span>
            </a>
          </div>
        </div>

        <!-- 2. Live Contact & Helpline Info -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Live Contact & Helpline
            </h3>
            <a href="/admin/home/notices" style="font-size: 11px; font-weight: 700; color: var(--admin-primary);">Edit</a>
          </div>

          <div style="padding: 18px;">
            <div style="margin-bottom: 12px;">
              <span style="display: block; font-size: 11px; color: var(--admin-text-muted); font-weight: 600;">Helpline Number</span>
              <strong style="font-size: 14px; color: var(--admin-text-dark);"><%= quickInfo.helplineTel || quickInfo.helplineText || '+91 99999 99999' %></strong>
            </div>

            <div style="margin-bottom: 12px;">
              <span style="display: block; font-size: 11px; color: var(--admin-text-muted); font-weight: 600;">Email Address</span>
              <strong style="font-size: 13px; color: var(--admin-text-dark);"><%= quickInfo.helplineEmail || 'info@nishadyatra.org' %></strong>
            </div>

            <div>
              <span style="display: block; font-size: 11px; color: var(--admin-text-muted); font-weight: 600;">Headquarters Address</span>
              <strong style="font-size: 12px; color: var(--admin-text-dark); line-height: 1.4;"><%= quickInfo.helplineAddress || 'Uttar Pradesh, India' %></strong>
            </div>
          </div>
        </div>

        <!-- 3. Server & System Health Status -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              System Health & Status
            </h3>
          </div>

          <div style="padding: 18px;">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--admin-border-subtle); font-size: 12px;">
              <span style="color: var(--admin-text-muted);">Database Status:</span>
              <span style="font-weight: 700; color: var(--admin-success); display: inline-flex; align-items: center; gap: 4px;">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--admin-success); display: inline-block;"></span>
                <%= systemInfo.dbStatus %>
              </span>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--admin-border-subtle); font-size: 12px;">
              <span style="color: var(--admin-text-muted);">Server Uptime:</span>
              <strong style="color: var(--admin-text-dark);"><%= systemInfo.uptime %></strong>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--admin-border-subtle); font-size: 12px;">
              <span style="color: var(--admin-text-muted);">Node.js Version:</span>
              <strong style="color: var(--admin-text-dark);"><%= systemInfo.nodeVersion %></strong>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--admin-border-subtle); font-size: 12px;">
              <span style="color: var(--admin-text-muted);">Server Port:</span>
              <strong style="color: var(--admin-text-dark);">Port <%= systemInfo.serverPort %></strong>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; font-size: 12px;">
              <span style="color: var(--admin-text-muted);">Active Admin Users:</span>
              <strong style="color: var(--admin-primary);"><%= stats.adminsCount %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../common/footer") %>
