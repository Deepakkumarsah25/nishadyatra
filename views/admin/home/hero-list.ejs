<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Hero Slider Manager
        </h1>
        <p>Manage home page main slider banners, headlines, and call-to-action links</p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/admin/home/hero/new" class="btn-admin btn-admin-primary">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add New Slide</span>
      </a>
      <a href="/" target="_blank" class="view-site-btn">View Website</a>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (message) { %>
      <div class="admin-alert admin-alert-success">✓ <%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          Available Hero Slides (<%= slides.length %>)
        </h3>
        <span style="font-size: 12px; color: var(--admin-text-muted);">Ordered list (lower order number appears first)</span>
      </div>

      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 70px;">Order</th>
              <th style="width: 120px;">Image</th>
              <th>Title & Description</th>
              <th>Tag / Badge</th>
              <th>Button Links</th>
              <th style="width: 100px;">Status</th>
              <th style="width: 160px; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (slides && slides.length > 0) { %>
              <% slides.forEach(function(slide) { %>
                <tr>
                  <td><strong>#<%= slide.order %></strong></td>
                  <td>
                    <img class="hero-slide-thumbnail" src="<%= slide.imageUrl %>" alt="<%= slide.tag %>" onerror="this.src='https://placehold.co/180x110/eadfd7/333?text=Slide'"/>
                  </td>
                  <td>
                    <div style="font-weight: 700; font-size: 14px; color: var(--admin-text-dark); margin-bottom: 3px;">
                      <%= slide.headingPrefix %> <span style="color: var(--admin-primary);"><%= slide.highlightText %></span> <%= slide.headingSuffix %>
                    </div>
                    <div style="font-size: 11px; color: var(--admin-text-muted); line-height: 1.4; max-width: 420px;">
                      <%= slide.description ? slide.description.substring(0, 110) + '...' : '' %>
                    </div>
                  </td>
                  <td>
                    <span style="display:inline-block; font-size: 11px; font-weight: 700; background: var(--admin-primary-light); color: var(--admin-primary); padding: 3px 8px; border-radius: 4px;">
                      <%= slide.tag %>
                    </span>
                    <% if (slide.badgeText) { %>
                      <div style="font-size: 10px; color: var(--admin-text-muted); margin-top: 4px; max-width: 200px;">
                        <%= slide.badgeText %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-size: 11px;">
                      <strong>1:</strong> <%= slide.primaryBtnText %> (<%= slide.primaryBtnLink %>)
                    </div>
                    <div style="font-size: 11px; color: var(--admin-text-muted);">
                      <strong>2:</strong> <%= slide.secondaryBtnText %> (<%= slide.secondaryBtnLink %>)
                    </div>
                  </td>
                  <td>
                    <form action="/admin/home/hero/toggle/<%= slide._id %>" method="POST" style="display:inline;">
                      <button type="submit" class="badge-status <%= slide.isActive ? 'badge-active' : 'badge-inactive' %>" style="border:none; cursor:pointer;" title="Click to toggle status">
                        <%= slide.isActive ? 'Active' : 'Hidden' %>
                      </button>
                    </form>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <a href="/admin/home/hero/edit/<%= slide._id %>" class="btn-admin btn-admin-outline btn-admin-sm">Edit</a>
                      <form action="/admin/home/hero/delete/<%= slide._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this slide?');" style="display:inline;">
                        <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align:center; padding: 40px; color: var(--admin-text-muted);">
                  No hero slides found. Click the button above to create a new slide.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include("../common/footer") %>
