<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          प्राप्त ऑनलाइन संकल्प एवं सहायता संदेश (Pledges & Inquiries)
        </h1>
        <p>होम पेज साइडबार संकल्प फॉर्म एवं पहल मॉडल से प्राप्त हुए आम जन के संदेश</p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/" target="_blank" class="view-site-btn">वेबसाइट देखें</a>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (message) { %>
      <div class="admin-alert admin-alert-success">✓ <%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          प्राप्त प्रविष्टियां (<%= inquiries.length %>)
        </h3>

        <!-- Filter tabs -->
        <div style="display: flex; gap: 8px;">
          <a href="/admin/home/inquiries" class="btn-admin btn-admin-sm <%= !currentFilter.type ? 'btn-admin-primary' : 'btn-admin-outline' %>">सभी</a>
          <a href="/admin/home/inquiries?type=pledge" class="btn-admin btn-admin-sm <%= currentFilter.type === 'pledge' ? 'btn-admin-primary' : 'btn-admin-outline' %>">केवल संकल्प</a>
          <a href="/admin/home/inquiries?type=initiative" class="btn-admin btn-admin-sm <%= currentFilter.type === 'initiative' ? 'btn-admin-primary' : 'btn-admin-outline' %>">केवल पहल अनुरोध</a>
        </div>
      </div>

      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 130px;">दिनांक व समय</th>
              <th style="width: 110px;">प्रकार</th>
              <th>नाम</th>
              <th>मोबाइल नंबर</th>
              <th>जिला / क्षेत्र</th>
              <th>श्रेणी / संदेश</th>
              <th style="width: 120px;">स्थिति</th>
              <th style="width: 100px; text-align: right;">हटाएं</th>
            </tr>
          </thead>
          <tbody>
            <% if (inquiries && inquiries.length > 0) { %>
              <% inquiries.forEach(function(item) { %>
                <tr>
                  <td>
                    <div style="font-size: 11px; font-weight: 700; color: var(--admin-text-dark);">
                      <%= new Date(item.createdAt).toLocaleDateString('hi-IN') %>
                    </div>
                    <div style="font-size: 10px; color: var(--admin-text-muted);">
                      <%= new Date(item.createdAt).toLocaleTimeString('hi-IN', { hour: '2-digit', minute: '2-digit' }) %>
                    </div>
                  </td>
                  <td>
                    <span style="display:inline-block; font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 4px; <%= item.type === 'pledge' ? 'background: #e0f2fe; color: #0284c7;' : 'background: #fef3c7; color: #b45309;' %>">
                      <%= item.type === 'pledge' ? 'ऑनलाइन संकल्प' : 'पहल सहायता' %>
                    </span>
                  </td>
                  <td>
                    <strong style="font-size: 13px; color: var(--admin-text-dark);"><%= item.name %></strong>
                  </td>
                  <td>
                    <a href="tel:<%= item.phone %>" style="color: var(--admin-primary); font-weight: 700; font-size: 12px;">
                      📞 <%= item.phone %>
                    </a>
                  </td>
                  <td>
                    <span style="font-size: 12px; color: var(--admin-text-dark);"><%= item.district || 'उल्लेख नहीं' %></span>
                  </td>
                  <td>
                    <div style="font-weight: 600; font-size: 11px; color: var(--admin-primary-dark);">
                      <%= item.category %>
                    </div>
                    <% if (item.message) { %>
                      <div style="font-size: 11px; color: var(--admin-text-muted); line-height: 1.3; max-width: 300px; margin-top: 2px;">
                        <%= item.message %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <form action="/admin/home/inquiries/status/<%= item._id %>" method="POST">
                      <select name="status" class="form-control" style="height: 30px; font-size: 11px; padding: 0 6px; font-weight: 700;" onchange="this.form.submit()">
                        <option value="new" <%= item.status === 'new' ? 'selected' : '' %>>🟡 नया</option>
                        <option value="contacted" <%= item.status === 'contacted' ? 'selected' : '' %>>🔵 संपर्क हुआ</option>
                        <option value="completed" <%= item.status === 'completed' ? 'selected' : '' %>>🟢 पूर्ण हुआ</option>
                      </select>
                    </form>
                  </td>
                  <td style="text-align: right;">
                    <form action="/admin/home/inquiries/delete/<%= item._id %>" method="POST" onsubmit="return confirm('क्या आप इस प्रविष्टि को हटाना चाहते हैं?');" style="display:inline;">
                      <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm">हटाएं</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align:center; padding: 40px; color: var(--admin-text-muted);">
                  अभी तक कोई संदेश या संकल्प प्राप्त नहीं हुआ है।
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include("../common/footer") %>
