<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Commitment & Pillars of Trust Management
        </h1>
        <p>Edit the core pillars of trust, inspirational quote, and pledge showcase card points</p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/#why-choose" target="_blank" class="view-site-btn">View Live Section</a>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (message) { %>
      <div class="admin-alert admin-alert-success">✓ <%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px;">
      
      <!-- Left Column: Section Details & Quote Card -->
      <div>
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Section Title & Pledge Showcase Card Details
            </h3>
          </div>

          <div class="admin-card-body">
            <form action="/admin/home/why-choose/update" method="POST">
              <div class="form-grid-2">
                <div class="form-group">
                  <label for="sectionTag">Section Tag</label>
                  <input type="text" id="sectionTag" name="sectionTag" class="form-control" value="<%= whyChoose.sectionTag %>" required />
                </div>

                <div class="form-group">
                  <label for="highlightText">Highlight Text (Accent Color)</label>
                  <input type="text" id="highlightText" name="highlightText" class="form-control" value="<%= whyChoose.highlightText %>" required />
                </div>
              </div>

              <div class="form-group">
                <label for="sectionTitle">Section Main Title</label>
                <input type="text" id="sectionTitle" name="sectionTitle" class="form-control" value="<%= whyChoose.sectionTitle %>" required />
              </div>

              <div class="form-group">
                <label for="sectionSubtitle">Section Subtitle</label>
                <textarea id="sectionSubtitle" name="sectionSubtitle" class="form-control" rows="2" required><%= whyChoose.sectionSubtitle %></textarea>
              </div>

              <div class="form-group">
                <label for="introHeading">Intro Heading (Left Section)</label>
                <input type="text" id="introHeading" name="introHeading" class="form-control" value="<%= whyChoose.introHeading %>" required />
              </div>

              <div class="form-group">
                <label for="introDesc">Intro Description (Left Section)</label>
                <textarea id="introDesc" name="introDesc" class="form-control" rows="2" required><%= whyChoose.introDesc %></textarea>
              </div>

              <div style="font-size: 13px; font-weight: 800; color: var(--admin-primary-dark); margin: 20px 0 10px; padding-bottom: 4px; border-bottom: 1px solid var(--admin-border-subtle);">
                Pledge Showcase Card (Right Section)
              </div>

              <div class="form-group">
                <label for="quoteText">Inspirational Quote (Quote Text)</label>
                <textarea id="quoteText" name="quoteText" class="form-control" rows="2" required><%= whyChoose.quoteText %></textarea>
              </div>

              <div class="form-group">
                <label for="pledgePoints">Pledge Card Bullet Points (One per line)</label>
                <textarea id="pledgePoints" name="pledgePoints" class="form-control" rows="4" required><%= whyChoose.pledgePoints ? whyChoose.pledgePoints.join('\n') : '' %></textarea>
                <div class="form-hint">Each new line will create a checkmark bullet point.</div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label for="pledgeBtnText">Card Button Label</label>
                  <input type="text" id="pledgeBtnText" name="pledgeBtnText" class="form-control" value="<%= whyChoose.pledgeBtnText %>" required />
                </div>
                <div class="form-group">
                  <label for="pledgeBtnLink">Card Button Link</label>
                  <input type="text" id="pledgeBtnLink" name="pledgeBtnLink" class="form-control" value="<%= whyChoose.pledgeBtnLink %>" required />
                </div>
              </div>

              <button type="submit" class="btn-admin btn-admin-primary" style="margin-top: 10px;">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                <span>Update Section Data</span>
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Right Column: Trust Pillars Management -->
      <div>
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Pillars of Trust (<%= whyChoose.pillars ? whyChoose.pillars.length : 0 %>)
            </h3>
          </div>

          <div class="admin-card-body">
            <!-- List of existing pillars -->
            <% if (whyChoose.pillars && whyChoose.pillars.length > 0) { %>
              <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px;">
                <% whyChoose.pillars.forEach(function(p, idx) { %>
                  <div style="padding: 14px; border: 1px solid var(--admin-border); border-radius: 9px; background: #fffdfb; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;">
                    <div>
                      <div style="font-weight: 700; font-size: 13px; color: var(--admin-text-dark); margin-bottom: 4px;">
                        <%= idx + 1 %>. <%= p.title %>
                      </div>
                      <div style="font-size: 11px; color: var(--admin-text-muted); line-height: 1.4;">
                        <%= p.description %>
                      </div>
                    </div>
                    <form action="/admin/home/why-choose/pillar/delete/<%= p._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this pillar?');" style="flex-shrink: 0;">
                      <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm">Delete</button>
                    </form>
                  </div>
                <% }); %>
              </div>
            <% } %>

            <!-- Add new pillar form -->
            <div style="background: #faf6f3; padding: 18px; border-radius: 11px; border: 1px solid var(--admin-border);">
              <h4 style="font-size: 13px; font-weight: 800; color: var(--admin-text-dark); margin-bottom: 12px;">+ Add New Pillar of Trust</h4>
              <form action="/admin/home/why-choose/pillar/add" method="POST">
                <div class="form-group">
                  <label for="pillarTitle">Pillar Title *</label>
                  <input type="text" id="pillarTitle" name="title" class="form-control" placeholder="e.g. 100% Active Ground Presence" required />
                </div>

                <div class="form-group">
                  <label for="pillarDesc">Pillar Brief Description *</label>
                  <textarea id="pillarDesc" name="description" class="form-control" rows="2" placeholder="Transparent ground-level work rather than mere paper claims..." required></textarea>
                </div>

                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="pillarIcon">Icon</label>
                    <select id="pillarIcon" name="iconKey" class="form-control">
                      <option value="shield">🛡️ Security (Shield)</option>
                      <option value="users">👥 Transparent Leadership (Users)</option>
                      <option value="check">✓ Proven Impact (Check)</option>
                      <option value="award">⭐ Heritage & Pride (Award)</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="pillarOrder">Display Order</label>
                    <input type="number" id="pillarOrder" name="order" class="form-control" value="<%= (whyChoose.pillars ? whyChoose.pillars.length : 0) + 1 %>" />
                  </div>
                </div>

                <button type="submit" class="btn-admin btn-admin-primary btn-admin-sm" style="margin-top: 6px;">Add Pillar</button>
              </form>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include("../common/footer") %>
