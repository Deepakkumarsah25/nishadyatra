<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <a href="/admin/home/initiatives" style="color: var(--admin-text-muted); margin-right: 6px;">←</a>
          <%= isEdit ? 'Edit Initiative Card' : 'Add New Initiative Card' %>
        </h1>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/admin/home/initiatives" class="btn-admin btn-admin-outline">Back to List</a>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card" style="max-width: 920px; margin: 0 auto;">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          Initiative Card & Action Modal Details
        </h3>
      </div>

      <div class="admin-card-body">
        <form action="<%= isEdit ? '/admin/home/initiatives/edit/' + initiative._id : '/admin/home/initiatives/new' %>" method="POST">
          
          <!-- Section 1: Card Front Details -->
          <div style="font-size: 14px; font-weight: 800; color: var(--admin-primary-dark); margin-bottom: 14px; padding-bottom: 6px; border-bottom: 1px solid var(--admin-border-subtle);">
            Part 1: Front Card Details (Displayed on Home Page)
          </div>

          <div class="form-grid-3">
            <div class="form-group">
              <label for="key">Unique Key *</label>
              <input type="text" id="key" name="key" class="form-control" placeholder="e.g. youth-wing" value="<%= initiative ? initiative.key : '' %>" required <%= isEdit ? 'readonly style="background:#f5eee8;"' : '' %> />
              <div class="form-hint">Lowercase letters and hyphens only (e.g. social-rights, youth-wing)</div>
            </div>

            <div class="form-group">
              <label for="cardTag">Card Tag *</label>
              <input type="text" id="cardTag" name="cardTag" class="form-control" placeholder="e.g. Education & Youth" value="<%= initiative ? initiative.cardTag : '' %>" required />
            </div>

            <div class="form-group">
              <label for="iconKey">Icon Type</label>
              <select id="iconKey" name="iconKey" class="form-control">
                <option value="scale" <%= initiative && initiative.iconKey === 'scale' ? 'selected' : '' %>>⚖️ Rights & Social Justice (Scale)</option>
                <option value="school" <%= initiative && initiative.iconKey === 'school' ? 'selected' : '' %>>🎓 Education & Youth (Cap)</option>
                <option value="trending" <%= initiative && initiative.iconKey === 'trending' ? 'selected' : '' %>>📈 Economic & Livelihood (Growth)</option>
                <option value="water" <%= initiative && initiative.iconKey === 'water' ? 'selected' : '' %>>💧 River & Water Conservation (Water)</option>
                <option value="hospital" <%= initiative && initiative.iconKey === 'hospital' ? 'selected' : '' %>>🏥 Relief & Disaster Response (Relief)</option>
                <option value="flag" <%= initiative && initiative.iconKey === 'flag' ? 'selected' : '' %>>🚩 Cultural & Community Heritage (Flag)</option>
              </select>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="title">Card Main Title *</label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Educational Support & Youth Guidance" value="<%= initiative ? initiative.title : '' %>" required />
            </div>

            <div class="form-group">
              <label for="btnText">Card Button Label *</label>
              <input type="text" id="btnText" name="btnText" class="form-control" placeholder="e.g. Connect with Youth Wing" value="<%= initiative ? initiative.btnText : 'Get Involved & Support' %>" required />
            </div>
          </div>

          <div class="form-group">
            <label for="description">Card Short Description *</label>
            <textarea id="description" name="description" class="form-control" rows="2" placeholder="Write a concise 2-sentence summary displayed on the card..." required><%= initiative ? initiative.description : '' %></textarea>
          </div>

          <div class="form-group">
            <label for="points">Key Bullet Points (One point per line)</label>
            <textarea id="points" name="points" class="form-control" rows="3" placeholder="Enter one key initiative point per line..."><%= initiative && initiative.points ? initiative.points.join('\n') : '' %></textarea>
            <div class="form-hint">Each new line creates a bullet point on the card.</div>
          </div>

          <!-- Section 2: Action Modal Popup Details -->
          <div style="font-size: 14px; font-weight: 800; color: var(--admin-primary-dark); margin: 26px 0 14px; padding-bottom: 6px; border-bottom: 1px solid var(--admin-border-subtle);">
            Part 2: Interactive Modal Popup Details (Opened on Click)
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="modalTag">Modal Department Tag</label>
              <input type="text" id="modalTag" name="modalTag" class="form-control" placeholder="e.g. Education & Youth Wing" value="<%= initiative ? initiative.modalTag : '' %>" />
            </div>

            <div class="form-group">
              <label for="modalTitle">Modal Heading</label>
              <input type="text" id="modalTitle" name="modalTitle" class="form-control" placeholder="e.g. Youth Wing Career Mentorship & Student Aid" value="<%= initiative ? initiative.modalTitle : '' %>" />
            </div>
          </div>

          <div class="form-group">
            <label for="modalDescription">Modal Detailed Description</label>
            <textarea id="modalDescription" name="modalDescription" class="form-control" rows="3" placeholder="Comprehensive information displayed inside the modal..."><%= initiative ? initiative.modalDescription : '' %></textarea>
          </div>

          <div class="form-group">
            <label for="modalHighlights">Modal Highlights (One per line)</label>
            <textarea id="modalHighlights" name="modalHighlights" class="form-control" rows="3" placeholder="Write one key initiative feature or benefit per line..."><%= initiative && initiative.modalHighlights ? initiative.modalHighlights.join('\n') : '' %></textarea>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="helplineText">Modal Helpline Display Text</label>
              <input type="text" id="helplineText" name="helplineText" class="form-control" placeholder="Youth Wing Helpline: +91 99999 99998" value="<%= initiative ? initiative.helplineText : '' %>" />
            </div>

            <div class="form-group">
              <label for="helplineTel">Dial Number for Helpline</label>
              <input type="text" id="helplineTel" name="helplineTel" class="form-control" placeholder="+919999999998" value="<%= initiative ? initiative.helplineTel : '' %>" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="formTitle">Modal Form Title</label>
              <input type="text" id="formTitle" name="formTitle" class="form-control" placeholder="Student Mentorship Application Form" value="<%= initiative ? initiative.formTitle : '' %>" />
            </div>

            <div class="form-group">
              <label for="formSubmitText">Modal Form Submit Button Label</label>
              <input type="text" id="formSubmitText" name="formSubmitText" class="form-control" placeholder="Get Mentorship from Youth Wing" value="<%= initiative ? initiative.formSubmitText : '' %>" />
            </div>
          </div>

          <!-- Section 3: Order and Status -->
          <div class="form-grid-2" style="margin-top: 14px;">
            <div class="form-group">
              <label for="order">Display Order</label>
              <input type="number" id="order" name="order" class="form-control" value="<%= initiative ? initiative.order : 0 %>" min="0" />
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 12px; margin-top: 26px;">
              <input type="checkbox" id="isActive" name="isActive" value="true" <%= !initiative || initiative.isActive ? 'checked' : '' %> style="width: 18px; height: 18px; accent-color: var(--admin-primary); cursor: pointer;" />
              <label for="isActive" style="margin-bottom: 0; cursor: pointer; font-size: 14px;">Keep this initiative card active and published on website</label>
            </div>
          </div>

          <!-- Actions -->
          <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--admin-border-subtle);">
            <button type="submit" class="btn-admin btn-admin-primary">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span><%= isEdit ? 'Save Changes' : 'Save Initiative' %></span>
            </button>
            <a href="/admin/home/initiatives" class="btn-admin btn-admin-outline">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<%- include("../common/footer") %>
