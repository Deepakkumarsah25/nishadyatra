<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          Work & Initiatives Manager (What We Do)
        </h1>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/admin/home/initiatives/new" class="btn-admin btn-admin-primary">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add New Initiative</span>
      </a>
      <a href="/#what-we-do" target="_blank" class="view-site-btn">View Section</a>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (message) { %>
      <div class="admin-alert admin-alert-success">✓ <%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Available Initiative Cards (<%= pagination.total %>)
        </h3>
        <span style="font-size: 12px; color: var(--admin-text-muted);">Clicking an initiative opens its dynamic action modal</span>
      </div>

      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 60px;">Order</th>
              <th>Key</th>
              <th>Tag</th>
              <th>Title & Short Description</th>
              <th>Button Label</th>
              <th>Modal Helpline</th>
              <th style="width: 90px;">Status</th>
              <th style="width: 140px; text-align: center;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (initiatives && initiatives.length > 0) { %>
              <% initiatives.forEach(function(item) { %>
                <tr>
                  <td><strong>#<%= item.order %></strong></td>
                  <td>
                    <code style="background: #f4ece6; padding: 2px 6px; border-radius: 4px; font-size: 11px; color: var(--admin-primary-dark);"><%= item.key %></code>
                  </td>
                  <td>
                    <span style="display:inline-block; font-size: 11px; font-weight: 700; background: var(--admin-primary-light); color: var(--admin-primary); padding: 2px 8px; border-radius: 4px;">
                      <%= item.cardTag %>
                    </span>
                  </td>
                  <td>
                    <div style="font-weight: 700; font-size: 13px; color: var(--admin-text-dark); margin-bottom: 3px;">
                      <%= item.title %>
                    </div>
                    <div style="font-size: 11px; color: var(--admin-text-muted); line-height: 1.4; max-width: 380px;">
                      <%= item.description ? item.description.substring(0, 90) + '...' : '' %>
                    </div>
                  </td>
                  <td>
                    <span style="font-size: 12px; font-weight: 600; color: #443232;"><%= item.btnText %></span>
                  </td>
                  <td>
                    <div style="font-size: 11px; color: var(--admin-text-dark);">
                      <%= item.helplineText || 'Default' %>
                    </div>
                  </td>
                  <td>
                    <form action="/admin/home/initiatives/toggle/<%= item._id %>" method="POST" style="display:inline;">
                      <button type="submit" class="badge-status <%= item.isActive ? 'badge-active' : 'badge-inactive' %>" style="border:none; cursor:pointer;" title="Click to toggle status">
                        <%= item.isActive ? 'Active' : 'Hidden' %>
                      </button>
                    </form>
                  </td>
                  <td style="text-align: center;">
                    <div class="table-actions">
                      <a href="/admin/home/initiatives/edit/<%= item._id %>" class="btn-edit" title="Edit Initiative">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        <span>Edit</span>
                      </a>
                      <form action="/admin/home/initiatives/delete/<%= item._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this initiative card?');" style="display:inline; margin: 0;">
                        <button type="submit" class="btn-del" title="Delete Initiative">
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                          <span>Delete</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align:center; padding: 40px; color: var(--admin-text-muted);">
                  No initiative cards found. Click the button above to add a new card.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
        <%- include("../common/pagination", { pagination, paginationPath, paginationQuery }) %>
      </div>
    </div>
  </div>
</div>

<%- include("../common/footer") %>
