<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <%= isEdit ? 'संकल्प फोटो संपादित करें' : 'नई संकल्प फोटो जोड़ें' %>
        </h1>
        <p><%= isEdit ? 'मौजूदा फोटो की जानकारी अथवा तस्वीर को अपडेट करें' : 'संकल्प लेते हुए व्यक्ति की तस्वीर, नाम, जिला व विवरण दर्ज करें' %></p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/admin/gallery" class="btn-admin btn-admin-outline">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>सूची पर वापस जाएं</span>
      </a>
      <% if (!isEdit) { %>
        <a href="/admin/gallery/bulk" class="btn-admin btn-admin-outline" style="border-color: #c28834; color: #a26b1a; background: #fffdf9;">
          <span>थोक अपलोड करें ↗</span>
        </a>
      <% } %>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card" style="max-width: 860px; margin: 0 auto;">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          फोटो विवरण फॉर्म (Photo Details)
        </h3>
        <span style="font-size: 11px; color: var(--admin-text-muted);">* चिन्हित फ़ील्ड आवश्यक हैं</span>
      </div>

      <div class="admin-card-body">
        <form
          action="<%= isEdit ? '/admin/gallery/edit/' + photo._id : '/admin/gallery/new' %>"
          method="POST"
          enctype="multipart/form-data"
        >
          <!-- Grid 1: Name and District -->
          <div class="form-grid-2">
            <div class="form-group">
              <label for="name">संकल्पकर्ता का नाम (Participant Name) *</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                placeholder="उदा. रामवृक्ष निषाद / सामूहिक संकल्प"
                value="<%= photo && photo.name ? photo.name : '' %>"
                required
              />
              <span class="form-hint">फोटो में उपस्थित व्यक्ति अथवा समूह का नाम</span>
            </div>

            <div class="form-group">
              <label for="district">जिला (District) *</label>
              <input
                type="text"
                id="district"
                name="district"
                list="districtSuggestions"
                class="form-control"
                placeholder="उदा. गोरखपुर, वाराणसी, प्रयागराज..."
                value="<%= photo && photo.district ? photo.district : '' %>"
                required
              />
              <datalist id="districtSuggestions">
                <% if (districtsList && districtsList.length > 0) { %>
                  <% districtsList.forEach(function(d) { %>
                    <option value="<%= d %>"></option>
                  <% }); %>
                <% } %>
                <option value="गोरखपुर"></option>
                <option value="वाराणसी"></option>
                <option value="प्रयागराज"></option>
                <option value="अयोध्या"></option>
                <option value="लखनऊ"></option>
                <option value="गाज़ीपुर"></option>
                <option value="बलिया"></option>
                <option value="मीरजापुर"></option>
                <option value="कानपुर"></option>
                <option value="जौनपुर"></option>
                <option value="पटना"></option>
              </datalist>
              <span class="form-hint">ड्रॉपडाउन से चुनें या नया जिला टाइप करें</span>
            </div>
          </div>

          <!-- Grid 2: Date and Order -->
          <div class="form-grid-2">
            <div class="form-group">
              <label for="date">संकल्प दिनांक (Date) *</label>
              <input
                type="date"
                id="date"
                name="date"
                class="form-control"
                value="<%= photo && photo.date ? formatDateForInput(photo.date) : '' %>"
              />
              <span class="form-hint">संकल्प लिए जाने की तारीख</span>
            </div>

            <div class="form-group">
              <label for="order">प्रदर्शन क्रम संख्या (Display Order)</label>
              <input
                type="number"
                id="order"
                name="order"
                class="form-control"
                placeholder="0"
                value="<%= photo && typeof photo.order !== 'undefined' ? photo.order : 0 %>"
              />
              <span class="form-hint">कम संख्या वाली फोटो पहले दिखेगी (0, 1, 2...)</span>
            </div>
          </div>

          <!-- Caption -->
          <div class="form-group">
            <label for="caption">विवरण या संकल्प संदेश (Caption / Message)</label>
            <textarea
              id="caption"
              name="caption"
              class="form-control"
              rows="3"
              placeholder="उदा. एकता, स्वाभिमान एवं शिक्षा के प्रचार-प्रसार हेतु लिया गया पावन संकल्प..."
            ><%= photo && photo.caption ? photo.caption : '' %></textarea>
            <span class="form-hint">फोटो पर क्लिक करने पर दिखने वाला संदेश</span>
          </div>

          <!-- Image Upload / Image URL Section -->
          <div style="background: #faf7f5; padding: 20px; border-radius: 12px; border: 1px dashed #dfcfc7; margin-bottom: 24px;">
            <label style="display: block; font-size: 13px; font-weight: 800; color: var(--admin-text-dark); margin-bottom: 12px;">
              तस्वीर चुनें (Select Photo) *
            </label>

            <!-- Current image preview if editing -->
            <% if (photo && photo.imageUrl) { %>
              <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px; padding: 10px; background: #fff; border-radius: 8px; border: 1px solid var(--admin-border);">
                <img
                  src="<%= photo.imageUrl %>"
                  alt="वर्तमान तस्वीर"
                  id="currentPreview"
                  style="width: 100px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid var(--admin-border);"
                />
                <div>
                  <strong style="display: block; font-size: 13px; color: var(--admin-text-dark);">वर्तमान फोटो</strong>
                  <span style="font-size: 11px; color: var(--admin-text-muted);">यदि नई तस्वीर नहीं अपलोड करेंगे तो यही फोटो सुरक्षित रहेगी।</span>
                </div>
              </div>
            <% } %>

            <div class="form-grid-2">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="photoFile" style="font-weight: 600;">विकल्प 1: अपने कंप्यूटर/फ़ोन से फोटो अपलोड करें</label>
                <input
                  type="file"
                  id="photoFile"
                  name="photo"
                  accept="image/*"
                  class="form-control"
                  style="padding-top: 8px;"
                  onchange="previewUploadedImage(this)"
                />
                <span class="form-hint">समर्थित: JPG, PNG, WEBP (अधिकतम 15MB)</span>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="imageUrl" style="font-weight: 600;">विकल्प 2: या ऑनलाइन फोटो का सीधा लिंक (URL)</label>
                <input
                  type="url"
                  id="imageUrl"
                  name="imageUrl"
                  class="form-control"
                  placeholder="https://example.com/photo.jpg"
                  value="<%= photo && photo.imageUrl && !photo.imageFilename ? photo.imageUrl : '' %>"
                  oninput="previewUrlImage(this.value)"
                />
                <span class="form-hint">यदि फोटो किसी अन्य लिंक पर होस्टेड है</span>
              </div>
            </div>

            <!-- Dynamic Live Preview Box -->
            <div id="livePreviewContainer" style="display: none; margin-top: 16px; text-align: center; padding: 12px; background: #fff; border-radius: 8px; border: 1px solid var(--admin-border);">
              <span style="display: block; font-size: 11px; font-weight: 700; color: var(--admin-text-muted); margin-bottom: 8px;">नई तस्वीर का पूर्वावलोकन (Preview)</span>
              <img id="livePreviewImg" src="" alt="Preview" style="max-height: 180px; max-width: 100%; border-radius: 6px; object-fit: contain; box-shadow: 0 4px 10px rgba(0,0,0,0.08);"/>
            </div>
          </div>

          <!-- Publish Status Toggle -->
          <div class="form-group" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding: 12px 16px; background: #fff; border: 1px solid var(--admin-border); border-radius: 9px;">
            <input
              type="checkbox"
              id="isPublished"
              name="isPublished"
              style="width: 20px; height: 20px; accent-color: var(--admin-primary); cursor: pointer;"
              <%= photo && photo.isPublished ? 'checked' : '' %>
            />
            <label for="isPublished" style="margin-bottom: 0; cursor: pointer; font-size: 13px; font-weight: 700;">
              वेबसाइट पर तुरंत प्रकाशित करें (Published Live)
              <span style="display: block; font-size: 11px; font-weight: 400; color: var(--admin-text-muted);">
                यदि टिक हटा दिया जाएगा तो फोटो गैलरी में नहीं दिखेगी (Draft रहेगी)।
              </span>
            </label>
          </div>

          <!-- Buttons -->
          <div style="display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--admin-border-subtle); padding-top: 20px;">
            <a href="/admin/gallery" class="btn-admin btn-admin-outline">
              रद्द करें (Cancel)
            </a>
            <button type="submit" class="btn-admin btn-admin-primary">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span><%= isEdit ? 'अपडेट सुरक्षित करें' : 'फोटो गैलरी में जोड़ें' %></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function previewUploadedImage(input) {
    const previewContainer = document.getElementById("livePreviewContainer");
    const previewImg = document.getElementById("livePreviewImg");
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        previewImg.src = e.target.result;
        previewContainer.style.display = "block";
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  function previewUrlImage(url) {
    const previewContainer = document.getElementById("livePreviewContainer");
    const previewImg = document.getElementById("livePreviewImg");
    if (url && url.startsWith("http")) {
      previewImg.src = url;
      previewContainer.style.display = "block";
    }
  }
</script>

<%- include("../common/footer") %>
