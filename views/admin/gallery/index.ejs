<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Sankalp Photo Gallery
        </h1>
        <p>Manage, edit, bulk upload, and control publication status of pledge photos</p>
      </div>
    </div>
    <div class="topbar-right" style="gap: 10px;">
      <a href="/admin/gallery/bulk" class="btn-admin btn-admin-outline" style="border-color: #c28834; color: #a26b1a; background: #fffdf9;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span>Bulk Upload</span>
      </a>
      <a href="/admin/gallery/new" class="btn-admin btn-admin-primary">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add New Photo</span>
      </a>
      <a href="/gallery" target="_blank" class="view-site-btn">View Live Gallery ↗</a>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <style>
      .gallery-filter-form {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
      }
      .gallery-filter-inputs {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        flex: 1;
      }

      @media (max-width: 900px) {
        .gallery-filter-inputs {
          width: 100%;
        }
        .gallery-filter-inputs > div,
        .gallery-filter-inputs select {
          flex: 1 1 calc(50% - 10px);
          width: auto !important;
        }
      }

      @media (max-width: 768px) {
        .topbar-right .btn-admin span {
          display: none;
        }
        .topbar-right .btn-admin {
          padding: 8px 10px;
        }
      }

      @media (max-width: 600px) {
        .gallery-filter-inputs {
          flex-direction: column;
          align-items: stretch;
        }
        .gallery-filter-inputs > div,
        .gallery-filter-inputs select,
        .gallery-filter-inputs button,
        .gallery-filter-inputs a {
          width: 100% !important;
          flex: none;
        }
      }
    </style>

    <% if (message) { %>
      <div class="admin-alert admin-alert-success">✓ <%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <!-- Quick Stats Cards -->
    <div class="admin-stats-grid">
      <div class="admin-card" style="margin-bottom: 0; padding: 18px; border-left: 4px solid var(--admin-primary);">
        <div style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Total Sankalp Photos</div>
        <div style="font-size: 26px; font-weight: 800; color: var(--admin-text-dark); margin-top: 6px;"><%= stats.total %></div>
      </div>
      <div class="admin-card" style="margin-bottom: 0; padding: 18px; border-left: 4px solid var(--admin-success);">
        <div style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Published Photos (Live)</div>
        <div style="font-size: 26px; font-weight: 800; color: var(--admin-success); margin-top: 6px;"><%= stats.published %></div>
      </div>
      <div class="admin-card" style="margin-bottom: 0; padding: 18px; border-left: 4px solid #f59e0b;">
        <div style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Unpublished (Draft/Hidden)</div>
        <div style="font-size: 26px; font-weight: 800; color: #b45309; margin-top: 6px;"><%= stats.unpublished %></div>
      </div>
      <div class="admin-card" style="margin-bottom: 0; padding: 18px; border-left: 4px solid #8b5cf6;">
        <div style="font-size: 11px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase;">Covered Districts</div>
        <div style="font-size: 26px; font-weight: 800; color: #6d28d9; margin-top: 6px;"><%= stats.districtsCount %></div>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="admin-card" style="padding: 16px 20px; margin-bottom: 20px;">
      <form action="/admin/gallery" method="GET" class="gallery-filter-form">
        <div class="gallery-filter-inputs">
          <!-- Search input -->
          <div style="position: relative; min-width: 220px; flex: 1;">
            <input
              type="text"
              name="search"
              value="<%= filters.search %>"
              placeholder="Search by name, district, or caption..."
              class="form-control"
              style="height: 38px; padding-left: 36px;"
            />
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#999" stroke-width="2" style="position: absolute; left: 12px; top: 11px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>

          <!-- State Filter -->
          <select name="state" id="filterState" class="form-control" style="height: 38px; width: 160px;">
            <option value="all" <%= filters.state === 'all' ? 'selected' : '' %>>All States</option>
            <% if (typeof statesList !== 'undefined' && statesList.length > 0) { %>
              <% statesList.forEach(function(st) { %>
                <option value="<%= st %>" <%= filters.state === st ? 'selected' : '' %>><%= st %></option>
              <% }); %>
            <% } %>
          </select>

          <!-- District Filter -->
          <select name="district" id="filterDistrict" class="form-control" style="height: 38px; width: 160px;">
            <option value="all" <%= filters.district === 'all' ? 'selected' : '' %>>All Districts</option>
            <% if (districtsList && districtsList.length > 0) { %>
              <% districtsList.forEach(function(d) { %>
                <option value="<%= d %>" <%= filters.district === d ? 'selected' : '' %>><%= d %></option>
              <% }); %>
            <% } %>
          </select>

          <!-- Status Filter -->
          <select name="status" class="form-control" style="height: 38px; width: 150px;">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published Only</option>
            <option value="unpublished" <%= filters.status === 'unpublished' ? 'selected' : '' %>>Unpublished Only</option>
          </select>

          <button type="submit" class="btn-admin btn-admin-primary btn-admin-sm" style="height: 38px; padding: 0 16px;">
            Apply Filter
          </button>

          <% if (filters.search || filters.state !== 'all' || filters.district !== 'all' || filters.status !== 'all') { %>
            <a href="/admin/gallery" class="btn-admin btn-admin-outline btn-admin-sm" style="height: 38px; display: inline-flex; align-items: center;">
              Reset
            </a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Photos Table & Grid View -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Available Photos (<%= pagination.total %>)
        </h3>
        <span style="font-size: 12px; color: var(--admin-text-muted);">Click status to toggle publish/unpublish</span>
      </div>

      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 80px;">Photo</th>
              <th>Name</th>
              <th>State & District</th>
              <th>Date</th>
              <th>Caption / Pledge Message</th>
              <th style="width: 120px;">Publication Status</th>
              <th style="width: 140px; text-align: center;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (photos && photos.length > 0) { %>
              <% photos.forEach(function(photo) { %>
                <tr>
                  <td>
                    <a href="<%= photo.imageUrl %>" target="_blank" title="Click to view full image">
                      <img
                        src="<%= photo.imageUrl %>"
                        alt="<%= photo.name %>"
                        style="width: 70px; height: 52px; object-fit: cover; border-radius: 8px; border: 1px solid var(--admin-border); transition: transform 0.2s;"
                        onmouseover="this.style.transform='scale(1.08)'"
                        onmouseout="this.style.transform='scale(1)'"
                        onerror="this.src='https://placehold.co/140x100/eadfd7/333?text=Photo'"
                      />
                    </a>
                  </td>
                  <td>
                    <strong style="color: var(--admin-text-dark); font-size: 14px;"><%= photo.name %></strong>
                  </td>
                  <td>
                    <span style="display: inline-block; padding: 3px 9px; font-size: 11px; font-weight: 700; background: #fff0ec; color: var(--admin-primary); border-radius: 6px; border: 1px solid #f7c9be;">
                      📍 <%= photo.district %>
                    </span>
                    <% if (photo.state) { %>
                      <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 3px; font-weight: 600;">
                        <%= photo.state %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span style="font-size: 12px; color: var(--admin-text-muted);">
                      <%= photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('en-US') : '-') %>
                    </span>
                  </td>
                  <td>
                    <div style="font-size: 12px; color: #555; max-width: 320px; line-height: 1.4;">
                      <%= photo.caption ? photo.caption : '—' %>
                    </div>
                  </td>
                  <td>
                    <form action="/admin/gallery/toggle/<%= photo._id %>" method="POST" style="display:inline;">
                      <button
                        type="submit"
                        class="badge-status <%= photo.isPublished ? 'badge-active' : 'badge-inactive' %>"
                        style="border: none; cursor: pointer; padding: 5px 10px;"
                        title="Click to toggle publication status"
                      >
                        <% if (photo.isPublished) { %>
                          <span style="color: var(--admin-success); font-weight: 800;">✓ Published</span>
                        <% } else { %>
                          <span style="color: #8c7870;">✕ Unpublished</span>
                        <% } %>
                      </button>
                    </form>
                  </td>
                  <td style="text-align: center;">
                    <div class="table-actions">
                      <a href="/admin/gallery/edit/<%= photo._id %>" class="btn-edit" title="Edit Photo">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        <span>Edit</span>
                      </a>
                      <form action="/admin/gallery/delete/<%= photo._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this photo?');" style="display:inline; margin: 0;">
                        <button type="submit" class="btn-del" title="Delete Photo">
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                          <span>Delete</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 48px; color: var(--admin-text-muted);">
                  <div style="font-size: 32px; margin-bottom: 8px;">📷</div>
                  <div style="font-size: 14px; font-weight: 700; color: var(--admin-text-dark);">No Sankalp photos found</div>
                  <p style="font-size: 12px; margin-top: 4px;">Click 'Add New Photo' or 'Bulk Upload' to add photos.</p>
                  <div style="margin-top: 14px; display: flex; gap: 10px; justify-content: center;">
                    <a href="/admin/gallery/new" class="btn-admin btn-admin-primary btn-admin-sm">Add New Photo</a>
                    <a href="/admin/gallery/bulk" class="btn-admin btn-admin-outline btn-admin-sm">Bulk Upload</a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
        <%- include("../common/pagination", { pagination, paginationPath, paginationQuery }) %>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin/india-states-districts.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof setupStateDistrictSelectors === "function") {
      setupStateDistrictSelectors({
        stateEl: "filterState",
        districtEl: "filterDistrict",
        includeAllOption: true,
        selectedState: "<%= filters.state %>",
        selectedDistrict: "<%= filters.district %>"
      });
    }
  });
</script>

<%- include("../common/footer") %>
