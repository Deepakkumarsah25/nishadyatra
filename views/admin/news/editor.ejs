<%- include("../common/header") %>
<%- include("../common/sidebar", { currentPath }) %>
<div class="admin-main">
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading"><h1>News &amp; Press</h1></div>
    </div>
    <div class="topbar-right"><a href="/news" target="_blank" class="view-site-btn">View Live News ↗</a></div>
  </header>
  <div class="admin-body">
    <main class="wrap editor-wrap news-admin-editor">
      <a class="back" href="/admin/video_news">← All Articles</a>
      <div class="heading">
        <div>
          <div class="eyebrow">
            NEWSROOM / <%= item?._id ? 'EDIT ARTICLE' : 'NEW ARTICLE' %>
          </div>
          <h1><%= item?._id ? 'Edit Article' : 'Add New Article' %></h1>
          <p>Manage media coverage details and published articles.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="error" role="alert"><%= error %></div>
      <% } %>

      <form
        class="editor"
        action="<%= item?._id ? '/admin/video_news/edit/' + item._id : '/admin/video_news/add' %>"
        method="post"
        enctype="multipart/form-data"
      >
        <section class="panel form-panel">
          <label class="field">
            Headline <span>Required</span>
            <input
              name="title"
              required
              maxlength="180"
              value="<%= item?.title || '' %>"
              placeholder="Enter the article headline"
            >
          </label>

          <label class="field">
            Summary <span>Shown on the article card</span>
            <textarea
              name="summary"
              maxlength="500"
              rows="3"
              placeholder="Write a short article summary"
            ><%= item?.summary || '' %></textarea>
            <small>Maximum 500 characters</small>
          </label>

          <label class="field">
            Article Content <span>Required</span>
            <div class="article-highlight-tools" style="display:flex; align-items:center; gap:10px; margin:8px 0;">
              <button type="button" id="highlightArticleText" class="article-format-btn article-format-btn-bold">Bold selected text</button>
              <button type="button" id="removeArticleHighlight" class="article-format-btn article-format-btn-remove">Remove bold</button>
              <small>Select marked text to remove its bold, or leave selection empty to remove all bold.</small>
            </div>
            <textarea
              id="articleContent"
              name="content"
              required
              maxlength="30000"
              rows="14"
              placeholder="Enter the full article content"
            ><%= item?.content || '' %></textarea>
            <div id="articleContentPreview" class="article-content-preview" aria-label="Article formatting preview"></div>
            <style>
              .article-format-btn { padding:8px 12px; border:0; border-radius:7px; font-weight:700; cursor:pointer; transition:filter .15s ease, transform .15s ease; }
              .article-format-btn:hover { filter:brightness(.94); transform:translateY(-1px); }
              .article-format-btn-bold { color:#fff; background:#2563eb; }
              .article-format-btn-remove { color:#fff; background:#64748b; }
              .article-content-preview { display:none; margin-top:10px; padding:12px; border:1px solid #d7dce3; border-radius:8px; white-space:pre-wrap; overflow-wrap:anywhere; }
              .article-content-preview.is-visible { display:block; }
              .article-content-preview strong { font-weight:800; }
            </style>
          </label>

          <div class="two">
            <div class="source-location-row">
              <label class="field">
                Source / Publisher <span>Required</span>
                <input
                  name="source"
                  required
                  maxlength="120"
                  value="<%= item?.source || '' %>"
                  placeholder="Example: newspaper or news portal"
                >
              </label>
              <label class="field">
                State
                <input name="state" maxlength="80" value="<%= item?.state || '' %>" placeholder="Example: Uttar Pradesh">
              </label>
              <label class="field">
                District
                <input name="district" maxlength="80" value="<%= item?.district || '' %>" placeholder="Example: Varanasi">
              </label>
            </div>

            <label class="field">
              Media Type
              <select name="category" required>
                <option
                  value="Digital Media"
                  <%= (item?.category || 'Digital Media') === 'Digital Media' ? 'selected' : '' %>
                >Digital Media</option>
                <option
                  value="Print Media"
                  <%= item?.category === 'Print Media' ? 'selected' : '' %>
                >Print Media</option>
              </select>
            </label>

            <label class="field">
              Publication Date
              <input
                type="date"
                name="publicationDate"
                value="<%= item?.publicationDate ? new Date(item.publicationDate).toISOString().slice(0, 10) : '' %>"
              >
            </label>

            <label class="field">
              External Article URL
              <input
                type="url"
                name="externalUrl"
                maxlength="1000"
                value="<%= item?.externalUrl || '' %>"
                placeholder="https://..."
              >
              <small>Shown as the source link at the bottom of this article’s detail page.</small>
            </label>
          </div>
        </section>

        <aside>
          <section class="panel form-panel">
            <h2>Featured image</h2>
            <p class="help">Use a hosted image URL to make the image available across deployments, or upload an image file.</p>
            <label class="field">
              Hosted image URL
              <input
                name="thumbnailUrl"
                type="url"
                value="<%= item?.thumbnailPath && /^https?:\/\//i.test(item.thumbnailPath) ? item.thumbnailPath : '' %>"
                placeholder="https://example.com/image.jpg"
              >
            </label>
            <p class="help">JPG, PNG, WebP, or AVIF · Maximum 8 MB</p>
            <label class="field">
              Article Image
              <input
                id="articleThumbnail"
                name="thumbnail"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/avif"
              >
              <input type="hidden" name="thumbnailUploadSelected" id="thumbnailUploadSelected" value="false">
              <img
                id="articleThumbnailPreview"
                class="preview"
                src="<%= item?.thumbnailPath || '' %>"
                alt="Article image preview"
                style="<%= item?.thumbnailPath ? '' : 'display:none;' %>"
              >
              <small id="articleThumbnailStatus"><%= item?.thumbnailPath ? 'Choose a new image or keep the current one.' : 'Selected image preview will appear here.' %></small>
            </label>
            <label class="feature-check" style="display: flex; align-items: flex-start; gap: 10px; margin-top: 14px; padding: 12px; border-radius: 8px; background: #fff8e6; border: 1px solid #fde68a; cursor: pointer;">
              <input type="checkbox" name="isHighlighted" style="margin-top: 3px; accent-color: #d97706; width: 18px; height: 18px;" <%= (item?.isHighlighted || item?.featured) ? 'checked' : '' %>>
              <div>
                <strong style="display: block; color: #92400e; font-size: 14px;">⭐ मुख्य समाचार बनाएं (Highlight News)</strong>
                <small style="display: block; color: #78350f; font-size: 12px; margin-top: 2px;">यह खबर वेबसाइट के होमपेज पर सबसे ऊपर 'मुख्य समाचार' के रूप में हाइलाइट होगी।</small>
              </div>
            </label>
          </section>

          <section class="panel form-panel publish-panel">
            <h2>Publication</h2>
            <p class="help">
              <%= item?.published
                ? 'This article is published on the website.'
                : 'Save as a draft or publish it on the website.' %>
            </p>
            <div class="form-actions">
              <a class="secondary" href="/admin/video_news">Cancel</a>
              <button class="secondary" name="action" value="draft">Save Draft</button>
              <button class="primary" name="action" value="publish">Publish Article</button>
            </div>
          </section>
        </aside>
      </form>
    </main>
  </div>
<script>
  (() => {
    const content = document.getElementById("articleContent");
    const highlightButton = document.getElementById("highlightArticleText");
    const removeHighlightButton = document.getElementById("removeArticleHighlight");
    const preview = document.getElementById("articleContentPreview");
    if (!content || !highlightButton || !removeHighlightButton || !preview) return;

    const escapeHtml = (value) => value.replace(/[&<>"']/g, (char) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;",
    })[char]);

    const refreshPreview = () => {
      const value = content.value;
      const parts = value.split(/(\[\[(?:bold|highlight)\]\][\s\S]*?\[\[\/(?:bold|highlight)\]\])/g);
      preview.innerHTML = parts.map((part) => {
        const match = part.match(/^\[\[(?:bold|highlight)\]\]([\s\S]*?)\[\[\/(?:bold|highlight)\]\]$/);
        return match ? `<strong>${escapeHtml(match[1])}</strong>` : escapeHtml(part);
      }).join("");
      preview.classList.toggle("is-visible", /\[\[(?:bold|highlight)\]\]/.test(value));
    };

    content.addEventListener("input", refreshPreview);
    refreshPreview();

    highlightButton.addEventListener("click", () => {
      const start = content.selectionStart;
      const end = content.selectionEnd;
      if (start === end) {
        content.focus();
        return;
      }

      const selected = content.value.slice(start, end);
      const marked = `[[bold]]${selected}[[/bold]]`;
      content.setRangeText(marked, start, end, "select");
      content.focus();
      content.setSelectionRange(start + marked.length, start + marked.length);
    });

    removeHighlightButton.addEventListener("click", () => {
      const start = content.selectionStart;
      const end = content.selectionEnd;
      const source = content.value;

      if (start !== end) {
        const selected = source.slice(start, end)
          .replace(/\[\[(?:bold|highlight)\]\]/g, "")
          .replace(/\[\[\/(?:bold|highlight)\]\]/g, "");
        content.setRangeText(selected, start, end, "select");
      } else {
        content.value = source
          .replace(/\[\[(?:bold|highlight)\]\]/g, "")
          .replace(/\[\[\/(?:bold|highlight)\]\]/g, "");
        content.setSelectionRange(0, 0);
      }

      content.dispatchEvent(new Event("input", { bubbles: true }));
      content.focus();
    });
  })();

  (() => {
    const input = document.getElementById("articleThumbnail");
    const preview = document.getElementById("articleThumbnailPreview");
    const status = document.getElementById("articleThumbnailStatus");
    const uploadSelected = document.getElementById("thumbnailUploadSelected");
    if (!input || !preview || !status || !uploadSelected) return;

    let previewUrl = "";
    input.addEventListener("change", () => {
      const file = input.files && input.files[0];
      uploadSelected.value = file ? "true" : "false";
      if (!file) return;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(file);
      preview.src = previewUrl;
      preview.style.display = "block";
      status.textContent = `Selected: ${file.name}`;
    });
  })();
</script>
<%- include("../common/footer") %>
