<%- include("../common/header") %>
<%- include("../common/sidebar", { currentPath }) %>
<div class="admin-main">
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Open menu">☰</button>
      <div class="page-heading"><h1>News &amp; Press</h1><p>Manage digital and print media coverage.</p></div>
    </div>
    <div class="topbar-right"><a href="/news" target="_blank" class="view-site-btn">View Live News ↗</a></div>
  </header>
  <div class="admin-body">
    <main class="wrap editor-wrap news-admin-editor">
      <a class="back" href="/admin/video_news">← All Articles</a>
      <div class="heading">
        <div>
          <div class="eyebrow">
            NEWSROOM / <%= item?._id ? 'EDIT ARTICLE' : 'NEW ARTICLE' %>
          </div>
          <h1><%= item?._id ? 'Edit Article' : 'Add New Article' %></h1>
          <p>Manage media coverage details and published articles.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="error" role="alert"><%= error %></div>
      <% } %>

      <form
        class="editor"
        action="<%= item?._id ? '/admin/video_news/edit/' + item._id : '/admin/video_news/add' %>"
        method="post"
        enctype="multipart/form-data"
      >
        <section class="panel form-panel">
          <label class="field">
            Headline <span>Required</span>
            <input
              name="title"
              required
              maxlength="180"
              value="<%= item?.title || '' %>"
              placeholder="Enter the article headline"
            >
          </label>

          <label class="field">
            Summary <span>Shown on the article card</span>
            <textarea
              name="summary"
              maxlength="500"
              rows="3"
              placeholder="Write a short article summary"
            ><%= item?.summary || '' %></textarea>
            <small>Maximum 500 characters</small>
          </label>

          <label class="field">
            Article Content <span>Required</span>
            <textarea
              name="content"
              required
              maxlength="30000"
              rows="14"
              placeholder="Enter the full article content"
            ><%= item?.content || '' %></textarea>
          </label>

          <div class="two">
            <div class="source-location-row">
              <label class="field">
                Source / Publisher <span>Required</span>
                <input
                  name="source"
                  required
                  maxlength="120"
                  value="<%= item?.source || '' %>"
                  placeholder="Example: newspaper or news portal"
                >
              </label>
              <label class="field">
                State
                <input name="state" maxlength="80" value="<%= item?.state || '' %>" placeholder="Example: Uttar Pradesh">
              </label>
              <label class="field">
                District
                <input name="district" maxlength="80" value="<%= item?.district || '' %>" placeholder="Example: Varanasi">
              </label>
            </div>

            <label class="field">
              Media Type
              <select name="category" required>
                <option
                  value="Digital Media"
                  <%= (item?.category || 'Digital Media') === 'Digital Media' ? 'selected' : '' %>
                >Digital Media</option>
                <option
                  value="Print Media"
                  <%= item?.category === 'Print Media' ? 'selected' : '' %>
                >Print Media</option>
              </select>
            </label>

            <label class="field">
              Publication Date
              <input
                type="date"
                name="publicationDate"
                value="<%= item?.publicationDate ? new Date(item.publicationDate).toISOString().slice(0, 10) : '' %>"
              >
            </label>

            <label class="field">
              External Article URL
              <input
                type="url"
                name="externalUrl"
                maxlength="1000"
                value="<%= item?.externalUrl || '' %>"
                placeholder="https://..."
              >
              <small>This link opens when readers select “Read Full Story.”</small>
            </label>
          </div>
        </section>

        <aside>
          <section class="panel form-panel">
            <h2>Featured image</h2>
            <p class="help">Use a hosted image URL to make the image available across deployments, or upload an image file.</p>
            <label class="field">
              Hosted image URL
              <input
                name="thumbnailUrl"
                type="url"
                value="<%= item?.thumbnailPath && /^https?:\/\//i.test(item.thumbnailPath) ? item.thumbnailPath : '' %>"
                placeholder="https://example.com/image.jpg"
              >
            </label>
            <p class="help">JPG, PNG, WebP, or AVIF · Maximum 8 MB</p>
            <label class="field">
              Article Image
              <input
                name="thumbnail"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/avif"
              >
              <% if (item?.thumbnailPath) { %>
                <img
                  class="preview"
                  src="<%= item.thumbnailPath %>"
                  alt="Current article image"
                >
                <small>Choose a new image or keep the current one.</small>
              <% } %>
            </label>
            <label class="feature-check">
              <input type="checkbox" name="featured" <%= item?.featured ? 'checked' : '' %>>
              Feature this article
            </label>
          </section>

          <section class="panel form-panel publish-panel">
            <h2>Publication</h2>
            <p class="help">
              <%= item?.published
                ? 'This article is published on the website.'
                : 'Save as a draft or publish it on the website.' %>
            </p>
            <div class="form-actions">
              <a class="secondary" href="/admin/video_news">Cancel</a>
              <button class="secondary" name="action" value="draft">Save Draft</button>
              <button class="primary" name="action" value="publish">Publish Article</button>
            </div>
          </section>
        </aside>
      </form>
    </main>
  </div>
<%- include("../common/footer") %>
